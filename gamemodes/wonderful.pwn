	           		if(level < 0 && pData[playerid][pAdmin] == 9) return SendClientMessage(playerid, COLOR_GREY, "Максимальный уровень: от 1-го до 8-го.");
	           		if(level > 8 && pData[playerid][pAdmin] == 9) return SendClientMessage(playerid, COLOR_GREY, "Максимальный уровень: от 1-го до 8-го.");
	           		if(level < 0 && pData[playerid][pAdmin] >= 10) return SendClientMessage(playerid, COLOR_GREY, "Максимальный уровень: от 1-го до 10-го.");
	           		if(level > 9 && pData[playerid][pAdmin] >= 10) return SendClientMessage(playerid, COLOR_GREY, "Максимальный уровень: от 1-го до 10-го.");
					pData[id][pAdmin] = level;
					if(pData[id][pAdmin] != 0)
	     			{
	           			if(pData[id][pApass] == 0 || pData[id][pApass] == 2038) pData[id][pApass] = 1000+random(8999);
				    }
	 				else pData[id][pApass] = 0;
