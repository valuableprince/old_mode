			sql_query(snow, query);
			format(query,sizeof(query),"UPDATE `aplayerakk` SET `ammo` = '%d' WHERE `id` = '%d'",pData[playerid][pAmmo],pData[playerid][pMysqlID]);
			sql_query(snow, query, QUERY_THREADED);
		}
	 	case 9210:
        {
       		if(!response) return 1;
			switch(listitem)
			{
				case 0: ShowPlayerDialog(playerid,9310,0,"{C697E5}Уволиться с работы","\n{ffffff}Вы действительно хотите уволиться с работы?\n","Да", "Нет");
				case 1:
				{
					if(pTemp[playerid][pOtgyl] == false) return ShowPlayerDialog(playerid,8510,0,"{C697E5}Отгул","\n{ffffff}Вы действительно хотите взять отгул?\n","Да", "Нет");
					else return ShowPlayerDialog(playerid,8511,0,"{C697E5}Отгул","\n{ffffff}Вы действительно хотите вернуться на работу?\n","Да", "Нет");
				}
     		}
