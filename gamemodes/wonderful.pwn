			if(IsPlayerInRangeOfPoint(playerid, 3.5, DYaz[i][g_y][0], DYaz[i][g_y][1], DYaz[i][g_y][2]) && !IsPlayerInAnyVehicle(playerid))
			{
				if(poxavat[playerid] > 0) return SendClientMessage(playerid, COLOR_GREY, "Вы держите поднос в руках!");
				if(DYaz[i][g_ypod] == 1)
				{
					ApplyAnimation(playerid,"CARRY","liftup05",1.0,0,1,1,0,0,1);
					SetPlayerAttachedObject(playerid,5,2218,1,0.096313,0.334523,-0.267872,109.200798,122.924514,313.923736,1.025472,1.000000,1.000000);
					ApplyAnimation(playerid,"CARRY","crry_prtial",4.1,1,0,0,0,0);
					poxavat[playerid] = 3;
					PUTEDA1[playerid][putinter][0] = 1;
					DestroyDynamicObject(DYaz[i][g_yid]);
					DYaz[i][g_y][0] = 0;
					DYaz[i][g_y][1] = 0;
					DYaz[i][g_y][2] = 0;
					DYaz[i][g_ypod] = 0;
					Delete3DTextLabel(DYaz[i][g_text]);
				}
				else if(DYaz[i][g_ypod] == 2)
				{
					ApplyAnimation(playerid,"CARRY","liftup05",1.0,0,1,1,0,0,1);
					SetPlayerAttachedObject(playerid,5,2212,1,0.096313,0.334523,-0.267872,109.200798,122.924514,313.923736,1.025472,1.000000,1.000000);
					ApplyAnimation(playerid,"CARRY","crry_prtial",4.1,1,0,0,0,0);
					poxavat[playerid] = 2;
					PUTEDA1[playerid][putinter][1] = 1;
					DestroyDynamicObject(DYaz[i][g_yid]);
					DYaz[i][g_y][0] = 0;
					DYaz[i][g_y][1] = 0;
					DYaz[i][g_y][2] = 0;
					DYaz[i][g_ypod] = 0;
					Delete3DTextLabel(DYaz[i][g_text]);
				}
				else if(DYaz[i][g_ypod] == 3)
				{
					ApplyAnimation(playerid,"CARRY","liftup05",1.0,0,1,1,0,0,1);
					SetPlayerAttachedObject(playerid,5,2215,1,0.096313,0.334523,-0.267872,109.200798,122.924514,313.923736,1.025472,1.000000,1.000000);
					ApplyAnimation(playerid,"CARRY","crry_prtial",4.1,1,0,0,0,0);
					poxavat[playerid] = 1;
					DestroyDynamicObject(DYaz[i][g_yid]);
					DYaz[i][g_y][0] = 0;
					DYaz[i][g_y][1] = 0;
					DYaz[i][g_y][2] = 0;
					DYaz[i][g_ypod] = 0;
					PUTEDA1[playerid][putinter][2] = 1;
					Delete3DTextLabel(DYaz[i][g_text]);
				}
			}
		}
