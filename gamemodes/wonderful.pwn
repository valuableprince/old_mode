        {
       		if(!response) return 1;
			if(pTemp[playerid][pOtgyl] == true) return SendErr(playerid, "Вы уже взяли отгул");
			pTemp[playerid][pOtgyl] = true;
			SetPlayerColor(playerid,0xFFFFFF11);
			SetPlayerSkin(playerid,pData[playerid][pSkin]);
			SendSucc(playerid, "Вы взяли отгул");
	 	}
	 	case 8511:
        {
       		if(!response) return 1;
			if(pTemp[playerid][pOtgyl] == false) return SendErr(playerid, "Вы не брали отгул");
