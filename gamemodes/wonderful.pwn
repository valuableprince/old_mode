			pData[playerid][pJob] = 0;
			SetPlayerColor(playerid,gFractionColor[fractionid]);
			SetPlayerSkin(playerid,pData[playerid][pFractionSkin]);
	 	}
	 	case 9310:
        {
       		if(!response) return 1;
