			if(!IsPlayerInDynamicArea(playerid,gAreas[arFill][i])) continue;
			else fillingid = i;
		}
		if(fillingid == -1) return SendClientMessage(playerid,-1,"• {AC0000}[Ошибка] {ffffff}Вы должны быть на АЗС");
		ShowPlayerDialog(playerid,dPokupKanistr,0,"{"#cOR"}Покупка канистры","{"#cW"}Канистра стоит {FF0000}500$\n{"#cW"}C ее помощью вы сможете запрвить любое т/с на 15 литров\n\nCогласны ли Вы приобрести канистру?","Да","Нет");
