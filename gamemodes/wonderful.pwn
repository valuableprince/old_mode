		getdate(year, month, day);
		new h,m,s;
		gettime(h,m,s);
		switch(pData[playerid][pAdmin])
		{
			case 1: { arang = "Практикант"; }
			case 2: { arang = "Старший практикант"; }
			case 3: { arang = "Младший модератор"; }
			case 4: { arang = "Модератор"; }
			case 5: { arang = "Старший модератор"; }
			case 6: { arang = "Администратор"; }
			case 7: { arang = "Старший администратор"; }
			case 8:	{ arang = "Зам.главного администратор"; }
			case 9: { arang = "Главный администратор"; }
			case 10: { arang = "Основатель"; }
			case 11: { arang = "Разработчик"; }
		}
		switch(pData[playerid][pAdmin])
		{
			case 1..5: { akat = "Младшая администрация"; }
