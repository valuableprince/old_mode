					SPFD(playerid,dRegister,1,"Регистрация","Далее","Выход","{FFFFFF}Вам необходимо зарегистрироваться на проекте.\nВаш логин: {4981b3}%s{FFFFFF}\n\nПридумайте пароль и введите его в окне ниже:",pData[playerid][pNickname]);
