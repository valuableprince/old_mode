		if(pData[id][pAmmo]+patr > 1000 && pData[id][pUpdate] >= 2) return SendErr(playerid, "Игрок не может взять столько патрон");
		pData[playerid][pAmmo] -= patr;
		UpdatePlayerData(playerid, "ammo", pData[playerid][pAmmo]);
		pData[id][pAmmo] += patr;
		UpdatePlayerData(playerid, "ammo", pData[id][pAmmo]);
		new mes[128];
		format(mes,sizeof(mes),"передал патроны %s",pData[id][pNickname]);
  		MeAction(playerid,mes);
		format(mes,128,"Вы передали %s %d пт", pData[id][pNickname],patr); SendSucc(playerid, mes);
		format(mes,128,"%s передал Вам %d пт", pData[playerid][pNickname], patr); SendSucc(id, mes);
		return 1;
	}
