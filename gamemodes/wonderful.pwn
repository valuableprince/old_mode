				case 0: color = 1;
				case 1: color = 0;
				case 2: color = 2;
				case 3: color = 3;
				case 4: color = 6;
				case 5: color = 103;
				case 6: color = 33;
				case 7: color = 126;
				case 8: color = 102;
				case 9: color = 85;
