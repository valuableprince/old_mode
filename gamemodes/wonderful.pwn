					{f8993b}Если вы согласитесь установить защиту, обязательно сохраните этот код во избежании его утераты\n",pTemp[playerid][pKodIP]);
					ShowPlayerDialog(playerid,dCodeIPSet,0,"Привязка по IP адрерсу",query,"Установить","Назад");
					}
