					if(pData[playerid][pRequestCode] == 0){ ShowPlayerDialog(playerid,dCodeSet1,3,"Код безопасности","{"#cW"}Введите {FF0000}новый{FFFFFF} защитный код\n\n{ADADAD}Код может состоять только из цифр\nТребуется как минимум 4 символа, маскимальная длина кода 32 символа","ОК","Назад"); }
				}
				case 1:
				{
					new query[223];
				    pData[playerid][pRequestCode] = 0;
				    SendClientMessage(playerid,CWHITE,"• {33AA33}[Успешно] {FFFFFF}Вы удалили код безопасности. Теперь он не будет запрашиваться при входе.");
					format(query,sizeof(query),"UPDATE `aplayerakk` SET `code` = '0000',`requestcode` = '0' WHERE id = '%d'",pData[playerid][pMysqlID]);
					sql_query(snow, query, QUERY_THREADED);
					ShowCodeSettings(playerid);
				}
			}
		}
		case dCodeIP:
