			new query[128];
			format(query,sizeof(query),"SELECT `nickname` FROM `aplayerakk` WHERE `nickname` = '%s'",inputtext);
			new Result:r = sql_query(snow, query);
			if(sql_num_rows(r))
			{
				SendErr(playerid,"Этот никнейм уже используется");
				OnPlayerCommandText(playerid,"/donate");
				return sql_free_result(r);
			}
			sql_free_result(r);
			SetPVarString(playerid,"nnick",inputtext);
			new mes[256];
			format(mes,sizeof(mes),"{"#cW"}Новый никнейм: {"#cBLUE"}%s{"#cW"}.\nБудет снято: 20 рублей\nОстанется на донат счете: %d рублей\n\t\tПродолжить?",inputtext,pData[playerid][pDonate] - 20);
			ShowPlayerDialog(playerid,dDonateNickname2,0,"Смена ника",mes,"Да","Нет");
