				else if(areaid == gDetonateArea[i][1])
				{
     				if(pTemp[playerid][pJustTP])
					{
						pTemp[playerid][pJustTP] = false;
						return 1;
					}
					new Float:x, Float:y, Float:z;
					Streamer_GetFloatData(STREAMER_TYPE_AREA,gDetonateArea[i][0],E_STREAMER_X,x);
