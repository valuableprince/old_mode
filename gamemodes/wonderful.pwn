	if(!strcmp(cmd,"/rvs",true))
	{
		new repairid = GetPVarInt(playerid,"selectedrepair") - 1;
		if(repairid < 0 || repairid > 2) return SendClientMessage(playerid,CGRAY,"Вы должны быть на эстакаде");
		new businessid = repairid + REPAIR_ID_OFFSET;
		if(gBusiness[businessid][busiType] != 8) return SendClientMessage(playerid,CGRAY,"Внутренняя ошибка (#143)");
		if(gBusiness[businessid][busiOwnerID])
		{
			if(gBusiness[businessid][busiProduct] < 100) return SendClientMessage(playerid,CGRAY,"В СТО недостаточно краски");
		}
		if(!pData[playerid][pCar] || !IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid,CGRAY,"Перекрашивать можно только личный авто");
		new slot = GetCarSlot(pData[playerid][pCar]);
		new vehicleid = gCars[slot][carVid];
		if(GetPlayerVehicleID(playerid) != vehicleid) return SendClientMessage(playerid,CGRAY,"Вы должны быть на своем личном авто");
		tmp = strtok(cmdtext,idx);
		if(!strlen(tmp) || !isNumeric(tmp)) return SendPods(playerid, "/rvs [Цвет 1] [Цвет 2]");
		new c1 = strval(tmp);
		tmp = strtok(cmdtext,idx);
		if(!strlen(tmp) || !isNumeric(tmp)) return SendPods(playerid, "/rvs [Цвет 1] [Цвет 2]");
		new c2 = strval(tmp);
		if(c1 > 180 || c2 > 180 || c1 < 0 || c2 < 0) return SendClientMessage(playerid,CGRAY,"Неверный ID цвета");
		SetPVarInt(playerid,"recolor1",c1);
		SetPVarInt(playerid,"recolor2",c2);
		new price = floatround(1.5 * gBusiness[businessid][busiPrice]);
		new mes[128];
		format(mes,sizeof(mes),"{"#cW"}Перекраска в этом СТО стоит $%d.\nПродолжить?",price);
		ShowPlayerDialog(playerid,dRecolor,0,"СТО",mes,"Да","Нет");

		return 1;
	}
	if(!strcmp(cmd,"/shieldoff", true))
	{
	    RemovePlayerAttachedObject(playerid, 1);
        SendClientMessage(playerid, CGRAY, "Вы сняли щит.");
	}
	if(!strcmp(cmd,"/drugs", true))
	{
		if(IsAMafia(playerid))
		{
		    new vehicleid = GetPlayerVehicleID(playerid);
	   		if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendClientMessage(playerid, COLOR_GREY, "Вы должны находится за рулем транспорта!");
			if(GetVehicleModel(GetPlayerVehicleID(playerid)) != 413) return SendClientMessage(playerid, COLOR_GREY, "Вы должны находится в специальном ТС!");
			if(gVehicleDrugs[vehicleid][DrugsKG] >= 2000) return SendClientMessage(playerid, COLOR_GREY, "В этом грузовике нет места!");
			new full, full_;
			for(new i = 1; i <= 5; i++)
			{
				if(MafiaDrugSlot[i] == pData[playerid][pFraction]) full_++;
				if(MafiaDrugs[i][4] == true && MafiaDrugSlot[i] == pData[playerid][pFraction]) full++;
			}
			if(full_ == 0) return SendClientMessage(playerid, COLOR_GREY, "Ваша организация не имеет слота!");
			if(full == 0) return SendClientMessage(playerid, COLOR_GREY, "Урожай должен быть собран!");
			new Float:X, Float:Y, Float:Z;
	 		GetVehiclePos(GetPlayerVehicleID(playerid), X, Y, Z);
			GetXYInFrontOfPlayer(playerid, X, Y, -3.0);
			gVehicleDrugs[vehicleid][MatsPickup] = CreatePickup(19197,23,X,Y,Z);
			gVehicleDrugs[vehicleid][MatsArea] = CreateDynamicSphere(X,Y,Z,1.0);

			new mes[128];
			format(mes,sizeof(mes),"{"#cGREEN"}Наркотиков\n%d",gVehicleDrugs[vehicleid][DrugsKG]);
			gVehicleDrugs[vehicleid][MatsText] = CreateDynamic3DTextLabel(mes,CWHITE,X,Y,Z+0.5,20.0,INVALID_PLAYER_ID,vehicleid);

			RemovePlayerFromVehicle(playerid);
			gVehicleDrugs[vehicleid][DrugsStatus] = true;
			SendClientMessage(playerid, COLOR_GREY, "Вы начали собирать урожай");
		}
	}
	if(!strcmp(cmd,"/place",true))
	{
	    new string[100];
	    if(IsPlayerInRangeOfPoint(playerid,10.0,-1060.2749,-1195.7297,129.5194))
		{
			if(pData[playerid][pRank] < 3) return SendClientMessage(playerid, COLOR_GREY, "Функция доступна с 3 ранга!");
			tmp = strtok(cmdtext, idx);
			if(!strlen(tmp)) return SendPods(playerid, "/place [slot] [time]");
			new slot = strval(tmp);
			tmp = strtok(cmdtext, idx);
			if(!strlen(tmp)) return SendPods(playerid, "/place [slot] [time]");
			new mind = strval(tmp);
			if(slot < 1 || slot > 5) return SendClientMessage(playerid, COLOR_GREY, "ID слот 1 до 5!");
			if(mind < 1 || mind > 120) return SendClientMessage(playerid, COLOR_GREY, "Кол-во минут от 1 до 120!");
			if(IsAMafia(playerid))
			{
				new full_, full;
		    	for(new i = 1; i <= 5; i++)
		    	{
					if(slot == i && MafiaDrugSlot[i] > 0) full_++;
		    		if(MafiaDrugSlot[i] == pData[playerid][pFraction]) full++;
		    	}
		    	if(full_ > 0) return SendClientMessage(playerid, CGRAY, "Данный слот занят!");
		    	if(full > 0) return SendClientMessage(playerid, CGRAY, "Мафия уже занимает слот!");

				format(string, 100, "Вы хотите занять слот №%i на %i минут Стоимость: %i$\n\nВы согласны?", slot,
				mind, PRICE_DRUGS*13*mind);
				ShowPlayerDialog(playerid, dFerma3, 0, "Место", string, "Да", "Нет");

				SetPVarInt(playerid, "PlaceDrugPlayer", playerid);
				SetPVarInt(playerid, "PlaceDrugPrice", PRICE_DRUGS*13*mind);
				SetPVarInt(playerid, "PlaceDrugSlot", slot);
				SetPVarInt(playerid, "PlaceDrugTime", mind);
		    }
			else SendClientMessage(playerid, CGRAY, "Вы не состоите в какой либо Мафии");
		}
		else SendClientMessage(playerid, CGRAY, "Вы должны находится на заводе или ферме!");
	}
	if(!strcmp(cmd,"/sellzone",true))
	{
