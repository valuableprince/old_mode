			case 24: GoAnim(playerid,"RIOT","Riot_Punches",4.1,1,0,0,0,0,0);
			case 25: ApplyAnimation(playerid,"PED","fucku",4.1,0,0,0,0,0,1);
	        case 26: ApplyAnimation(playerid,"BAR","dnK_StndM_loop",4.1,0,0,0,0,0,1);
	        case 27: GoAnim(playerid,"BD_FIRE","BD_Panic_03",4.1,1,0,0,0,0,0);
	        case 28: GoAnim(playerid,"BD_FIRE","M_smklean_loop",4.1,1,0,0,0,0,0);
			case 29: GoAnim(playerid,"BEACH","bather",4.1,1,0,0,0,0,0);
			case 30: GoAnim(playerid,"BEACH","Lay_Bac_loop",4.1,1,0,0,0,0,0);
			case 31: GoAnim(playerid,"BEACH","Parksit_w_loop",4.1,1,0,0,0,0,0);
			case 32: GoAnim(playerid,"BEACH","Sitnwait_Loop_W",4.1,1,0,0,0,0,0);
			case 33: GoAnim(playerid,"BEACH","Parksit_M_loop",4.1,1,0,0,0,0,0);
			case 34: GoAnim(playerid,"benchpress","gym_bp_celebrate",4.1,1,0,0,0,0,0);
			case 35: GoAnim(playerid,"LOWRIDER","Rap_C_loop",4.1,1,0,0,0,0,0);
			case 36: GoAnim(playerid,"LOWRIDER","Rap_B_loop",4.1,1,0,0,0,0,0);
			case 37: GoAnim(playerid,"LOWRIDER","Rap_A_loop",4.1,1,0,0,0,0,0);
			case 38: GoAnim(playerid,"BSKTBALL","BBALL_idleloop",4.1,1,0,0,0,0,0);
			case 39: ApplyAnimation(playerid,"BSKTBALL","BBALL_Jump_Shot",4.1,0,0,0,0,0,1);
			case 40: ApplyAnimation(playerid,"BSKTBALL","BBALL_pickup",4.1,0,0,0,0,0,1);
			case 41: ApplyAnimation(playerid,"CAMERA","camstnd_cmon",4.1,0,0,0,0,0,1);
			case 42: GoAnim(playerid,"CAR","fixn_car_loop",4.1,1,0,0,0,0,0);
			case 43: GoAnim(playerid,"CAR_CHAT","car_talkm_loop",4.1,1,0,0,0,0,0);
			case 44: GoAnim(playerid,"COP_AMBIENT","coplook_loop",4.1,1,0,0,0,0,0);
			case 45: GoAnim(playerid,"CRACK","Bbalbat_Idle_01",4.1,1,0,0,0,0,0);
	        case 46: GoAnim(playerid,"CRACK","Bbalbat_Idle_02",4.1,1,0,0,0,0,0);
    		case 47: ApplyAnimation(playerid,"GHANDS","gsign1",4.1,0,0,0,0,0,1);
	        case 48: ApplyAnimation(playerid,"GHANDS","gsign2",4.1,0,0,0,0,0,1);
	        case 49: ApplyAnimation(playerid,"GHANDS","gsign3",4.1,0,0,0,0,0,1);
			case 50: ApplyAnimation(playerid,"GHANDS","gsign4",4.1,0,0,0,0,0,1);
			case 51: ApplyAnimation(playerid,"GHANDS","gsign5",4.1,0,0,0,0,0,1);
			case 52: ApplyAnimation(playerid,"GHANDS","gsign1LH",4.1,0,0,0,0,0,1);
			case 53: ApplyAnimation(playerid,"GHANDS","gsign2LH",4.1,0,0,0,0,0,1);
			case 54: ApplyAnimation(playerid,"GHANDS","gsign4LH",4.1,0,0,0,0,0,1);
			case 55: GoAnim(playerid,"GRAVEYARD","mrnF_loop",4.1,1,0,0,0,0,0);
			case 56: GoAnim(playerid,"MISC","seat_LR",4.1,1,0,0,0,0,0);
			case 57: GoAnim(playerid,"INT_HOUSE","Lou_in",4.1,0,1,1,1,1,0);
			case 58: GoAnim(playerid,"INT_OFFICE","OFF_sit_Bored_loop",4.1,1,0,0,0,0,0);
			case 59: GoAnim(playerid,"LOWRIDER","F_smklean_loop",4.1,1,0,0,0,0,0);
			case 60: ApplyAnimation(playerid,"MEDIC","CPR",4.1,0,0,0,0,0,1);
			case 61: GoAnim(playerid,"GANGS","LeanIn",4.1,0,1,1,1,1,0);
			case 62: GoAnim(playerid,"MISC","plyrlean_loop",4.1,1,0,0,0,0,0);
			case 63: ApplyAnimation(playerid,"MISC","plyr_shkhead",4.1,0,0,0,0,0,1);
			case 64: GoAnim(playerid,"MISC","scratchballs_01",4.1,1,0,0,0,0,0);
		}
	    PlayerTextDrawShow(playerid, AnimDraw[playerid]);
	    SetPVarInt(playerid,"Animation", 1);
		return 1;
	}
	if(!strcmp(cmd,"/invite",true))
	{
	    if(pData[playerid][pAdmin] > 0 && pData[playerid][pAdmin] < 7) return SendErr(playerid, "Недоступно");
		if(!pData[playerid][pFraction]) return SendErr(playerid, "Вы не состоите в организации");
		new fractionid = pData[playerid][pFraction]-1;
		if(!IsAbleToHire(playerid)) return SendErr(playerid, "Ваш ранг недостаточен");
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp) || !isNumeric(tmp)) return SendPods(playerid, "/invite (ID - игрока)");
		new actplayerid = strval(tmp);
		//if(pData[actplayerid][pLevel] < 2) return SendErr(playerid, "У игрока должен быть 2 уровень");
		if(!IsPlayerConnected(actplayerid)) return SendErr(playerid, "Неверный ID игрока");
		else if(pData[actplayerid][pFraction]) return SendErr(playerid, "Игрок уже состоит в организации");
		if(pData[actplayerid][pWarnc]) return SendErr(playerid, "У игрока есть варн");
		//if(pData[actplayerid][pAdmin] > 1) return SendErr(playerid, "Вы не можете принять администратора.");
		if(GetPlayerDistanceToPlayer(playerid,actplayerid) > 3.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(actplayerid)) return SendErr(playerid, "Вы далеко друг от друга");
		new mes[128];
		format(mes,sizeof(mes),"Вы предложили %s вступить в вашу фракцию",pData[actplayerid][pNickname]);
		SendClientMessage(playerid,CBLUE,mes);
		format(mes,sizeof(mes),"%s предложил Вам вступить во фракцию \"%s\"",pData[playerid][pNickname],gFractionName[fractionid]);
		pTemp[actplayerid][pOfferFraction] = playerid;
		pTemp[actplayerid][pOfferFractionid] = fractionid;
		SetPVarInt(playerid,"actinplayerid",actplayerid);
		ShowPlayerDialog(actplayerid,dInvite,0,"Вступление во фракцию",mes,"Вступить","Отмена");
	}
	if(!strcmp(cmd,"/rang",true))
	{
	    if(pData[playerid][pAdmin] > 0 && pData[playerid][pAdmin] < 7) return SendErr(playerid, "Недоступно");
		if(!pData[playerid][pFraction]) return SendErr(playerid, "Вы не состоите в организации.");
		new fractionid = pData[playerid][pFraction]-1;
		if(!IsAbleToGiveRank(playerid)) return SendErr(playerid, "Ваш ранг недостаточен");
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp) || !isNumeric(tmp)) return SendPods(playerid, "/rang (ID - игрока)");
		new actplayerid = strval(tmp);
		if(!IsPlayerConnected(actplayerid) || actplayerid == playerid) return SendErr(playerid, "Неверный ID игрока");
		if(pData[actplayerid][pFraction] != pData[playerid][pFraction] || pData[actplayerid][pSubfraction] != pData[playerid][pSubfraction]) return SendErr(playerid, "Игрок не состоит в вашей организации");
		if(pData[playerid][pSubfraction] > 0)
		{
			if(pData[actplayerid][pSubfraction] != pData[playerid][pSubfraction]) return SendErr(playerid, "Игрок не состоит в вашей подфракции");
		}
		if(pData[actplayerid][pRank] >= pData[playerid][pRank]) return SendErr(playerid, "Ваш ранг недостаточен");
		if(GetPlayerDistanceToPlayer(playerid,actplayerid) > 3.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(actplayerid)) return SendErr(playerid, "Вы далеко друг от друга");
		SetPVarInt(playerid,"actgrplayerid",actplayerid);
		new mes[512];
		new m = pData[playerid][pRank]-1;
		if(pData[playerid][pFraction] == 11 && !pData[playerid][pSubfraction]) m = 9;
		for(new i;i<m;i++)
		{
			if(pData[actplayerid][pRank] == i+1)
			{
			    if(pData[actplayerid][pFraction] == 11 && !pData[actplayerid][pSubfraction])
					format(mes,sizeof(mes),"%s{33AA33}%s\n",mes,gPrezRankName[i]);
     			else format(mes,sizeof(mes),"%s{33AA33}%s\n",mes,gFractionRankName[fractionid][i]);
    		}
			else
			{
				if(pData[actplayerid][pFraction] == 11 && !pData[actplayerid][pSubfraction])
					format(mes,sizeof(mes),"%s%s\n",mes,gPrezRankName[i]);
				else format(mes,sizeof(mes),"%s%s\n",mes,gFractionRankName[fractionid][i]);
			}
		}
		ShowPlayerDialog(playerid,dSetRank,2,"Смена ранга",mes,"Сменить","Выход");
	}
 	else if(strcmp(cmd, "/jail", true) == 0)
	{
		tmp = strtok(cmdtext, idx);
		if(pData[playerid][pAdmin] < 3) return 1;
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_WHITE, "[{FFA500}Admin-Helper{FFFFFF}] /jail (ID - игрока) (количество минут) (причина)");
		new acter;
		new time;
		acter = ReturnUser(tmp);
		tmp = strtok(cmdtext, idx);
		if(pData[acter][pJail] > 0) return SendErr(playerid, "Данный игрок уже сидит в тюрьме");
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_WHITE, "[{FFA500}Admin-Helper{FFFFFF}] /jail (ID - игрока) (количество минут) (причина)");
		time = strval(tmp);
		tmp = strrest(cmdtext,idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_WHITE, "[{FFA500}Admin-Helper{FFFFFF}] /jail (ID - игрока) (количество минут) (причина)");
		if(pData[acter][pAdmin] >= pData[playerid][pAdmin]) return SendClientMessage(playerid, COLOR_WHITE, "[{FFA500}Admin-Helper{FFFFFF}] /jail (ID - игрока) (количество минут) (причина)");
		new string[128];
		ResetPlayerWeapons(acter);
  		SetPlayerPos(acter,219.5900,110.1900,999.0200,0);
		SetPlayerFacingAngle(acter,269.1558);
		SetPlayerVirtualWorld(acter,1);
		SetPlayerSkin(acter, 42);
		SetPlayerInterior(acter,10);
		pData[acter][pJail] = time*60;
		if(pTemp[acter][pWork] == 3 || pTemp[acter][pWork] == 2 || pTemp[acter][pWork] == 555)
		{
			SendClientMessage(acter, COLOR_LIGHTRED, "Работа завершена");
			DisablePlayerCheckpoint(playerid);
		}
		format(string, sizeof(string), "Администратор %s посадил Вас в тюрьму на %d минут. Причина: %s", pData[playerid][pNickname], time, tmp);
		SendClientMessage(acter, COLOR_LIGHTRED, string);
		format(string, sizeof(string), "• {FFC800}[Подсказка] {ffffff}Чтобы посмотреть сколько Вам осталось сидеть в тюрьме, ведите команду {FFC800}/ptime", pData[playerid][pNickname], time, tmp);
		SendClientMessage(acter, -1, string);
		format(string, sizeof(string), "Вы посадили %s в тюрьму", pData[acter][pNickname]);
		SendClientMessage(playerid, COLOR_LIGHTRED, string);
		format(string,sizeof(string),"(A) Администратор %s[%d] посадил игрока %s[%d] в тюрьму на %d минут. (Причина: %s)",pData[playerid][pNickname],playerid,pData[acter][pNickname],acter,time,tmp);
		AdminChat(CGRAY,string);
		UpdatePlayerData(acter,"wanted",pData[acter][pWanted]);
  		new stringer[255];
		format(stringer, sizeof(stringer), "Администратор %s выдал кпз игроку %s на %d минут. (Причина: %s)",pData[playerid][pNickname],pData[acter][pNickname],time,tmp);
		SendLog(stringer);
		return 1;
	}
 	else if(strcmp(cmd, "/unjail", true) == 0)
	{
		tmp = strtok(cmdtext, idx);
		if(pData[playerid][pAdmin] < 3) return 1;
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_WHITE, "[{FFA500}Admin-Helper{FFFFFF}] /unjail (ID - игрока)");
		new acter;
		acter = ReturnUser(tmp);
		if(!pData[acter][pJail]) return SendErr(playerid, "Игрок не находиться в КПЗ");
		new string[128];
		pData[acter][pJail] = 0;
		if(pData[acter][pFraction])
		{
			SetPlayerSkin(acter,pData[acter][pFractionSkin]);
		}
		else SetPlayerSkin(acter,pData[acter][pSkin]);
		format(string, sizeof(string), "Администратор %s выпустил вас из тюрьмы",pData[playerid][pNickname]);
		SendClientMessage(acter, COLOR_LIGHTRED, string);
		format(string,sizeof(string),"(A) Администратор %s[%d] выпустил игрока %s[%d] из тюрьмы",pData[playerid][pNickname],playerid,pData[acter][pNickname],acter);
		AdminChat(CGRAY,string);
		SetPlayerInterior(acter, 0);
		SetPlayerVirtualWorld(acter, 0);
		SetPlayerPos(acter,1552.9467,-1675.5570,16.1953);
  		new stringer[255];
		format(stringer, sizeof(stringer), "Администратор %s выпустил игрока %s из кпз",pData[playerid][pNickname],pData[acter][pNickname]);
		SendLog(stringer);
		return 1;
	}
	if(!strcmp(cmd,"/setskin",true))
	{
	    if(pData[playerid][pAdmin] > 0 && pData[playerid][pAdmin] < 7) return SendErr(playerid, "Недоступно");
		if(!pData[playerid][pFraction]) return SendErr(playerid, "Вы не состоите во организации");
		new fractionid = pData[playerid][pFraction] - 1;
		if(!IsAbleToGiveSkin(playerid)) return SendErr(playerid, "Ваш ранг недостаточен");
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp) || !isNumeric(tmp)) return SendPods(playerid, "/setskin (ID - игрока)");
		new actplayerid = strval(tmp);
		if(!IsPlayerConnected(actplayerid)) return SendErr(playerid, "Неверный ID игрока");
		if(GetPlayerDistanceToPlayer(playerid,actplayerid) > 3.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(actplayerid)) return SendErr(playerid, "Вы далеко друг от друга");
		if(pData[actplayerid][pFraction] != pData[playerid][pFraction]) return SendErr(playerid, "Игрок не состоит в вашей организации");
		if(pData[playerid][pSubfraction] > 0)
		{
			if(pData[actplayerid][pSubfraction] != pData[playerid][pSubfraction]) return SendErr(playerid, "Игрок не состоит в вашей подфракции");
		}
		if(pData[actplayerid][pRank] >= pData[playerid][pRank] && actplayerid != playerid) return SendErr(playerid, "Ваш ранг недостаточен");
		SetPVarInt(playerid,"actplayerid",actplayerid);
		new mes[256];
		for(new i;i<16;i++)
		{
			new skinid = gFractionSkin[fractionid][i];
			if(!skinid) break;
			if(skinid == pData[actplayerid][pFractionSkin])
			{
				if(!i) format(mes,sizeof(mes),"{33AA33}Скин %d [%d]",i+1,skinid);
				else format(mes,sizeof(mes),"%s\n{33AA33}Скин %d [%d]",mes,i+1,skinid);
			}
			else
			{
				if(!i) format(mes,sizeof(mes),"Скин %d [%d]",i+1,skinid);
				else format(mes,sizeof(mes),"%s\nСкин %d [%d]",mes,i+1,skinid);
			}
		}
		ShowPlayerDialog(playerid,dFractionSkin,2,pData[actplayerid][pNickname],mes,"OK","Отмена");
	}
	if(!strcmp(cmd, "/showall", true))
	{
	    if(pData[playerid][pAdmin] > 0 && pData[playerid][pAdmin] < 7) return SendErr(playerid, "Недоступно");
	    if(!pData[playerid][pFraction]) return SendErr(playerid, "Вы не состоите во организации");
		new query[2046];
		if(pData[playerid][pSubfraction]) {
            if(pData[playerid][pRank] < gFractionRankCount[pData[playerid][pFraction]-1]-1) return SendErr(playerid, "Команда доступна только лидеру организации.");
			format(query, sizeof(query), "SELECT `nickname`,`rank`,`level` FROM `aplayerakk` WHERE `fraction` = %d AND `subfraction` = %d ORDER BY `rank`", pData[playerid][pFraction], pData[playerid][pSubfraction]);
		}
		else {
            if(pData[playerid][pRank] < gFractionRankCount[pData[playerid][pFraction]-1]) return SendErr(playerid, "Команда доступна только лидеру организации.");
			format(query, sizeof(query), "SELECT `nickname`,`rank`,`level` FROM `aplayerakk` WHERE `fraction` = %d AND `subfraction` = 0 ORDER BY `rank`", pData[playerid][pFraction], pData[playerid][pSubfraction]);
		}
		new Result:r = sql_query(snow, query, QUERY_CACHED);
		if(sql_num_rows(r)) {
			format(query, sizeof(query), "Уровень\tИмя игрока\tРанг\n\n");
			new nn[MAX_PLAYER_NAME], rank, lvl;
	        for(new i; i<sql_num_rows(r); i++)
			{
			    sql_get_field_ex(r, i, 0, nn);
			    rank = sql_get_field_int_ex(r, i, 1);
				lvl = sql_get_field_int_ex(r, i, 2);
			    format(query, sizeof(query), "%s%d.\t%d\t%s\t\t%d\n",query,i+1, lvl,nn, rank);
			}
			ShowPlayerDialog(playerid, dMes, 0, "Список сотрудников:",query,"Ок", "");
  		}
		else SendClientMessage(playerid, CGRAY, "Произошла ошибка базы данных. (Информация не найдена)");
		sql_free_result(r);
		return 1;
	}
	if(!strcmp(cmd,"/uninviteoff",true))
	{
	    if(pData[playerid][pAdmin] > 0 && pData[playerid][pAdmin] < 7) return SendErr(playerid, "Недоступно");
	    if(!pData[playerid][pFraction]) return SendErr(playerid, "Вы не состоите во организации");
		tmp = strrest(cmdtext, idx);
		if(!strlen(tmp)) return SendPods(playerid, "/uninviteoff (ник игрока)");
		new query[256];
		if(pData[playerid][pSubfraction]) {
		    if(pData[playerid][pRank] < gFractionRankCount[pData[playerid][pFraction]-1]-1) return SendErr(playerid, "Команда доступна только лидеру организации.");
			format(query, sizeof(query), "UPDATE `aplayerakk` SET `fraction` = '0' WHERE `nickname` = '%s' AND `fraction`='%d' AND `subfraction`='%d'", tmp, pData[playerid][pFraction], pData[playerid][pSubfraction]);
		}
		else {
			if(pData[playerid][pRank] < gFractionRankCount[pData[playerid][pFraction]-1]) return SendErr(playerid, "Команда доступна только лидеру организации.");
			format(query, sizeof(query), "UPDATE `aplayerakk` SET `fraction` = '0' WHERE `nickname` = '%s' AND `fraction`='%d'", tmp, pData[playerid][pFraction]);
		}
		new Result:r = sql_query(snow, query);
		if(!sql_affected_rows(r)) return SendErr(playerid, "Игрок с введенным ником не найден в Вашей организации.");
		format(query, sizeof(query), "Лидер организации %s уволил в оффлайне игрока %s",pData[playerid][pNickname], tmp);
		foreach(new i:Player) {
		    if(pData[i][pFraction] == pData[playerid][pFraction]) {
				if(pData[playerid][pSubfraction] && pData[i][pSubfraction] == pData[playerid][pSubfraction]) {
					SendClientMessage(i,COLOR_ORANGE, query);
					continue;
				}
				if(!pData[playerid][pSubfraction]) {
				    SendClientMessage(i,COLOR_ORANGE, query);
				    continue;
				}
			}
		}
		return 1;
	}
	if(!strcmp(cmd, "/leave",true))
	{
	    if(pData[playerid][pUpdate] < 1) return SendErr(playerid, "Вы не можете использовать это. Нужно улучшение: Решительность");
        if(!pData[playerid][pFraction]) return SendErr(playerid, "Вы не состоите во организации");
		if(IsAbleToUninvite(playerid)) return SendErr(playerid, "Вы не можете уволиться из организации");
		tmp = strrest(cmdtext,idx);
		if(strlen(tmp) < 3) return SendPods(playerid, "/leave (причина)");
		new query[128];
		format(query,sizeof(query),"UPDATE `aplayerakk` SET `fraction` = '0', `rank` = '0', `fractionskin` = '0', `subfraction` = '0' WHERE `id` = '%d'",pData[playerid][pMysqlID]);
		sql_query(snow, query, QUERY_THREADED);
		SetPlayerArmourEx(playerid, 0);
		ResetPlayerWeaponsEx(playerid);
		new fractionid = pData[playerid][pFraction]-1;
		new rank = pData[playerid][pRank];
		new subfraction = pData[playerid][pSubfraction];
		pData[playerid][pFraction] = 0;
		pData[playerid][pRank] = 0;
		pData[playerid][pFractionSkin] = 0;
		pData[playerid][pSubfraction] = 0;
		ResetPlayerWeaponsEx(playerid);
		SetPlayerColor(playerid,0xFFFFFF11);
		new houseid = pData[playerid][pHouse]-1;
		if(!(houseid+1) || ((houseid+1) > 0 && pData[playerid][pMysqlID] != gHouses[houseid][houseOwnerID])) SetPlayerSkin(playerid,pData[playerid][pSkin]);
		else if(!gHouses[houseid][houseImprove][3]) SetPlayerSkin(playerid,pData[playerid][pSkin]);
		else
		{
			for(new x; x < 3; x ++) {
				if(!gHouses[houseid][houseSkin]) continue;
				pData[playerid][pSkin] = gHouses[houseid][houseSkin];
				if(GetPlayerSkin(playerid) == gHouses[houseid][houseSkin][3]) SetPlayerSkin(playerid,pData[playerid][pSkin]);
			}
			gHouses[houseid][houseSkin][3] = 0;

			UpdateHouseDress(houseid);
		}
		SetPlayerSkin(playerid,pData[playerid][pSkin]);
		format(query,sizeof(query),"%s %s[%d] уволился из организации. Причина: %s",gFractionRankName[fractionid][rank-1],pData[playerid][pNickname],playerid,tmp);
		if(fractionid+1 == 11 && !pData[playerid][pSubfraction] && rank <= 9)
			format(query,sizeof(query),"%s %s[%d] уволился из организации. Причина: %s",gPrezRankName[rank-1],pData[playerid][pNickname],playerid,tmp);
		foreach(new i:Player)
		{
			if(IsPlayerConnected(i) && pData[i][pFraction] == fractionid+1 &&
			pData[i][pSubfraction] == subfraction) SendClientMessage(i,CYELLOW,query);
		}
	    return 1;
	}
	if(!strcmp(cmd,"/uninvite",true))
	{
	    if(pData[playerid][pAdmin] > 0 && pData[playerid][pAdmin] < 7) return SendErr(playerid, "Недоступно");
		if(!pData[playerid][pFraction]) return SendErr(playerid, "Вы не состоите во организации");
		if(!IsAbleToUninvite(playerid)) return SendErr(playerid, "Ваш ранг недостаточен");
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp) || !isNumeric(tmp)) return SendPods(playerid, "/uninvite (ID - игрока) (причина)");
		new actplayerid = strval(tmp);
		tmp = strrest(cmdtext,idx);
		if(!strlen(tmp)) return SendPods(playerid, "/uninvite (ID - игрока) (причина)");
		if(!IsPlayerConnected(actplayerid) || actplayerid == playerid) return SendErr(playerid, "Неверный ID игрока");
		if(pData[actplayerid][pFraction] != pData[playerid][pFraction]) return SendErr(playerid, "Игрок не состоит в вашей организации");
		//if(pData[actplayerid][pAdmin] > 1) return SendErr(playerid, "Вы не можете уволить администратора.");
		if(pData[playerid][pSubfraction] > 0)
		{
			if(pData[actplayerid][pSubfraction] != pData[playerid][pSubfraction]) return SendErr(playerid, "Игрок не состоит в вашей подфракции");
		}
		if(pData[actplayerid][pRank] >= pData[playerid][pRank]) return SendErr(playerid, "Ваш ранг недостаточен");
		new query[128];
		format(query,sizeof(query),"UPDATE `aplayerakk` SET `fraction` = '0', `rank` = '0', `fractionskin` = '0', `subfraction` = '0' WHERE `id` = '%d'",pData[actplayerid][pMysqlID]);
		sql_query(snow, query, QUERY_THREADED);
        SetPlayerArmourEx(actplayerid, 0);
		ResetPlayerWeaponsEx(actplayerid);
		pData[actplayerid][pFraction] = 0;
		pData[actplayerid][pRank] = 0;
		pData[actplayerid][pFractionSkin] = 0;
		pData[actplayerid][pSubfraction] = 0;
		ResetPlayerWeaponsEx(actplayerid);
		SetPlayerColor(actplayerid,0xFFFFFF11);
		new houseid = pData[actplayerid][pHouse]-1;
		if(!(houseid+1) || ((houseid+1) > 0 && pData[actplayerid][pMysqlID] != gHouses[houseid][houseOwnerID])) SetPlayerSkin(actplayerid,pData[actplayerid][pSkin]);
		else if(!gHouses[houseid][houseImprove][3]) SetPlayerSkin(actplayerid,pData[actplayerid][pSkin]);
		else
		{
			for(new x; x < 3; x ++) {
				if(!gHouses[houseid][houseSkin]) continue;
				pData[actplayerid][pSkin] = gHouses[houseid][houseSkin];
				if(GetPlayerSkin(actplayerid) == gHouses[houseid][houseSkin][3]) SetPlayerSkin(actplayerid,pData[actplayerid][pSkin]);
			}
			gHouses[houseid][houseSkin][3] = 0;
			UpdateHouseDress(houseid);
		}
		SetPlayerSkin(actplayerid,pData[actplayerid][pSkin]);
		new mes[128];
		format(mes,sizeof(mes),"%s уволил Вас из организации. Причина: %s",pData[playerid][pNickname], tmp);
		SendClientMessage(actplayerid,CBADINFO,mes);
  		format(mes,sizeof(mes),"%s уволил %s из организации. Причина: %s",pData[playerid][pNickname],pData[actplayerid][pNickname], tmp);
		SendFMes(pData[playerid][pFraction],CBLUE, mes);
		format(mes,sizeof(mes),"%s был уволен из организации. Причина: %s",pData[actplayerid][pNickname], tmp);
		SendClientMessage(playerid,CINFO,mes);
	}
	if(!strcmp(cmd,"/takelic",true))
    {
        if(!IsACop(playerid) || pData[playerid][pRank] < 6) return SendErr(playerid, "Эта функция только для Полиции/ФБР с 6 ранга");
        tmp = strtok(cmdtext, idx);
		if(!strlen(tmp) || !isNumeric(tmp)) return SendPods(playerid, "/takelic (ID - игрока)(причина)");
		new actplayerid = strval(tmp);
		if(!IsPlayerConnected(actplayerid) || actplayerid == playerid || (IsACop(actplayerid) && pData[actplayerid][pRank] >= pData[playerid][pRank])) return SendErr(playerid,"Неверный ID игрока или нет полномочий");
		if(GetPlayerDistanceToPlayer(playerid,actplayerid) > 3.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(actplayerid)) return SendErr(playerid,"Вы далеко друг от друга");
		if(!pData[actplayerid][pLicenses][LIC_DRIVING]) return SendErr(playerid, "У игрока нет лицензии");
		tmp = strrest(cmdtext,idx);
		if(!strlen(tmp)) return SendPods(playerid, "/takelic (ID - игрока)(причина)");
		new mes[128];
		format(mes,sizeof(mes),"UPDATE `aplayerakk` SET `licDrive` = '0' WHERE `id` = '%d'",pData[actplayerid][pMysqlID]);
		sql_query(snow, mes);
		pData[actplayerid][pLicenses][LIC_DRIVING] = 0;
		format(mes,sizeof(mes),"%s забрал у Вас лицензию на вождение. Причина: %s",pData[playerid][pNickname], tmp);
		SendClientMessage(actplayerid,CBADINFO,mes);
		format(mes,sizeof(mes),"%s был лишён лицензии на вождение. Причина: %s",pData[actplayerid][pNickname], tmp);
		SendClientMessage(playerid,CINFO,mes);
		format(mes, sizeof(mes), "%s %s[%d] забрал лицензию на вождение у %s. Причина: %s", gFractionRankName[pData[playerid][pFraction]-1][pData[playerid][pRank]-1], pData[playerid][pNickname], playerid, pData[actplayerid][pNickname], tmp);
		SendFMes(pData[playerid][pFraction],CBLUE, mes);
		return 1;
	}
	if(!strcmp(cmd, "/leaders", true))
	{
		new zStr[3000],zVal;
		new atext[150];
		format(zStr, sizeof(zStr), "{ffffad}Организация - Должность - Имя - Телефон - Выговоры\n\n{"#cW"}");
		foreach(new i: Player)
		{
			if(pData[i][pFraction] && IsALeader(i))
			{
				new fractionid = pData[i][pFraction] - 1;
				new frid = GetSubfractionID(fractionid);
				new subid = pData[i][pSubfraction] - 1;
				if(pData[i][pFraction] && pData[i][pSubfraction] >= 1)
				format(atext, sizeof(atext), "%s", gSubfractionName[frid][subid]);
				else if(pData[i][pFraction] && pData[i][pSubfraction] == 0)
				format(atext, sizeof(atext), "%s", gFractionName[fractionid]);
				zVal++;
			}
			if(pData[i][pFraction] && IsALeader(i))
			{
		        if(pTemp[i][pAFK] > 0)
		        {
					format(zStr, sizeof(zStr), "%s%s - %s - %s[%d] - %d {ffa800}[AFK: %s]{FFFFFF}\n", zStr, atext,gFractionRankName[pData[i][pFraction]-1][pData[i][pRank]-1],pData[i][pNickname], i, pData[i][pPhone],Converts(pTemp[i][pAFK]));
				}
				else format(zStr, sizeof(zStr), "%s%s - %s - %s[%d] - %d\n", zStr, atext,gFractionRankName[pData[i][pFraction]-1][pData[i][pRank]-1],pData[i][pNickname], i, pData[i][pPhone]);
			}
		}
		if(!zVal) format(zStr, sizeof(zStr), "\tЛидеров нет онлайн");
		ShowPlayerDialog(playerid, dMes, DIALOG_STYLE_MSGBOX, "{ffffad}Лидеры oнлайн", zStr, "Закрыть", "");
		return 1;
	}
	if(!strcmp(cmd,"/find",true))
	{
  		new want_text[256],want1,sttr[2000], otgyl[64];
		if(!pData[playerid][pFraction]) return SendErr(playerid, "Вы не состоите в организации");
		format(want_text,sizeof(want_text),"{FFFF99}ID\tУровень\tТелефон\tРанг\tВыговороы\tИмя игрока\t\tСтатус\n\n");
		strcat(sttr, want_text);
		if(pTemp[playerid][pOtgyl] == true) otgyl = "{FF0000}Отгул{FFFFFF}";
		else otgyl = "{00FF00}На работе{FFFFFF}";
  		new fractionid = pData[playerid][pFraction] - 1;
		new subfraction = GetSubfractionID(fractionid);
		new subfractionid = pData[playerid][pSubfraction] - 1;
		foreach(new i : Player)
		{
		    if(pData[i][pAdmin] > 0) continue;
		    if(subfraction == -1)
			{
  				if(pData[i][pFraction] != fractionid+1) continue;
				if(pData[i][pPhone] > 0)
				{
					if(pTemp[i][pAFK] > 0) format(want_text,sizeof(want_text), "{"#cW"}%d\t%d\t\t%i\t\t%d\t%d/3\t\t%s \t[%s] {ffa800}[AFK: %s]{"#cW"}\n", i, pData[i][pLevel], pData[i][pPhone], pData[i][pRank], pData[i][pTWarn], pData[i][pNickname], otgyl, Converts(pTemp[i][pAFK]));
					else format(want_text,sizeof(want_text), "{"#cW"}%d\t%d\t\t%i\t\t%d\t%d/3\t\t%s\n", i, pData[i][pLevel], pData[i][pPhone], pData[i][pRank], pData[i][pTWarn], pData[i][pNickname]);
				}
				else
				{
					if(pTemp[i][pAFK] > 0) format(want_text,sizeof(want_text), "{"#cW"}%d\t%d\t\tNone\t\t%d\t%d/3\t%s \t[%s] {ffa800}[AFK: %s]{"#cW"}\n", i, pData[i][pLevel], pData[i][pRank], pData[i][pTWarn], pData[i][pNickname], otgyl, Converts(pTemp[i][pAFK]));
					else format(want_text,sizeof(want_text), "{"#cW"}%d\t%d\t\tNone\t\t%d\t\t%d/3\t\t%s\n", i, pData[i][pLevel], pData[i][pRank], pData[i][pTWarn], pData[i][pNickname]);
				}
				strcat(sttr, want_text);
				want1++;
			}
			else
			{
			    if(pData[i][pFraction] != fractionid+1 || pData[i][pSubfraction] != subfractionid + 1) continue;
			    if(pData[i][pPhone] > 0) format(want_text,sizeof(want_text), "{"#cW"}%d\t%d\t\t%i\t\t%d\t%d/3\t\t%s\t[%s]\n", i, pData[i][pLevel], pData[i][pPhone], pData[i][pRank], pData[i][pTWarn], pData[i][pNickname], otgyl);
				else format(want_text,sizeof(want_text), "{"#cW"}%d\t%d\t\tNone\t\t%d\t%d/3\t\t%s\t[%s]\n", i, pData[i][pLevel], pData[i][pRank], pData[i][pTWarn], pData[i][pNickname],otgyl);
				strcat(sttr, want_text);
				want1++;
			}
		}
		if(want1 == 0) strcat(sttr, "{"#cW"}Информация не найдена");
		ShowPlayerDialog(playerid, dMes, DIALOG_STYLE_MSGBOX, "{FFFF00}Члены организации онлайн", sttr, "Закрыть", "");
		return 1;
	}
	if(!strcmp(cmd,"/heal",true))
	{
	    new string[100];
		if(pData[playerid][pFraction] != 2) return SendErr(playerid, "Вам недоступна эта Команда");
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp) || !isNumeric(tmp)) return SendPods(playerid, "/heal (ID - игрока) [Цена]");
		new actplayerid = strval(tmp);
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp) || !isNumeric(tmp)) return SendPods(playerid, "/heal (ID - игрока) [Цена]");
		new price = strval(tmp);
		if(price < 1 || price > 150) return SendErr(playerid, "Цена должна быть от $1 до $150");
		if(GetPlayerDistanceToPlayer(playerid,actplayerid) > 3.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(actplayerid)) return SendErr(playerid, "Вы далеко друг от друга");
		SetPVarInt(actplayerid,"healprice",price);
		SetPVarInt(actplayerid,"doctorid",playerid);
		format(string, 100, "Вы предложили %s игроку купить лекарство за %d$", pData[actplayerid][pNickname], price);
		SendClientMessage(playerid, CGREEN, string);
		SPFD(actplayerid,dHeal,0,"Мед. обслуживание","Да","Нет","{"#cW"}%s предлагает Вам купить лекарство за %d$",pData[playerid][pNickname],price);
		return 1;
	}
	if(!strcmp(cmd,"/healme",true))
	{
		if(pTemp[playerid][pHealing] < 1) return SendErr(playerid, "У вас нет аптечек");
		new Float:shealth;
		GetPlayerHealth(playerid, shealth);
		if(shealth >= 100) return SendClientMessage(playerid, CGRAY, "Ваше здоровье в хорошем состоянии");
		SetPlayerHealthEx(playerid,100.0);
		pData[playerid][pHealth] = 100;
		pTemp[playerid][pHealing] -= 1;
		MeAction(playerid,"перебинтовал рану");
		if(!IsPlayerInAnyVehicle(playerid)) return ApplyAnimation(playerid,"ped","gum_eat",4.0,0,0,0,0,0,1);
		return 1;
	}
	if(!strcmp(cmd,"/healup",true))
	{
	    for(new i; i < 3; i ++)
		{
			if(!IsPlayerInRangeOfPoint(playerid, 15.0, HealPos[i][0], HealPos[i][1], HealPos[i][2])) return 1;
 			if(GetPlayerMoneyEx(playerid) < 150) return SendClientMessage(playerid,CGRAY,"У вас недостаточно денег");
 			new Float:shealth;
			GetPlayerHealth(playerid, shealth);
			if(shealth >= 100) return SendClientMessage(playerid, CGRAY, "Ваше здоровье в хорошем состоянии");
			pData[playerid][pMoney] -= 150;
			SetPlayerHealthEx(playerid, shealth+40);
			GetPlayerHealth(playerid, shealth);
			if(shealth > 100) SetPlayerHealthEx(playerid, 100);
			if(!IsPlayerInAnyVehicle(playerid)) { ApplyAnimation(playerid,"ped","gum_eat",4.0,0,0,0,0,0,1); }
			if(pData[playerid][pSex] == 1) SetPlayerChatBubble(playerid,"использовал аптечку",COLOR_PURPLE,30.0,1000);
			else SetPlayerChatBubble(playerid,"использовала аптечку",COLOR_PURPLE,30.0,1000);
			GameTextForPlayer(playerid, "~b~+40 HP", 100, 1);
		}
	}
	if(!strcmp(cmd,"/l",true))
    {
        if(pData[playerid][pAdmin] > 0 && pData[playerid][pAdmin] < 7) return SendClientMessage(playerid,CGRAY,"Недоступно"); //1, 2, 8, 9, 10, 11, 12
    	if(!IsAGos(playerid)) return 1;
    	if(pData[playerid][pFraction] == 1 && pData[playerid][pRank] >= 7 ||
    	pData[playerid][pFraction] == 2 && pData[playerid][pRank] >= 9 ||
    	pData[playerid][pFraction] == 8 && pData[playerid][pRank] >= 11 ||
    	pData[playerid][pFraction] == 9 && pData[playerid][pRank] >= 19 ||
    	pData[playerid][pFraction] == 10 && pData[playerid][pRank] == 9 ||
    	pData[playerid][pFraction] == 11 && pData[playerid][pRank] == 9 ||
    	pData[playerid][pFraction] == 12 && pData[playerid][pRank] >= 16)
    	{
	    	if(pData[playerid][pMut]) return SendClientMessage(playerid,CGRAY,"У Вас бан чата");
	    	tmp = strrest(cmdtext, idx);
			if(!strlen(tmp)) return SendClientMessage(playerid,CGRAY,"{"#cYELLOW"}• [Подсказка]: {"#cWHITE"}/l [текст]");
			SetPlayerChatBubble(playerid, "Сказал что-то в рацию партии", CPINK, 10.0, 3000);
			new mesid[128];
			format(mesid,sizeof(mesid),"[L] %s: %s",pData[playerid][pNickname],tmp);
	    	SendGos(0xF0E68CAA, mesid);
    	}
    }
	if(!strcmp(cmd,"/r",true))
	{
		if(IsAGang(playerid) || IsAMafia(playerid) || pData[playerid][pFraction] == 1) return SendErr(playerid, "Вам недоступна эта функция");
		if(!pData[playerid][pFraction]) return SendErr(playerid, "Вам недоступна эта функция");
		if(pData[playerid][pMut]) return SendPods(playerid, "У вас бан чата. Используйте /mutetime чтобы узнать время бана.");
		if(!(pData[playerid][pSettings] & setFractionChat)) return SendErr(playerid, "Включите чат фракции в личных настройках");
		if(pData[playerid][pJail]) return SendErr(playerid, "Вы в тюрьме.");
		tmp = strrest(cmdtext, idx);
		if(!strlen(tmp)) return SendPods(playerid, "/r (текст)");
		new fractionid = pData[playerid][pFraction]-1;
		new rank = pData[playerid][pRank];
		new mesid[128];
		SetPlayerChatBubble(playerid, "Сказал что-то в рацию", CPINK, 10.0, 3000);
		format(mesid,sizeof(mesid),"[R] %s %s[%d]: %s",gFractionRankName[fractionid][rank-1],pData[playerid][pNickname],playerid,tmp);
		if(fractionid+1 == 11 && !pData[playerid][pSubfraction] && rank <= 9)
		format(mesid,sizeof(mesid),"[R] %s %s[%d]: %s",gPrezRankName[rank-1],pData[playerid][pNickname],playerid,tmp);
		foreach(new i:Player)
		{
			if(IsPlayerConnected(i) && pData[i][pFraction] == fractionid+1 &&
			pData[i][pSubfraction] == pData[playerid][pSubfraction]) SendClientMessage(i,0xa8e607FF,mesid);
		}
		return 1;
	}
	if(!strcmp(cmd,"/rn",true))
	{
		if(IsAGang(playerid) || IsAMafia(playerid) || pData[playerid][pFraction] == 1) return SendErr(playerid, "Вам недоступна эта функция");
		if(!pData[playerid][pFraction]) return SendErr(playerid, "Вам недоступна эта функция");
		if(pData[playerid][pMut]) return SendPods(playerid, "У вас бан чата. Используйте /mutetime чтобы узнать время бана.");
		if(!(pData[playerid][pSettings] & setFractionChat)) return SendErr(playerid, "Включите чат фракции в личных настройках");
		if(pData[playerid][pJail]) return SendErr(playerid, "Вы в тюрьме.");
		tmp = strrest(cmdtext, idx);
		if(!strlen(tmp)) return SendPods(playerid, "/rn (текст)");
		new fractionid = pData[playerid][pFraction]-1;
		new rank = pData[playerid][pRank];
		new mesid[128];
		format(mesid,sizeof(mesid),"(( [R] %s %s[%d]: %s ))",gFractionRankName[fractionid][rank-1],pData[playerid][pNickname],playerid,tmp);
		if(fractionid+1 == 11 && !pData[playerid][pSubfraction] && rank <= 9)
		format(mesid,sizeof(mesid),"(( [R] %s %s[%d]: %s ))",gPrezRankName[rank-1],pData[playerid][pNickname],playerid,tmp);
		foreach(new i:Player)
		{
			if(IsPlayerConnected(i) && pData[i][pFraction] == fractionid+1 &&
			pData[i][pSubfraction] == pData[playerid][pSubfraction]) SendClientMessage(i,0xa8e607FF,mesid);
		}
		return 1;
	}
	if(!strcmp(cmd,"/f",true))
	{
	    if(pData[playerid][pFraction] == 16 || pData[playerid][pFraction] == 11) return SendClientMessage(playerid,CGRAY,"Ошибка: Вам недоступна эта функция");
