		new query[2046];
		if(pData[playerid][pFlvl] > 0) {
            if(pData[playerid][pFlvl] < 6) return SendClientMessage(playerid,CGRAY,"Команда доступна только создателю семьи.");
			format(query, sizeof(query), "SELECT `nickname`,`phone`,`level`,`flvl` FROM `aplayerakk` WHERE `fname` = '%s' ORDER BY `flvl`", pData[playerid][pFname]);
		}
		new Result:r = sql_query(snow, query, QUERY_CACHED);
		if(sql_num_rows(r)) {
			format(query, sizeof(query), "Уровень\tИмя игрока\tТелефон\tРанг\n\n");
			new nn[MAX_PLAYER_NAME], phone, lvl, flvl;
	        for(new i; i<sql_num_rows(r); i++)
			{
			    sql_get_field_ex(r, i, 0, nn);
			    phone = sql_get_field_int_ex(r, i, 1);
				lvl = sql_get_field_int_ex(r, i, 2);
				flvl = sql_get_field_int_ex(r, i, 3);
			    format(query, sizeof(query), "%s\t%d\t%s\t\t%d\t%d\n",query, lvl,nn, phone, flvl);
			}
			ShowPlayerDialog(playerid, 0000, 0, "Список членов семьи:",query,"Ок", "");
  		}
		else SendClientMessage(playerid, CGRAY, "Произошла ошибка базы данных");
		sql_free_result(r);
		return 1;
	}
