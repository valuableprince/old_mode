		if(actplayerid != playerid)
		{
			new mes[128];
			format(mes,sizeof(mes),"Вы предложили {"#cW"}%s {"#cINFO"} показать ПТС",pData[actplayerid][pNickname]);
			SendClientMessage(playerid,CINFO,mes);
