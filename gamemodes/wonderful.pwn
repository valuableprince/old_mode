						if(gShopPriceEx[11] > gBusiness[id][busiProduct]) return SendClientMessage(playerid,-1,"• {AC0000}[Ошибка] {"#cW"}В этом магазине не осталось товара");
					}
					gBusiness[id][busiProduct] -= gShopPriceEx[11];
					gBusiness[id][busiBank] += price;
					UpdateBusinessDataEx(id+1,"product",gBusiness[id][busiProduct],"bank",gBusiness[id][busiBank]);
					UpdateBusinessText(id);
					pData[playerid][pMoney] -= price;
					GivePlayerWeaponEx(playerid, 41, 500);
					SendClientMessage(playerid,CGREEN,"Вы купили {FFCC00}маленький балончик с краской{33AA33}.");
					new mesa[500];
					for(new i;i<SHOP_OBJECTS;i++)
					{
						format(mesa,sizeof(mesa),"%s{"#cW"}%s ($%d)\n",mesa,gShopObject[i],gShopPrice[i]);
					}
					ShowPlayerDialog(playerid,dShop,2,"{FFFF99}Магазин 24/7",mesa,"Купить","Выход");
				}
				case 12:
				{
				    new price = gShopPrice[12];
				    if(GetPlayerMoneyEx(playerid) < price) return SendClientMessage(playerid,-1,"• {AC0000}[Ошибка] {"#cW"}У Вас недостаточно денег");
                    if(gBusiness[id][busiOwnerID])
                    {
						if(gShopPriceEx[12] > gBusiness[id][busiProduct]) return SendClientMessage(playerid,-1,"• {AC0000}[Ошибка] {"#cW"}В этом магазине не осталось товара");
					}
					gBusiness[id][busiProduct] -= gShopPriceEx[12];
					gBusiness[id][busiBank] += price;
					UpdateBusinessDataEx(id+1,"product",gBusiness[id][busiProduct],"bank",gBusiness[id][busiBank]);
					UpdateBusinessText(id);
					pData[playerid][pMoney] -= price;
					GivePlayerWeaponEx(playerid, 41, 1000);
					SendClientMessage(playerid,CGREEN,"Вы купили {FFCC00}большой балончик с краской{33AA33}.");
					new mesa[500];
