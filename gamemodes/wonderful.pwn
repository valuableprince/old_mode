		ShowPlayerDialog(playerid, dSellZone, DIALOG_STYLE_LIST, "Продажа территории", "The Ballas\nGrove Street\nVarios Los Aztecas\nLos Santos Vagos\nThe Rifa","Выбор","Отмена");
