				OnPlayerCommandText(playerid,"/donate");
				return SendErr(playerid,"Вам нужно иметь 20 рублей на донат счете, чтобы поменять ник");
			}
			if(strlen(inputtext) < 3 || strlen(inputtext) > 20)
			{
				OnPlayerCommandText(playerid,"/donate");
