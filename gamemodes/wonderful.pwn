			x = gHints[hint][hintX];
			y = gHints[hint][hintY];
			z = gHints[hint][hintZ];
			if(IsPlayerInRangeOfPoint(playerid,2.0,x,y,z))
			{
				SetPlayerInterior(playerid,0);
				SetPlayerVirtualWorld(playerid,0);
				pTemp[playerid][pJustTP] = true;
