public OnPlayerKeyStateChange(playerid, newkeys, oldkeys)
{
	if(newkeys == KEY_SPRINT)
	{
		if(GetPVarInt(playerid, "AutoSalon") == 1) return 1;
		if(IsPlayerInDynamicArea(playerid,gAreas[arDoorLS]))
		{
			SetPlayerPos(playerid,1540.1921,-1692.2007,-51.6619);
		}
		if(IsPlayerInDynamicArea(playerid,gAreas[arDoorLSn]))
		{
			SetPlayerPos(playerid,1540.1976,-1695.1836,-51.6684);
		}
		if(IsPlayerInDynamicArea(playerid,gAreas[arDoornew]))
		{
			SetPlayerPos(playerid,1534.5598,-1696.2845,-51.6684);
		}
		if(IsPlayerInDynamicArea(playerid,gAreas[arDoornewn]))
		{
			SetPlayerPos(playerid,1537.1134,-1695.5382,-51.6619);
		}
		if(IsPlayerInDynamicArea(playerid,gAreas[arDor]))
		{
			SetPlayerPos(playerid,1577.6548,-1673.3263,-47.5200);
		}
		if(IsPlayerInDynamicArea(playerid,gAreas[arDorn]))
		{
			SetPlayerPos(playerid,1577.6394,-1675.3365,-47.5200);
		}
	}
	if(newkeys == 128 || newkeys == 16)
  	{
  	   if (GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
   	   {
          new Float:vec[3];
          GetPlayerCameraFrontVector(playerid, vec[0], vec[1], vec[2]);
          new bool:crasher = false;
          for (new i = 0; !crasher && i < sizeof(vec); i++)
          if (floatabs(vec[i]) > 10.0)
          crasher = true;
      	  if (crasher) {
      	  new mes[135];
		  format(mes,sizeof(mes),"[Античит] %s был кикнут. Причина: Крашер",pData[playerid][pNickname]);
		  AdminChat(CRED,mes);
		  SendClientMessage(playerid,-1,"Вы были кикнуты по подозрению в crash");
		  NewKick(playerid);
			}

   	   }
    }
    if((newkeys & KEY_SECONDARY_ATTACK && GetPVarInt(playerid,"Animation") == 1))
    {
    ClearAnimations(playerid);
    SetPVarInt(playerid,"Animation",0);
	PlayerTextDrawHide(playerid, AnimDraw[playerid]);
    }
    if(newkeys & KEY_JUMP && pTemp[playerid][pWork] == 2 && GetPVarInt(playerid,"perenos") > 0 ||
	newkeys & KEY_FIRE && pTemp[playerid][pWork] == 2 && GetPVarInt(playerid,"perenos") > 0)
	{
		RemovePlayerAttachedObject(playerid,0);
		new id = RandomEx(0,2);
		SetPlayerCheckpoint(playerid,gCoalManCPs[id][0],gCoalManCPs[id][1],gCoalManCPs[id][2],3.0);
		SetPVarInt(playerid,"loadid",id);
		SendClientMessage(playerid,-1,"Вы уронили мешок");
		SetPVarInt(playerid,"coalamount",0);
		SetPVarInt(playerid,"perenos",0);
		ApplyAnimation(playerid,"PED","getup_front",4.0,0,0,0,0,0);
	}
	//
	if(newkeys & KEY_JUMP && pTemp[playerid][pWork] == 555 && GetPVarInt(playerid,"perenos") > 0 ||
	newkeys & KEY_FIRE && pTemp[playerid][pWork] == 555 && GetPVarInt(playerid,"perenos") > 0)
	{
		RemovePlayerAttachedObject(playerid,0);
		new id = RandomEx(0,2);
		SetPlayerCheckpoint(playerid,gSadManCPs[id][0],gSadManCPs[id][1],gSadManCPs[id][2],3.0);
		SetPVarInt(playerid,"loadid",id);
		SendClientMessage(playerid,-1,"Вы уронили яблоки");
		SetPVarInt(playerid,"coalamount",0);
		SetPVarInt(playerid,"perenos",0);
		ApplyAnimation(playerid,"PED","getup_front",4.0,0,0,0,0,0);
	}
    if(newkeys & KEY_SPRINT && newkeys & KEY_JUMP)
	{
		if(!IsPlayerInAnyVehicle(playerid) && times[playerid] == true)
		{
			times[playerid] = false;
			SetTimerEx("AntiBH",500,false,"i",playerid);
			return 1;
		}
	}
	if (newkeys == 2)
	{
		if(pData[playerid][pHouse] == 529)
		{
		    if(IsPlayerInRangeOfPoint(playerid,10,660.0380249,-1227.0469971,17.6669998))
		    {
		    	MoveObject(GateOsobn[0],660.0380249,-1227.0469971,21.7,5);
		    	SetTimer("CloseGate1",5000,true);
		    }
		    if(IsPlayerInRangeOfPoint(playerid,10,665.3027344,-1309.4492188,14.9829998))
		    {
		    	MoveObject(GateOsobn[1],665.3027344,-1309.4492188,19.7329998,5);
		    	SetTimer("CloseGate2",5000,true);
		    }
		    if(IsPlayerInRangeOfPoint(playerid,10,785.4316406,-1153.4423828,25.0900002))
		    {
		    	MoveObject(GateOsobn[2],785.4320068,-1153.4420166,29.8400002,5);
		    	SetTimer("CloseGate3",5000,true);
		    }
		}
	}
	if(newkeys == KEY_CROUCH && pTemp[playerid][pOpenv] == 1)
	{
    	if(GetBarrierID(playerid) == -1) return 1;
		if(!pData[playerid][pFraction]) return SendClientMessage(playerid,CGRAY,"Вам недоступна данная функция");
		if(GetBarrierID(playerid) == 3 || GetBarrierID(playerid) == 4 || GetBarrierID(playerid) == 5 || GetBarrierID(playerid) == 6)
		{
			if(!IsACop(playerid)) return SendClientMessage(playerid,CGRAY,"Этот шлагбаум только для Полиции");
			OpenBarrier(GetBarrierID(playerid));
			SetTimerEx("CloseBarrierex", 15000, false, "d", GetBarrierID(playerid));
			PlayerPlaySound(playerid, 21001, 0.0, 0.0, 0.0);
	    }
   		if(IsPlayerInRangeOfPoint(playerid,20.0,-1791.008,812.925,24.591))
		{
			if(pData[playerid][pFraction] != 12) return SendClientMessage(playerid,CGRAY,"Этот шлагбаум только для ФБР");
			OpenBarrier(13);
			SetTimerEx("CloseBarrierex", 15000, false, "d", 13);
			PlayerPlaySound(playerid, 21001, 0.0, 0.0, 0.0);
	    }
	    if(GetBarrierID(playerid) == 14)
		{
			if(pData[playerid][pFraction] != 1) return SendClientMessage(playerid,CGRAY,"Этот шлагбаум только для Инструкторов");
			{
			    OpenBarrier(GetBarrierID(playerid));
				SetTimerEx("CloseBarrierex", 15000, false, "d", GetBarrierID(playerid));
				PlayerPlaySound(playerid, 21001, 0.0, 0.0, 0.0);
			}
		}
		if(GetBarrierID(playerid) == 0 || GetBarrierID(playerid) == 1 || GetBarrierID(playerid) == 2 || GetBarrierID(playerid) == 9 || GetBarrierID(playerid) == 8 || GetBarrierID(playerid) == 10 || GetBarrierID(playerid) == 11 || GetBarrierID(playerid) == 12 || GetBarrierID(playerid) == 15 || GetBarrierID(playerid) == 16 || GetBarrierID(playerid) == 17)
		{
			if(pData[playerid][pFraction] == 8 || pData[playerid][pFraction] == 12 || pData[playerid][pFraction] == 11)
			{
				OpenBarrier(GetBarrierID(playerid));
				SetTimerEx("CloseBarrierex", 15000, false, "d", GetBarrierID(playerid));
				PlayerPlaySound(playerid, 21001, 0.0, 0.0, 0.0);
			}
		}
	}
	if(newkeys == 16)
	{
			if(IsPlayerInRangeOfPoint(playerid, 3.0,240.0620038,118.3239978,1003.2289941))
			{
				if(pData[playerid][pFraction] == 9 || pData[playerid][pFraction] == 12)
				{
					MoveObject(PDDoor[0],239.6320038,115.2539978,1002.2189941,2.00);
					MoveObject(PDDoor[1],239.6360016,119.9039993,1002.2189941,2.00);
					SetTimer("PDopen1", 3000, false);
				}
			}
			//////////////////////////////////////////////////////////////////////////////////
   			if(IsPlayerInRangeOfPoint(playerid, 3.0,253.2409973,106.7669983,1002.2189941))
			{
				if(pData[playerid][pFraction] == 9 || pData[playerid][pFraction] == 12)
				{
					MoveObject(PDDoor[2], 253.2290039,111.4169998,1002.2189941,2.00);
					MoveObject(PDDoor[3], 253.2409973,106.7669983,1002.2189941,2.00);
					SetTimer("PDopen2", 3000, false);
				}
 			}
 			/////Дверь в допросную ФБР
   			if(IsPlayerInRangeOfPoint(playerid, 3.0,-1758.0344,826.4215,2644.2861))
			{
				if(pData[playerid][pFraction] == 9 || pData[playerid][pFraction] == 12)
				{
					MoveObject(PDDoor[4], -1758.5354, 824.2664, 2643.2339,2.00);
					SetTimer("PDopen3", 3000, false);
				}
 			}
	}
	if (newkeys == KEY_SPRINT)
	{
	    if(pTemp[playerid][pChoosingSkin] == true) //Выбор скина
		{
			new skinid = GetPVarInt(playerid,"skinid");
			new cat = 0;
			if(pData[playerid][pSex] == 2) cat = 1;
			DeletePVar(playerid,"skinid");
			new skin = gRegSkins[cat][pData[playerid][pColor]][skinid];
			pData[playerid][pSkin] = skin;
//			pTemp[playerid][pLogined] = 1;         //
			pTemp[playerid][pChoosingSkin] = false;
			TextDrawHideForPlayer(playerid,TD[tdNextSkin]);
			TextDrawHideForPlayer(playerid,TD[tdBackSkin]);
			TextDrawHideForPlayer(playerid,TD[tdSelSkin]);
			TogglePlayerControllable(playerid,1);
			UpdatePlayerData(playerid,"skin",skin);
      		SpawnPlayer(playerid);
		}
	}
	if(predlojbrak == 1)
	{
		if(newkeys == KEY_YES)
		{
		    new string[128];
	  		SendMes(playerid,-1,"Вы вступили в брак с %s", pData[WeddingTwo[playerid]][pNickname]);
	  		SendMes(WeddingTwo[playerid],-1,"Выше предожение вступить в брак принято. Ваша супруга: %s",pData[playerid][pNickname]);
			format(string, sizeof(string), "%s и %s вступили в брак", pData[WeddingTwo[playerid]][pNickname], pData[playerid][pNickname]);
			SendClientMessageToAll(0xcc33ffff, string);
			new sendername[32],giveplayer[32];
			new giveplayerid = WeddingTwo[playerid];
			GetPlayerName(playerid, sendername,MAX_PLAYER_NAME);
			GetPlayerName(giveplayerid, giveplayer,MAX_PLAYER_NAME);
			strmid(pData[playerid][pDivorce], giveplayer, 0, strlen(giveplayer), 32);
			strmid(pData[giveplayerid][pDivorce], sendername, 0, strlen(sendername), 32);
			new query[128];
		    format(query,sizeof(query),"UPDATE `aplayerakk` SET divorce = '%s',married = 1 WHERE id = '%d'",sendername,pData[giveplayerid][pMysqlID]);
		    sql_query(snow, query, QUERY_THREADED);
		    format(query,sizeof(query),"UPDATE `aplayerakk` SET divorce = '%s',married = 1 WHERE id = '%d'",giveplayer,pData[playerid][pMysqlID]);
		    sql_query(snow, query, QUERY_THREADED);
		    pData[giveplayerid][pMarried] = 1;
		    pData[playerid][pMarried] = 1;
		    predlojbrak = 0;
		}
		if(newkeys == KEY_NO)
		{
		    SendClientMessage(playerid,-1,"Вы отвергли предложение вступить в брак");
		    SendClientMessage(WeddingTwo[playerid],-1,"Вам отвергли предложение вступить в брак");
		    predlojbrak = 0;
		}
	}
	if(pTemp[playerid][pCuffee] == playerid)
	{
		if(!IsPlayerInAnyVehicle(playerid))
		{
			if((newkeys & KEY_JUMP || newkeys & KEY_FIRE || newkeys & KEY_CROUCH || (newkeys & KEY_HANDBRAKE && newkeys & KEY_SECONDARY_ATTACK)) && pTemp[playerid][pControllable])
			{
				ClearAnimations(playerid,1);
				//SetTimerEx("Unfreez",3000,false,"i",playerid);
				ApplyAnimation(playerid,"FAT","IDLE_tired",3.0,1,0,0,0,3000,1);
