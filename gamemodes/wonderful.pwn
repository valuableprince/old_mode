		ProxDetector(20.0, playerid, string,0xCCCC99FF,0xCCCC99FF,0xCCCC99FF,0xCCCC99FF,0xCCCC99FF);
		SetPlayerChatBubble(playerid, tmp, 0xCCCC99FF, 20.0, 7000);
