			switch(carclass)
			{
				case 0: strcat(classname,"economy");
				case 1: strcat(classname,"standart");
				case 2: strcat(classname,"sport");
				case 3: strcat(classname,"moto");
			}
			format(mes,sizeof(mes),"~g~%s~n~class: ~w~%s~n~~g~price: ~w~$%d~n~~g~tank: ~w~%dL~n~~g~cons.: ~w~%dL/100KM",gTransport[modelid][trName],classname,gTransport[modelid][trPrice],gTransport[modelid][trTank],gTransport[modelid][trConsumption]);
			PlayerTextDrawSetString(playerid,pTemp[playerid][pSellCarText],mes);
