stock UpdateDonate(playerid)
{
	new query[128];
	format(query,sizeof(query),"SELECT `donate`,`newdonate` FROM `aplayerakk` WHERE `id` = '%d'",pData[playerid][pMysqlID]);
	new Result:udon = sql_query(snow, query, QUERY_CACHED);
 	pData[playerid][pDonate] = sql_get_field_int(udon, 0);
	new newdonate = sql_get_field_int(udon, 1);
	if(newdonate) {
	    pData[playerid][pDonate] += newdonate;
		format(query, 128, "[ДОНАТ] Вам было зачислено %d рублей на ваш донат счет",newdonate);
		SendClientMessage(playerid, COLOR_LIGHTRED, query);
		format(query,sizeof(query),"UPDATE `aplayerakk` SET `newdonate` = '0',`donate` = '%d' WHERE id = '%d'",pData[playerid][pDonate], pData[playerid][pMysqlID]);
		sql_query(snow, query, QUERY_THREADED);
		new stringer[255];
		format(stringer, sizeof(stringer), "Донат счет игрока %s был пополнен на %d рублей",pData[playerid][pNickname],newdonate);
		SendLog(stringer);
	}
	sql_free_result(udon);
}

