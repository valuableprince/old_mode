			}
			SetPVarInt(playerid,"pbuycarC2",color);
			ShowPlayerDialog(playerid,dBuyCar,0,"Покупка авто","Вы действительно хотите купить этот автомобиль?","Да","Нет");
		}
		case dBuyCarC2Edit:
		{
			if(!response) return ShowPlayerDialog(playerid,dBuyCarC2,2,"Выберите цвет номер 2","1.Белый\n{505050}2.Черный\n{"#cLIGHTBLUE"}3.Голубой\n{"#cRED"}4.Красный\n{"#cY"}5.Желтый\n{0066FF}6. Синий\n{"#cGRAY"}7.Серый\n{"#cPINK"}8. РозоВый\n{f5f5dc}9.БежеВый\n{ff00ff}10.Пурпурный\n{"#cW"}Другой...","OK","Назад");
