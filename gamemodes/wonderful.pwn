	        new acter = pTemp[playerid][pGiveHipl];
			SendClientMessage(playerid,-1,"Вы отказались от предложения");
			SendClientMessage(pTemp[playerid][pGiveHipl],-1,"Игрок отказался от предложения");
			pTemp[playerid][pGiveHiact] = -1;
