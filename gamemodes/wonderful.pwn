		if(pTemp[playerid][pShowPtsact] == playerid)
	    {
	        new acter = pTemp[playerid][pShowPtspl];
			ShowPts(acter,playerid);
       		new mese[64];
			format(mese,sizeof(mese),"* достал(а) ПТС и показал(а) его %s",pData[playerid][pNickname]);
			MeAction(acter,mese);
			pTemp[playerid][pShowPtsact] = -1;
	    }
	    if(pTemp[playerid][pShowSkillact] == playerid)
	    {
	        new acter = pTemp[playerid][pShowSkillpl];
			new strkill[1006];
			new points[6];
			points[0] = 100 - pTemp[acter][pGunSkill][0];
			points[1] = 100 - pTemp[acter][pGunSkill][1];
			points[2] = 100 - pTemp[acter][pGunSkill][2];
			points[3] = 100 - pTemp[acter][pGunSkill][3];
			points[4] = 100 - pTemp[acter][pGunSkill][4];
			points[5] = 100 - pTemp[acter][pGunSkill][5];
			format(strkill,1000,"{"#cW"}SDPistol:\t[%s]%d\nDeagle:\t[%s]%d \nShotGun:\t[%s]%d\nMP5\t\t[%s]%d \nAK47:\t\t[%s]%d\nM4A1:\t\t[%s]%d",
			ToDevelopSkills(pTemp[acter][pGunSkill][0],points[0]),pTemp[acter][pGunSkill][0],
			ToDevelopSkills(pTemp[acter][pGunSkill][1],points[1]),pTemp[acter][pGunSkill][1],
			ToDevelopSkills(pTemp[acter][pGunSkill][2],points[2]),pTemp[acter][pGunSkill][2],
			ToDevelopSkills(pTemp[acter][pGunSkill][3],points[3]),pTemp[acter][pGunSkill][3],
			ToDevelopSkills(pTemp[acter][pGunSkill][4],points[4]),pTemp[acter][pGunSkill][4],
			ToDevelopSkills(pTemp[acter][pGunSkill][5],points[5]),pTemp[acter][pGunSkill][5]);
			ShowPlayerDialog(playerid,dMes,DIALOG_STYLE_MSGBOX,"{FFCD00}Навыки владения оружием",strkill,"Закрыть","");
       		new mese[64];
			format(mese,sizeof(mese),"показал выписку из тира %s'y",pData[playerid][pNickname]);
			MeAction(acter,mese);
			pTemp[playerid][pShowSkillact] = -1;
	    }
	    if(pTemp[playerid][pShowLicact] == playerid)
	    {
	        new acter = pTemp[playerid][pShowLicpl];
			new mes[450];
			strcat(mes,"{"#cW"}Водительские права: ");
			if(pData[acter][pLicenses][LIC_DRIVING]) strcat(mes,"{33AA33}Есть\n");
			else strcat(mes,"{"#cRED"}Нет\n");
			strcat(mes,"{"#cW"}Лицензия пилота: ");
			if(pData[acter][pLicenses][LIC_FLY]) strcat(mes,"{33AA33}Есть\n");
			else strcat(mes,"{"#cRED"}Нет\n");
			strcat(mes,"{"#cW"}Лицензия на водный транспорт: ");
			if(pData[acter][pLicenses][LIC_BOAT]) strcat(mes,"{33AA33}Есть\n");
			else strcat(mes,"{"#cRED"}Нет\n");
			strcat(mes,"{"#cW"}Лицензия на оружие: ");
			if(pData[acter][pLicenses][LIC_WEAP]) strcat(mes,"{33AA33}Есть\n");
			else strcat(mes,"{"#cRED"}Нет\n");
			ShowPlayerDialog(playerid,dMes,0,"Лицензии",mes,"OK","");
       		new mese[64];
			format(mese,sizeof(mese),"показал лицензии %s",pData[playerid][pNickname]);
			MeAction(acter,mese);
