				}
				else
				{
					new vznos = floatround(gFractionSalary[fractionid][rank-1]*0.01);
					new nalog = floatround((gFractionSalary[fractionid][rank-1])*0.13);
					new viplata = gFractionSalary[fractionid][rank-1]-nalog-vznos;
					SendClientMessage(i,CWHITE,"      [Расчетный лист]");
