				SendClientMessage(playerid,CGRAY,"Длина кода должна быть от 4 до 32 символов");
				ShowPlayerDialog(playerid,dCodeSet1,3,"Код безопасности","{"#cW"}Введите {FF0000}новый{FFFFFF} защитный код\n\n{ADADAD}Код может состоять только из цифр\nТребуется как минимум 4 символа, маскимальная длина кода 32 символа","ОК","Назад");
