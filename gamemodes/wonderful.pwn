		   	account = strtok(cmdtext, idx);
		   	if(!strlen(account)) return SendPods(playerid, "/unwarnoff (ник игрока)");
			format(query, sizeof(query), "SELECT `warnc` FROM `aplayerakk` WHERE `nickname` = '%s'", account);
			new Result:warns = sql_query(snow, query, QUERY_CACHED);
			if(!sql_num_rows(warns)) return SendClientMessage(playerid, COLOR_GREY, "Аккаунты не найдены");
			new warn = sql_get_field_int(warns, 0);
		   	if(warn == 0) return SendClientMessage(playerid,CGRAY,"У этого игрока нет варнов");
			if(GetPlayerID(account) != -1)
			{
			    format(str,sizeof(str),"/unwarn %d",GetPlayerID(account));
                OnPlayerCommandText(playerid,str);
	  			return 1;
			}
			if(warn == 1)
			{
   			format(query, sizeof(query), "UPDATE `aplayerakk` SET `warnc` = '0', `warn` = '0' WHERE nickname = '%s'", account);
      		sql_query(snow, query, QUERY_THREADED);
      		}
      		if(warn > 1)
      		{
   			format(query, sizeof(query), "UPDATE `aplayerakk` SET `warnc` = `warnc`-1, `warn` = `warn`-%d WHERE nickname = '%s'",WARN_TIME, account);
      		sql_query(snow, query, QUERY_THREADED);
      		}
		   	format(str,sizeof(str),"(A) Администратор %s снял оффлайн предупреждение игроку %s",pData[playerid][pNickname], account);
