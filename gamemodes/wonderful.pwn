			if(!response) return ShowPlayerDialog(playerid,dPlayerMenuSecurity,2,"{003beb}Безопасность","{d2ff4d}1. {"#cW"}Изменить пароль\n{d2ff4d}2. {"#cW"}Привязка по {4d79ff}IP {"#cW"}адресу","Далее","Отмена");
			if(strfind(inputtext,"|") != -1)
			{
				return SendClientMessage(playerid,CGRAY,"У вас в пароле присутствуют запрещенные символы");
			}
			if(!isNumeric(inputtext))
			{
				SendClientMessage(playerid,-1,"• {AC0000}[Ошибка] {ffffff}Код может состоять только цифр");
				ShowPlayerDialog(playerid,dCodeSet1,3,"Код безопасности","{"#cW"}Введите {FF0000}новый{FFFFFF} защитный код\n\n{ADADAD}Код может состоять только из цифр и букв\nТребуется как минимум 4 символа, маскимальная длина кода 32 символа","ОК","Назад");
				return 1;
			}
			sql_escape_string(snow, inputtext,inputtext, 24);
