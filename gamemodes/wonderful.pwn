   		new query[256];
		format(query,sizeof(query),"UPDATE `aplayerakk` SET `flvl` = '0', `fname` = '' WHERE `nickname` = '%s'",account);
		sql_query(snow, query, QUERY_THREADED);
		format(query,sizeof(query),"UPDATE `family_system` SET `members`=`members`-1 WHERE `name` = '%s'",pData[playerid][pFname]);
		sql_query(snow, query, QUERY_THREADED);
	}
	if(!strcmp(cmd,"/finfo",true))
	{
	    if(pData[playerid][pFlvl] < 1) return 1;
		new string2[500];
		new query[128];
