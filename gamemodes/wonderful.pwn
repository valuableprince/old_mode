	if(!strcmp(cmd,"/hhelp",true))
	{
		if(pData[playerid][pHelper] <= 0) return 1;
		SendClientMessage(playerid, COLOR_YELLOW, "Доступные команды:");
		SendClientMessage(playerid, 0xF0E68Cff, "/ans - ответить игроку на вопрос, /hc - чат хелперов");
	}
	if(strcmp(cmd, "/spawncars", true) == 0)
	{
		if(!IsPlayerConnected(playerid)) return 1;
	    new string[70+MAX_PLAYER_NAME];
		if(pData[playerid][pAdmin] < 6) return 1;
		format(string,sizeof(string), "(A) %s[%d] обновит весь незанятый транспорт через 15 секунд!",pData[playerid][pNickname],playerid);
		AdminChat(COLOR_GREY,string);
		SetTimerEx("SpcarsAvto",15000,false,"i",playerid);
	}
	if(!strcmp(cmd,"/hpcar",true))
	{
 		if(!IsPlayerConnected(playerid)) return 1;
    	if(pData[playerid][pAdmin] < 3) return 1;
    	if(!IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, COLOR_GREY, PlayerIsNotInCar);
    	RepairVehicle(GetPlayerVehicleID(playerid));
    	SendClientMessage(playerid, COLOR_WHITE, "Ваша машина отремонтирована");
    	return 1;
	}
	if(!strcmp(cmd,"/aclear",true))
	{
		if(pData[playerid][pAdmin] < 4) return 1;
		tmp = strtok(cmdtext, idx);
		new id = strval(tmp);
		if(!IsPlayerConnected(id)) return SendClientMessage(playerid,CGRAY,"Неверный ID");
		if(!pData[id][pWanted]) return SendClientMessage(playerid,CGRAY,"У игрока нет розыска");
		pData[id][pWanted] = 0;
		UpdatePlayerData(id,"wanted",0);
		SetPlayerWantedLevel(id,0);
		new mes[128];
		format(mes,sizeof(mes),"(A) %s снял розыск с игрока %s",pData[playerid][pNickname],pData[id][pNickname]);
		AdminChat(COLOR_GREY,mes);
		format(mes,sizeof(mes),"Администратор %s снял вам розыск",pData[playerid][pNickname]);
		SendClientMessage(id,CDEPARTMENT,mes);
	}
	if(strcmp(cmd, "/testattachobjexx", true) == 0)
  	{
		if(pData[playerid][pAdmin] < 8) return 1;
	  	tmp = strtok(cmdtext, idx);
   		new slot = strval(tmp);
   		tmp = strtok(cmdtext, idx);
   		new telo = strval(tmp);
   		tmp = strtok(cmdtext, idx);
	 	new obj = strval(tmp);
	 	if(slot == -1)
	    {
		    for(new i=0; i<MAX_PLAYER_ATTACHED_OBJECTS; i++)
	        {
	            if(IsPlayerAttachedObjectSlotUsed(playerid, i)) RemovePlayerAttachedObject(playerid, i);
	        }
			return 1;
  		}
	 	if(!slot) return SendClientMessage(playerid,CGRAY,"/testattachobjexx [Слот] [Часть тела (1-18)] [ID объекта]");
     	if(!obj) return SendClientMessage(playerid,CGRAY,"/testattachobjexx [Слот] [Часть тела (1-18)] [ID объекта]");
   		if(telo < 1 || telo > 18 || !telo) return SendClientMessage(playerid,CGRAY,"/testattachobjexx [Слот] [Часть тела (1-18)] [ID объекта]");
        new name[20];
		switch(telo)
   		{
			case 1: name = "спину";
			case 2: name = "голову";
			case 3: name = "плечо левой руки";
			case 4: name = "плечо правой руки";
			case 5: name = "левую руку";
			case 6: name = "правую руку";
			case 7: name = "левое бедро";
			case 8: name = "правое бедро";
			case 9: name = "левую ногу";
			case 10: name = "правую ногу";
			case 11: name = "правую коленку";
			case 12: name = "левую коленку";
			case 13: name = "левое предплечье";
			case 14: name = "правое предплечье";
			case 15: name = "левую ключицу";
			case 16: name = "лравую ключицу";
			case 17: name = "шею";
			case 18: name = "челюсть";
			default: name = "No-ne";

   		}
		new mes[150];
		format(mes,sizeof(mes),"Вы установили объект %d на %s (Слот: %d)",obj,name,slot);
		SendClientMessage(playerid,CGRAY,mes);
		SetPlayerAttachedObject(playerid,slot,obj,telo);
		EditAttachedObject(playerid,slot);
   		return 1;
   	}
   	if(!strcmp(cmd,"/mpfund",true))
	{
	    if(pData[playerid][pAdmin] < 8) return 1;
	    SFCM(playerid,-1,"{FFFFFF}Общий фонд мероприятий составляет: %d $", BankAdmin);
	}
	if(!strcmp(cmd,"/givefund",true))
	{
	    if(pData[playerid][pAdmin] < 8) return SendErr(playerid, "Вам недоступна данная функция");
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp) || !isNumeric(tmp)) return SendPods(playerid, "/givefund (ID - игрока) [сумма]");
		new actplayerid = strval(tmp);
        if(!IsPlayerConnected(actplayerid)) return SendErr(playerid, "Неверный ID игрока");
        if(pData[actplayerid][pAdmin] == 0) return SendErr(playerid, "Выбранный пользователь не администратор");
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp) || !isNumeric(tmp)) return SendPods(playerid, "/givefund (ID - игрока) [сумма]");
		new money = strval(tmp);
		if(money < 1 || money > 20000) return SendErr(playerid, "Можно передавать от 1 до 20000$");
		if(BankAdmin < money) return SendErr(playerid, "В фонде мероприятий недостаточно денег");
		new mes[300];
		format(mes,sizeof(mes),"(A) Администратор %s[%d] выделил из фонда МП средства администратору %s[%d] в размере: %d$",pData[playerid][pNickname],playerid,pData[actplayerid][pNickname],actplayerid,money);
		AdminChat(CGRAY,mes);
		format(mes,sizeof(mes),"%s {"#cINFO"}выделил Вам денежные средства из фонда МП в размере {"#cGREEN"}$%d",pData[playerid][pNickname],money);
		SendClientMessage(actplayerid,CWHITE,mes);
		BankAdmin -= money;
		pData[actplayerid][pMoney] += money;
		format(mes,sizeof(mes),"~w~Succ~g~WRP");
		GameTextForPlayer(playerid,mes,5000,1);
		format(mes,sizeof(mes),"~w~+%d~g~$",money);
		GameTextForPlayer(actplayerid,mes,5000,1);
		UpdatePlayerData(actplayerid,"money",pData[actplayerid][pMoney]);
		new stringer[255];
		format(stringer, sizeof(stringer), "Администратор %s выделил денежные средства %s в размере %d. (Остаток: %d)",pData[playerid][pNickname],pData[actplayerid][pNickname],money, BankAdmin);
		FundLog(stringer);
		SaveServerData();
	}
	if(!strcmp(cmd,"/putfund",true))
	{
	    if(strcmp(pData[playerid][pNickname], FD1, true)!=0) return 1;
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp) || !isNumeric(tmp)) return SendPods(playerid, "/putfund [сумма]");
		new money = strval(tmp);
		if(money < 1 || money > 20000) return SendErr(playerid, "Можно положить от 1 до 20000$");
		new mes[300];
