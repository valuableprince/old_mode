			case 8..11: { akat = "Руководство"; }
		}
		format(stringes,sizeof(stringes),"{FFFFFF}Пользователь: {32CD32}%s\n",pData[playerid][pNickname]);
		strcat(mes,stringes);
		format(stringes,sizeof(stringes),"{FFFFFF}Уровень администрирования: {32CD32}%d\n",pData[playerid][pAdmin]);
		strcat(mes,stringes);
