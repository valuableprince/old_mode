stock FindTheNearestAzs(playerid)
{
	AzsInfo[Position][0] = GetPlayerDistanceFromPoint(playerid, AzsPos[0][0], AzsPos[0][1], AzsPos[0][2]);
    for(new i; i < 18; i ++)
    {
        if(AzsInfo[Position][0] <= (AzsInfo[Position][1] = GetPlayerDistanceFromPoint(playerid, AzsPos[i][0], AzsPos[i][1], AzsPos[i][2]))) continue;
        AzsInfo[Position][0] = AzsInfo[Position][1];
        AzsInfo[AzsId] = i;
    }
    SetPlayerCheckpoint(playerid, AzsPos[AzsInfo[AzsId]][0], AzsPos[AzsInfo[AzsId]][1], AzsPos[AzsInfo[AzsId]][2],4.0);
    pTemp[playerid][pGPS] = true;
	SendClientMessage(playerid,CRED,"Метка {"#cWHITE"}установлена у Вас на радаре. Чтобы снять метку напишите {"#cINFO"}/gps");
    return 0;
}
stock FindTheNearestShop(playerid)
{
	ShopInfo[ShopPosition][0] = GetPlayerDistanceFromPoint(playerid, ShopPos[0][0], ShopPos[0][1], ShopPos[0][2]);
    for(new i; i < 18; i ++)
    {
        if(ShopInfo[ShopPosition][0] <= (ShopInfo[ShopPosition][1] = GetPlayerDistanceFromPoint(playerid, ShopPos[i][0], ShopPos[i][1], ShopPos[i][2]))) continue;
        ShopInfo[ShopPosition][0] = ShopInfo[ShopPosition][1];
        ShopInfo[ShopId] = i;
    }
    SetPlayerCheckpoint(playerid, ShopPos[ShopInfo[ShopId]][0], ShopPos[ShopInfo[ShopId]][1], ShopPos[ShopInfo[ShopId]][2],4.0);
    pTemp[playerid][pGPS] = true;
	SendClientMessage(playerid,CRED,"Метка {"#cWHITE"}установлена у Вас на радаре. Чтобы снять метку напишите {"#cINFO"}/gps");
    return 0;
}
forward Tuning(playerid);
public Tuning(playerid)
{
	vehicleidspeed[0] = GetPlayerVehicleID(playerid);
	new carID = GetCarSlot(pData[playerid][pCar]);
	new vehicleid = gCars[carID][carVid];
	if(GetPlayerVehicleID(playerid) == vehicleid)
    if(pData[playerid][pCar])
    {
        vehicleidspeed[1] = GetVehicleSpeed(vehicleidspeed[0]);
        if(vehicleidspeed[1] >= 50 && vehicleidspeed[1] <= 190)
        {
            /*switch(pData[playerid][pCar]) // создать переменную и тюнинг по своему желанию
            {
                case 0: newsvehicleidspeed = vehicleidspeed[0]+10;
                case 1: newsvehicleidspeed = vehicleidspeed[0]+20;
                case 2: newsvehicleidspeed = vehicleidspeed[0]+30;
                case 3: newsvehicleidspeed = vehicleidspeed[0]+40;
                case 4: newsvehicleidspeed = vehicleidspeed[0]+50;
                case 5: newsvehicleidspeed = vehicleidspeed[0]+60;
            }*/
          	if(pData[playerid][pFast1]) // Проверка домашнее ли это авто(пишем свою проверку)
    		{
	            newsvehicleidspeed = vehicleidspeed[1]+random(5)+5;
	            SetVehicleSpeed(vehicleidspeed[0],newsvehicleidspeed);
			}
			if(pData[playerid][pFast2]) // Проверка домашнее ли это авто(пишем свою проверку)
    		{
	            newsvehicleidspeed = vehicleidspeed[1]+random(20)+10;
	            SetVehicleSpeed(vehicleidspeed[0],newsvehicleidspeed);
			}
		}
    }
    return 1;

}
stock SetVehicleSpeed(vehicleid, Float:speed)
{
    new Float:cr[4];
    GetVehicleZAngle(vehicleid, cr[0]);
    GetVehicleVelocity(vehicleid, cr[1], cr[2], cr[3]);
    SetVehicleVelocity(vehicleid, floatsin(-cr[0],degrees)*(speed/99), floatcos(-cr[0],degrees)*(speed/99), cr[3]);
    return 1;
}

stock GetVehicleSpeed(vehicleid)
{
    new Float:x, Float:y, Float:z;
    GetVehicleVelocity(vehicleid, x, y, z);
    return floatround(floatsqroot(x*x+y*y+z*z)*100);
}
stock SendGos(color, str[])
{
	foreach(new i:Player)
	{
 		if(pData[i][pFraction] == 1 && pData[i][pRank] >= 7 ||
    	pData[i][pFraction] == 2 && pData[i][pRank] >= 9 ||
    	pData[i][pFraction] == 8 && pData[i][pRank] >= 11 ||
    	pData[i][pFraction] == 9 && pData[i][pRank] >= 19 ||
    	pData[i][pFraction] == 10 && pData[i][pRank] == 9 ||
    	pData[i][pFraction] == 11 && pData[i][pRank] == 9 ||
    	pData[i][pFraction] == 12 && pData[i][pRank] >= 16) SendClientMessage(i, color, str);

	}
	return 1;
}
stock SendFam(fact, color, str[])
{

	foreach(new i:Player)
	{

		if(pData[i][pFname] == fact) SendClientMessage(i, color, str);

	}
	return 1;
}
stock GetPlayerCameraLookAt(playerid, &Float:rX, &Float:rY, &Float:rZ, Float:dist = 10.0)
{
    new Float: locAt[6];
    GetPlayerCameraFrontVector(playerid, locAt[0], locAt[1], locAt[2]);
    GetPlayerCameraPos(playerid, locAt[3], locAt[4], locAt[5]);
    rX = locAt[0] * dist + locAt[3];
    rY = locAt[1] * dist + locAt[4];
    rZ = locAt[2] * dist + locAt[5];
}
publics: vsystem(playerid)
{
    new string[150],year,month,day;
    getdate(year, month, day);
    format(string, sizeof string, "%d-%s%d-%s%d", day, ((month < 10) ? ("0") : ("")), month, (year < 10) ? ("0") : (""), year);
    TextDrawSetString(Datum, string);

}
publics: vsysted(playerid)
{
    new string[150],hours,minutes,seconds;
    gettime(hours, minutes, seconds);
    format(string, sizeof string, "%s%d:%s%d:%s%d", (hours < 10) ? ("0") : (""), hours, (minutes < 10) ? ("0") : (""), minutes, (seconds < 10) ? ("0") : (""), seconds);
    TextDrawSetString(Vrijeme, string);
}
stock GetNumberOfPlayersOnThisIP(test_ip[])
{
	new against_ip[32+1];
	new x = 0;
	new ip_count = 0;
	for(x=0; x<MAX_PLAYERS; x++) {
	if(IsPlayerConnected(x)) {
	GetPlayerIp(x,against_ip,32);
	if(!strcmp(against_ip,test_ip)) ip_count++;
	}
	}
	return ip_count;
}
