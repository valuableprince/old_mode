						//if(IsPlayerInBandOnline(MafiaID) < 1) return SendMes(playerid,COLOR_GREY, "В вашей мафии мало игроков онлайн!");
						if(IsPlayerInBandOnline(MafiaNapad) < 1) return SendMes(playerid,COLOR_GREY, "У мафии \"%s\" мало игроков!",atext);
						ShowPlayerDialog(playerid,dBizWar,DIALOG_STYLE_MSGBOX,"{FFCD00}Атака бизнеса",str,"Да","Нет");
