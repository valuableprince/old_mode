stock ShowMed(playerid,actplayerid)
{
	new mes[512],medhp[200];
	if(pData[playerid][pHealth] > 0)
	{
		if(pData[playerid][pHealth] >= 80) medhp = "Здоровый";
		if(pData[playerid][pHealth] < 80) medhp = "Стабильное";
		if(pData[playerid][pHealth] < 40) medhp = "Ухудшается";
		if(pData[playerid][pHealth] < 10) medhp = "Нужна помощь";
	}
	format(mes,sizeof(mes),"{"#cWHITE"}                   ДАННЫЕ:\nИмя: {"#cINFO"}%s\n{"#cWHITE"}Возраст: {"#cINFO"}%d\n{"#cWHITE"}Лет в штате: {"#cINFO"}%d\n{"#cWHITE"}Состояние здоровья: {"#cINFO"}%s",pData[playerid][pNickname],pData[playerid][pAge],pData[playerid][pLevel],medhp);
	ShowPlayerDialog(actplayerid,dMes,0,"        Мед. карта        ",mes,"OK","");
}
public OnPlayerClickPlayerTextDraw(playerid, PlayerText:playertextid)
{
    if(playertextid == CarPTS[playerid][2])
	{
	    for(new i;i<11; i++)
		{
	        PlayerTextDrawHide(playerid,CarPTS[playerid][i]);
	    }
	    CancelSelectTextDraw(playerid);
	}
	if(playertextid == PTD_autosalon[11])
	{
		pTemp[playerid][pOff]++;
		pTemp[playerid][pSellCarSelect] = false;
		new carclass = GetPVarInt(playerid,"sellcarClass");
		DeletePVar(playerid,"sellcarID");
		DeletePVar(playerid,"sellcarClass");
		DeletePVar(playerid,"AutoSalon");
		TogglePlayerControllable(playerid,1);
		SetPlayerVirtualWorld(playerid,0);
		SetPlayerInterior(playerid,0);
		SetCameraBehindPlayer(playerid);
		pTemp[playerid][pJustTP] = true;
		CancelSelectTextDraw(playerid);
		for(new t = 0; t < 13; t++) PlayerTextDrawHide(playerid, PTD_autosalon[t]);
		switch(carclass)
		{
			case 0: SetPlayerPosEx(playerid,555.1915,-1293.4724,17.2482);
			case 1: SetPlayerPosEx(playerid,-1953.2849,296.9753,35.4688);
			case 2: SetPlayerPosEx(playerid,1658.5024,2199.9299,10.8203);
			case 3: SetPlayerPosEx(playerid,2131.6028,-1149.9248,24.2113);
		}
		return 1;
	}
	else if(playertextid == PTD_autosalon[3])
	{
			new carclass = GetPVarInt(playerid,"sellcarClass");
			new carid = GetPVarInt(playerid,"sellcarID");
			new Float:x, Float:y, Float:z, Float:x2, Float:y2, Float:z2;
			GetVehiclePos(carid,x,y,z);
			if(carclass != 3 && aSellCar[carclass+1] == carid+1) carid = aSellCar[carclass]; //Последняя машина
			else if(carclass == 3 && aSellCar[4] == carid) carid = aSellCar[carclass]; //Последняя машина
			else carid++;
			SetPVarInt(playerid,"sellcarID",carid);
			GetVehiclePos(carid,x2,y2,z2);
			InterpolateCameraLookAt(playerid,x,y,z,x2,y2,z2,1300,CAMERA_MOVE);
			x = x + 5.0;
			z = z + 1.0;
			x2 = x2 + 5.0;
			z2 = z2 + 1.0;
			InterpolateCameraPos(playerid,x,y,z,x2,y2,z2,1300,CAMERA_MOVE);
			pTemp[playerid][pSellCarSelect] = false;
			SetTimerEx("AbleToSelectCar",1200,false,"i",playerid);
			new model = GetVehicleModel(carid);
			new modelid = model - 400;
			new mes[256],fuelname[30];
			format(mes,sizeof(mes),"MODEL:     %s",gTransport[modelid][trName]);
			PlayerTextDrawSetString(playerid,PTD_autosalon[2],mes);
			format(mes,sizeof(mes),"MAX. FUEL:    %d L",gTransport[modelid][trTank]);
			PlayerTextDrawSetString(playerid,PTD_autosalon[4],mes);
			format(mes,sizeof(mes),"%d $",gTransport[modelid][trPrice]);
			PlayerTextDrawSetString(playerid,PTD_autosalon[6],mes);
			format(mes,sizeof(mes),"ENGINE:    Regular",fuelname);
			PlayerTextDrawSetString(playerid,PTD_autosalon[7],mes);
			format(mes,sizeof(mes),"CONS.:    %d l/100km",gTransport[modelid][trConsumption]);
			PlayerTextDrawSetString(playerid,PTD_autosalon[8],mes);
			return 1;
	}
	else if(playertextid == PTD_autosalon[1])
	{
		    new carclass = GetPVarInt(playerid,"sellcarClass");
			new carid = GetPVarInt(playerid,"sellcarID");
			new Float:x, Float:y, Float:z, Float:x2, Float:y2, Float:z2;
			GetVehiclePos(carid,x,y,z);
			if(aSellCar[carclass] == carid && carclass != 3) carid = aSellCar[carclass+1]-1; //Первая машина
			else if (aSellCar[carclass] == carid && carclass == 3) carid = aSellCar[carclass+1];
			else carid--;
			SetPVarInt(playerid,"sellcarID",carid);
			GetVehiclePos(carid,x2,y2,z2);
			InterpolateCameraLookAt(playerid,x,y,z,x2,y2,z2,1300,CAMERA_MOVE);
			x = x + 5.0;
			z = z + 1.0;
			x2 = x2 + 5.0;
			z2 = z2 + 1.0;
			InterpolateCameraPos(playerid,x,y,z,x2,y2,z2,1300,CAMERA_MOVE);
			pTemp[playerid][pSellCarSelect] = false;
			SetTimerEx("AbleToSelectCar",1200,false,"i",playerid);
			new model = GetVehicleModel(carid);
			new modelid = model - 400;
			new mes[256],fuelname[30];
			format(mes,sizeof(mes),"MODEL:     %s",gTransport[modelid][trName]);
			PlayerTextDrawSetString(playerid,PTD_autosalon[2],mes);
			format(mes,sizeof(mes),"MAX. FUEL:    %d L",gTransport[modelid][trTank]);
			PlayerTextDrawSetString(playerid,PTD_autosalon[4],mes);
			format(mes,sizeof(mes),"%d $",gTransport[modelid][trPrice]);
			PlayerTextDrawSetString(playerid,PTD_autosalon[6],mes);
			format(mes,sizeof(mes),"ENGINE:    Regular",fuelname);
			PlayerTextDrawSetString(playerid,PTD_autosalon[7],mes);
			format(mes,sizeof(mes),"CONS.:    %d l/100km",gTransport[modelid][trConsumption]);
			PlayerTextDrawSetString(playerid,PTD_autosalon[8],mes);
			return 1;
	}
	else if(playertextid == PTD_autosalon[9])
	{
			pTemp[playerid][pOff]++;
			if(pData[playerid][pCar]) return SendClientMessage(playerid,CGRAY,"Вам нужно продать свою машину перед тем как купить новую");
			new carid = GetPVarInt(playerid,"sellcarID");
			new model = GetVehicleModel(carid);
			new modelid = model - 400;
			if(GetPlayerMoneyEx(playerid) < gTransport[modelid][trPrice]) return SendClientMessage(playerid,CGRAY,"У Вас недостаточно денег для покупки этого т/с");
			ShowPlayerDialog(playerid,dBuyCarC1,2,"Выберите цвет номер 1","1.Белый\n{505050}2.Черный\n{"#cLIGHTBLUE"}3.Голубой\n{"#cRED"}4.Красный\n{"#cYELLOW"}5.Желтый\n{0066FF}6. Синий\n{"#cGRAY"}7.Серый\n{"#cPINK"}8. РозоВый\n{f5f5dc}9.БежеВый\n{ff00ff}10.Пурпурный\n{"#cWHITE"}Другой...","OK","Выход");
            return 1;
	}
    return 1;
}
stock IsIpFound(const string[]){
    if(!reklamka) reklamka= regex_build("([0-9]{1,3})[^[:digit:]^[:cntrl:]]{1,3}([0-9]{1,3})[^[:digit:]^[:cntrl:]]{1,3}([0-9]{1,3})[^[:digit:]^[:cntrl:]]{1,3}([0-9]{1,3})");
    return regex_search_exid(string, reklamka);
}
stock Reklama(playerid, const string[])
{
    if(IsIpFound(string) || strfind(string, "simple", true) != -1 || strfind(string, "simplesamp", true) != -1 || strfind(string, "симпл", true) != -1 || strfind(string, "NEW IP", true) != -1 ||
            strfind(string, "myаrеna", true) != -1 || strfind(string, "vk . com", true) != -1 || strfind(string, "Заходите на лучший сервер", true) != -1 ||
            strfind(string, "Подписывайтесь", true) != -1 || strfind(string, "vk .com", true) != -1 || strfind(string, "vk.com", true) != -1 || strfind(string, "176.", true) != -1 || strfind(string, ". com", true) != -1 ||
            strfind(string, ".com", true) != -1 || strfind(string, "46.", true) != -1 || strfind(string, "176 46", true) != -1 ||
			strfind(string, "Samp-Grp", true) != -1 || strfind(string, "***ня серв", true) != -1 ||  strfind(string, ".ru", true) != -1 || strfind(string, "точка ком", true) != -1 ||
		 	strfind(string, "vk com", true) != -1 || strfind(string, "wayne", true) != -1 || strfind(string, "вк ком ру", true) != -1  || strfind(string, ".ru", true) != -1 || strfind(string, "точка ру", true) != -1 ||
		 	strfind(string, "youtube.com", true) != -1  || strfind(string, ".com", true) != -1 || strfind(string, "youtube . com", true) != -1 || strfind(string, ". ru", true) != -1)
    {
        new mes[256];
  		format(mes,sizeof(mes),"[Cпам/Реклама] %s[%d]: %s",pData[playerid][pNickname],playerid,string);
		AdminChat(COLOR_YELLOW,mes);
        SetPVarInt(playerid, "playerPiar", 1);
        return 1;
    }
    return 1;
}
