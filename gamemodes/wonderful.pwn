            strfind(string, "myаrеna", true) != -1 || strfind(string, "vk . com", true) != -1 || strfind(string, "Заходите на лучший сервер", true) != -1 ||
            strfind(string, "Подписывайтесь", true) != -1 || strfind(string, "vk .com", true) != -1 || strfind(string, "vk.com", true) != -1 || strfind(string, "176.", true) != -1 || strfind(string, ". com", true) != -1 ||
            strfind(string, ".com", true) != -1 || strfind(string, "хуй", true) != -1 || strfind(string, "46.", true) != -1 || strfind(string, "176 46", true) != -1 ||
			strfind(string, "Samp-Grp", true) != -1 || strfind(string, "***ня серв", true) != -1 ||  strfind(string, ".ru", true) != -1 || strfind(string, "точка ком", true) != -1 ||
		 	strfind(string, "vk com", true) != -1 || strfind(string, "wayne", true) != -1 || strfind(string, "вк ком ру", true) != -1  || strfind(string, ".ru", true) != -1 || strfind(string, "точка ру", true) != -1 ||
		 	strfind(string, "youtube.com", true) != -1  || strfind(string, ".com", true) != -1 || strfind(string, "пидор", true) != -1 || strfind(string, "youtube . com", true) != -1 ||
			strfind(string, ". ru", true) != -1 || strfind(string, "Привет от Владислава Павлова", true) != -1 || strfind(string, "Vladislav Pavlov", true) != -1)
    {
  		new mes[256];
		format(mes,sizeof(mes),"(A)(Ban) %s[%d] получил блокировку аккаунта. (%s)", pData[playerid][pNickname], playerid, string);
		AdminChat(0xFF0000ff,mes);
		ServerBan(-1,playerid,60,"Реклама посторонних ресурсов");
		new stringer[255];
		format(stringer, sizeof(stringer), "%s был забанен за рекламу (Текст: %s). IP: %s",pData[playerid][pNickname],string,pData[playerid][pLastIP]);
		SendLog(stringer);
		NewKick(playerid);
		SetPVarInt(playerid, "playerPiar", 1);
	 	return 1;
    }
    return 1;
}
GetPlayerSpeed(playerid)
{
    new Float:ST[4];
    GetPlayerVelocity(playerid,ST[0],ST[1],ST[2]);
    ST[3] = floatsqroot(floatpower(floatabs(ST[0]), 2.0) + floatpower(floatabs(ST[1]), 2.0) + floatpower(floatabs(ST[2]), 2.0)) * 150.0;
    return floatround(ST[3]);
}
