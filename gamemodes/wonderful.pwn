		{
			new mes[128];
			format(mes,sizeof(mes),"{"#cWHITE"}Эта автозаправочная станция продается.\n{"#cORANGE"}Номер заправки: {"#cWHITE"}%d\n{"#cORANGE"}Цена: {"#cWHITE"}%d",gFillings[fillingid][fillMysqlID],gFillings[fillingid][fillPrice]);
			ShowPlayerDialog(playerid,dFillingBuy,0,"Автозаправочная станция",mes,"Купить","Отмена");
		}
		else SendClientMessage(playerid, -1, "• {AC0000}[Ошибка] {ffffff}Данная Автозаправочная станция уже приобретена кем-то");
		return 1;
	}
	if(!strcmp(cmd,"/sellfilling",true))
	{
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp) || !isNumeric(tmp)) return SendPods(playerid, "/sellfilling (ID игрока) [цена]");
		if(pData[playerid][pBusiness] < FILLING_ID_OFFSET) return SendClientMessage(playerid,-1,"• {AC0000}[Ошибка] {ffffff}У Вас нет АЗС");
		if(pTemp[playerid][pTaxiID] != INVALID_VEHICLE_ID || pTemp[playerid][pTaxiPass] != INVALID_PLAYER_ID) return SendClientMessage(playerid,-1,"• {AC0000}[Ошибка] {ffffff}Нельзя использовать данную Команду сейчас");
		new actplayerid = strval(tmp);
		if(!IsPlayerConnected(actplayerid)) return SendClientMessage(playerid,-1,"• {AC0000}[Ошибка] {ffffff}Неверный ID игрока");
		if(GetPlayerDistanceToPlayer(playerid,actplayerid) > 3.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(actplayerid)) return SendClientMessage(playerid,-1,"• {AC0000}[Ошибка] {ffffff}Вы далеко друг от друга");
		if(pData[actplayerid][pBusiness]) return SendClientMessage(playerid,-1,"• {AC0000}[Ошибка] {ffffff}У игрока уже есть бизнес");
		tmp = strtok(cmdtext, idx);
		new price = strval(tmp);
		if(price < gBusiness[pData[playerid][pBusiness]-1][busiSellPrice] || price > 20000000) return SendClientMessage(playerid,-1,"• {AC0000}[Ошибка] {ffffff}Цена не может быть меньше гос. цены АЗС и больше 20 млн.");
		new mes[128];
		format(mes,sizeof(mes),"Вы предложили {"#cW"}%s {"#cINFO"} купить вашу АЗС",pData[actplayerid][pNickname]);
		SendClientMessage(playerid,CINFO,mes);
		format(mes,sizeof(mes),"%s {"#cINFO"}предложил Вам купить его АЗС за {"#cRED"}$%d{"#cINFO"}. Чтобы подтвердить нажмите {FFFFFF}Y{"#cINFO"}, иначе {"#cRED"}N",pData[playerid][pNickname],price);
		SendClientMessage(actplayerid,CWHITE,mes);
		pTemp[playerid][pSellFillingOffer] = playerid;
		pTemp[actplayerid][pSellFillingOffer] = playerid;
		pTemp[actplayerid][pSellFillingOffee] = actplayerid;
		pTemp[actplayerid][pSellFillingPrice] = price;
	}
	if(!strcmp(cmd,"/fill",true))
	{
		if(pTemp[playerid][pFilling]) return 1;
		new fillingid = -1;
		if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendClientMessage(playerid,-1,"• {AC0000}[Ошибка] {ffffff}Вы должны быть в т/с");
		//if(gFillings[fillingid][fillWorking] == 1) return SendClientMessage(playerid,-1,"• {AC0000}[Ошибка] {ffffff}Заправка не работает!");
		new vehicleid = GetPlayerVehicleID(playerid);
		if(GetEngineStat(vehicleid) == 1) return SendClientMessage(playerid,-1,"• {AC0000}[Ошибка] {ffffff}Заправляться можно только с заглушенными двигателем");
		new modelid = GetVehicleModel(vehicleid) - 400;
		if(!gTransport[modelid][trFuelable]) return SendClientMessage(playerid,-1,"• {AC0000}[Ошибка] {ffffff}Ваше т/с не имеет бензобака");
		for(new i;i<FILLING_COUNT;i++)
		{
			if(!IsPlayerInDynamicArea(playerid,gAreas[arFill][i])) continue;
			else fillingid = i;
		}
		if(fillingid == -1) return SendClientMessage(playerid,-1,"• {AC0000}[Ошибка] {ffffff}Вы должны быть на АЗС");
		pTemp[playerid][pFillingID] = fillingid+1;
		pTemp[playerid][pFilling] = true;
  		ShowFillingBar(playerid,vehicleid);
  		SendClientMessage(playerid,CGRAY,"Выбрать нужное количество бензина: A,D. Заправиться: пробел/левый шифт.");
		TogglePlayerControllable(playerid,0);
	}
	if(!strcmp(cmd,"/gun",true))
	{
		if(pData[playerid][pAdmin] < 7) return 1;
		tmp = strtok(cmdtext, idx);
		new gun = strval(tmp);
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp) || !isNumeric(tmp)) return SendClientMessage(playerid, COLOR_WHITE, "[{FFA500}Admin-Helper{FFFFFF}] /gun [ID оружия] [Патроны]");
		new ammo = strval(tmp);
		new string[128];
		new weapname[50];
		if(gun > 46 || gun < 1 || !gun) return SendClientMessage(playerid, COLOR_WHITE, "[{FFA500}Admin-Helper{FFFFFF}] /gun [ID оружия] [Патроны]");
		if(gun == 4 || gun == 9 || gun == 16 || gun == 18 || gun == 26 || gun == 27 || gun == 28 || gun == 32 || gun == 35 || gun == 36 || gun == 37 || gun == 38 || gun == 39 || gun == 44) return SendClientMessage(playerid, COLOR_GRAD1, "Запрещенное оружие");
		if(ammo > 9999 || ammo < 1 || !ammo) return SendClientMessage(playerid, COLOR_WHITE, "[{FFA500}Admin-Helper{FFFFFF}] /gun [ID оружия] [Патроны]");
		GetWeaponName(gun, weapname, sizeof weapname);
		format(string, sizeof(string), "Вы выдали себе %s с %d патронами",weapname, ammo);
		SendClientMessage(playerid, COLOR_GRAD1, string);
		GivePlayerWeaponEx(playerid,gun,ammo);
	}
 	if(strcmp(cmd, "/agivegun", true) == 0)
  	{
		if(pData[playerid][pAdmin] < 6) return 1;
   		tmp = strtok(cmdtext, idx);
