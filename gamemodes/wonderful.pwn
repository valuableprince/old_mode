stock DropYas(playerid) // сброс ящика
{
	TOTALY ++;
	new Float:f[4],string[50];
	GetPlayerPos(playerid,f[0],f[1],f[2]);
	DYaz[TOTALY][g_y][0] = f[0];
	DYaz[TOTALY][g_y][1] = f[1];
	DYaz[TOTALY][g_y][2] = f[2] - 0.95;
	if(PUTEDA1[playerid][putinter][0] == 1)
	{
		DYaz[TOTALY][g_yid] = CreateDynamicObject(2218, f[0], f[1], f[2]-0.95, -23.3600, 22.6000, 90.0);
		DYaz[TOTALY][g_ypod] = 1;
	}
	else if(PUTEDA1[playerid][putinter][1] == 1)
	{
		DYaz[TOTALY][g_yid] = CreateDynamicObject(2212, f[0], f[1], f[2]-0.95, -23.3600, 22.6000, 90.0);
		DYaz[TOTALY][g_ypod] = 2;
	}
	else if(PUTEDA1[playerid][putinter][2] == 1)
	{
		DYaz[TOTALY][g_yid] = CreateDynamicObject(2215, f[0], f[1], f[2]-0.95, -23.3600, 22.6000, 90.0);
		DYaz[TOTALY][g_ypod] = 3;
	}
	poxavat[playerid] = 0;
	format(string, 50, "       Поднять\n       {FFFF00}/pick");
	DYaz[TOTALY][g_text] = Create3DTextLabel(string, COLOR_LIME, f[0], f[1], f[2]-0.95, 20.0,0,0);
	return 1;
}

