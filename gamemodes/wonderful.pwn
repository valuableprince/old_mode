			if(pData[playerid][pAdmin] < 8) return 1;
			if(!strlen(tmp) && pData[playerid][pAdmin] == 8)return SendClientMessage(playerid, COLOR_GRAD2, "/setadmin (ID - игрока) (0-7)");
			if(!strlen(tmp) && pData[playerid][pAdmin] == 9)return SendClientMessage(playerid, COLOR_GRAD2, "/setadmin (ID - игрока) (0-8)");
			if(!strlen(tmp) && pData[playerid][pAdmin] == 10)return SendClientMessage(playerid, COLOR_GRAD2, "/setadmin (ID - игрока) (0-9)");
			if(!strlen(tmp) && pData[playerid][pAdmin] == 11)return SendClientMessage(playerid, COLOR_GRAD2, "/setadmin (ID - игрока) (0-10)");
			new id;
