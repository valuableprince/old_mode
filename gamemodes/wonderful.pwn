        if(fractionid+1 == 11 && !pData[playerid][pSubfraction] && rank <= 9)
        format(mesid,sizeof(mesid),"[F] %s %s[%d]: %s",gPrezRankName[rank-1],pData[playerid][pNickname],playerid,tmp);
		SendFMes(fractionid+1,CBLUE, mesid);
