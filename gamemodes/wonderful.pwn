       format(want_text,sizeof(want_text), "{FFFFFF}\t%d\t%i\t\t%d\t%s {ffa800}[AFK: %s]{FFFFFF}\n", pData[i][pLevel], pData[i][pPhone], pData[i][pFlvl], pData[i][pNickname], Converts(pTemp[i][pAFK]));
