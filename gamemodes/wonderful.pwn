stock GetCarSlot(carID)
{
	for(new islot; islot < MAX_VEHICLES; islot++)
	{
		if(carID == gCars[islot][carMysqlID])
		{
			return islot;
		}
	}
	return -1;
}

stock GetCarClassName(classid,classname[],size=sizeof(classname))
{
	switch(classid)
	{
		case 0: format(classname,size,"Эконом");
		case 1: format(classname,size,"Средний");
		case 2: format(classname,size,"Спорт");
		case 3: format(classname,size,"Мото");
		case 4: format(classname,size,"Воздушный");
	}
}
forward Float:GetDistanceBetweenPlayers(p1,p2);
stock Float:GetDistanceBetweenPlayers(p1,p2){
	new Float:x1,Float:y1,Float:z1,Float:x2,Float:y2,Float:z2;
	if(!IsPlayerConnected(p1) || !IsPlayerConnected(p2)){return -1.00;}
	GetPlayerPos(p1,x1,y1,z1);
	GetPlayerPos(p2,x2,y2,z2);
	return floatsqroot(floatpower(floatabs(floatsub(x2,x1)),2)+floatpower(floatabs(floatsub(y2,y1)),2)+floatpower(floatabs(floatsub(z2,z1)),2));}
stock GetPlayerMoneyEx(playerid)
{
	//if(GetPlayerMoney(playerid) < pData[playerid][pMoney]) pData[playerid][pMoney] = GetPlayerMoney(playerid);
	return pData[playerid][pMoney];
}

stock GivePlayerMoneyEx(playerid,money,reason[])
{
	if(GetPlayerMoney(playerid) < 0) ResetPlayerMoney(playerid);
	pData[playerid][pMoney] = pData[playerid][pMoney] + money;
	ResetPlayerMoney(playerid);
	GivePlayerMoney(playerid,pData[playerid][pMoney]);
	UpdatePlayerData(playerid,"money",pData[playerid][pMoney]);
	return 1;
}
stock ShowUdost(playerid, actplayerid)
{
	new str[220];
	new fraction = pData[playerid][pFraction]-1;
	new rang = pData[playerid][pRank]-1;
	format(str,sizeof(str),"*** Удостоверение №%d ***",pData[playerid][pMysqlID]);
	SendClientMessage(actplayerid,CORANGE,str);
	format(str,sizeof(str),"Имя: %s",pData[playerid][pNickname]);
	SendClientMessage(actplayerid,CORANGE,str);
	format(str,sizeof(str),"Место службы: %s",gFractionName[fraction]);
	SendClientMessage(actplayerid,CORANGE,str);
	format(str,sizeof(str),"Звание: %s",gFractionRankName[fraction][rang]);
	SendClientMessage(actplayerid,CORANGE,str);
	SendClientMessage(actplayerid,CORANGE,"*************************");
	pTemp[playerid][pShowUdact] = -1;
}
stock ShowPts(playerid, actplayerid)
{
	new carID = pData[playerid][pCar],query[250],nomer[15];
	new modelid = gCars[GetCarSlot(carID)][carModelid];
	format(query,sizeof(query),"SELECT `carnumber` FROM `cars` WHERE `id` = '%d'",pData[playerid][pCar]);
	new Result:r = sql_query(snow, query, QUERY_CACHED);
	sql_get_field(r, 0, nomer);
    new classname[32];
	switch(gTransport[modelid][trClass])
	{
		case 0: strcat(classname,"economy");
		case 1: strcat(classname,"standart");
		case 2: strcat(classname,"sport");
		case 3: strcat(classname,"moto");
	}
	PlayerTextDrawSetPreviewModel(actplayerid, CarPTS[playerid][3], gTransport[modelid][trModel]);//мд машины
	PlayerTextDrawSetPreviewVehCol(actplayerid, CarPTS[playerid][3], gCars[GetCarSlot(carID)][carColor1],gCars[GetCarSlot(carID)][carColor2]);//Цвета машины
	format(strg,50,"Name: ~w~%s",pData[playerid][pNickname]);//Ник
	PlayerTextDrawSetString(actplayerid,CarPTS[playerid][4],strg);//Ник
	format(strg,50,"date: ~w~00-00-0000");//Дата
	PlayerTextDrawSetString(actplayerid,CarPTS[playerid][5],strg);//Дата
	format(strg,50,"model: ~w~%s",gTransport[modelid][trName]);//Название кара
	PlayerTextDrawSetString(actplayerid,CarPTS[playerid][6],strg);//Название кара
	format(strg,50,"class: ~w~%s",classname);//Класс
	PlayerTextDrawSetString(actplayerid,CarPTS[playerid][7],strg);//Класс
	format(strg,50,"reg: ~w~%s",nomer);//Номера
	PlayerTextDrawSetString(actplayerid,CarPTS[playerid][8],strg);//Номера
	for(new i;i<11; i++)
	{
        PlayerTextDrawShow(actplayerid,CarPTS[playerid][i]);
    }
    SelectTextDraw(actplayerid, 0xFF0000FF);
	return 1;
}
stock ShowPass(playerid,actplayerid)
{
	new mes[512],army[30],jobname[30],jobstat[30],classname[15],nation[68];
	new houseid = pData[playerid][pHouse]-1;
	if(pData[playerid][pJob])
	{
		switch(pData[playerid][pJob])
		{
		    case 0:
		    {
		        strcat(jobname,"—");
		        jobstat = "—";
		    }
			case 1:
			{
				strcat(jobname,"Водитель автобуса");
				if(pData[playerid][pBusSkill] >= BUS_LEVEL_3) jobstat = "Опытный работник";
				else if(pData[playerid][pBusSkill] >= BUS_LEVEL_2) jobstat = "Стабильный работник";
				else jobstat = "Начинающий работник";
			}
			case 2:
			{
				strcat(jobname,"Дальнобойщик");
				if(pData[playerid][pTruckSkill] >= TRUCK_LEVEL_3) jobstat = "Опытный работник";
				else if(pData[playerid][pTruckSkill] >= TRUCK_LEVEL_2) jobstat = "Стабильный работник";
				else jobstat = "Начинающий работник";
			}
			case 3:
			{
				strcat(jobname,"Водитель такси");
				jobstat = "Водитель";
			}
		}
	}
	else if(pData[playerid][pFraction])
	{
		new fractionid = pData[playerid][pFraction];
		new rank = pData[playerid][pRank];
		strcat(jobname,gFractionName[fractionid-1]);
        if(fractionid+1 == 11 && !pData[playerid][pSubfraction] && rank <= 9)
            strcat(jobstat, gPrezRankName[rank-1]);
		else strcat(jobstat,gFractionRankName[fractionid-1][rank-1]);
	}
	new housenumber[15];
	if(houseid >= 0)
	{
		format(housenumber,15,"%d",pData[playerid][pHouse]);
		switch(gHouses[houseid][houseClass])
		{
			case 0:classname = "Эконом";
			case 1:classname = "Cредний";
			case 2:classname = "Элитный";
			case 3:classname = "Особняк";
			default:classname = "Неизвестно";
		}
	}
	else
	{
		housenumber = "Отсутствует";
		classname = "Отсутствует";
	}
	switch(pData[playerid][pNation])
	{
		case 1: strcat(nation,"Американец");
		case 2: strcat(nation,"Японец");
		case 3: strcat(nation,"Итальянец");
		case 4: strcat(nation,"Мексиканец");
		case 5: strcat(nation,"Латиноамериканец");
		case 6: strcat(nation,"Испанец");
		case 7: strcat(nation,"Русский");
		case 8: strcat(nation,"Португалец");
		case 9: strcat(nation,"Француз");
		case 10: strcat(nation,"Афроамериканец");
	}
	if(pData[playerid][pArmyRank] > 0) format(army,24,"{"#cINFO"}%s",gFractionRankName[7][pData[playerid][pArmyRank]-1]);
	else format(army,24," —");
	format(mes,sizeof(mes),"{"#cW"}                   ДАННЫЕ:\nИмя: {"#cINFO"}%s\n{"#cW"}Возраст: {"#cINFO"}%d\n{"#cW"}Лет в штате: {"#cINFO"}%d\n{"#cW"}Законопослушность: {"#cINFO"}%d\n{"#cW"}Уровень розыска: {"#cINFO"}%d\n{"#cW"}Национальность: {"#cINFO"}%s\n{"#cW"}Воинский учет: %s",pData[playerid][pNickname],pData[playerid][pAge],pData[playerid][pLevel],pData[playerid][pZakon],pData[playerid][pWanted],nation,army);
	format(mes,sizeof(mes),"%s\n\n{"#cW"}                  ПРОПИСКА\nНомер дома: {"#cBLUE"}%s\n{"#cW"}Класс дома: {"#cBLUE"}%s",mes,housenumber,classname);
	format(mes,sizeof(mes),"%s\n\n{"#cW"}        ТРУДОВОЕ УСТРОЙСТВО:\nМесто работы: {"#cBLUE"}%s\n{"#cW"}Должность: {"#cBLUE"}%s",mes,jobname,jobstat);

	ShowPlayerDialog(actplayerid,dMes,0,"Паспорт",mes,"OK","");
}

stock MeActionMUT(playerid,action[],Float:distance = 13.0)
{
	if(pData[playerid][pMut]) return SendPods(playerid, "У вас бан чата. Используйте /mutetime чтобы узнать время бана.");
	new mes[128];
	format(mes,sizeof(mes),"%s %s",pData[playerid][pNickname],action);
	for(new i;i<MAX_PLAYERS;i++)
	{
		if(!IsPlayerConnected(i) || GetPlayerDistanceToPlayer(playerid,i) > distance || GetPlayerVirtualWorld(i) != GetPlayerVirtualWorld(playerid)) continue;
		SendClientMessage(i,CPINK,mes);
	}
	return 1;
}

stock SendCasino(playerid,action[],Float:distance = 13.0)
{
	new mes[128];
	format(mes,sizeof(mes),"%s",action);
	for(new i;i<MAX_PLAYERS;i++)
	{
		if(!IsPlayerConnected(i) || GetPlayerDistanceToPlayer(playerid,i) > distance || GetPlayerVirtualWorld(i) != GetPlayerVirtualWorld(playerid)) continue;
		SendClientMessage(i,0xF5B800FF,mes);
	}
	return 1;
}

stock MeAction(playerid,action[],Float:distance = 13.0)
{
	new mes[128];
	format(mes,sizeof(mes),"%s %s",pData[playerid][pNickname],action);
	for(new i;i<MAX_PLAYERS;i++)
	{
		if(!IsPlayerConnected(i) || GetPlayerDistanceToPlayer(playerid,i) > distance || GetPlayerVirtualWorld(i) != GetPlayerVirtualWorld(playerid)) continue;
		SendClientMessage(i,CPINK,mes);
	}
	return 1;
}

stock DoAction(playerid,action[],Float:distance = 13.0)
{
	if(pData[playerid][pMut]) return SendPods(playerid, "У вас бан чата. Используйте /mutetime чтобы узнать время бана.");
	new mes[128];
	format(mes,sizeof(mes),"%s (%s)",action,pData[playerid][pNickname]);
	for(new i;i<MAX_PLAYERS;i++)
	{
		if(!IsPlayerConnected(i) ||  GetPlayerDistanceToPlayer(playerid,i) > distance || GetPlayerVirtualWorld(i) != GetPlayerVirtualWorld(playerid)) continue;
		SendClientMessage(i,CPINK,mes);
	}
	return 1;
}


stock TryAction(playerid,action[],Float:distance = 13.0)
{
	if(pData[playerid][pMut]) return SendPods(playerid, "У вас бан чата. Используйте /mutetime чтобы узнать время бана.");
	new luck[24];
	if(RandomEx(0,2) == 1) strcat(luck,"{"#cGR"}Удачно");
	else strcat(luck,"{"#cRE"}Неудачно");
	new mes[190];
	format(mes,sizeof(mes),"%s %s | %s",pData[playerid][pNickname],action,luck);
	for(new i;i<MAX_PLAYERS;i++)
	{
		if(!IsPlayerConnected(i) || GetPlayerDistanceToPlayer(playerid,i) > distance || GetPlayerVirtualWorld(i) != GetPlayerVirtualWorld(playerid)) continue;
		SendClientMessage(i,CPINK,mes);
	}
	return 1;
}

stock Speech(playerid,text[],language,Float:distance = 13.0,anim = 1,color = 1)
{
	new string[64];
	if(!pTemp[playerid][pLogined] || !pData[playerid][pMysqlID]) return 1;
	if(pData[playerid][pMut]) return SendPods(playerid, "У вас бан чата. Используйте /mutetime чтобы узнать время бана.");
	if(GetString(text,")"))
	{
	    format(string,sizeof(string),"улыбается",pData[playerid][pNickname]);
		MeAction(playerid,string);
		return 0;
	}
	if(GetString(text,"))"))
	{
	    format(string,sizeof(string),"смеётся",pData[playerid][pNickname]);
		MeAction(playerid,string);
		return 0;
	}
	if(GetString(text,"("))
	{
	    format(string,sizeof(string),"расстроился",pData[playerid][pNickname]);
		MeAction(playerid,string);
		return 0;
	}
	if(GetString(text,"(("))
	{
	    format(string,sizeof(string),"сильно расстроился",pData[playerid][pNickname]);
		MeAction(playerid,string);
		return 0;
	}
	if(pTemp[playerid][pControllable] && anim)
	{
	    if(GetPVarInt(playerid,"Animation") == 0)
		{
	    	ApplyAnimation(playerid,"PED","IDLE_CHAT",8.1,0,1,1,1,1);
			SetTimerEx("ClearAnimText", 1400, false, "d", playerid);
		/*ApplyAnimation(playerid,"ped","IDLE_chat",4.1,1,1,1,1,1,1);
		SetTimerEx("ClearAnimationsDelay",strlen(text)*200,false,"i",playerid);
		*/
		}
	}
	new mes[250],mes2[64],langname[32];
	new mesid[250];
	if(language != LANG_ENGLISH)
	{
		switch(language)
		{
			case LANG_JAPAN: strcat(langname,"Японский");
			case LANG_ITALIAN: strcat(langname,"Итальянский");
			case LANG_PORTUGAL: strcat(langname,"Португальский");
			case LANG_FRENCH: strcat(langname,"Французский");
			case LANG_SPAIN: strcat(langname,"Испанский");
			case LANG_RUSSIAN: strcat(langname,"Русский");
		}
		format(mes,sizeof(mes),"%s [%s]: %s",pData[playerid][pNickname],langname,text);
		format(mesid,sizeof(mesid),"%s [%d] [%s]: %s",pData[playerid][pNickname],playerid,langname,text);
	}
	else
	{
	    if(pData[playerid][pFraction] > 0)
	    {
			if(GetPVarInt(playerid,"maskedf") > 0)
			{
			    switch(GetPVarInt(playerid,"maskedf"))
			    {
			        case 1:
			        {
						format(mes,sizeof(mes),"- %s {009900}(%s)",text,pData[playerid][pNickname]);
						format(mesid,sizeof(mesid),"- %s {009900}(%s)[%d]",text,pData[playerid][pNickname],playerid);
					}
			        case 2:
			        {
						format(mes,sizeof(mes),"- %s {CC00FF}(%s)",text,pData[playerid][pNickname]);
						format(mesid,sizeof(mesid),"- %s {CC00FF}(%s)[%d]",text,pData[playerid][pNickname],playerid);
					}
			        case 3:
			        {
						format(mes,sizeof(mes),"- %s {6666FF}(%s)",text,pData[playerid][pNickname]);
						format(mesid,sizeof(mesid),"- %s {6666FF}(%s)[%d]",text,pData[playerid][pNickname],playerid);
					}
			        case 4:
			        {
						format(mes,sizeof(mes),"- %s {FBD400}(%s)",text,pData[playerid][pNickname]);
						format(mesid,sizeof(mesid),"- %s {FBD400}(%s)[%d]",text,pData[playerid][pNickname],playerid);
					}
			        case 5:
			        {
						format(mes,sizeof(mes),"- %s {00EEEE}(%s)",text,pData[playerid][pNickname]);
						format(mesid,sizeof(mesid),"- %s {00EEEE}(%s)[%d]",text,pData[playerid][pNickname],playerid);
					}
			        case 6:
			        {
						format(mes,sizeof(mes),"- %s {6300f8}(%s)",text,pData[playerid][pNickname]);
						format(mesid,sizeof(mesid),"- %s {6300f8}(%s)[%d]",text,pData[playerid][pNickname],playerid);
					}
			        case 7:
			        {
						format(mes,sizeof(mes),"- %s {9eff4f}(%s)",text,pData[playerid][pNickname]);
						format(mesid,sizeof(mesid),"- %s {9eff4f}(%s)[%d]",text,pData[playerid][pNickname],playerid);
					}
   			        case 8:
			        {
						format(mes,sizeof(mes),"- %s {ff0000}(%s)",text,pData[playerid][pNickname]);
						format(mesid,sizeof(mesid),"- %s {ff0000}(%s)[%d]",text,pData[playerid][pNickname],playerid);
					}
     				case 9:
			        {
						format(mes,sizeof(mes),"- %s {FFFFFF}(%s)",text,pData[playerid][pNickname]);
						format(mesid,sizeof(mesid),"- %s {FFFFFF}(%s)[%d]",text,pData[playerid][pNickname],playerid);
					}
			        case 10:
			        {
						format(mes,sizeof(mes),"- %s {FFFFFF}(%s)",text,pData[playerid][pNickname]);
						format(mesid,sizeof(mesid),"- %s {FFFFFF}(%s)[%d]",text,pData[playerid][pNickname],playerid);
					}
			        case 11:
			        {
						format(mes,sizeof(mes),"- %s {FFFFFF}(%s)",text,pData[playerid][pNickname]);
						format(mesid,sizeof(mesid),"- %s {FFFFFF}(%s)[%d]",text,pData[playerid][pNickname],playerid);
					}
				}
			}
			else
			{
		        if(GetPVarInt(playerid,"odetcol") > 0)
		        {
					format(mes,sizeof(mes),"- %s {"#cW"}(%s)",text,pData[playerid][pNickname]);
					format(mesid,sizeof(mesid),"- %s {"#cW"}(%s)[%d]",text,pData[playerid][pNickname],playerid);
		        }
		        else
		        {
					format(mes,sizeof(mes),"- %s {%s}(%s)",text,GetColor(playerid),pData[playerid][pNickname]);
					format(mesid,sizeof(mesid),"- %s {%s}(%s)[%d]",text,GetColor(playerid),pData[playerid][pNickname],playerid);
				}
			}
		}
		else
		{
		    format(mes,sizeof(mes),"- %s (%s)",text,pData[playerid][pNickname]);
			format(mesid,sizeof(mesid),"- %s (%s) [%d]",text,pData[playerid][pNickname],playerid);
	}
	}
	format(mes2,sizeof(mes2),"%s сказал что-то на непонятном языке",pData[playerid][pNickname]);
	if(language == LANG_ENGLISH) SetPlayerChatBubble(playerid,text,CWHITE,20.0,5000);
	for(new i;i<MAX_PLAYERS;i++)
	{
		if(IsPlayerConnected(i) && pData[i][pMysqlID])
		{
			new Float:rdist,c;
			rdist = GetPlayerDistanceToPlayer(playerid,i);
			if (rdist > distance || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(i)) continue;
			if(color)
			{
				switch(floatround(rdist))
				{
					case 0..4: c = 0xFFFFFFFF;
					case 5..8: c = 0xCCCCCCFF;
					case 9..14: c = 0xAAAAAAFF;
					default: c = 0x888888FF;
				}
			}
			else c = CWHITE;
			if(pData[i][pLanguage][language] || language == LANG_ENGLISH)
			{
				if(pData[i][pSettings] & setPlayerIDChat) SendClientMessage(i,c,mesid);
				else SendClientMessage(i,c,mes);
			}
			else SendClientMessage(i,CPINK,mes2);
		}
	}
	return 1;
}

forward ClearAnimText(playerid);
public ClearAnimText(playerid)
{
	//ClearAnimations(playerid);
	ApplyAnimation(playerid,"CARRY","crry_prtial",4.0,0,0,0,0,0);
	return 1;
}

stock LoudSpeech(playerid,text[],language,Float:distance = 20.0)
{
	if(!pTemp[playerid][pLogined] || !pData[playerid][pMysqlID]) return 1;
	if(pData[playerid][pMut]) return SendPods(playerid, "У вас бан чата. Используйте /mutetime чтобы узнать время бана.");
	new mes[190],mes2[64],langname[32];
	if(language != LANG_ENGLISH)
	{
		switch(language)
		{
			case LANG_JAPAN: strcat(langname,"Японский");
			case LANG_ITALIAN: strcat(langname,"Итальянский");
			case LANG_PORTUGAL: strcat(langname,"Португальский");
			case LANG_FRENCH: strcat(langname,"Французский");
			case LANG_SPAIN: strcat(langname,"Испанский");
			case LANG_RUSSIAN: strcat(langname,"Русский");
		}
		format(mes,sizeof(mes),"%s [%s]: %s",pData[playerid][pNickname],langname,text);
	}
	else format(mes,sizeof(mes),"[S] %s кричит: %s",pData[playerid][pNickname],text);
	format(mes2,sizeof(mes2),"[S] %s кричит что-то на непонятном языке",pData[playerid][pNickname]);
	if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) ApplyAnimation(playerid,"RIOT","RIOT_shout",4.1,0,0,0,0,1);
	for(new i;i<MAX_PLAYERS;i++)
	{
		if(!IsPlayerConnected(i)) continue;
		new Float:rdist,c;
		rdist = GetPlayerDistanceToPlayer(playerid,i);
		if(!pTemp[i][pLogined] || !pData[i][pMysqlID] || rdist > distance || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(i)) continue;
		switch(floatround(rdist))
		{
			case 0..3: c = 0xFFFFFFFF;
			case 4..8: c = 0xCCCCCCFF;
			case 9..13: c = 0xAAAAAAFF;
			default: c = 0x888888FF;
		}
		if(pData[i][pLanguage][language] || language == LANG_ENGLISH) SendClientMessage(i,c,mes);
		else SendClientMessage(i,CPINK,mes2);
	}
	return 1;
}

stock DepartmentChat(color,mes[],Medic = 1,DOD = 1, DOI = 1, FBI = 1,Mayor = 1)
{
	for(new i;i<MAX_PLAYERS;i++)
	{
		if(!IsPlayerConnected(i) || !pData[i][pFraction] || pData[i][pJail]) continue;
		new fraction = pData[i][pFraction];
		if(Medic && fraction == 2 || DOD && fraction == 8 || DOI && fraction == 9 || FBI && fraction == 12 || Mayor && fraction == 11)
		{
			SendClientMessage(i,color,mes);
		}
	}
}

stock CopMes(color,mes[])
{
	for(new i;i<MAX_PLAYERS;i++)
	{
		if(!IsPlayerConnected(i) || !pData[i][pFraction]) continue;
		if(IsACop(i))
		{
			SendClientMessage(i,color,mes);
		}
	}
}

stock SendAdminMessage(color,const message[],exc = -1)
{
	for(new i;i<MAX_PLAYERS;i++)
	{
		if(IsPlayerConnected(i) && pData[i][pMysqlID])
		{
			if(pData[i][pSettings] & setAdminInfo || exc == i) SendClientMessage(i,color,message);
		}
	}
}

stock PayDay()
{
    new h; gettime(h); SetWorldTime(h);
	new day = GetDayNumber();
 	if(gCurDay != day) {
	    gCurDay = day;
	}
	new str[128];
	foreach(new i: Player) {
	    GameTextForPlayer(i,"~w~PAYDAY",5000,1);
		new fractionid = pData[i][pFraction]-1;
		new rank = pData[i][pRank]-1;
		new query[600];
		if(pData[i][pPromZP])
		{
		    pData[i][pPromZP] -= 1;
			SendMes(i, COLOR_WHITE, "[{FFA500}Информация{FFFFFF}] Акция 'Повышенная зарплата на первоначальных работах' истечет через %d PayDay",pData[i][pPromZP]);
			format(query,sizeof(query),"UPDATE `aplayerakk` SET `pPromZP` = '%d' WHERE `id` = '%d'",pData[i][pPromZP], pData[i][pMysqlID]);
			sql_query(snow, query, QUERY_THREADED);
		}
		PlayerPlaySound(i, 31204, 0.0, 0.0, 0.0);
		if(pData[i][pAdmin] && pData[i][pFraction])
		{
			format(query,sizeof(query),"UPDATE `aplayerakk` SET `fraction` = '0', `rank` = '0', `fractionskin` = '0', `subfraction` = '0' WHERE `id` = '%d'",pData[i][pMysqlID]);
			sql_query(snow, query, QUERY_THREADED);
			pData[i][pFraction] = 0;
			pData[i][pRank] = 0;
			pData[i][pFractionSkin] = 0;
			pData[i][pSubfraction] = 0;
			SetPlayerColor(i,0xFFFFFF11);
			SetPlayerSkin(i,pData[i][pSkin]);
			SendClientMessage(i, COLOR_GREY, "Вы были уволены из организации, т.к. являетесь администратором");
   		}
		if(pData[i][pAdmin] > 3)
		{
		    if(pData[i][pBank] > 0 && pData[i][pBank] < 20000)
		    {
			    pData[i][pBank] -= 500;
			    SendClientMessage(i, COLOR_GREY, "[Admin-Team] С Вас удержаны денежные средства в фонд мероприятий в размере 500$");
			    BankAdmin += 500;
		    }
		    if(pData[i][pBank] > 20000)
		    {
			    pData[i][pBank] -= 1000;
			    SendClientMessage(i, COLOR_GREY, "[Admin-Team] С Вас удержаны денежные средства в фонд мероприятий в размере 1000$");
			    BankAdmin += 1000;
		    }
		    UpdatePlayerData(i,"pBank",pData[i][pBank]);
		}
  		if(pTemp[i][pAFK] >= 19) { SendClientMessage(i,CGRAY,"Вы не получили зарплату, потому что находились в AFK.");continue; }
  		if(pData[i][pGiveExp] < 1200) { SendClientMessage(i,CGRAY,"К сожалению, вы не отыграли 20 минут за час, и не получили зарплату.");continue; }
		pData[i][pGiveExp] = 0;
		format(query,sizeof(query),"UPDATE `aplayerakk` SET `otigral` = '0' WHERE `id` = '%d'",pData[i][pMysqlID]);
		sql_query(snow, query, QUERY_THREADED);
		if(pData[i][pLevel] > VozrastPenc)
		{
		    pData[i][pBank] += PenciaCen;
		    format(str,sizeof(str), "Вам была начислена пенсия в размере: {"#cGREEN"}%d$",PenciaCen);
		    SendClientMessage(i, COLOR_GREY, str);
		    KaznaAP -= PenciaCen;
		}
		if(pData[i][pHelper])
		{
		    pData[i][pBank] += 500;
		    SendClientMessage(i, COLOR_GREY, "Поощрение агентам поддержки: {"#cGREEN"}500$");
		    KaznaAP -= 500;
		}
		if(pData[i][pDJ])
		{
		    pData[i][pBank] += 500;
		    SendClientMessage(i, COLOR_GREY, "Поощрение ведущим Wonderful FM: {"#cGREEN"}500$");
		    KaznaAP -= 500;
		}
		if(expx2 == 0) { pData[i][pExp]++;}
		else { pData[i][pExp]++,pData[i][pExp]++;}
		if(pData[i][pExp] >= pData[i][pLevel]*6)
		{
			SendClientMessage(i,0xc0c0c0FF,"Ваш игровой уровень и IC возраст повысился");
			pData[i][pLevel]++;
			pData[i][pAge]++;
			pData[i][pExp] = pData[i][pExp] - (pData[i][pLevel]-1)*6;
			SetPlayerScore(i,pData[i][pLevel]);
			if(pData[i][pLevel] == 2)
			{
			    SendClientMessage(i,COLOR_WHITE, "[{FFA500}Помощник Аманда{FFFFFF}] Поздравляю! Ты достиг 2 уровня, это уже прогресс!");
			    SendClientMessage(i,COLOR_WHITE, "[{FFA500}Помощник Аманда{FFFFFF}] Теперь ты можешь поехать в Правительство и устроиться на государственные работы");
			    SendClientMessage(i,COLOR_WHITE, "[{FFA500}Помощник Аманда{FFFFFF}] На данный момент в государстве открыта ваканси 'Водитель автобуса'");
			}
			if(pData[i][pLevel] == 4)
			{
		   		if(pData[i][pPromo1] == 1)
		   		{
	           		SFCM(i,-1,"• {FFC800}[Информация] {FFFFFF}Вы получили {EE82EE}50.000$ {FFFFFF}за введеный ранее промокод");
	           		pData[i][pMoney] += 50000;
	           		pData[i][pPromo1] = 0;
	           		format(query,sizeof(query),"UPDATE `aplayerakk` SET `pPromo1` = '0', `money` = '%d' WHERE `id` = '%d'", pData[i][pMoney],pData[i][pMysqlID]);
					sql_query(snow, query, QUERY_THREADED);
   				}
   				if(pData[i][pPromo1] == 2)
		    	{
	           		SFCM(i,-1,"• {FFC800}[Информация] {FFFFFF}Вы получили {EE82EE}200.000$ {FFFFFF}за введеный ранее промокод");
	           		pData[i][pMoney] += 200000;
	           		pData[i][pPromo1] = 0;
	           		format(query,sizeof(query),"UPDATE `aplayerakk` SET `pPromo1` = '0', `money` = '%d' WHERE `id` = '%d'", pData[i][pMoney],pData[i][pMysqlID]);
					sql_query(snow, query, QUERY_THREADED);
   				}
			}
		}
		if(pTemp[i][pOtgyl] == true) { SendClientMessage(i,CGRAY,"Вы не получили заработную плату, так как были в отгуле");continue; }
		if(IsAGang(i))
		{
			pData[i][pSalary] += TotalGz[pData[i][pFraction]-3]*70;
			SendClientMessage(i,CWHITE,"      [Банковский счет]");
			SendClientMessage(i,CWHITE,"_____________________________________________");
			SFCM(i,CWHITE,"     Зарплата: {c4f500}$%d",TotalGz[IsAGang(i)]*150);
			pData[i][pBank] += TotalGz[IsAGang(i)]*150;
			pData[i][pSalary] = 0;
			SFCM(i,CWHITE,"     Счет: {c4f500}$%d",pData[i][pBank]);
			if(pData[i][pSalary]) { pData[i][pSalary] = 0; }
			SendClientMessage(i,CWHITE,"_____________________________________________");
			SaveServerData();
   			if(pData[i][pSoc] == 1)
			{
   				if(pData[i][pSocKop] == 0)
			    {
			        SFCM(i,CWHITE,"{FFAF00}SMS: {FFF700}Выплаты пособия завершились. Договор расторгнут. {FFAF00}| {FFF700}Отправитель: Отдел социальной защиты",pData[i][pBank]);
					pData[i][pSoc] = 0;
  				}
				if(pData[i][pSocKop] < 30001 && pData[i][pSocKop] > 0)
				{
				    pData[i][pSocKop] -= 1000;
				    pData[i][pBank] += 1000;
					SFCM(i,CWHITE,"{FFAF00}SMS: {FFF700}Зачисление социального пособия в размере 1000$. Баланс: %i$ {FFAF00}| {FFF700}Отправитель: Bank of America",pData[i][pBank]);
				}
			}
			format(query,sizeof(query),"UPDATE `aplayerakk` SET exp='%d', level='%d', age='%d', zakon='%d', bank='%d', pSoc='%d', pSocKop='%d', salary=0 WHERE `id` = '%d'",
			pData[i][pExp],pData[i][pLevel],pData[i][pAge],pData[i][pZakon], pData[i][pBank],pData[i][pSoc], pData[i][pSocKop], pData[i][pMysqlID]);
			sql_query(snow, query, QUERY_THREADED);
		}
		else if(IsAMafia(i)) //if(pData[i][pFraction] && !pData[i][pAdmin])
		{
			SendClientMessage(i,CWHITE,"      [Банковская выписка]");
			SendClientMessage(i,CWHITE,"____________________________");
			SFCM(i,CWHITE,"     Зарплата: {c4f500}$%d",gFractionSalary[fractionid][rank]);
			pData[i][pBank] += gFractionSalary[fractionid][rank];
			SFCM(i,CWHITE,"     Счет: {c4f500}$%d",pData[i][pBank]);
			pData[i][pSalary] = 0;
			if(pData[i][pSalary]) { pData[i][pSalary] = 0; }
			SendClientMessage(i,CWHITE,"____________________________");
			SaveServerData();
			if(pData[i][pSoc] == 1)
			{
   				if(pData[i][pSocKop] == 0)
			    {
			        if(pData[i][pPhone]) { SFCM(i,CWHITE,"{FFAF00}SMS: {FFF700}Выплаты пособия завершились. Договор расторгнут. {FFAF00}| {FFF700}Отправитель: Отдел социальной защиты",pData[i][pBank]); }
					pData[i][pSoc] = 0;
  				}
				if(pData[i][pSocKop] < 30001 && pData[i][pSocKop] > 0)
				{
				    pData[i][pSocKop] -= 1000;
				    pData[i][pBank] += 1000;
					if(pData[i][pPhone]) { SFCM(i,CWHITE,"{FFAF00}SMS: {FFF700}Зачисление социального пособия в размере 1000$. Баланс: %i$ {FFAF00}| {FFF700}Отправитель: Bank of America",pData[i][pBank]); }
				}
			}
			format(query,sizeof(query),"UPDATE `aplayerakk` SET exp='%d', level='%d', age='%d', zakon='%d', bank='%d', pSoc='%d', pSocKop='%d', salary=0, otigral=0 WHERE `id` = '%d'",
			pData[i][pExp],pData[i][pLevel],pData[i][pAge],pData[i][pZakon], pData[i][pBank],pData[i][pSoc], pData[i][pSocKop], pData[i][pMysqlID]);
			sql_query(snow, query, QUERY_THREADED);
		}
		else if(IsAGos(i)) //if(pData[i][pFraction] && !pData[i][pAdmin])
		{
			if(pData[i][pZakon] < 100)
			{
				pData[i][pZakon]++;
			}
			format(query,sizeof(query),"UPDATE `aplayerakk` SET exp='%d', level='%d', age='%d', zakon='%d' salary=0 WHERE `id` = '%d'",pData[i][pExp],pData[i][pLevel],pData[i][pAge],pData[i][pZakon],pData[i][pMysqlID]);
			sql_query(snow, query, QUERY_THREADED);
			pData[i][pSalary] += gFractionSalary[fractionid][rank];
			if(IsAMVD(i))
			{
				if(pData[i][pSchool] == 1)
				{
				    if(KaznaAP > 5000000)
				    {
					   	new vznos = floatround(gFractionSalary[fractionid][rank]*0.01);
						new premia = floatround(gFractionSalary[fractionid][rank]*0.3);
						new doplata = floatround(gFractionSalary[fractionid][rank]*0.21);
						new nalog = floatround((gFractionSalary[fractionid][rank]+premia+doplata)*0.13);
						new prom = gFractionSalary[fractionid][rank]+premia+doplata;
						new viplata = prom-nalog-vznos;
						SendClientMessage(i,CWHITE,"      [Расчетный лист]");
						SendClientMessage(i,CWHITE,"_____________________________________________");
						SFCM(i,CWHITE,"     Оклад: {c4f500}$%d",gFractionSalary[fractionid][rank]);
						SFCM(i,CWHITE,"     Премия 20 процентов: {c4f500}$%d",premia);
						SFCM(i,CWHITE,"     Доплата 21 процент: {c4f500}$%d",doplata);
						SFCM(i,CWHITE,"     Подоходный налог 13 процентов: {c4f500}$%d",nalog);
	    				SFCM(i,CWHITE,"     Взнос в фонд организации 1 процент: {c4f500}$%d",vznos);
						SFCM(i,CWHITE,"     К выплате: {c4f500}$%d",viplata);
						KaznaMVD += vznos;
						KaznaAP -= doplata;
						KaznaAP -= gFractionSalary[fractionid][rank];
						KaznaAP += nalog;
						pData[i][pNalog] += nalog;
						pData[i][pBank] += viplata;
						pData[i][pSalary] = 0;
						if(pData[i][pSalary]) { pData[i][pSalary] = 0; }
						SendClientMessage(i,CWHITE,"_____________________________________________");
						if(pData[i][pPhone]) { SFCM(i,CWHITE,"{FFAF00}SMS: {FFF700}Зачисление заработной платы в размере %i$. Баланс: %i$ {FFAF00}| {FFF700}Отправитель: Bank of America",viplata,pData[i][pBank]); }
					}
					else
					{
	   					new vznos = floatround(gFractionSalary[fractionid][rank]*0.01);
						new premia = floatround(gFractionSalary[fractionid][rank]*0.05);
						new nalog = floatround((gFractionSalary[fractionid][rank]+premia)*0.13);
						new prom = gFractionSalary[fractionid][rank]+premia;
						new viplata = prom-nalog-vznos;
		    			SendClientMessage(i, COLOR_GREY, "В казне государства недостаточно средств для выплаты доплат и премий. Премия понижена до 5 процентов");
						SendClientMessage(i,CWHITE,"      [Расчетный лист]");
						SendClientMessage(i,CWHITE,"_____________________________________________");
						SFCM(i,CWHITE,"     Оклад: {c4f500}$%d",gFractionSalary[fractionid][rank]);
						SFCM(i,CWHITE,"     Премия 5 процентов: {c4f500}$%d",premia);
						SFCM(i,CWHITE,"     Подоходный налог 13 процентов: {c4f500}$%d",nalog);
	    				SFCM(i,CWHITE,"     Взнос в фонд организации 1 процент: {c4f500}$%d",vznos);
						SFCM(i,CWHITE,"     К выплате: {c4f500}$%d",viplata);
						KaznaMVD += vznos;
						KaznaAP -= premia;
						KaznaAP += nalog;
						pData[i][pNalog] += nalog;
						KaznaAP -= gFractionSalary[fractionid][rank];
						pData[i][pBank] += viplata;
						pData[i][pSalary] = 0;
						if(pData[i][pSalary]) { pData[i][pSalary] = 0; }
						SendClientMessage(i,CWHITE,"_____________________________________________");
						if(pData[i][pPhone]) { SFCM(i,CWHITE,"{FFAF00}SMS: {FFF700}Зачисление заработной платы в размере %i$. Баланс: %i$ {FFAF00}| {FFF700}Отправитель: Bank of America",viplata,pData[i][pBank]); }
					}
				}
				else
				{
					new vznos = floatround(gFractionSalary[fractionid][rank]*0.01);
					new nalog = floatround((gFractionSalary[fractionid][rank])*0.13);
					new viplata = gFractionSalary[fractionid][rank]-nalog-vznos;
					SendClientMessage(i,CWHITE,"      [Расчетный лист]");
					SendClientMessage(i,CWHITE,"_____________________________________________");
					SFCM(i,CWHITE,"     Оклад: {c4f500}$%d",gFractionSalary[fractionid][rank]);
					SFCM(i,CWHITE,"     Подоходный налог 13 процентов: {c4f500}$%d",nalog);
	    			SFCM(i,CWHITE,"     Взнос в фонд организации 1 процент: {c4f500}$%d",vznos);
