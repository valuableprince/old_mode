    }
			}
			else
			{
		 		if(pTemp[i][pAFK] > 0)
    {
					format(want_text,sizeof(want_text), "{FFFFFF}\t%d\tNone\t\t%d\t%s {ffa800}[AFK: %s]{ffffff}\n", pData[i][pLevel], pData[i][pFlvl], pData[i][pNickname],Converts(pTemp[i][pAFK]));
    }
				else
    {
					format(want_text,sizeof(want_text), "{FFFFFF}\t%d\tNone\t\t%d\t%s\n", pData[i][pLevel], pData[i][pFlvl], pData[i][pNickname]);
    }
			}
