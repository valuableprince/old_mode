stock hbminus()
{
	sql_query(snow, "UPDATE `houses` SET `days` = `days` -1 WHERE `days` > 0");
 	sql_query(snow, "UPDATE `business` SET `day` = `day` -1 WHERE `day` > 0");
	sql_query(snow, "UPDATE `fillings` SET `day` = `day` -1 WHERE `day` > 0");
	sql_query(snow, "UPDATE `aplayerakk` SET `admintime` = '0' WHERE `admin` > 0");
	return 1;
}

stock hunban()
{
    sql_query(snow, "UPDATE `aplayerakk` SET `warn` = `warn` -1 WHERE `warn` > 0");
	sql_query(snow, "UPDATE `ban` SET `time` = `time` -1 WHERE `time` > 0");
	return 1;
}

