					}
					ShowPlayerDialog(playerid,dDonateNickname1,1,"Смена ника","{"#cW"}Введите игровой ник, на который вы хотите поменять свой:","Далее","Отмена");
				}
				case 2: // рулетка
				{
				    if(pData[playerid][pDonate] < 25)
