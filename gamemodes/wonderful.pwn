		new fractionid = pData[playerid][pFraction]-1;
		if(pData[playerid][pRank] < gGangAccess[fractionid-2][0]-1) return SendClientMessage(playerid,-1,"У Вас нет доступа к общаку");
		ShowPlayerDialog(playerid,dObshak,2,"Общак","Единицы оружия\nПатроны\nНаркотики\nДеньги","Далее","Отмена");
