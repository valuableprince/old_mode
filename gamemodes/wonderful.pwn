		new route = pTemp[playerid][pBusRoute];
		if(gBusCPs[route][pos][0] == gBusCPs[route][pos+1][0] && gBusCPs[route][pos][1] == gBusCPs[route][pos+1][1]) //Остановка
		{
			new routename[30], string[128];
			switch(route)
			{
				case 0: routename = "ЖДЛС - Лесопилка";
				case 1: routename = "ЖДЛС - Оружейный завод";
				case 2: routename = "ЖДЛС - Шахта";
				case 3: routename = "ЖДЛС - Автошкола";
				case 4: routename = "ЖДСФ - Лесопилка";
				case 5: routename = "ЖДСФ - Оружейный завод";
				case 6: routename = "Лос-Сантос - Лас-Вентурас";
				case 7: routename = "Лас-Вентурас - Сан-Фиерро";
			}
			format(string,sizeof(string),"Автобус по маршруту %s отправляется через 10 секунд",routename);
			ProxDetector(30.0, playerid, string,0x44b2ffff,0x44b2ffff,0x44b2ffff,0x44b2ffff,0x44b2ffff);
			SetTimerEx("BusStop",10000,false,"i",playerid);
			return 1;
		}
		if(pos == 99 || gBusCPs[route][pos+1][0] == 0.0)
		{
			if(route < 4) pTemp[playerid][pBusPos] = 10;
			else pTemp[playerid][pBusPos] = 0;
			pData[playerid][pZarplata] += gBusSalary[route];
			new buslevel = 0;
			if(pData[playerid][pBusSkill] >= BUS_LEVEL_2) buslevel = 1;
			if(pData[playerid][pBusSkill] >= BUS_LEVEL_3) buslevel = 2;
			pData[playerid][pZarplata] += gBusAward[buslevel];
			pData[playerid][pBusSkill] ++;
			new query[300];
			format(query,sizeof(query),"UPDATE `aplayerakk` SET `pZarplata` = '%d', `busskill` = '%d' WHERE `id` = '%d'",pData[playerid][pZarplata]+gBusSalary[route],pData[playerid][pBusSkill],pData[playerid][pMysqlID]);
			sql_query(snow, query);
			format(query,sizeof(query),"%d$ было добавлено к вашей зарплате.",gBusSalary[route]);
			SendClientMessage(playerid,CGREEN,query);
			format(query,sizeof(query),"{FFAF00}SMS: {FFF700}На ваш зарплатный счет поступила заработная плата в размере %i$. {FFAF00}| {FFF700}Отправитель: Bank of America",gBusSalary[route]);
			SendClientMessage(playerid,0xFFF700FF,query);
			SendClientMessage(playerid, COLOR_WHITE, "[{FF8C00}Подсказка{FFFFFF}] Заработную плату можно снять в банке");
			if(pData[playerid][pBusSkill] == BUS_LEVEL_2 || pData[playerid][pBusSkill] == BUS_LEVEL_3) SendClientMessage(playerid,CGREEN,"Вы повысили свой уровень водителя автобуса");
		}
