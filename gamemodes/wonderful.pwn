						getdate(d,m,y);
						format(date,12,"%d-%d-%d",d,m,y);
						format(query,sizeof(query),"UPDATE `aplayerakk` SET `lastip` = '%s', `lastdate` = '%s' WHERE id = '%d'",ip, date,pData[playerid][pMysqlID]);
						sql_query(snow, query, QUERY_THREADED);
						pData[playerid][pLastIP] = ip;
						pData[playerid][pLastdate] = date;
