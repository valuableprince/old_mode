   		tmp = strtok(cmdtext, idx);
	 	new gun = strval(tmp);
 		tmp = strtok(cmdtext, idx);
   		new ammo = strval(tmp);
     	if(gun < 1 || gun > 46 || !gun) return SendClientMessage(playerid, COLOR_WHITE, "[{FFA500}Admin-Helper{FFFFFF}] agivegun (ID - игрока) [ID оружия] [Патроны]");
     	if(gun == 4 || gun == 9 || gun == 16 || gun == 18 || gun == 26 || gun == 27 || gun == 28 || gun == 32 || gun == 35 || gun == 36 || gun == 37 || gun == 38 || gun == 39 || gun == 44) return SendClientMessage(playerid, COLOR_GRAD1, "Запрещенное оружие");
   		if(ammo > 9999 || ammo < 1 || !ammo) return SendClientMessage(playerid, COLOR_WHITE, "[{FFA500}Admin-Helper{FFFFFF}] agivegun (ID - игрока) [ID оружия] [Патроны]");
   		if(!IsPlayerConnected(id)) return SendErr(playerid, "Неверный ID");
		new string[128];
		new weapname[50];
		GetWeaponName(gun, weapname, sizeof weapname);
		format(string, sizeof(string), "Администратора %s выдал Вам %s с %d патронами",pData[playerid][pNickname],weapname, ammo);
		SendClientMessage(id, -1, string);
		format(string, sizeof(string), "(A) Администратор %s[%d] выдал оружие %s(%d) игроку %s[%d]",pData[playerid][pNickname],playerid,weapname,ammo,pData[id][pNickname],id);
		AdminChat(COLOR_GREY,string);
   		GivePlayerWeaponEx(id, gun, ammo);
   		return 1;
   	}
	if(!strcmp(cmd,"/store",true))
	{
