	RemoveBuildingForPlayer(playerid, 728, -1815.7500, 564.3281, 34.0078, 0.25);
	RemoveBuildingForPlayer(playerid, 728, -1799.2109, 563.5625, 34.0078, 0.25);
	RemoveBuildingForPlayer(playerid, 728, -1806.5703, 549.9141, 34.0078, 0.25);
	RemoveBuildingForPlayer(playerid, 728, -1812.7344, 556.2422, 34.0078, 0.25);
	RemoveBuildingForPlayer(playerid, 728, -1799.6484, 556.3516, 34.0078, 0.25);
	RemoveBuildingForPlayer(playerid, 728, -1807.6719, 565.8438, 34.0078, 0.25);

	SetPVarInt(playerid,"repairoffee",-1);
	SetPVarInt(playerid,"repairoffer",-1);
	SetPVarInt(playerid,"zaprafoffee",-1);
	SetPVarInt(playerid,"zaprafoffer",-1);

	CancelSelectTextDraw(playerid);
	return 1;
}

stock RegisterPlayer(playerid) // Регистрация
{
	new query[600],date[12],d,m,y,ip[16],invitation[28];
	GetPlayerIp(playerid,ip,sizeof(ip));
	getdate(d,m,y);
	format(date,12,"%d-%d-%d",d,m,y);
	GetPVarString(playerid,"rinvitation",invitation,28);
	format(query,sizeof(query),"INSERT INTO `aplayerakk`(`nickname`,`password`,`email`,`ip`,`sex`,`color`,`age`,`language`,`regdate`,`status`,`money`,`bank`,`level`,`skills`,`health`,`code`,`requestcode`,`requestmail`,`lastip`,`ipcode`,`requestipcode`,`phonebook`,`carnumber`,`drugs2`,`admintime`,`banknomer`,`LicDrive`,`lastdate`,`pregl`)\
								VALUES('%s','%s','%s','%s','%d','%d','%d','%s','%s','1','25','0','1','0,0,0,0,0,0','100.0','0000','0','0','%s','0000','0','0','0','0','0','0','0','%s','%s')",
		pData[playerid][pNickname],
		pData[playerid][pPassword],
		pData[playerid][pEmail],
		ip,
		pData[playerid][pSex],
		pData[playerid][pColor],
		pData[playerid][pAge],
		pData[playerid][pLanguage],
		date,
  //pData[playerid][pNation],
		ip,
		date,
		invitation
	);
	if(!sql_query(snow, query)) Kick(playerid);
	else {
	    SetPVarInt(playerid, #reg_check, 1);
		LoadPlayerData(playerid);
		pTemp[playerid][pLogined] = true;
		pTemp[playerid][pREGISKL] = true;
		SpawnPlayer(playerid);
	}
	return 1;
}

stock UpdatePlayerData(playerid,field[],data)
{
	new query[256];
	format(query,sizeof(query),"UPDATE `aplayerakk` SET `%s` = '%d' WHERE `id` = '%d'",field,data,pData[playerid][pMysqlID]);
	sql_query(snow, query, QUERY_THREADED);
	return 1;
}

stock UpdateSpectating(playerid)
{
	if(pTemp[playerid][pSpectating] == true)
	{
		new Float:hp;
		new Float:armour;
		new str[356];
		GetPlayerArmour(pTemp[playerid][pSpectatee], armour);
		GetPlayerHealth(pTemp[playerid][pSpectatee], hp);
		new ammos = GetPlayerAmmo(pTemp[playerid][pSpectatee]);
		new weaponname[24];
		new weaponid = GetPlayerWeapon(pTemp[playerid][pSpectatee]);
		new specid = pTemp[playerid][pSpectatee];
		GetWeaponName(weaponid,weaponname,24);
		PlayerTextDrawShow(playerid, Spectate[playerid]);
		format(str, sizeof(str), "~n~%s~n~[ ~w~%d ~r~]~n~~r~GUN:     ~w~%s~n~~r~AMMO:    ~w~%d~n~~r~PING:    ~w~%d~n~~r~AFK:     ~w~%d~n~~r~FPS:     ~w~%d~n~~n~~r~HP:      ~g~%.0f.0~n~",pData[specid][pNickname], specid, weaponname ,ammos,GetPlayerPing(specid),pTemp[specid][pAFK],GetPlayerFPS(specid), hp);
		PlayerTextDrawSetString(playerid, Spectate[playerid], str);
 	}
}

