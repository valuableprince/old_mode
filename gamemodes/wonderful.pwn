	if(!strcmp(cmd,"/uncuff",true))
    {
		if(!IsACop(playerid)) return SendClientMessage(playerid,CGRAY,"Эта функция только для Полиции/ФБР");
		tmp = strtok(cmdtext,idx);
		if(!strlen(tmp)) return SendPods(playerid, "/uncuff (ID - игрока)");
		new id = strval(tmp);
		if(!IsPlayerConnected(id)) return SendClientMessage(playerid,CGRAY,"Неверный ID игрока");
		if(GetPlayerDistanceToPlayer(playerid,id) > 3.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(id)) return SendClientMessage(playerid,CGRAY,"Вы далеко друг от друга");
		if(pTemp[id][pCuffer] == INVALID_PLAYER_ID) return SendClientMessage(playerid,CGRAY,"Игрок не в наручниках");
		if(pTemp[playerid][pCuffee] != id) return SendClientMessage(playerid,CGRAY,"У вас нет ключа от этих наручников");
		SetPlayerSpecialAction(id,SPECIAL_ACTION_NONE);
		RemovePlayerAttachedObject(id,0);
		pTemp[id][pCuffer] = INVALID_PLAYER_ID;
		pTemp[id][pCuffee] = INVALID_PLAYER_ID;
		pTemp[playerid][pCuffee] = INVALID_PLAYER_ID;
		pTemp[playerid][pCuffer] = INVALID_PLAYER_ID;
		TogglePlayerControllable(id,1);
		MeAction(playerid,"снял наручники с преступника");
	}
	if(!strcmp(cmd,"/setmark",true))
	{
	    if(!IsACop(playerid)) return SendErr(playerid, "Эта функция только для Полиции/ФБР");
		if(pTemp[playerid][pGPS]) return SendErr(playerid, "У Вас уже есть метка на радаре");
		if(pTemp[playerid][Marked]) return SendErr(playerid, "Вы уже запустили систему поиска преступника. Дождитесь её окончания.");
		tmp = strtok(cmdtext,idx);
		if(!strlen(tmp)) return SendPods(playerid, "/setmark (ID - игрока)");
		new id = strval(tmp);
		if(pData[id][pWanted] < 2) return SendErr(playerid, "Данный игрок не в розыске или уровень розыска меньше 2");
		SendSucc(playerid, "Система спутникового поиска преступника активирована. Ожидайте ответа от спутника.");
		pTemp[playerid][Marked] = true;
		SetTimerEx("SetMark", 1000*random(10)+1000,0,"dd",playerid,id);
		return 1;
	}
	if(!strcmp(cmd,"/arrest",true))
	{
  		if(pData[playerid][pFraction] != 9 && pData[playerid][pFraction] != 12) return SendClientMessage(playerid,CGRAY,"Эта функция доступна только сотрудникам МВД");
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendPods(playerid, "/arrest (ID - игрока)");
		new id,time,mes[350],money = RandomEx(100,900);
		id = ReturnUser(tmp);
		if(!Nearjail(playerid) || !Nearjail(id)) return SendClientMessage(playerid,CGRAY,"Вы должны находиться у входа к камерам");
		if(!pData[id][pWanted]) return SendClientMessage(playerid,CGRAY,"Этот игрок не совершал преступление");
		if(pData[id][pJail]) return SendClientMessage(playerid,CGRAY,"Этот игрок уже находится в КПЗ");
		if(id == playerid) return 1;
		if(pData[id][pWanted] == 6){ time = 30; }
		if(pData[id][pWanted] == 5){ time = 25; }
		if(pData[id][pWanted] == 4){ time = 20; }
		if(pData[id][pWanted] == 3){ time = 15; }
		if(pData[id][pWanted] == 2){ time = 10; }
		if(pData[id][pWanted] == 1){ time = 5; }
		if(pTemp[id][pCuffer] != INVALID_PLAYER_ID)
		{
			new cuffer = pTemp[id][pCuffer];
			SetPlayerSpecialAction(id,SPECIAL_ACTION_NONE);
			RemovePlayerAttachedObject(id,0);
			pTemp[id][pCuffer] = INVALID_PLAYER_ID;
			pTemp[id][pCuffee] = INVALID_PLAYER_ID;
			pTemp[cuffer][pCuffee] = INVALID_PLAYER_ID;
			pTemp[cuffer][pCuffer] = INVALID_PLAYER_ID;
		}
		SetPlayerPos(id,219.5900,110.1900,999.0200);
		SetPlayerFacingAngle(id,269.1558);
		SetPlayerInterior(id, 10);
		if(pData[playerid][pSubfraction]){ SetPlayerVirtualWorld(id, pData[playerid][pSubfraction]); }
		else { SetPlayerVirtualWorld(id, 1); }
		SetPlayerSkin(id, 42);
		pData[id][pJail] = time*60;
		pData[id][pPrison] = RandomEx(1,3);
		pData[id][pWanted] = 0;
		SetPlayerWantedLevel(id, 0);
		UpdatePlayerData(id,"wanted",pData[id][pWanted]);
		format(mes,sizeof(mes),"Вы были помещены в КПЗ сотрудником ПД %s на %d минут",pData[playerid][pNickname],time);
		SendClientMessage(id,CBADINFO,mes);
		pData[playerid][pMoney] += money;
		format(mes,sizeof(mes),"Вы получили премию {009900}%d",money);
		SendClientMessage(playerid,CINFO,mes);
		format(mes,sizeof(mes),"Вы поместили %s в КПЗ",pData[id][pNickname]);
		SendClientMessage(playerid,CINFO,mes);
		return 1;
	}
	if(!strcmp(cmd,"/push",true))
	{
		if(!IsACop(playerid)) return SendClientMessage(playerid,CGRAY,"Эта функция только для Полиции/ФБР");
		tmp = strtok(cmdtext,idx);
		if(!strlen(tmp)) return SendPods(playerid, "/push (ID - игрока)");
		new id = strval(tmp);
		if(!IsPlayerConnected(id) || id == playerid) return SendClientMessage(playerid,CGRAY,"Неверный ID игрока");
		if(GetPlayerDistanceToPlayer(playerid,id) > 3.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(id)) return SendClientMessage(playerid,CGRAY,"Вы далеко друг от друга");
		new Float:x, Float:y, Float:z;
		GetPlayerPos(id,x,y,z);
		for(new i=1;i<=MAX_VEHICLES;i++)
		{
			if(!IsVehicleStreamedIn(i,playerid)) continue;
			new model = GetVehicleModel(i);
			if(model == 497 || model == 596 || model == 597 || model == 598 || model == 599 || model == 528 || model == 490 || model == 427)
			{
				new Float:vx, Float:vy, Float:vz;
				GetVehiclePos(i,vx,vy,vz);
				if(PointToPoint3D(x,y,z,vx,vy,vz) <= 8.0)
				{
					new seat = GetFreeSeat(i);
					if(seat == -1) continue;
					PutPlayerInVehicle(id,i,seat);
					MeAction(playerid,"посадил преступника в транспорт");
					if(pTemp[id][pCuffee] == id) TogglePlayerControllable(id,0);
					break;
				}
			}
		}
	}
	if(!strcmp(cmd,"/frisk",true))
	{
	    if(pData[playerid][pFraction] != 12 || pData[playerid][pRank] < 4) return SendErr(playerid, "Вы не можете использовать данную команду");
	    tmp = strtok(cmdtext, idx);
	    if(!strlen(tmp)) return SendPods(playerid, "/frisk (ID - игрока)");
	    new id = strval(tmp);
	    if(!IsPlayerConnected(id) || id == playerid) return SendErr(playerid,"Неверный ID игрока");
		if(GetPlayerDistanceToPlayer(playerid,id) > 3.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(id)) return SendClientMessage(playerid,CGRAY,"Вы далеко друг от друга");
		new str[64];
		if(!pData[id][pDrugs]) format(str, sizeof(str), "Наркотиков не обнаружено");
		else format(str, sizeof(str), "Обнаружено %d грамм наркотиков", pData[id][pDrugs]+pData[id][pHarddrugs]);
		SendClientMessage(playerid, COLOR_YELLOW, str);
		if(!pData[id][pAmmo]) format(str, sizeof(str), "Патрон не обнаружено");
		else format(str, sizeof(str), "Обнаружено %d патрон", pData[id][pAmmo]);
		SendClientMessage(playerid, COLOR_YELLOW, str);
		if(!pData[id][pMoney]) format(str, sizeof(str), "Денег не обнаружено");
		else format(str, sizeof(str), "Обнаружено %d$", pData[id][pMoney]);
		SendClientMessage(playerid, COLOR_YELLOW, str);
		format(str, sizeof(str), "произвёл обыск у %s", pData[id][pNickname]);
		MeAction(playerid,str);
		return 1;
	}
	if(!strcmp(cmd,"/skip",true))
	{
	    if(pData[playerid][pFraction] == 12 && pData[playerid][pRank] >= 5)
	    {
		    tmp = strtok(cmdtext, idx);
		    if(!strlen(tmp)) return SendPods(playerid, "/skip (ID - игрока)");
		    new id = strval(tmp);
		    if(!IsPlayerConnected(id) || id == playerid) return SendErr(playerid,"Неверный ID игрока");
			if(GetPlayerDistanceToPlayer(playerid,id) > 3.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(id)) return SendClientMessage(playerid,CGRAY,"Вы далеко друг от друга");
			pTemp[id][FBISkip] = 1;
			new str[64]; format(str, 64, "%s выдал Вам пропуск в здание ФБР",pData[playerid][pNickname]);
			SendSucc(id, str);
	  		format(str, 64, "Вы выдали пропуск в здание ФБР %s",pData[id][pNickname]);
     		SendSucc(playerid, str);
  		}
  		else if(pData[playerid][pFraction] == 9 && pData[playerid][pRank] >= 5)
	    {
		    tmp = strtok(cmdtext, idx);
		    if(!strlen(tmp)) return SendPods(playerid, "/skip (ID - игрока)");
		    new id = strval(tmp);
		    if(!IsPlayerConnected(id) || id == playerid) return SendErr(playerid,"Неверный ID игрока");
			if(GetPlayerDistanceToPlayer(playerid,id) > 3.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(id)) return SendClientMessage(playerid,CGRAY,"Вы далеко друг от друга");
			pTemp[id][PDSkip] = 1;
			new str[64]; format(str, 64, "%s выдал Вам пропуск в здание ПД",pData[playerid][pNickname]);
			SendSucc(id, str);
	  		format(str, 64, "Вы выдали пропуск в здание ПД %s",pData[id][pNickname]);
     		SendSucc(playerid, str);
  		}
  		else SendErr(playerid, "Вы не можете использовать данную команду (доступна с 5 ранга)");
	    return 1;
	}
	if(!strcmp(cmd,"/wanted",true))
    {
		if(!IsACop(playerid)) return SendClientMessage(playerid,CGRAY,"Эта функция только для Полиции/ФБР");
		new zStr[1024], number_wanted;
		format(zStr, sizeof(zStr), "Дело\tИмя преступника\tУровень розыска\n\n");
		foreach(new i:Player)
		{
			if(!pData[i][pMysqlID] || !pData[i][pWanted]) continue;
			format(zStr, sizeof(zStr), "%s{"#cW"}%d\t%s\t\t%d\n",zStr,i,pData[i][pNickname],pData[i][pWanted]);
			number_wanted++;
        }
        if(number_wanted == 0) strcat(zStr, "{"#cW"}Информация не найдена");
		ShowPlayerDialog(playerid,dMes,0,"{FFFF00}Список преступников",zStr,"Закрыть","");
		return 1;
	}
	if(!strcmp(cmd,"/m",true))
    {
		if(!IsACop(playerid)) return SendClientMessage(playerid,CGRAY,"Эта функция только для Полиции/ФБР");
		if(!IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid,CGRAY,"Вы должны быть в служебном т/с");
		new vehicleid = GetPlayerVehicleID(playerid);
//		new model = GetVehicleModel(vehicleid);
		if(vehicleid >= aLSPD[0] && vehicleid <= aLSPD[1] || vehicleid >= aSFPD[0] && vehicleid <= aSFPD[1] || vehicleid >= aLVPD[0] && vehicleid <= aLVPD[1] || vehicleid >= aFBI[0] && vehicleid <= aFBI[1]){}
		else return SendClientMessage(playerid,CGRAY,"Вы должны быть в служебном т/с");
		tmp = strrest(cmdtext, idx);
		if(!strlen(tmp)) return SendPods(playerid, "/m (текст)");
		new fractionid = pData[playerid][pFraction]-1;
		new rank = pData[playerid][pRank];
		new mes[128];
		if(pData[playerid][pFraction] == 12) format(mes, sizeof(mes), "<<< %s %s: %s >>>", gFractionRankName[fractionid][rank-1], pData[playerid][pNickname], tmp);
		else format(mes, sizeof(mes), "<<< %s %s: %s >>>", gFractionRankName[fractionid][rank-1], pData[playerid][pNickname], tmp);
		foreach(new i:Player)
		{
			if(!IsPlayerConnected(i) || !pTemp[i][pLogined] || !pData[i][pMysqlID] || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(i)) continue;
			new Float:rdist;
			rdist = GetPlayerDistanceToPlayer(playerid,i);
			if(rdist > 45.0) continue;
			SendClientMessage(i,CYELLOW,mes);
		}
	}
	if(strcmp(cmd, "/gzcolor", true) == 0)
    {
	    if(pData[playerid][pAdmin] < 7) return 1;
        tmp = strtok(cmdtext,idx);
        new l = strval(tmp);
        if(!strlen(tmp)) return SendPods(playerid, "/gzcolor [ID банды]");
        if(l == 3 || l == 4 || l == 5 || l == 6 || l == 7)
        {
            for(new i = 0; i < sizeof(GZMZ); i++)
            {
                if(PlayerToKvadrat(playerid,GZMZ[i][gCoords][0], GZMZ[i][gCoords][1],GZMZ[i][gCoords][2],GZMZ[i][gCoords][3]))
                {
                    GZMZ[i][gFrak] = l;
                    GangZoneStopFlashForAll(GZMZ[i][idm]);
                    GangZoneHideForAll(GZMZ[i][idm]);
                    GangZoneShowForAll(GZMZ[i][idm],GetGangZoneColor(i));
                    SaveGZ(i);
                }
            }
        }
    }
	if(!strcmp(cmd,"/ptime",true))
    {
		if(!pData[playerid][pJail]) return SendClientMessage(playerid,CGRAY,"Вы не находитесь в КПЗ");
		new mes[128],jailname[12];
		switch(pData[playerid][pPrison])
		{
			case 0: jailname = "LSPD";
			case 1: jailname = "SFPD";
			case 2: jailname = "LVPD";
		}
		if(pData[playerid][pJail] > 60){
		format(mes,sizeof(mes),"~g~%s~n~~w~REMAIN: ~g~%d ~w~MIN",jailname,pData[playerid][pJail]/60);
		GameTextForPlayer(playerid,mes,1,1);}
		if(pData[playerid][pJail] < 60){
		format(mes,sizeof(mes),"~g~%s~n~~w~REMAIN: ~g~%d ~w~SEC",jailname,pData[playerid][pJail]);
		GameTextForPlayer(playerid,mes,1,1);}
	}
	if(!strcmp(cmd,"/play",true))
	{
	    if(GetPVarInt(playerid, "music_play") == 1)
	    {
	        StopAudioStreamForPlayer(playerid);
	        SetPVarInt(playerid, "music_play", 0);
	    }
		ShowPlayerDialog(playerid, dRadio, DIALOG_STYLE_LIST, "{FFCD00}Онлайн радио", "1. Wonderful FM\n2. Дорожное радио\n3. Radio Шансон\n4. Record Russian Mix\n5. Классическая музыка\n6. Dance\n7. Europa+\n8. Наше радио", "Выбрать", "Отмена");
	}
	if(!strcmp(cmd,"/eject",true))
	{
		if(!IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid,CWHITE,"Вы должны быть в т.с.");
		if(GetPlayerVehicleSeat(playerid) != 0) return SendClientMessage(playerid,CGRAY,"Вы должны быть за рулем");
		tmp = strtok(cmdtext,idx);
		if(!strlen(tmp)) return SendPods(playerid, "/eject (ID - игрока)");
		new id = strval(tmp);
		if(!IsPlayerConnected(id) || id == playerid) return SendClientMessage(playerid,CGRAY,"Неверный ID игрока");
		new vehicleid = GetPlayerVehicleID(playerid);
		if(vehicleid == GetPlayerVehicleID(id) && GetPlayerVehicleSeat(id) != 0)
		{
		    new mes[64];
			format(mes, sizeof(mes), "%s вытолкнул вас из т.с.",pData[playerid][pNickname]);
			SendClientMessage(playerid,CINFO,mes);
			if(pTemp[id][pCuffee] == id) TogglePlayerControllable(id,1);
			RemovePlayerFromVehicle(id);
		}
	}
	if(!strcmp(cmd,"/limit",true))
	{
		if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendClientMessage(playerid,CGRAY,"Вы должны быть за рулем");
		tmp = strtok(cmdtext,idx);
		if(!strlen(tmp))
		{
			if(pTemp[playerid][pSLimit])
			{
				pTemp[playerid][pSLimit] = 0;
				SendClientMessage(playerid,CGREEN,"Ограничение скорости снято");
			}
			else SendPods(playerid, "/limit [скорость]");
			return 1;
		}
		new limit = strval(tmp);
		if(limit < 10 || limit > 150) return SendClientMessage(playerid,CGRAY,"Ограничение должно быть от 10 до 150");
		pTemp[playerid][pSLimit] = limit;
		SendClientMessage(playerid,CGREEN,"Установлено ограничение скорости");
	}
	if(!strcmp(cmd,"/pc",true))
	{
		new fractionid = pData[playerid][pFraction] - 1;
		new subfraction = pData[playerid][pSubfraction];
		if(!IsACop(playerid)) return SendClientMessage(playerid,CGRAY,"Вам не доступна эта функция");
		new caller = gEmCall[0];
		if(caller == INVALID_PLAYER_ID) return SendClientMessage(playerid,CGRAY,"Вызовов не поступало");
		gEmCall[0] = INVALID_PLAYER_ID;
		if(!IsPlayerConnected(caller) || !pData[caller][pMysqlID]) return SendClientMessage(playerid,CGRAY,"Игрок вышел");
		new Float:x, Float:y, Float:z;
		GetPlayerPos(caller,x,y,z);
		SetPlayerCheckpoint(playerid,x,y,z,4.0);
		pTemp[playerid][pGPS] = true;
		new mes[128];
		if(!subfraction) format(mes, sizeof(mes), "%s %s принял вызов", gFractionRankName[fractionid][pData[playerid][pRank]-1], pData[playerid][pNickname]);
		else format(mes,sizeof(mes),"%s %s (%s) принял вызов",gFractionRankName[fractionid][pData[playerid][pRank]-1], pData[playerid][pNickname],gSubfractionName[2][subfraction-1]);
		SendClientMessage(caller,CINFO,mes);
  		DepartmentChat(CDEPARTMENT,mes,0,0,1,1,0);
		SendClientMessage(playerid,CINFO,"Метка установлена на радаре. Чтобы убрать введите {"#cW"}/gps");
		return 1;
	}
	if(!strcmp(cmd,"/mc",true))
	{
		new fractionid = pData[playerid][pFraction] - 1;
		new subfraction = pData[playerid][pSubfraction];
		if(fractionid != 1 || !subfraction) return SendClientMessage(playerid,CGRAY,"Вам не доступна эта функция");
		new caller = gEmCall[1];
		if(caller == INVALID_PLAYER_ID) return SendClientMessage(playerid,CGRAY,"Вызовов не поступало");
		gEmCall[0] = INVALID_PLAYER_ID;
		if(!IsPlayerConnected(caller) || !pData[caller][pMysqlID]) return SendClientMessage(playerid,CGRAY,"Игрок вышел");
		new Float:x, Float:y, Float:z;
		GetPlayerPos(caller,x,y,z);
		SetPlayerCheckpoint(playerid,x,y,z,4.0);
		pTemp[playerid][pGPS] = true;
		new mes[128];
		format(mes,sizeof(mes),"%s (%s) принял вызов",pData[playerid][pNickname],gSubfractionName[0][subfraction-1]);
		SendClientMessage(caller,CINFO,mes);
		DepartmentChat(CDEPARTMENT,mes,1,0,0,0,0);
		SendClientMessage(playerid,CINFO,"Метка установлена на радаре. Чтобы убрать введите {"#cW"}/gps");
	}
	if(!strcmp(cmd,"/rc",true))
	{
		if(pData[playerid][pJob] != 4) return SendClientMessage(playerid,CGRAY,"Вам не доступна эта функция");
		if(pTemp[playerid][pMechID] == INVALID_VEHICLE_ID) return SendClientMessage(playerid,CGRAY,"Вы должны сначала арендовать буксир");
		if(pTemp[playerid][pGPS]) return SendClientMessage(playerid,CGRAY,"У вас уже установлена метка");
		new caller = gEmCall[2];
		if(caller == INVALID_PLAYER_ID) return SendClientMessage(playerid,CGRAY,"Вызовов не поступало");
		gEmCall[2] = INVALID_PLAYER_ID;
		if(!IsPlayerConnected(caller) || !pData[caller][pMysqlID]) return SendClientMessage(playerid,CGRAY,"Игрок вышел");
		new Float:x, Float:y, Float:z;
		GetPlayerPos(caller,x,y,z);
		SetPlayerCheckpoint(playerid,x,y,z,4.0);
		pTemp[playerid][pGPS] = true;
		new mes[128];
		format(mes,sizeof(mes),"%s принял вызов",pData[playerid][pNickname]);
		SendClientMessage(caller,CINFO,mes);
		foreach(new i:Player)
		{
			if(pData[i][pJob] != 4 || pTemp[i][pMechID] == INVALID_VEHICLE_ID) continue;
			SendClientMessage(i,CDEPARTMENT,mes);
		}
		SendClientMessage(playerid,CINFO,"Метка установлена на радаре. Чтобы убрать введите {"#cW"}/gps");
	}
	if(!strcmp(cmd,"/setspawn",true))
	{
	    if(!pData[playerid][pHouse]) return SendClientMessage(playerid,CGRAY,"Вы не проживаете в доме");
	    new mes[256], zS[20];
	    switch(pData[playerid][pSpawn])
	    {
	        case 1: format(zS, sizeof(zS), "Дом");
	        case 2: format(zS, sizeof(zS), "База организации");
	    }
	    format(mes, sizeof(mes), "Текущее место появления: {"#cOR"}%s\n- Дом\n- База организации", zS);
		ShowPlayerDialog(playerid, dSetSpawn, DIALOG_STYLE_LIST, "{"#cGR"}Место появления", mes, "Выбор", "Отмена");
		return 1;
	}
	if(!strcmp(cmd,"/ad",true))
	{
		if(gAdvertCount >= MAX_ADVERT_COUNT) return SendClientMessage(playerid,CGRAY,"К сожалению, очередь на объявления занята, попробуйте позже");
		if(!pData[playerid][pPhone]) return SendClientMessage(playerid,CGRAY,"Вам нужен телефон, что бы отправить объявление");
		if(pTemp[playerid][pAdvertTime]) return SendClientMessage(playerid,CGRAY,"Нельзя посылать чаще одного объявления в 30 секунд");
		tmp = strrest(cmdtext,idx);
		new len = strlen(tmp);
		if(!len) return SendClientMessage(playerid,-1,"{FFFFFF}• {FFC800}[Подсказка] {FFFFFF}/ad [текст объявления]");
		if(len > 100) return SendClientMessage(playerid,-1,"Максимальная длина объявления - 100 символов");
		SetPVarString(playerid,"advert",tmp);
		new mes[128];
		format(mes,sizeof(mes),"{"#cWHITE"}Цена объявления: {"#cRED"}$%d.\n{"#cWHITE"}Вы действительно хотите отправить объявление?",gAdvertPrice);
		ShowPlayerDialog(playerid,dAdvertSend,0,"Объявление",mes,"Да","Нет");
	}
	if(!strcmp(cmd,"/edit",true))
	{
		if(pData[playerid][pFraction] != 10) return SendClientMessage(playerid,CGRAY,"Эта функция доступна только сотрудникам новостной сети");
		ShowAdvertList(playerid);
	}
	if(!strcmp(cmd,"/ether",true))
	{
		if(pData[playerid][pFraction] != 10) return SendClientMessage(playerid,CGRAY,"Эта функция доступна только сотрудникам новостной сети");
		if(!pTemp[playerid][pEther])
		{
			new vehicleid = GetPlayerVehicleID(playerid);
			if(vehicleid >= aRadio[0] && vehicleid <= aRadio[1])
			{
				pTemp[playerid][pEther] = true;
				SendClientMessage(playerid,CGREEN,"Вы в эфире");
			}
			else return SendClientMessage(playerid,CGRAY,"В эфир можно выходить только в служебном транспорте");
		}
		else
		{
			pTemp[playerid][pEther] = false;
			SendClientMessage(playerid,CGREEN,"Вы вышли из эфира");
		}

	}
	if(!strcmp(cmd,"/dial",true))
	{
		if(pData[playerid][pFraction] != 10) return SendClientMessage(playerid,CGRAY,"Эта функция доступна только сотрудникам новостной сети");
		if(!pTemp[playerid][pEther]) return SendClientMessage(playerid,CGRAY,"Вы должны быть в эфире, чтобы начать принимать звонки");
		if(pData[playerid][pRank] < 5) return SendClientMessage(playerid,CGRAY,"Принимать звонки можно с пятого ранга");
		if(gNewsDialing[pData[playerid][pSubfraction]-1])
		{
			new mes[128];
			format(mes,sizeof(mes),"%s уже принимает звонки",pData[gNewsDialer[pData[playerid][pSubfraction]-1]][pNickname]);
			SendClientMessage(playerid,CGRAY,mes);
			return 1;
		}
		tmp = strtok(cmdtext,idx);
		if(!strlen(tmp) || !isNumeric(tmp)) return SendPods(playerid, "/dial [Цена звонка]");
		new price = strval(tmp);
		if(price < 0) return SendClientMessage(playerid,CGRAY,"Неверная цена");
		if(price > 150) return SendClientMessage(playerid,CGRAY,"Цена за 1 звонок не может быть больше $150");
		new mes[128];
		format(mes,sizeof(mes),"[R] %s начал принимать звонки. Цена звонка: $%d.",pData[playerid][pNickname],price);
		foreach(new i:Player)
		{
			if(pData[i][pFraction] == 10) {
				SendClientMessage(i,CBLUE,mes);
				switch(pData[playerid][pSubfraction]-1) {
					case 0: SendClientMessage(i, CBLUE, "[R] Телефон студии: 9900 [LS]");
					case 1: SendClientMessage(i, CBLUE, "[R] Телефон студии: 9901 [LV]");
					case 2: SendClientMessage(i, CBLUE, "[R] Телефон студии: 9902 [SF]");
				}
			}
		}
		gNewsDialing[pData[playerid][pSubfraction]-1] = true;
		gNewsDialer[pData[playerid][pSubfraction]-1] = playerid;
		gNewsDialee[pData[playerid][pSubfraction]-1] = INVALID_PLAYER_ID;
		gNewsDialPrice[pData[playerid][pSubfraction]-1] = price;
	}
	if(!strcmp(cmd,"/hdial",true))
	{
	    if(pData[playerid][pAdmin] > 0 && pData[playerid][pAdmin] < 7) return SendClientMessage(playerid,CGRAY,"Недоступно");
		if(pData[playerid][pFraction] != 10) return SendClientMessage(playerid,CGRAY,"Эта функция доступна только сотрудникам новостной сети");
		if(gNewsDialee[pData[playerid][pSubfraction]-1] == INVALID_PLAYER_ID) return SendClientMessage(playerid,CGRAY,"Никого на линии нет");
		SendClientMessage(gNewsDialee[pData[playerid][pSubfraction]-1],CWHITE,"Вы были отсоединены ведущим");
		SetPlayerSpecialAction(gNewsDialee[pData[playerid][pSubfraction]-1],SPECIAL_ACTION_STOPUSECELLPHONE);
		SetTimerEx("ClearPhone",2000,false,"i",gNewsDialee[pData[playerid][pSubfraction]-1]);
		gNewsDialee[pData[playerid][pSubfraction]-1] = INVALID_PLAYER_ID;
		SendClientMessage(playerid,CSYSTEM,"Игрок отсоединен");
	}
	if(!strcmp(cmd,"/stopdial",true))
	{
	    if(pData[playerid][pAdmin] > 0 && pData[playerid][pAdmin] < 7) return SendClientMessage(playerid,CGRAY,"Недоступно");
		if(pData[playerid][pFraction] != 10) return SendClientMessage(playerid,CGRAY,"Эта функция доступна только сотрудникам новостной сети");
		if(pData[playerid][pRank] < 5) return SendClientMessage(playerid,CGRAY,"Принимать звонки можно с пятого ранга");
		if(gNewsDialer[pData[playerid][pSubfraction]-1] != playerid) return SendClientMessage(playerid,CGRAY,"Невозможно");
		OnPlayerCommandText(playerid,"/hdial");
		gNewsDialing[pData[playerid][pSubfraction]-1] = false;
		gNewsDialer[pData[playerid][pSubfraction]-1] = INVALID_PLAYER_ID;
		gNewsDialee[pData[playerid][pSubfraction]-1] = INVALID_PLAYER_ID;
		gNewsDialPrice[pData[playerid][pSubfraction]-1] = 0;
		new mes[128];
		format(mes,sizeof(mes),"[R] %s закончил принимать звонки. Доход: $%d",pData[playerid][pNickname],gNewsDialMoney[pData[playerid][pSubfraction]-1]);
		gNewsMoney[pData[playerid][pSubfraction]-1] += gNewsDialMoney[pData[playerid][pSubfraction]-1];
		SaveNewsMoney();
		gNewsDialMoney[pData[playerid][pSubfraction]-1] = 0;
		foreach(new i:Player)
		{
			if(pData[i][pFraction] == 10) SendClientMessage(i,CBLUE,mes);
		}
	}
	if(!strcmp(cmd,"/number",true))
	{
	   	if(pData[playerid][pPhonebook] == 0) return SendClientMessage(playerid, COLOR_WHITE, "• {AC0000}[Ошибка] {"#cW"}У вас нет телефонной книжки.");
		{
		   	tmp = strtok(cmdtext, idx);
		   	if(!strlen(tmp)) return SendClientMessage(playerid,COLOR_WHITE,"• {FFC800}[Подсказка] {"#cWHITE"}/number [Полный ник игрока]");
		   	new account[24]; format(account, 24, "%s", tmp);
		   	tmp = strtok(cmdtext, idx);
			tmp = strrest(cmdtext, idx);
			sql_escape_string(snow, account,account, 24);
			new all[1000];
			new query[128];
			new playernumber[10];
 			format(query, sizeof(query), "SELECT `phone`,`admin` FROM `aplayerakk` WHERE `nickname` = '%s'", account);
			new Result:r = sql_query(snow, query, QUERY_CACHED);
			if(!sql_num_rows(r)) return SendClientMessage(playerid, COLOR_WHITE, "• {AC0000}[Ошибка] {"#cW"}Данный абонент не найден в базе");
			new number = sql_get_field_int(r, 0);
			sql_get_field(r, 0, playernumber);
			new admin = sql_get_field_int(r, 1);
			if(number == 0) return SendClientMessage(playerid, COLOR_WHITE, "• {AC0000}[Ошибка] {"#cW"}Номер данного абонента не удалось определить");
            if(admin > 0) return SendClientMessage(playerid, COLOR_WHITE, "• {AC0000}[Ошибка] {"#cW"}Номер данного абонента не удалось определить");
			sql_free_result(r);
			format(all,sizeof(all),"Номер %s: {fa5000}%s",account,playernumber);
			SendClientMessage(playerid, 0x00FF00FF, all);
			if(GetPlayerID(account) != -1)
			{
			    format(all,sizeof(all),"Абонент доступен для звонка");
	     		SendClientMessage(playerid, COLOR_LIGHTGREEN, all);
				return 1;
			}
			format(all,sizeof(all),"Телефон абонента вне зоны доступа");
			SendClientMessage(playerid, CINFO, all);
		}
	}
	if(!strcmp(cmd, "/givedonate", true) || !strcmp(cmd, "/givedn", true))
	{
	    if(strcmp(pData[playerid][pNickname], FD1, true)!=0) return 1;
	    new zStr[128];
     	tmp = strtok(cmdtext, idx);
     	if(!strlen(tmp)) return SendClientMessage(playerid, -1, "• {FFC800}[Подсказка] {FFFFFF}/givedonate [Ник игрока] [Кол-во рублей]");
     	new nickname[24]; format(nickname, 24, "%s", tmp);
     	tmp = strtok(cmdtext, idx);
     	if(!strlen(tmp) || !isNumeric(tmp)) return SendClientMessage(playerid, -1, "• {FFC800}[Подсказка] {FFFFFF}/givedonate [Ник игрока] [Кол-во рублей]");
     	new value = strval(tmp);
     	if(GetPlayerID(nickname) != -1)
		{
		    new i = GetPlayerID(nickname);
     		pData[i][pDonate] += value;
			UpdatePlayerData(i,"donate",pData[i][pDonate]);
	   		format(zStr, 100, "Вы добавили %d рублей в донат %s. Теперь у него %d рублей.", value, pData[i][pNickname], pData[i][pDonate]);
			SendClientMessage(playerid, COLOR_LIGHTRED, zStr);
			format(zStr, 100, "Администратор пополнил Ваш донат на %d рублей. Теперь у Вас %d рублей.", value, pData[i][pDonate]);
			SendClientMessage(i, COLOR_LIGHTRED, zStr);
			return 1;
		}
		sql_escape_string(snow, nickname,nickname, 24);
		format(zStr,sizeof(zStr),"SELECT donate FROM `aplayerakk` WHERE `nickname` = '%s'",nickname);
		new Result:r = sql_query(snow, zStr, QUERY_CACHED);
		if(!sql_num_rows(r)) return SendErr(playerid, "Игрок с таким именем не найден в базе.");
		new tdonate = sql_get_field_int(r, 0);
		sql_free_result(r);
		format(zStr,sizeof(zStr),"UPDATE `aplayerakk` SET donate='%d' WHERE `nickname`='%s'", tdonate+value, nickname);
		sql_query(snow, zStr, QUERY_THREADED);
		format(zStr, 128, "Вы пополнили донат счет %s в оффлайне на %d рублей.", pData[playerid][pNickname], nickname, value);
		SendClientMessage(playerid, COLOR_LIGHTRED, zStr);
		return 1;
	}
