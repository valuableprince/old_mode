	if(!strcmp(cmd,"/startmp",true))
	{
	    if(pData[playerid][pAdmin] < 5) return 1;
  		ShowPlayerDialog(playerid, dMp1, DIALOG_STYLE_INPUT, "Редактор мероприятия", "{"#cW"}Введите кол-во человек которые смогут участвовать в мероприятие","Далее","Отмена");
	}
  	if(!strcmp(cmd,"/stopmp",true))
	{
