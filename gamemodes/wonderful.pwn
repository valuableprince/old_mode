	if(!strcmp(cmd,"/business",true))
	{
		if(pData[playerid][pBusiness] < 1) return SendClientMessage(playerid,CGRAY,"У вас нет бизнеса");
		if(pData[playerid][pBusiness] > FILLING_ID_OFFSET) return SendClientMessage(playerid,CGRAY,"У вас нет бизнеса");
		ShowPlayerDialog(playerid,dBusiness,2,"{ffff85}Управление бизнесом","{ffff85}1.{FFFFFF} Управление кассой\n\
		{ffff85}2.{FFFFFF} Заказать продукты\n\
		{ffff85}3.{FFFFFF} Статистика\n\
		{ffff85}4.{FFFFFF} Открыть / закрыть\n\
		{ffff85}5.{FFFFFF} Продать бизнес\n\
		{ffff85}6.{FFFFFF} Установить цену за вход\n\
		{ffff85}7.{FFFFFF} Установить цену за продукты","Отметить","Назад");
	}
	if(!strcmp(cmd,"/sellbusiness",true))
	{
		if(pData[playerid][pBusiness] < 1) return SendErr(playerid, "У вас нет бизнеса");
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendPods(playerid, "/sellbusiness (ID - игрока) [Сумма]");
		new actplayerid = strval(tmp);
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendPods(playerid, "/sellbusiness (ID - игрока) [Сумма]");
		new price = strval(tmp);
		if(!IsPlayerConnected(actplayerid) || !pData[actplayerid][pMysqlID]) return SendErr(playerid, "Неверный ID игрока");
		if(pData[actplayerid][pBusiness]) return SendErr(playerid, "У игрока уже есть бизнес");
		if(price < gBusiness[pData[playerid][pBusiness]-1][busiSellPrice] || price > 40000000) return SendErr(playerid, "Цена не может быть меньше гос. цены бизнеса и больше 40 млн.");
		if(GetPlayerDistanceToPlayer(playerid,actplayerid) > 3.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(actplayerid)) return SendErr(playerid, "Вы далеко друг от друга");
		new businessid = -1;
		for(new i;i<gBusinessCount;i++)
		{
			if(gBusiness[i][busiOwnerID] == pData[playerid][pMysqlID]) {businessid = i; break;}
		}
		if(businessid == -1) return SendClientMessage(playerid,CGRAY,"Ошибка. Бизнес не найден");
		new mes[128];
		format(mes,sizeof(mes),"Вы предложили %s купить ваш бизнес",pData[actplayerid][pNickname]);
		SendClientMessage(playerid,CINFO,mes);
		format(mes,sizeof(mes),"%s предложил Вам купить его бизнес за $%d. Чтобы подтвердить нажмите Y, иначе N",pData[playerid][pNickname],price);
		SendClientMessage(actplayerid,CWHITE, mes);
		SendClientMessage(actplayerid,CWHITE,"/binfo - {"#cINFO"}чтобы посмотреть информацию о предлагаемом бизнесе");
		pTemp[playerid][pSellBusinessOffer] = playerid;
		pTemp[actplayerid][pSellBusinessOffer] = playerid;
		pTemp[actplayerid][pSellBusinessOffee] = actplayerid;
		pTemp[actplayerid][pSellBusinessPrice] = price;
		pTemp[actplayerid][pSellBusinessID] = businessid + 1;
	}
	if(!strcmp(cmd,"/binfo",true))
	{
		if(!pTemp[playerid][pSellBusinessID]) return SendErr(playerid, "Вам не предлагали купить бизнес");
		ShowBusinessInformation(playerid,pTemp[playerid][pSellBusinessID]-1,dMes);
	}
	if(!strcmp(cmd,"/maskoff",true))
	{
		if(!pData[playerid][pMasked]) return SendErr(playerid, "Вы не в маске");
	    if(!pData[playerid][pFraction]) SetPlayerColor(playerid,0xffffff25);
		if(pData[playerid][pFraction]) SetPlayerColor(playerid,gFractionColor[pData[playerid][pFraction] - 1]);
		RemovePlayerAttachedObject(playerid, 8);
		SendClientMessage(playerid,CBLUE,"Вы сняли маску.");
		pData[playerid][pMasked] = 0;
	}
    if(!strcmp(cmd,"/smoke",true))
	{
	    if(pData[playerid][pCiggaret] < 1) return SendErr(playerid, "У Вас нет сигарет, купите их в 24/7");
	    if(!Smoke[playerid])
		{
			new randsig = random(2);
			if(!randsig)
			{
			    if(pData[playerid][pSex] == 1) MeAction(playerid, "достал сигарету с зажигалкой и попытался закурить (Неудачно)");
				else MeAction(playerid, "достала сигарету с зажигалкой и попыталася закурить (Неудачно)");
			}
			else
			{
				SetPlayerSpecialAction(playerid,SPECIAL_ACTION_SMOKE_CIGGY);
				if(pData[playerid][pSex] == 1) MeAction(playerid, "достал сигарету с зажигалкой и закурил");
				else MeAction(playerid, "достала сигарету с зажигалкой и закурила");
				pData[playerid][pCiggaret] --;
				new query[128];
				format(query,sizeof(query),"UPDATE `aplayerakk` SET `ciggaret` = '%d' WHERE `id` = '%d'",pData[playerid][pCiggaret],pData[playerid][pMysqlID]);
				sql_query(snow, query);
				Smoke[playerid] = 1;
				SmokeTime[playerid] = 10;
				Smokes[playerid] = 0;
			}
		}
		return 1;
	}
	if(!strcmp(cmd,"/mask",true))
	{
	    if(pData[playerid][pMask] < 1) return SendErr(playerid, "У Вас нет маски");
		if(pData[playerid][pMasked] == 1) return SendErr(playerid, "Вы уже надели маску");
		SetPlayerColor(playerid, 0x7a766700);
		SendClientMessage(playerid, CBLUE, "Вы надели маску. Ваше местоположение скрыто (Введите /maskoff, чтобы снять маску)");
