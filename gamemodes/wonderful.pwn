		new warn = pData[playerid][pWarn];
		if(warn && warn <= gCurDay)
		{
			pData[playerid][pWarn] = 0;
			pData[playerid][pWarnc] = 0;
			UpdatePlayerData(playerid,"warn",0);
			UpdatePlayerData(playerid,"warnc",0);
