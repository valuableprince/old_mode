	}
}

forward PreWoodLoaded(playerid);
public PreWoodLoaded(playerid)
{
	if(!IsPlayerInDynamicArea(playerid,gAreas[arWoodLoad1]) && !IsPlayerInDynamicArea(playerid,gAreas[arWoodLoad2]) && !IsPlayerInDynamicArea(playerid,gAreas[arWoodLoad3]) && !IsPlayerInDynamicArea(playerid,gAreas[arWoodLoad4]))
	{
		RemovePlayerAttachedObject(playerid,0);
		RemovePlayerAttachedObject(playerid,1);
		ApplyAnimation(playerid,"CARRY","putdwn105",5.0,0,0,0,0,0);
		new id = RandomEx(0,4);
		SetPlayerCheckpoint(playerid,gWoodCPs[id][0],gWoodCPs[id][1],gWoodCPs[id][2],1.0);
		SendClientMessage(playerid,CGRAY,"Вернитесь к дереву");
		SetPVarInt(playerid,"loadid",id);
		return 1;
	}
	RemovePlayerAttachedObject(playerid,0);
	SetPlayerAttachedObject(playerid,0, 1458, 1, -1.034844, 1.116571, -0.065124, 76.480148, 75.781570, 280.952545, 0.575599, 0.604554, 0.624122);
	ClearAnimations(playerid);
	ApplyAnimation(playerid,"PED","IDLE_chat",5.0,0,0,0,1,5000,1);
	SetTimerEx("WoodLoaded",4000,false,"i",playerid);
	return 1;
}

public WoodLoaded(playerid)
{
	if(!IsPlayerInDynamicArea(playerid,gAreas[arWoodLoad1]) && !IsPlayerInDynamicArea(playerid,gAreas[arWoodLoad2]) && !IsPlayerInDynamicArea(playerid,gAreas[arWoodLoad3]) && !IsPlayerInDynamicArea(playerid,gAreas[arWoodLoad4]))
	{
		RemovePlayerAttachedObject(playerid,0);
		RemovePlayerAttachedObject(playerid,1);
		ApplyAnimation(playerid,"CARRY","putdwn105",5.0,0,0,0,0,1);
		new id = RandomEx(0,4);
		SetPlayerCheckpoint(playerid,gWoodCPs[id][0],gWoodCPs[id][1],gWoodCPs[id][2],1.0);
		SendClientMessage(playerid,CGRAY,"Вернитесь к дереву");
		SetPVarInt(playerid,"loadid",id);
		return 1;
	}
	new woodamount = gWorkSalary[1];
	SetPVarInt(playerid,"woodamount",woodamount);
	new mes[64];
	format(mes,sizeof(mes),"Загружено: %d кг. Везите тележку с дровами на переработку.",woodamount);
	SendClientMessage(playerid,CWHITE,mes);
	pTemp[playerid][pAntiCleoWood] = 200;
	SetPlayerAttachedObject(playerid,1,1463,1,-0.39, 1.616571, -0.065124,76.480148, 102.781570, 190.952545,1.1,0.5,1.0);
	SetPlayerCheckpoint(playerid,gWoodCPs[4][0],gWoodCPs[4][1],gWoodCPs[4][2],5.0);
	GetPlayerFacingAngle(playerid,pTemp[playerid][pAngle]);
	return 1;
}

public AbleToSelectCar(playerid)
{
	pTemp[playerid][pSellCarSelect] = true;
}

public GunReady(playerid)
{
	new objectid = GetPVarInt(playerid,"pgunobject");
	DeletePVar(playerid,"pgunobject");
	DestroyDynamicObject(objectid);
	DeletePVar(playerid,"pgunmodel");
	new locat = GetPVarInt(playerid,"pgunlocat") - 1;
	DeletePVar(playerid,"pgunlocat");
	gGunWorkTableStat[locat] = false;
	RemovePlayerAttachedObject(playerid,0);
	RemovePlayerAttachedObject(playerid,1);
	if(!IsPlayerInDynamicArea(playerid,gAreas[arGunWorkWork][locat])) return SendClientMessage(playerid,CGRAY,"Вы потеряли все детали по дороге. (( Не используй баги ))");
	if(GetPVarInt(playerid,"varioty") > 0)
	{
		new mat1 = GetPVarInt(playerid,"varioty");
		new vick = RandomEx(0,50);
		if(vick < mat1)
		{
			SendClientMessage(playerid,CGRAY,"Вы сделали бракованную деталь");
			SetPVarInt(playerid,"gunamount",0);
			gGunWorkWH[3] += 10;
			return 1;
		}
		else SetPVarInt(playerid,"varioty",mat1-5);
	}
	SetPVarInt(playerid,"gunamount",2);
	ClearAnimations(playerid);
	ApplyAnimation(playerid,"CARRY","crry_prtial",4.0,1,1,1,1,1,1);
	SetPlayerAttachedObject(playerid,0,2358,6,0.0,0.10,-0.2, -110.0,0.0,78.0);
	SendClientMessage(playerid,CWHITE,"Вы собрали оружие. Отнесите его на склад");
	SetPlayerCheckpoint(playerid,2564.0759,-1292.8741,1044.1250,2.0);
	return 1;
}

public FabReady(playerid)
{
	new objectid = GetPVarInt(playerid,"pgunobject");
	DeletePVar(playerid,"pgunobject");
	DestroyDynamicObject(objectid);
	DeletePVar(playerid,"pgunmodel");
	new locat = GetPVarInt(playerid,"pgunlocat") - 1;
	DeletePVar(playerid,"pgunlocat");
	gFabWorkTableStat[locat] = false;
	RemovePlayerAttachedObject(playerid,0);
	RemovePlayerAttachedObject(playerid,1);
	ClearAnimations(playerid);
	ApplyAnimation(playerid,"CARRY","crry_prtial",4.0,1,1,1,1,1,1);
	SetPlayerAttachedObject(playerid,0,2358,6,0.0,0.10,-0.2, -110.0,0.0,78.0);
	SendClientMessage(playerid,CWHITE,"Вы собрали ящик с патронами. Отнесите его на склад.");
	SetPlayerCheckpoint(playerid,2600.3474,-2210.8872,13.6638,2.0);
	SetPVarInt(playerid,"gunamount",2);
	return 1;
}
public CarShotTimer()
{
	for(new i;i<MAX_PLAYERS;i++)
	{
		carshoter[i] = 0;
	}
	return 1;
}

public MainTimer3()
{
	foreach(new i:Player) {
  		if(pTemp[i][pWork] == 2 && GetPVarInt(i,"coalamount") && pTemp[i][pShaxTime] > 0)  pTemp[i][pShaxTime]--;
 	}
	return 1;
}

public MainTimer2()
{
	foreach(new i:Player) {
   		if(IsKicked(i)) continue;
       	if(pData[i][pJail])
		{
			pData[i][pJail]--;
			if(pData[i][pJail] <= 0)
			{
				pData[i][pJail] = 0;
				SendClientMessage(i,CGRAY,"Вы были освобождены");
				new prison = pData[i][pPrison];
				if(pData[i][pFraction]) SetPlayerSkin(i,pData[i][pFractionSkin]);
				else SetPlayerSkin(i,pData[i][pSkin]);
				SetPlayerInterior(i,0);
				SetPlayerVirtualWorld(i,0);
				SetPlayerPos(i,camExit[prison][0],camExit[prison][1],camExit[prison][2]);
				SetPlayerFacingAngle(i,camExit[prison][3]);
			}
		}
   		if(GetPlayerMoney(i) > pData[i][pMoney] && !pTemp[i][pIsAFK] && !pData[i][pAdmin])
		{
			if(pTemp[i][pCheat])
			{
				ResetPlayerMoney(i);
				GivePlayerMoney(i,pData[i][pMoney]);
				pTemp[i][pCheat] = false;
			}
			else pTemp[i][pCheat] = true;
		}
		else pTemp[i][pCheat] = false;

		if(pTemp[i][pAbletoGun]) pTemp[i][pAbletoGun] --;
		if(pTemp[i][pCoalmanTime]) pTemp[i][pCoalmanTime]--;
		if(pTemp[i][pAntiCleoWood] > 0) pTemp[i][pAntiCleoWood]--;
		if(IsPlayerInRangeOfPoint(i, 2, 312.4241,-165.9406,999.6010))
		{
			new armsyid = GetPlayerVirtualWorld(i);
			if((pData[i][pFraction] >= 3 && pData[i][pFraction] <= 8) && armsyid < 4)
			{
				StealMats(i,armsyid);
			}
		}
	    if(Vor[i] > 0)
		{
			if(IsPlayerInRangeOfPoint(i, 2, 122.6930,-319.2666,1.5781))
			{
			    new str[300];
				new ptsk[MAX_PLAYERS];
				ptsk[i] = random(5)+1;
				if(MafiaAngar[0] - ptsk[i] < 0 || MafiaAngar[1] - ptsk[i] < 0) return SendClientMessage(i, COLOR_WHITE, "Нет патронов или Ед.Оружия");
				if(500 > ptsk[i] + pData[i][pAmmo] && pData[i][pUpdate] < 2) pData[i][pAmmo] += ptsk[i];
				if(1000 > ptsk[i] + pData[i][pAmmo] && pData[i][pUpdate] >= 2) pData[i][pAmmo] += ptsk[i];
				if(500 > ptsk[i] + pData[i][pGunAmount] && pData[i][pUpdate] < 2) pData[i][pGunAmount] += ptsk[i];
				if(1000 > ptsk[i] + pData[i][pGunAmount] && pData[i][pUpdate] >= 2) pData[i][pGunAmount] += ptsk[i];
				else if(500 < ptsk[i] + pData[i][pAmmo] && pData[i][pUpdate] < 2) return SendClientMessage(i, COLOR_WHITE, "Недостаточно места в инвентаре.");
				else if(1000 < ptsk[i] + pData[i][pAmmo] && pData[i][pUpdate] >= 2) return SendClientMessage(i, COLOR_WHITE, "Недостаточно места в инвентаре.");
				format(str, 200, "~y~PATRON %d~n~~b~Ed.Oruz %d", pData[i][pAmmo], pData[i][pGunAmount]);
				GameTextForPlayer(i, str, 1500, 6);
				format(str, 100, "+ %i", ptsk[i]);
				SetPlayerChatBubble(i, str, COLOR_YELLOW, 20.0, 10000);
				MafiaAngar[0] -= ptsk[i];
				MafiaAngar[1] -= ptsk[i];
				new mes[200];
    			format(mes,sizeof(mes),"Кол-во патронов на складе: {"#cWHITE"}%i\n{"#cGREEN"}Кол-во ед. оружия на складе: {"#cWHITE"}%i\n\nНажмите \"H\" чтобы взять боеприпасы.", MafiaAngar[0], MafiaAngar[1]);
				UpdateDynamic3DTextLabelText(Angar,0x33AA33FF,mes);
			}
			if(IsPlayerInRangeOfPoint(i, 2, 122.6930,-319.2666,1.5781))
			{
			    new str[300];
				new ptsk[MAX_PLAYERS];
				ptsk[i] = random(5)+1;
				if(MafiaAngar[0] - ptsk[i] < 0 || MafiaAngar[1] - ptsk[i] < 0) return SendClientMessage(i, COLOR_WHITE, "Нет Патронов или Ед.Оружия");
				if(500 < ptsk[i] + pData[i][pAmmo] && pData[i][pUpdate] < 2) return SendClientMessage(i, COLOR_WHITE, "Недостаточно места в инвентаре.");
				if(1000 < ptsk[i] + pData[i][pAmmo] && pData[i][pUpdate] >= 2) return SendClientMessage(i, COLOR_WHITE, "Недостаточно места в инвентаре.");
				if(500 < ptsk[i] + pData[i][pGunAmount] && pData[i][pUpdate] < 2) return SendClientMessage(i, COLOR_WHITE, "Недостаточно места в инвентаре.");
				if(1000 < ptsk[i] + pData[i][pGunAmount] && pData[i][pUpdate] >= 2) return SendClientMessage(i, COLOR_WHITE, "Недостаточно места в инвентаре.");
				pData[i][pAmmo] += ptsk[i];
				UpdatePlayerData(i, "ammo", pData[i][pAmmo]);
				pData[i][pGunAmount] += ptsk[i];
				UpdatePlayerData(i, "gunamount", pData[i][pGunAmount]);
				format(str, 200, "~y~PATRON %d~n~~b~Ed.Oruz %d", pData[i][pAmmo], pData[i][pGunAmount]);
				GameTextForPlayer(i, str, 1500, 6);
				format(str, 100, "+ %i", ptsk[i]);
				SetPlayerChatBubble(i, str, COLOR_YELLOW, 20.0, 10000);
				MafiaAngar[0] -= ptsk[i];
				MafiaAngar[1] -= ptsk[i];
				new mes[200];
    			format(mes,sizeof(mes),"Кол-во патронов на складе: {"#cWHITE"}%i\n{"#cGREEN"}Кол-во ед. оружия на складе: {"#cWHITE"}%i\n\nНажмите \"H\" чтобы взять боеприпасы.", MafiaAngar[0], MafiaAngar[1]);
				UpdateDynamic3DTextLabelText(Angar,0x33AA33FF,mes);
			}
		}
		if(GetPlayerState(i) == PLAYER_STATE_PASSENGER && !pTemp[i][pAFK] && checkcs[i] == 1)
    	{
        	new veher = GetPlayerVehicleID(i);
			new Float:xa, Float:ya, Float:za;
			new Float:b_x, Float:b_y, Float:b_z;
			GetPlayerPos(i, b_x, b_y, b_z);
			xa = b_x - pTemp[i][pX];
			ya = b_y - pTemp[i][pY];
			za = b_z - pTemp[i][pZ];
			new Float:distance;
			distance = floatsqroot(floatadd(floatadd(floatpower(xa,2),floatpower(ya,2)),floatpower(za,2)));
            if(distance > 55)
            {
                if(GetVehicleDriver(veher) != INVALID_PLAYER_ID) pTemp[i][pCarDriver] = 20;
                else if(pTemp[i][pCarDriver] <= 0)
				{
                    carshoter[i]++;
					if(carshoter[i] > 2)
					{
					    if(pData[i][pLevel] < 2 && pData[i][pAdmin] == 0)
					    {
							SendClientMessage(i,CORANGE,"Вы были кикнуты по подозрению в читерстве (#195)");
               	   			NewKick(i);
               	   		}
					    if(pData[i][pLevel] > 3 && pData[i][pAdmin] == 0)
					    {
							AddCheaterID(i,1);
               	   		}
                	}
				}
				else pTemp[i][pCarDriver]--;
			}
		}
		if(pTemp[i][pTazer]) pTemp[i][pTazer]--;
		if(!pTemp[i][pAFK]) pData[i][pGiveExp]++, UpdatePlayerData(i,"otigral",pData[i][pGiveExp]);
		if(pTemp[i][AntiCrack]) pTemp[i][AntiCrack]--;
		if(pTemp[i][PlayerStoned] >= 2)
		{
			pTemp[i][PlayerStoned] += 1;
			switch(pTemp[i][PlayerStoned])
			{
			    case 10,20,25,30: {
			        new Float:angle;
					GetPlayerFacingAngle(i, angle);
					if(IsPlayerInAnyVehicle(i) && GetPlayerState(i) == 2) SetVehicleZAngle(GetPlayerVehicleID(i), angle + 25);
					else SetPlayerFacingAngle(i, angle + 90);
				}
			    case 31: pTemp[i][PlayerStoned] = 0;
			}
		}
		if(pTemp[i][pInHospital])
		{
		    if(poluch[i] > 4)
		    {
		        poluch[i] = 0;
		    }
			if(pData[i][pHealth] < 100.0)
			{
			    if(poluch[i] < 1)
			    {
			    	pData[i][pHealth] += 5;
					SetPlayerHealthEx(i,pData[i][pHealth]+5);
				}
				poluch[i]++;
			}
		}
		if(pTemp[i][pOff] > 1)
    	{
	    	pTemp[i][pOff]--;
	    	return 1;
    	}
	}
	return 1;
}


public MainTimer()
{
	if(FrakCD > 0 && IsCapture == 0) FrakCD--;
	WHDataUpdate();
	for(new i;i<6;i++) if(gGunWorkTime[i]) gGunWorkTime[i]--;
	for(new i2;i2<2;i2++)
	{
		new text[256];
		strcat(text,"{"#cLIGHTBLUE"}  Очередь на загрузку:{"#cW"}");
		for(new i;i<10;i++)
		{
			if(gTruckLoadTurn[i2][i] != INVALID_PLAYER_ID && !IsPlayerConnected(gTruckLoadTurn[i2][i])) gTruckLoadTurn[i2][i] = INVALID_PLAYER_ID;
			if(i != 9 && gTruckLoadTurn[i2][i] == INVALID_PLAYER_ID && gTruckLoadTurn[i2][i+1] != INVALID_PLAYER_ID) {gTruckLoadTurn[i2][i] = gTruckLoadTurn[i2][i+1]; gTruckLoadTurn[i2][i+1] = INVALID_PLAYER_ID;}
			if(gTruckLoadTurn[i2][i] != INVALID_PLAYER_ID) format(text,sizeof(text),"%s\n%d. %s",text,i+1,pData[gTruckLoadTurn[i2][i]][pNickname]);
			else format(text,sizeof(text),"%s\n%d. Свободно",text,i+1);
		}
		UpdateDynamic3DTextLabelText(gTruckLoadTurnText[i2], CWHITE, text);
		if(gTruckLoadTurn[i2][0] != INVALID_PLAYER_ID)
		{
			new playerid = gTruckLoadTurn[i2][0];
			new amount = GetPVarInt(playerid,"truckamount");
			if(IsPlayerConnected(playerid))
			{
				if(pTemp[playerid][pTruckWagonID] != INVALID_VEHICLE_ID)
				{
					if(amount - pTemp[playerid][pTruckWeight] == 100)
					{
						pTemp[playerid][pTruckWeight] += 100;
						if(!i2) gCoalWH -= 100;
						else gWoodWH -= 100;
						pTemp[playerid][pTruckWagonTime] = 60;
						SendClientMessage(playerid,CGREEN,"Ваша фура загружена. У Вас есть 1 минута чтобы прицепить её");
						SendClientMessage(playerid,CGREEN,"Если не успеете заказ будет аннулирован. Деньги не возвращаются");
					}
					else if(pTemp[playerid][pTruckWeight] < amount)
					{
						pTemp[playerid][pTruckWeight] += 100;
						if(!i2) gCoalWH -= 100;
						else gWoodWH -= 100;
						new str1[100];
						format(str1, 100, "УГЛЯ: %d кг", gCoalWH);
						SetDynamicObjectMaterialText(shahter[0], 0, str1, 80, "Quartz MS", 20, 1, 0xFF000000, 0x00000000, 1);
						SetDynamicObjectMaterialText(shahter[1], 0, str1, 80, "Quartz MS", 20, 1, 0xFF000000, 0xFFFFFFFF, 1);
					}
					else if(pTemp[playerid][pTruckWagonTime] && GetPVarInt(playerid,"waitgruz") == 2) pTemp[playerid][pTruckWagonTime]--;
                    if(pTemp[playerid][pTruckWagonTime] < 1 && GetPVarInt(playerid,"waitgruz") == 2)
					{
						if(IsValid3DTextLabel(pTemp[playerid][pTruckWagonText])) DestroyDynamic3DTextLabelEx(pTemp[playerid][pTruckWagonText]);
						DestroyVehicle(pTemp[playerid][pTruckWagonID]);
						pTemp[playerid][pTruckWagonText] = Text3D:INVALID_3DTEXT_ID;
						pTemp[playerid][pTruckWagonID] = INVALID_VEHICLE_ID;
						pTemp[playerid][pTruckWeight] = 0;
						pTemp[playerid][pTruckWagonTime] = 0;
						gTruckLoadTurn[i2][0] = INVALID_PLAYER_ID;
						SendClientMessage(playerid,CRED,"Вы не успели. Заказ аннулирован");
					}
					if(pTemp[playerid][pTruckWagonText] != Text3D:INVALID_3DTEXT_ID)
					{
						new mes[128];
						if(i2 == 0) format(mes,sizeof(mes),"{"#cGREEN"}Угля в фуре: {"#cW"}%d/%d",pTemp[playerid][pTruckWeight],amount);
						if(i2 == 1) format(mes,sizeof(mes),"{"#cGREEN"}Древесины в фуре: {"#cW"}%d/%d",pTemp[playerid][pTruckWeight],amount);
						UpdateDynamic3DTextLabelText(pTemp[playerid][pTruckWagonText],CWHITE,mes);
					}
				}
				else
				{
					SendClientMessage(playerid,CWHITE,"Подошла очередь загрузки вашей фуры");
					SendClientMessage(playerid,CWHITE,"После загрузки у Вас будет всего минута, чтобы прицепить её.");
					SetPVarInt(playerid,"waitgruz",2);
					pTemp[playerid][pTruckWagonTime] = 60;
					if(!i2) pTemp[playerid][pTruckWagonID] = CreateVehicle(450,384.9763,902.6101,20.2163,82.9793,1,1,-1);
					else pTemp[playerid][pTruckWagonID] = CreateVehicle(450,-2003.7578,-2421.1641,31.6471,134.4641,1,1,-1);
					if(pTemp[playerid][pTruckWagonText] != Text3D:INVALID_3DTEXT_ID) DestroyDynamic3DTextLabelEx(pTemp[playerid][pTruckWagonText]);
					pTemp[playerid][pTruckWagonText] = CreateDynamic3DTextLabel("_",CWHITE,0.0,0.0,2.0,20.0,INVALID_PLAYER_ID,pTemp[playerid][pTruckWagonID]);
				}
				if(!IsPlayerInDynamicArea(playerid,gAreas[arTruckWagonCoal]) && !IsPlayerInDynamicArea(playerid,gAreas[arTruckWagonWood]) && (gTruckLoadTurn[0][0] == playerid || gTruckLoadTurn[1][0] == playerid))
				{
					new vehicleid = GetPlayerVehicleID(playerid);
					if(IsTrailerAttachedToVehicle(vehicleid))
					{
						new trailerid = GetVehicleTrailer(vehicleid);
						if(pTemp[playerid][pTruckWagonID] == trailerid)
						{
							new loadid = GetPVarInt(playerid,"loadid");
							pTemp[playerid][pTruckLoadID] = loadid;
							DeletePVar(playerid,"loadid");
							SetPVarInt(playerid,"truckonroad",1);
							gTruckLoadTurn[loadid][0] = INVALID_PLAYER_ID;
							SendClientMessage(playerid,CWHITE,"Теперь можете спокойно ехать к разгрузке. (( /gps => Дальнобойщики => Разгрузка ))");
						}
						else
						{
							SendClientMessage(playerid,CGRAY,"Данную фуру уже арендуют");
							RemovePlayerFromVehicle(playerid);
						}
					}
				}
			}
		}
	}
	new text[256];
	strcat(text,"{"#cINFO"}  Очередь на экзамен:{"#cWHITE"}");
	for(new i;i<20;i++)
	{
		if(gDSTurn[i] != INVALID_PLAYER_ID && !IsPlayerConnected(gDSTurn[i]) || (gDSTurn[i] != INVALID_PLAYER_ID && !pTemp[gDSTurn[i]][pWaitingExam])) gDSTurn[i] = INVALID_PLAYER_ID;
		if(i != 19 && gDSTurn[i] == INVALID_PLAYER_ID && gDSTurn[i+1] != INVALID_PLAYER_ID)
		{
			gDSTurn[i] = gDSTurn[i+1];
			gDSTurn[i+1] = INVALID_PLAYER_ID;
			if(!i)
			{
				new mes[128];
				format(mes,sizeof(mes),"%s ожидает вызова на практический экзамен по вождению",pData[gDSTurn[0]][pNickname]);
				for(new j;j<MAX_PLAYERS;j++)
				{
					if(!IsPlayerConnected(j) || !pTemp[j][pLogined]) continue;
					else if(pData[j][pFraction] == 1)
					{
						SendClientMessage(j,CINFO,mes);
					}
				}
			}
		}
		if(gDSTurn[i] != INVALID_PLAYER_ID) format(text,sizeof(text),"%s\n%d. %s",text,i+1,pData[gDSTurn[i]][pNickname]);
	}
	UpdateDynamic3DTextLabelText(gDSTurnText,CWHITE,text);
	if(gGangRespawnCar) gGangRespawnCar--;
	if(mafiacapture == 0 && IsStrelas == 1)
	{
	    MafiaTimeCapture(factionss, MafiaNapads);
	}
	if(mafiacapture == 0 && IsStrela == 1)
	{
	    GzCheckD();
	    CaptureEndD();
	}
	if(mafiacapture > 0 && IsStrela == 1)
	{
	    new str_mafia1[4], str_mafia2[4];
	    format(str_mafia2, sizeof(str_mafia2), "%d",SCORE1);
		TextDrawSetString(ScoreCapt1as,str_mafia2);
		format(str_mafia1, sizeof(str_mafia1), "%d",SCORE2);
		TextDrawSetString(ScoreCapt2as,str_mafia1);
	}
	if(mafiacapture > 0)
	{
        mafiacapture--;
		new mins,secs,string[5];
		mins = floatround((mafiacapture / 60));
		secs = floatround(mafiacapture - (mins * 60));
		format(string, sizeof(string), "%d:%02d", mins, secs);
		TextDrawSetString(CaptTimes, string);
		foreach(new i:Player)
		{
			if(IsAMafia(i))
			{
				if(mafiacapture == 0)
				{
				    TextDrawHideForPlayer(i,CaptTimes);
				}
			}
		}
	}
	for(new i;i<MAX_PLAYERS;i++)
	{
		pTemp[i][pDDOS] = false;
		pTemp[i][pDDOS2] = false;
		pTemp[i][pKick2] = 0;
		pTemp[i][pOff] = 0;
		if(!pTemp[i][pLogined])
		{
			pTemp[i][pLoginTime]--;
			if(pTemp[i][pLoginTime] <= 30)
			{
				SendClientMessage(i,0x33AA33FF,"Время на авторизацию ограничено!");
				NewKick(i);
			}
   		}
		pTemp[i][pAFK] ++;
		if(pTemp[i][pAFK] >= 3)
		{
			new mes[128];
			format(mes,sizeof(mes),"На паузе %s сек.",Converts(pTemp[i][pAFK]));
			SetPlayerChatBubble(i,mes,CWHITE,10.0,1600);
			pTemp[i][pIsAFK] = true;
		}
		if(pData[i][pAdmin] == 0 && (pTemp[i][pAFK] > 1000 || pTemp[i][pDarkAFK] > 1000))
		{
		    SendClientMessage(i,CGRAY,"Вы были кикнуты за простой в АФК");
			NewKick(i);
		}
		if(pTemp[i][pFillGoing])
		{
			new vehicleid = GetPlayerVehicleID(i);
			if(vehicleid && pTemp[i][pFillingAmount] > gVehicles[vehicleid-1][vFuel] + 1.0) gVehicles[vehicleid-1][vFuel] += 1.0;
			else if(vehicleid)
			{
				gVehicles[vehicleid-1][vFuel] = pTemp[i][pFillingAmount];
				TogglePlayerControllable(i,1);
				SendClientMessage(i,CGREEN,"Транспорт заправлен, можете ехать");
				SaveServerData2(i, vehicleid);
				pTemp[i][pFilling] = false;
				pTemp[i][pFillGoing] = false;
				pTemp[i][pFillingAmount] = 0.0;
				pTemp[i][pFillingSpeed] = 0.0;
				pTemp[i][pFillingAccel] = 0.0;
				pTemp[i][pFillingID] = 0;
   				pTemp[i][pFillingPrice] = 0;
			}
		}
		if(GetPlayerSurfingVehicleID(i) != INVALID_VEHICLE_ID)
		{
			new cid = GetPlayerSurfingVehicleID(i);
			new cm = GetVehicleModel(cid);
			switch(cm)
			{
				case 430,446,452,453,454,472,473,478,484,493,543,595:{return 1;} // если это лодка, скидывать ненадо)
				default:{}
			}
			new Float:x, Float:y, Float:z;
			GetPlayerPos(i,x,y,z);
			x -= 1.5;
			SetPlayerPos(i,x,y,z);
		}
		if(pTemp[i][pWork] == 2 && IsPlayerInDynamicArea(i,gAreas[arAntiCleo]))
		{
			new Float:x, Float:y, Float:z;
			GetPlayerPos(i,x,y,z);
			if(z < -180.0)
			{
				AddCheaterID(i,0);
			}
		}
  		if(pTemp[i][pAdvertTime] > 0) pTemp[i][pAdvertTime]--;
	}
	new h, m;
	gettime(h,m);
	if(gCurMinutes != m)
	{
 		gCurMinutes = m;
		if(m == 0) PayDay();
		if(m == 10 || m == 20 || m == 40 || m == 0) OilZ += RandomEx(0,200);
		if(h == 5 && m == 5)
		{
			for(new c=0; c<MAX_VEHICLES; c++)
			{
				if(IsVehicleOccupied(c) == -1) SetVehicleToRespawn(c);
			}
		}
		if(m == 2)
		{
		    if(Donatex2 == 1)
		    {
		        SendClientMessageToAll(0xFFFFFFCAA, "[{FFA500}Информация{FFFFFF}] {FFDAB9}Уважаемые игроки сервера {00BFFF}Wonderful Role Play{FFDAB9}! Мы рады, что вы выбрали нас!");
		    	SendClientMessageToAll(0xFFFFFFCAA, "[{FFA500}Информация{FFFFFF}] {FFDAB9}Вступайте в нашу группу ВКонтакте: {00BFFF}vk.com/official_wonderful");
		    	SendClientMessageToAll(0xFFFFFFCAA, "[{FFA500}Информация{FFFFFF}] {FFDAB9}Сайт проекта: {00BFFF}wonderful-rp.ru");
		    	SendClientMessageToAll(0xFFFFFFCAA, "[{FFA500}Информация{FFFFFF}] {FFDAB9}Форум проекта: {00BFFF}forum.wonderful-rp.ru");
		    	SendClientMessageToAll(0xFFFFFFCAA, "[{FFA500}Информация{FFFFFF}] {FFA500}Сегодня весь день действует акция X2 Donate {00BFFF}(/donate)");
		    	SendClientMessageToAll(0xFFFFFFCAA, "[{FFA500}Информация{FFFFFF}] {FFDAB9}Слушайте нашу радиостанцию Wonderful FM: {00BFFF}/play - Wonderful FM");
	    	}
		    else if(Donatex2 == 0)
   			{
		    	SendClientMessageToAll(0xFFFFFFCAA, "[{FFA500}Информация{FFFFFF}] {FFDAB9}Уважаемые игроки сервера {00BFFF}Wonderful Role Play{FFDAB9}! Мы рады, что вы выбрали нас!");
		    	SendClientMessageToAll(0xFFFFFFCAA, "[{FFA500}Информация{FFFFFF}] {FFDAB9}Вступайте в нашу группу ВКонтакте: {00BFFF}vk.com/official_wonderful");
		    	SendClientMessageToAll(0xFFFFFFCAA, "[{FFA500}Информация{FFFFFF}] {FFDAB9}Сайт проекта: {00BFFF}wonderful-rp.ru");
		    	SendClientMessageToAll(0xFFFFFFCAA, "[{FFA500}Информация{FFFFFF}] {FFDAB9}Форум проекта: {00BFFF}forum.wonderful-rp.ru");
		    	SendClientMessageToAll(0xFFFFFFCAA, "[{FFA500}Информация{FFFFFF}] {FFDAB9}Слушайте нашу радиостанцию Wonderful FM: {00BFFF}/play - Wonderful FM");
		    }
  		}
  		if(m == 25)
  		{
  		    SendClientMessageToAll(0xFFFFFFCAA, "[{00FFFF}Гос.Новости{FFFFFF}] {FFDAB9}Уважаемые жители и гости штата! Вещает отдел социальной защиты и помощи населению");
		   	SendClientMessageToAll(0xFFFFFFCAA, "[{00FFFF}Гос.Новости{FFFFFF}] {FFDAB9}Напоминаем вам, что правительством был подписан документ о соц.поддержке");
		   	SendClientMessageToAll(0xFFFFFFCAA, "[{00FFFF}Гос.Новости{FFFFFF}] {FFDAB9}Это материальная поддержка доступна всем недавно приезжим гражданам.");
		   	SendClientMessageToAll(0xFFFFFFCAA, "[{00FFFF}Гос.Новости{FFFFFF}] {FFDAB9}Подробнее можно узнать в Многофункциональном центре. Мы находимся в г.San-Fierro,");
		   	SendClientMessageToAll(0xFFFFFFCAA, "[{00FFFF}Гос.Новости{FFFFFF}] {FFDAB9}напротив порта. По навигатору: координаты 4 - 18.");
  		}
  		if(m == 4)
  		{
  		    new mes[144];
			format(mes,sizeof(mes),"[{00FFFF}Новости Bank of America{FFFFFF}] На сегодняшний день курс Woks-Token составляет: %d $ за банкноту",WoksToken);
			SendClientMessageToAll(0x00FF00FF,mes);
  		}
		if(h == 0 && m == 0) hunban();
 		else if(m == 5 && h == 0) hbminus();
 		else if(m == 55 && h == 4)
 		{
			SaveServerData3();
			SaveServerData();
 		}
 		//Объявления
	  	if(gAdvertTime > 0) gAdvertTime = 0;
  		for(new i;i<MAX_ADVERT_COUNT;i++)
		{
			if(gAdvert[i][adTime]) gAdvert[i][adTime] = 0;
			if(gAdvert[i][adCheked] && !gAdvert[i][adTime])
			{
				new mes[168];
				format(mes,sizeof(mes),"%s Отправитель: %s (тел. %d)",gAdvert[i][adText],gAdvert[i][adSender],gAdvert[i][adPhone]);
				SendClientMessageToAll(0x00FF00FF,mes);
				format(mes,sizeof(mes),"  Объявление проверил: %s %s",gAdvert[i][adRang], gAdvert[i][adCheker]);
				SendClientMessageToAll(CGREEN,mes);
				strdel(gAdvert[i][adSender],0,24);
				gAdvert[i][adPhone] = 0;
				strdel(gAdvert[i][adText],0,100);
				strdel(gAdvert[i][adCheker],0,24);
				gAdvert[i][adBusy] = false;
				gAdvert[i][adCheked] = false;
				gAdvert[i][adCheking] = false;
				gAdvert[i][adTime] = 0;
				if(gAdvertCount > 0) gAdvertCount--;
			}
		}
	}
	return 1;
}

public BusStop(playerid)
{
	new pos = pTemp[playerid][pBusPos];
	new route = pTemp[playerid][pBusRoute];
	if(pos == 99 || gBusCPs[route][pos+1][0] == 0.0)
	{
		pTemp[playerid][pBusPos] = 10;
		SendClientMessage(playerid,CGREEN,"Вы закончили рейс");
	}
	else pTemp[playerid][pBusPos]++;
	SetNextBusCP(playerid,pTemp[playerid][pBusPos]);
	return 1;
}

public BusSpawnEx(playerid)
{
	UpdatePlayerData(playerid, "pZarplata", pData[playerid][pZarplata]+pTemp[playerid][pWorkSalary]);
	DisablePlayerRaceCheckpoint(playerid);
	pTemp[playerid][pBusID] = INVALID_VEHICLE_ID;
	pTemp[playerid][pBusRoute] = 0;
	pTemp[playerid][pBusPos] = 0;
	pTemp[playerid][pBusPrice] = 0;
	if(IsValid3DTextLabel(pTemp[playerid][pBusText])) DestroyDynamic3DTextLabelEx(pTemp[playerid][pBusText]);
	pTemp[playerid][pBusText] = Text3D:INVALID_3DTEXT_ID;
	SendClientMessage(playerid,CWHITE,"Рабочий день окончен");
	new mes[250];
	format(mes,sizeof(mes),"Заработано: {"#cW"}$%d",pTemp[playerid][pWorkSalary]);
	SendClientMessage(playerid,CGREEN,mes);
	format(mes,sizeof(mes),"{FFAF00}SMS: {FFF700}На ваш зарплатный счет поступила заработная плата в размере %i$. {FFAF00}| {FFF700}Отправитель: Bank of America",pTemp[playerid][pWorkSalary]);
	SendClientMessage(playerid,0xFFF700FF,mes);
	SendClientMessage(playerid, COLOR_WHITE, "[{FF8C00}Подсказка{FFFFFF}] Заработную плату можно снять в банке (( Меню банкомата/банка - Зарплатный счет ))");
	pTemp[playerid][pWorkSalary] = 0;
	SetVehicleToRespawnEx(pTemp[playerid][pBusID]);
	SendClientMessage(playerid,CRED,"Рабочее т/с было отбуксировано.");
	return 1;
}

forward TaxiSpawn(playerid);
public TaxiSpawn(playerid)
{
	if(GetPVarInt(playerid,"exitedtrans") != 1) return 1;
	DisablePlayerRaceCheckpoint(playerid);
	SetVehicleToRespawnEx(pTemp[playerid][pTaxiID]);
	if(pTemp[playerid][pTaxi3DText] != Text3D:INVALID_3DTEXT_ID) DestroyDynamic3DTextLabelEx(pTemp[playerid][pTaxi3DText]);
	pTemp[playerid][pTaxiID] = INVALID_VEHICLE_ID;
	pTemp[playerid][pTaxiPrice] = 0;
	pTemp[playerid][pTaxiTurn][0] = INVALID_PLAYER_ID;
	pTemp[playerid][pTaxiTurn][1] = INVALID_PLAYER_ID;
	return 1;
}

forward TruckerSpawn(playerid);
public TruckerSpawn(playerid)
{
	if(GetPVarInt(playerid,"exitedtrans") != 1) return 1;
	SetVehicleToRespawnEx(pTemp[playerid][pTruckID]);
	if(IsValid3DTextLabel(pTemp[playerid][pTruckWagonText])) DestroyDynamic3DTextLabel(pTemp[playerid][pTruckWagonText]);
	pTemp[playerid][pTruckID] = INVALID_VEHICLE_ID;
	if(pTemp[playerid][pTruckWagonID] != INVALID_VEHICLE_ID)
	{
		DestroyVehicle(pTemp[playerid][pTruckWagonID]);
		pTemp[playerid][pTruckWagonID] = INVALID_VEHICLE_ID;
	}
	for(new i2;i2<2;i2++)
	{
		for(new i;i<10;i++)
		{
			if(gTruckLoadTurn[i2][i] == playerid || gTruckLoadTurn[i2][i] == playerid) gTruckLoadTurn[i2][i] = INVALID_PLAYER_ID;
		}
	}
	SendClientMessage(playerid,CRED,"Рабочее т/с было отбуксировано.");
	return 1;
}

public UpdateCarInfo(playerid,const vehicleid,speedonly)
{
	if(!IsPlayerConnected(playerid) || IsKicked(playerid))
	{
		HideCarInfo(playerid);
		KillTimer(pTemp[playerid][pCarInfoTimer]);
		pTemp[playerid][pCarInfoTimer] = 0;
		return 1;
	}
	new info[256];
	new Float:X, Float:Y, Float:Z, Float:X2, Float:Y2, Float:Z2, marks[4], tick = GetTickCount();
	marks[0] = 'r';
	marks[1] = 'r';
	marks[2] = 'r';
	marks[3] = 'g';
	new lights,engine;
	engine = GetEngineStatL(vehicleid,lights);
	if(!speedonly)
	{
		X2 = gVehicles[vehicleid-1][vX];
		Y2 = gVehicles[vehicleid-1][vY];
		Z2 = gVehicles[vehicleid-1][vZ];
		GetVehiclePos(vehicleid, X, Y, Z);
		if(X > 10000.0 || Y > 10000.0 || Z > 10000.0 || X < -10000.0 || Y < -10000.0 || Z < -10000.0)
		{
			SendClientMessage(playerid,CGRAY,"Ошибка 2");
			NewKick(playerid);
			SetVehicleToRespawnEx(vehicleid);
			return 1;
		}
		new Float:veloc;
		veloc = PointToPoint3D(X2,Y2,Z2,X,Y,Z)/1000;
		veloc = floatsqroot(floatadd(floatadd(floatpower(X -X2, 2), floatpower(Y-Y2, 2)),  floatpower(Z-Z2, 2)))/1000;
		gVehicles[vehicleid-1][vDrived] += veloc;
		if(engine == 1)
		{
			if(gVehicles[vehicleid-1][vEngine] == false) pTemp[playerid][pKick5]++;
			if(pTemp[playerid][pKick5] == 10)
			{
				pTemp[playerid][pKick5] = 0;
				new mes[128];
				format(mes,sizeof(mes),"[Античит] %s[%d] подозревается в вождении с выключенным двигателем",pData[playerid][pNickname],playerid);
				AdminChat(CRED,mes);
			}
			marks[0] = 'g';
			gVehicles[vehicleid-1][vFuel] -= (veloc/100)*gTransport[GetVehicleModel(vehicleid)-400][trConsumption];
			if(gVehicles[vehicleid-1][vFuel] <= 0.0)
			{
				gVehicles[vehicleid-1][vFuel] = 0.0;
				ToggleEngine(vehicleid);
				SendClientMessage(playerid,CGRAY,"Двигатель заглох");
			}
			else if(gVehicles[vehicleid-1][vHealth] <= 300.0)
			{
				gVehicles[vehicleid-1][vHealth] = 300.0;
				ToggleEngine(vehicleid);
				SendClientMessage(playerid,CGRAY,"Двигатель заглох");
			}
		}
		gVehicles[vehicleid-1][vX] = X;
		gVehicles[vehicleid-1][vY] = Y;
		gVehicles[vehicleid-1][vZ] = Z;
	}
 	GetVehicleVelocity(vehicleid,X,Y,Z);
	new Float:speed = floatsqroot(floatadd(floatadd(floatpower(X, 2), floatpower(Y, 2)),  floatpower(Z, 2))) * 126.31;
	new lims[64];
	if(pTemp[playerid][pSLimit])
	{
		format(lims,sizeof(lims),"(%d)",pTemp[playerid][pSLimit]);
		if(speed > pTemp[playerid][pSLimit])
		{
			marks[3] = 'r';
			new Float:dif = pTemp[playerid][pSLimit] / speed;
			SetVehicleVelocity(vehicleid,X*dif,Y*dif,Z);
			speed = pTemp[playerid][pSLimit];
		}

	}
	marks[1] = gVehicles[vehicleid-1][vLock] == 1 ? 'g':'r';
	marks[2] = lights > 0 ? 'g':'r';
	new carid = GetPlayerVehicleID(playerid);
	//format(info,sizeof(info)," FUEL: ~g~%.2f~n~ ~w~SPEED: ~b~%.0fKM/H ~%c~%s~n~ ~w~MILEAGE: ~r~%.1fKM~n~ ~%c~ENG ~%c~LOCK ~%c~LAMP",gVehicles[vehicleid-1][vFuel],speed,marks[3],lims,gVehicles[vehicleid-1][vDrived],marks[0],marks[1],marks[2]);
	format(info,sizeof(info),"%s",GetVehicleName(GetVehicleModel(carid)));
	TextDrawSetString(gVehInfo[0][playerid],info);
	format(info,sizeof(info),"~w~FUEL: ~b~%.0f~w~L~n~~n~~w~SPEED: ~g~%.0f~w~KM/H ~%c~%s~n~~n~~w~Health: ~p~%.0f~w~%~n~~n~MILEAGE: ~y~%.1f~w~KM~n~~n~~%c~ENGINE ~%c~LOCK ~%c~LAMP",gVehicles[vehicleid-1][vFuel],speed,marks[3],lims,gVehicles[vehicleid-1][vHealth]/10,gVehicles[vehicleid-1][vDrived],marks[0],marks[1],marks[2]);
	TextDrawSetString(gVehInfo[1][playerid],info);
	TextDrawShowForPlayer(playerid,gVehInfo[0][playerid]);
	TextDrawShowForPlayer(playerid,gVehInfo[1][playerid]);
	if(pTemp[playerid][pSpectator] != INVALID_PLAYER_ID)
	{
	format(info,sizeof(info),"%s",GetVehicleName(GetVehicleModel(carid)));
	PlayerTextDrawSetString(pTemp[playerid][pSpectator], gAdmVehInfo[0][pTemp[playerid][pSpectator]],info);
	format(info,sizeof(info),"~w~FUEL: ~b~%.0f~w~L~n~~n~~w~SPEED: ~g~%.0f~w~KM/H ~%c~%s~n~~n~~w~Health: ~p~%.0f~w~%~n~~n~MILEAGE: ~y~%.1f~w~KM~n~~n~~%c~ENGINE ~%c~LOCK ~%c~LAMP",gVehicles[vehicleid-1][vFuel],speed,marks[3],lims,gVehicles[vehicleid-1][vHealth]/10,gVehicles[vehicleid-1][vDrived],marks[0],marks[1],marks[2]);
	PlayerTextDrawSetString(pTemp[playerid][pSpectator], gAdmVehInfo[1][pTemp[playerid][pSpectator]],info);
	}
	GetVehicleHealth(vehicleid,gVehicles[vehicleid-1][vHealth]);
	new Float:acceleration;
	acceleration = (speed - pTemp[playerid][pSpeed0]) / 0.2;
	if(acceleration >= 160.0 && tick - pTemp[playerid][pLastTick2] < 175)
	if(SpeedVehicle(playerid) > MaxSpeed[playerid]+5 && GetPlayerState(playerid) != PLAYER_STATE_PASSENGER && pData[playerid][pAdmin] == 0)
	{
	    if(GetPVarInt(playerid, "Fly30") > gettime()) { return 0; }
     	AddCheaterID(playerid, 1);
	    SetPVarInt(playerid, "Fly30", gettime()+30);
	}
	pTemp[playerid][pSpeed0] = speed;
	if(pTemp[playerid][pTaxiGoing])
	{
		if(pTemp[playerid][pTaxiTurn][0] != INVALID_PLAYER_ID)
		{
			new gig = pTemp[playerid][pTaxiTurn][0];
			if(!IsPlayerConnected(gig) || GetPlayerVehicleID(gig) != vehicleid) pTemp[playerid][pTaxiTurn][0] = INVALID_PLAYER_ID;
		}
		if(pTemp[playerid][pTaxiTurn][1] != INVALID_PLAYER_ID)
		{
			new gig = pTemp[playerid][pTaxiTurn][1];
			if(!IsPlayerConnected(gig) || GetPlayerVehicleID(gig) != vehicleid) pTemp[playerid][pTaxiTurn][1] = INVALID_PLAYER_ID;
		}
		new passid = pTemp[playerid][pTaxiPass];
		if(!IsPlayerConnected(passid) || passid == INVALID_PLAYER_ID)
		{
			pTemp[playerid][pTaxiGoing] = false;
			pTemp[playerid][pTaxiPass] = INVALID_PLAYER_ID;
			pTemp[playerid][pTaxiStart] = 0.0;
		}
		else
		{
			new sum = floatround((gVehicles[vehicleid-1][vDrived] - pTemp[playerid][pTaxiStart])*pTemp[playerid][pTaxiPrice]);
			if(GetPlayerState(passid) == PLAYER_STATE_PASSENGER && GetPlayerVehicleID(passid) == vehicleid)
			{
				new mes[24];
				format(mes,sizeof(mes),"~w~$%d",sum);
				GameTextForPlayer(playerid,mes,300,4);
				GameTextForPlayer(passid,mes,300,4);
				if(GetPlayerMoneyEx(passid) < sum)
				{
					SendClientMessage(passid,CGRAY,"Недостаточно денег для проезда на такси");
					if(GetPlayerMoneyEx(passid) - sum > -5 && sum > 0)
					{
					    pData[passid][pMoney] -= sum;
					    pData[playerid][pMoney] += sum;
					}
					pTemp[playerid][pTaxiGoing] = false;
					pTemp[playerid][pTaxiPass] = INVALID_PLAYER_ID;
					passid = INVALID_PLAYER_ID;
					pTemp[playerid][pTaxiStart] = 0.0;
					RemovePlayerMapIcon(playerid,iconTaxi);
					RemovePlayerMapIcon(passid,iconTaxi);
					RemovePlayerFromVehicle(passid);
					return 1;
				}
			}
			else
			{
				pTemp[playerid][pTaxiGoing] = false;
				pTemp[playerid][pTaxiPass] = INVALID_PLAYER_ID;
				pTemp[playerid][pTaxiStart] = 0.0;
				RemovePlayerMapIcon(playerid,iconTaxi);
				RemovePlayerMapIcon(passid,iconTaxi);
				if(sum > 0)
				{
	    			pData[passid][pMoney] -= sum;
				    pData[playerid][pMoney] += sum;
				}
				passid = INVALID_PLAYER_ID;
			}
		}
		if(passid == INVALID_PLAYER_ID && pTemp[playerid][pTaxiTurn][0] != INVALID_PLAYER_ID)
		{
			passid = pTemp[playerid][pTaxiTurn][0];
			if(IsPlayerConnected(passid) && GetPlayerVehicleID(passid) == vehicleid)
			{
				if(GetPlayerMoneyEx(passid) < pTemp[playerid][pTaxiPrice])
				{
					SendClientMessage(passid,CGRAY,"Недостаточно денег для проезда на такси");
					return RemovePlayerFromVehicle(passid);
				}
				pTemp[playerid][pTaxiStart] = gVehicles[vehicleid-1][vDrived];
				pTemp[playerid][pTaxiPass] = passid;
				pTemp[playerid][pTaxiGoing] = true;
				pTemp[playerid][pTaxiTurn][0] = INVALID_PLAYER_ID;
				new mes[128];
				format(mes,sizeof(mes),"Теперь за проезд будет платить {"#cWHITE"}%s",pData[passid][pNickname]);
				SendClientMessage(playerid,CINFO,mes);
				SendClientMessage(passid,CINFO,"Теперь Вы платите за проезд");
			}
			else pTemp[playerid][pTaxiTurn][0] = INVALID_PLAYER_ID;
		}
		if(pTemp[playerid][pTaxiTurn][1] != INVALID_PLAYER_ID && pTemp[playerid][pTaxiTurn][0] == INVALID_PLAYER_ID) {pTemp[playerid][pTaxiTurn][0] = pTemp[playerid][pTaxiTurn][1]; pTemp[playerid][pTaxiTurn][1] = INVALID_PLAYER_ID;}
	}
	if(pTemp[playerid][pFilling] && IsPlayerInAnyVehicle(playerid))
	{
		new newkeys,ud,lr;
		GetPlayerKeys(playerid,newkeys,ud,lr);
		if(lr > 0)
		{
			new tank = gTransport[GetVehicleModel(vehicleid) - 400][trTank];
			pTemp[playerid][pFillingAccel] += 0.1;
			pTemp[playerid][pFillingSpeed] += pTemp[playerid][pFillingAccel];
			if(pTemp[playerid][pFillingAmount] + pTemp[playerid][pFillingSpeed] <= tank ) pTemp[playerid][pFillingAmount] = pTemp[playerid][pFillingSpeed] + pTemp[playerid][pFillingAmount];
			else pTemp[playerid][pFillingAmount] = tank;
			PlayerTextDrawBoxColor(playerid, pTemp[playerid][pFillingBar][1], 0x33AA33AA);
			PlayerTextDrawShow(playerid,pTemp[playerid][pFillingBar][1]);
			PlayerTextDrawBoxColor(playerid,pTemp[playerid][pFillingBar][2], -16777182);
			PlayerTextDrawShow(playerid,pTemp[playerid][pFillingBar][2]);
			UpdateFillingBar(playerid,vehicleid);
		}
		else if(lr < 0)
		{
			pTemp[playerid][pFillingAccel] += 0.1;
			pTemp[playerid][pFillingSpeed] += pTemp[playerid][pFillingAccel];
			if(pTemp[playerid][pFillingAmount] - pTemp[playerid][pFillingSpeed] > gVehicles[vehicleid-1][vFuel]) pTemp[playerid][pFillingAmount] -= pTemp[playerid][pFillingSpeed];
			else pTemp[playerid][pFillingAmount] = gVehicles[vehicleid-1][vFuel];
			PlayerTextDrawBoxColor(playerid, pTemp[playerid][pFillingBar][2], 0xFF0000AA);
			PlayerTextDrawShow(playerid,pTemp[playerid][pFillingBar][2]);
			PlayerTextDrawBoxColor(playerid,pTemp[playerid][pFillingBar][1], 866792226);
			PlayerTextDrawShow(playerid,pTemp[playerid][pFillingBar][1]);
			UpdateFillingBar(playerid,vehicleid);
			/*
			new fillingid = pTemp[playerid][pFillingID]-1;
			new markid = pTemp[playerid][pFillingMark]-1;
			new mes[128];
			format(mes,sizeof(mes),"filling: %d, amount: %.2f, fuel: %.2f, speed: %.1f, acc: %.1f",gFillings[fillingid][fillFuel][markid],pTemp[playerid][pFillingAmount],gVehicles[vehicleid-1][vFuel],pTemp[playerid][pFillingSpeed],pTemp[playerid][pFillingAccel]);
			SendClientMessage(playerid,CWHITE,mes);*/
		}
		else
		{
			pTemp[playerid][pFillingSpeed] = 0.0;
			pTemp[playerid][pFillingAccel] = 0.0;
			PlayerTextDrawBoxColor(playerid,pTemp[playerid][pFillingBar][1], 866792226);
			PlayerTextDrawBoxColor(playerid,pTemp[playerid][pFillingBar][2], -16777182);
			PlayerTextDrawShow(playerid,pTemp[playerid][pFillingBar][1]);
			PlayerTextDrawShow(playerid,pTemp[playerid][pFillingBar][2]);
		}
		if(ud < 0) // вверх
		{
			pTemp[playerid][pFillingAmount] = gVehicles[vehicleid-1][vFuel];
			UpdateFillingBar(playerid,vehicleid);
		}
		else if(ud > 0) // вниз
		{
   			pTemp[playerid][pFillingAmount] = gVehicles[vehicleid-1][vFuel];
			UpdateFillingBar(playerid,vehicleid);
		}
	}
	if(speed >= 10 && !pTemp[playerid][pDialog] && !IsKicked(playerid) && pData[playerid][pAdmin] == 0) {
		if(pTemp[playerid][pBusID] != vehicleid && vehicleid >= aBus[0] && vehicleid <= aBus[1]) {
			AddCheaterID(playerid,1);
		}
		if(pTemp[playerid][pTruckID] != vehicleid && vehicleid >= aTruck[0][0] && vehicleid <= aTruck[2][1]) {
			AddCheaterID(playerid,1);
		}
		if(pTemp[playerid][pTaxiID] != vehicleid && vehicleid >= vehicleid >= aTaxi[0] && vehicleid <= aTaxi[2]) {
			AddCheaterID(playerid,1);
		}
		if(pTemp[playerid][pMechID] != vehicleid && vehicleid >= aMech[0] && vehicleid <= aMech[1]) {
			AddCheaterID(playerid,1);
		}
		if(pTemp[playerid][pDFTID] != vehicleid && vehicleid >= aProduct[0] && vehicleid <= aProduct[1]) {
			AddCheaterID(playerid,1);
		}
	}
	pTemp[playerid][pLastTick2] = GetTickCount();
	return 1;
	/*new panels,doors,lights,tires;
	GetVehicleDamageStatus(vehicleid,panels,doors,lights,tires);
	printf("Vehicle Status : [Panels] : %d - [Doors] : %d - [Lights] : %d - [Tires] : %d",panels,doors,lights,tires);*/
}

public FuelTimer()
{
	for(new i;i<MAX_VEHICLES;i++)
	{
		if(GetEngineStat(i+1) > 0)
		{
			if(gVehicles[i][vFuel] >= 1.0) gVehicles[i][vFuel] -= 1.0;
			else gVehicles[i][vFuel] = 0;
		}
	}
}

public MinuteTimer()
{
	UpdateEconomic(); //Расчет экономики
	for(new i;i<MAX_PLAYERS;i++)
	{
		if(!IsPlayerConnected(i) || !pTemp[i][pLogined]) continue;
		if(pData[i][pMut])
		{
			pData[i][pMut]--;
			UpdatePlayerData(i,"mut",pData[i][pMut]);
			if(!pData[i][pMut]) SendClientMessage(i,CGREEN,"Вы снова можете использовать чат");
		}
		if(pData[i][pExam])
		{
			pData[i][pExam]--;
			UpdatePlayerData(i,"pExam",pData[i][pExam]);
		}
		if(pData[i][pExamM])
		{
			pData[i][pExamM]--;
			UpdatePlayerData(i,"pExamM",pData[i][pExamM]);
		}
		if(pTemp[i][pNotReport]) pTemp[i][pNotReport]--;
		if(pTemp[i][pNotFMReport]) pTemp[i][pNotFMReport]--;
		if(pData[i][pAdmin] >= 1 && pTemp[i][pAFK] == 0) pData[i][pAdmintime]++,UpdatePlayerData(i,"admintime",pData[i][pAdmintime]);
		if(pTemp[i][pTakeGun]) pTemp[i][pTakeGun]--;
		if(pTemp[i][pEconomicLog])
		{
			new mes[128],CT;
			CT = floatround(1000 * (1 - (float(gGunWorkWH[0]) / gGunWorkWH[1])));
			format(mes,sizeof(mes),"k = %.2f; C1 = %d; C2 = %d; C3 = %d; CoalTruck = %d;",economicFactor,gWorkSalary[0],gWorkSalary[1],gWorkSalary[2],CT);
			SendClientMessage(i,CSYSTEM,mes);
		}
	}
}

