 		MPstatus = 0;
 		SendClientMessage(playerid,CGRAY,"Вы закрыли телепорт на мероприятие");
	}
  	if(!strcmp(cmd,"/mp",true))
	{
	    if(pData[playerid][pJail] != 0) return SendClientMessage(playerid,CWHITE,"• {AC0000}[Ошибка] {ffffff}Команда не доступна в тюрьме");
 		if(MPstatus == 0) return SendClientMessage(playerid,CWHITE,"• {AC0000}[Ошибка] {"#cW"}В данный момент не проводится мероприятие либо все места заняты");
 		if(MPnow > MPpersons) return MPnow = 0,MPpersons = 0,MPstatus = 0;
		SetPlayerPos(playerid,MPx,MPy,MPz);
		SetPlayerVirtualWorld(playerid,MPworld);
		SetPlayerInterior(playerid,MPint);
		pTemp[playerid][pOnmp] = 1;
		if(pTemp[playerid][pOnmp] == 1) {
		MPnow += 1;
		pTemp[playerid][pOnmp] = 1; }
		SendClientMessage(playerid,CWHITE,"• {FFC800}[Подсказка]{"#cW"} Вы были телепортированы на мероприятие");
	}
	if(!strcmp(cmd,"/banip",true))
	{
	    new mes[128],string[140],playersip[32],zvezda;
		if(pData[playerid][pAdmin] < 8) return 1;
		tmp = strrest(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_WHITE, "[{FFA500}Admin-Helper{FFFFFF}] /banip [IP адрес]");
		for(new i = !strlen(tmp); i != 0; --i)
		{
  			if(tmp[i] == '*') zvezda++;
		}
		if(zvezda > 0) return SendErr(playerid, "Нельзя звёздочки!");
		foreach(Player,i)
		{
  			if(pData[i][pAdmin] > 5)
	    	{
      			GetPlayerIp(i,playersip,sizeof(playersip));
		 		if(!strcmp(tmp, playersip, true)) return SendErr(playerid, "Данный IP Адрес нельзя забанить.");
	    	}
		}
		format(mes,sizeof(mes),"banip %s",tmp);
  		SendRconCommand(mes);
  		format(string, sizeof(string), "(A) Администратор %s[%d] заблокировал IP: %s",pData[playerid][pNickname],playerid,tmp);
		AdminChat(COLOR_GREY,string);
	    SendRconCommand("reloadbans");
     	new stringer[255];
		format(stringer, sizeof(stringer), "Администратор %s заблокировал IP: %s",pData[playerid][pNickname],tmp);
		SendLog(stringer);
	}
	if(!strcmp(cmd,"/unbanip",true))
		{
		if(pData[playerid][pAdmin] < 8) return 1;
		tmp = strrest(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_WHITE, "[{FFA500}Admin-Helper{FFFFFF}] /unbanip [IP адрес]");
		new mes[128],string[140];
		format(mes,sizeof(mes),"unbanip %s",tmp);
  		SendRconCommand(mes);
	    format(string, sizeof(string), "(A) Администратор %s[%d] разблокировал IP: %s",pData[playerid][pNickname], playerid, tmp);
		AdminChat(COLOR_GREY,string);
	    SendRconCommand("reloadbans");
		new stringer[255];
		format(stringer, sizeof(stringer), "Администратор %s разбанил IP: %s",pData[playerid][pNickname], tmp);
		SendLog(stringer);
	}
	if(!strcmp(cmd,"/gethere",true))
	{
	    new string[128];
        if(pData[playerid][pAdmin] < 5) return 1;
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_WHITE, "[{FFA500}Admin-Helper{FFFFFF}] /gethere (ID - игрока)");
        new id = strval(tmp);
        if(!IsPlayerConnected(id)) return SendClientMessage(playerid, COLOR_GREY, "Неверный ID");
        if(!pData[id][pMysqlID]) return SendClientMessage(playerid,CGRAY,"Игрок еще не авторизовался");
        if(pData[playerid][pAdmin] <= 9 && gethereme[id] == 1) return SendClientMessage(playerid,COLOR_GREY,"Администратор запретил к нему телепортироваться");
		if(pTemp[id][pSpecOn] == 1) return SendClientMessage(playerid,CRED,"Игрок находится в наблюдении");
		if(pData[id][pAdmin] > pData[playerid][pAdmin]) return SendClientMessage(playerid,CGRAY,"Невозможно");
		new Float:plocx,Float:plocy,Float:plocz;
		GetPlayerPos(playerid, plocx, plocy, plocz);
		SetPlayerPos(id, plocx,plocy+2, plocz);
		SetPlayerVirtualWorld(id, GetPlayerVirtualWorld(playerid));
		SetPlayerInterior(id, GetPlayerInterior(playerid));
		SendMes(id, -1, "Администратор %s[%d] телепортировал Вас к себе", pData[playerid][pNickname], playerid);
		format(string, 128, "(A) %s[%d] телепортировал к себе игрока %s[%d]",pData[playerid][pNickname], playerid, pData[id][pNickname],id);
		AdminChat(CGRAY, string);
		pTemp[id][pSelectedBusinessID] = pTemp[playerid][pSelectedBusinessID];
	}
	if(!strcmp(cmd, "/setstat", true))
	{
     	if(strcmp(pData[playerid][pNickname], FD1, true)!=0) return 1;
     	tmp = strtok(cmdtext, idx);
		if(!strlen(tmp) || !isNumeric(tmp))
		{
			SendClientMessage(playerid, CGRAY, "{FFFFFF}• {FFC800}[Подсказка] {"#cWHITE"}/setstat (ID - игрока) [Номер данных] [Значение]");
			SendClientMessage(playerid, CGRAY, "[1] Пол [2] Возраст [3] Работа [4] Скин [5] Деньги [6] Банк");
		    SendClientMessage(playerid, CGRAY, "[7] Уровень [8] Exp [9] Номер телефона [10] Наркотики");
		    SendClientMessage(playerid, CGRAY, "[11] Патроны [12] Ед.оружия [13] Фракционный скин");
			return 1;
		}
		new i = strval(tmp);
		if(!IsPlayerConnected(i)) return SendClientMessage(playerid, CGRAY, "Указанный игрок не найден.");
		tmp = strtok(cmdtext, idx);
		new set = strval(tmp);
		tmp = strtok(cmdtext, idx);
		new value = strval(tmp);
		new zStr[100];
		switch(set)
		{
		    case 1:
			{
			    if(value < 1 || value > 2) return SendClientMessage(playerid, CGRAY, "{FFFFFF}• {FFC800}[Подсказка] {"#cWHITE"}1) Мужской 2) Женский");
   			    pData[i][pSex] = value;
			    UpdatePlayerData(i,"sex",pData[i][pSex]);
			    new otext[250];
			    switch(value)
			    {
			    	case 1: { otext = "Мужской"; }
				    case 2: { otext = "Женский"; }
			    }
			    format(zStr, 100, "{FFFFFF}• {33AA33}[Успешно] {"#cWHITE"}Пол игрока %s, изменен на %s", pData[i][pNickname], otext);
			    SendClientMessage(playerid, CWHITE, zStr);
			}
			case 2:
			{
			    if(value < 18 || value > 120) return SendClientMessage(playerid,CGRAY,"Возраст не может быть менее 18 и более 120");
                pData[i][pAge] = value;
			    UpdatePlayerData(i,"age",pData[i][pAge]);
			    format(zStr, 100, "{FFFFFF}• {33AA33}[Успешно] {"#cWHITE"}Возраст игрока %s, изменен на %d лет(года)", pData[i][pNickname], value);
			    SendClientMessage(playerid, CWHITE, zStr);
			}
			case 3:
			{
			    if(value < 0 || value > 6) return SendClientMessage(playerid,COLOR_WHITE,"• {FFC800}[Подсказка] {"#cWHITE"}1) Водитель автобуса 2) Дальнобой 3) Таксист 4) Механик 5) Развозчик продуктов");
			    pData[i][pJob] = value;
			    UpdatePlayerData(i,"job",pData[i][pJob]);
			    new otext[250];
			    switch(value)
			    {
			        case 0: { otext = "Безработный"; }
			    	case 1: { otext = "Водитель автобуса"; }
				    case 2: { otext = "Дальнобой"; }
				    case 3: { otext = "Таксист"; }
                    case 4: { otext = "Механик"; }
				    case 5: { otext = "Развочик продуктов"; }
			    }
			    format(zStr, 100, "• {33AA33}[Успешно] {"#cWHITE"}Место работы игрока %s, изменено на %s", pData[i][pNickname], otext);
			    SendClientMessage(playerid, CWHITE, zStr);
			}
			case 4:
			{
			    if(value < 1 || value > 311) return SendClientMessage(playerid,CGRAY,"ID скина от 1 до 311");
				pData[i][pSkin] = value;
			    UpdatePlayerData(i,"skin",pData[i][pSkin]);
			    format(zStr, 100, "• {33AA33}[Успешно] {"#cWHITE"}Скин игрока %s, изменен на %d", pData[i][pNickname], value);
			    if(!pData[i][pFraction]) SetPlayerSkin(i, value);
			    SendClientMessage(playerid, CWHITE, zStr);
			}
			case 5:
			{
			    if(value < 1 && pData[playerid][pMysqlID] != 1 || value > 5000000 && pData[playerid][pMysqlID] != 1) return SendClientMessage(playerid,CGRAY,"Деньги можно выдавать до 5кк");
			    format(zStr, 100, "• {33AA33}[Успешно] {"#cWHITE"}Кол-во денег у %s, изменено на %d$", pData[i][pNickname], value);
			    SendClientMessage(playerid, CWHITE, zStr);
			    pData[i][pMoney] = value;
				ResetPlayerMoney(i); GivePlayerMoney(i,pData[i][pMoney]);
				UpdatePlayerData(i,"money",pData[i][pMoney]);
			}
