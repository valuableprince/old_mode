			if(zcdm == 2) { object[playerid] = CreateObject(994, x, y, z-1.0, 0, 0, angle); }
			if(zcdm == 3) { object[playerid] = CreateObject(1423, x, y, z-0.2, 0, 0, angle); }
			if(zcdm == 4) { object[playerid] = CreateObject(1422, x, y, z-0.49, 0, 0, angle); }
