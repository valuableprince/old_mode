CheckFireArm(weaponid) {
	switch(weaponid) {
		case 16..39, 41..43: return 1;
		default: return 0;
	}
	return 0;
}

public OnPlayerUpdate(playerid)
{
    if(pTemp[playerid][pTazer] > 0)
	{
		GoAnim(playerid,"CRACK","Crckidle2",4.1,1,0,0,0,0,0);
		TogglePlayerControllable(playerid, 0);
		SetTimerEx("Unfreez",15000,false,"i",playerid);
	}
	//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~[ Кейс ]~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	new weaponida = GetPlayerWeapon(playerid);
	if(pData[playerid][pMoney] > 999999 && !IsPlayerInAnyVehicle(playerid) && weaponida == 0){SetPlayerAttachedObject(playerid,3,1210,5,0.299999,0.099999,0.000000,0.000000,-83.000000,0.000000,1.000000,1.000000,1.000000);}
	else{RemovePlayerAttachedObject(playerid,3);}
	//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	//~~~~~~~~~~~~~~~~~~~~~~~~~~~~[ Анти метла ]~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	if(GetPlayerAnimationIndex(playerid) == 1058 && GetPlayerState(playerid) != 9 && !IsPlayerInAnyVehicle(playerid) && GetPlayerSpeed(playerid) > 8 && pData[playerid][pAdmin] == 0)
	{
		AddCheaterID(playerid,0);
		if(GetPlayerSpeed(playerid) > 15)
		{
 		SendClientMessage(playerid, CORANGE, "Вы были кикнуты по подозрению в читерстве (#027)");
      	NewKick(playerid);
      	}
	}
	//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	//~~~~~~~~~~~~~~~~~~~~~~~~~~~~[ Анти чит на деньги ]~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	if(pData[playerid][pMoney] != GetPlayerMoney(playerid))
	{
 		ResetPlayerMoney(playerid);
		GivePlayerMoney(playerid,pData[playerid][pMoney]);
	}
	//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	//~~~~~~~~~~~~~~~~~~~~~~~~~~~~[ Режим /sp ]~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	if(pTemp[playerid][pSpectating])
	{
 	UpdateSpectating(playerid);
	}
	//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	//~~~~~~~~~~~~~~~~~~~~~~~~~~~~[ Анти JetPack ]~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	if (GetPlayerSpecialAction(playerid) == SPECIAL_ACTION_USEJETPACK && pData[playerid][pAdmin] == 0)
	{
 		SendClientMessage(playerid, COLOR_GREY, "Вы были забанены на 30 дней за использование JetPack (#225)");
 		ServerBan(-1,playerid,30,"JetPack");
	 	new stringer[255];
		format(stringer, sizeof(stringer), "%s был забанен за JetPack. IP: %s",pData[playerid][pNickname],pData[playerid][pLastIP]);
		SendLog(stringer);
      	NewKick(playerid);
	}
	//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	//~~~~~~~~~~~~~~~~~~~~~~~~~~~~[ Анти Аирбркйк ]~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	new mesfly[135];
   	new Float:Zfly; new animfly = GetPlayerAnimationIndex(playerid); new pdame[MAX_PLAYER_NAME];
    GetPlayerName(playerid, pdame, sizeof(pdame)); GetPlayerPos(playerid,Zfly,Zfly,Zfly);
    if((animfly == 1538 || animfly == 1539 || animfly == 1543) && Zfly > 4 && (playerid) > 10)
	{
   		if(pData[playerid][pAdmin] < 1)
		{
			format(mesfly,sizeof(mesfly),"[Античит] %s был кикнут по подозрению в FlyHack",pData[playerid][pNickname]);
	  		AdminChat(0xff0000ff,mesfly);
	    	SendClientMessage(playerid, CORANGE, "Вы кикнуты по подозрению в читерстве (#651)");
	     	NewKick(playerid);
   		}
 	}
	//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	if(pData[playerid][pAdmin] < 1)
	{
		new Float:healthpl[MAX_PLAYERS];
		GetPlayerHealth(playerid,healthpl[playerid]);
		if(pData[playerid][pHealth] != healthpl[playerid]) pData[playerid][pHealth] = healthpl[playerid];
		if(healthpl[playerid] > 350) return SendClientMessage(playerid,-1,"Вы были кикнуты по подозрению в читерстве"),NewKick(playerid);
 	}
	//~~~~~~~~~~~~~~~~~~~~~~~~~~~~[ Система AFK ]~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	if(pTemp[playerid][pIsAFK])
