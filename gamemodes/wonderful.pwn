	if(!strcmp(cmd,"/med",true))
	{
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp) || !isNumeric(tmp)) return SendClientMessage(playerid,CGRAY,"• {FFC800}[Подсказка]: {"#cWHITE"}/med (ID - игрока)");
		new actplayerid = strval(tmp);
		if(!IsPlayerConnected(actplayerid)) return SendClientMessage(playerid,CGRAY,"Неверный ID игрока");
		if(GetPlayerDistanceToPlayer(playerid,actplayerid) > 3.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(actplayerid)) return SendClientMessage(playerid,CGRAY,"Вы далеко друг от друга");
		new mes[256];
		format(mes,sizeof(mes),"Вы предложили {"#cWHITE"}%s {"#cINFO"} показать медицинскую карту",pData[actplayerid][pNickname]);
		SendClientMessage(playerid,CINFO,mes);
		format(mes,sizeof(mes),"%s {"#cINFO"}хочет показать медицинскую карту. Что бы подтвердить нажмите {"#cGREEN"}Y{"#cINFO"}, иначе {"#cRED"}N",pData[playerid][pNickname]);
		SendClientMessage(actplayerid,CWHITE,mes);
		pTemp[actplayerid][pShowMedpl] = playerid;
		pTemp[actplayerid][pShowMedct] = actplayerid;
	}
	if(!strcmp(cmd,"/fwarn",true))
	{
	    if(pData[playerid][pAdmin] > 7 && pData[playerid][pAdmin] < 7) return SendClientMessage(playerid,CGRAY,"Недоступно");
  		if(!IsALeader(playerid)) return SendErr(playerid, "Вам недоступна данная функция");
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp) || !isNumeric(tmp)) return SendClientMessage(playerid,CGRAY,"• {FFC800}[Подсказка]: {"#cWHITE"}/fwarn (ID - игрока) (причина)");
		new id = strval(tmp);
		if(!IsPlayerConnected(id) || IsKicked(id)) return SendClientMessage(playerid,CGRAY,"Неверный ID");
		if(pData[id][pFraction] != pData[playerid][pFraction] || pData[id][pSubfraction] != pData[playerid][pSubfraction]) return SendClientMessage(playerid,CGRAY,"Игрок не состоит в вашей организации");
		if(id == playerid) return SendClientMessage(playerid,CGRAY,"Нельзя указывать свой ID");
		if(!pData[id][pMysqlID]) return SendClientMessage(playerid,CGRAY,"Этот игрок не зарегистрирован");
		tmp = strrest(cmdtext, idx);
		if(!strlen(tmp)) return SendPods(playerid, "/fwarn (ID - игрока) (причина)");
		new mes[128];
		pData[id][pTWarn] = pData[id][pTWarn]+1;
		new koll = pData[id][pTWarn];
		if(koll < 3)
  		format(mes,sizeof(mes),"Вы получили выговор (%d/3) от %s. Причина: %s",koll,pData[playerid][pNickname],tmp);
		SendClientMessage(id,CBADINFO,mes);
		format(mes,sizeof(mes),"%s получил выговор от %s (%d/3). Причина: %s",pData[id][pNickname],pData[playerid][pNickname],koll,tmp);
		SendFMes(pData[playerid][pFraction],CBLUE, mes);
		format(mes,sizeof(mes),"%s получил выговор (%d/3). Причина: %s",pData[id][pNickname],koll,tmp);
		SendClientMessage(playerid,CINFO,mes);
		pData[id][pTWarn] = koll;
		UpdatePlayerData(id,"TWarn",pData[id][pTWarn]);
		if(koll == 3)
		{
			pData[id][pTWarn] = 0;
			UpdatePlayerData(id,"TWarn",pData[id][pTWarn]);
			new query[128];
			format(query,sizeof(query),"UPDATE `aplayerakk` SET `fraction` = '0', `rank` = '0', `fractionskin` = '0', `subfraction` = '0' WHERE `id` = '%d'",pData[id][pMysqlID]);
			sql_query(snow, query, QUERY_THREADED);
			ResetPlayerWeaponsEx(id);
			pData[id][pFraction] = 0;
			pData[id][pRank] = 0;
			pData[id][pFractionSkin] = 0;
			pData[id][pSubfraction] = 0;
			ResetPlayerWeaponsEx(id);
			SetPlayerColor(id,0xFFFFFF11);
			new houseid = pData[id][pHouse]-1;
			if(!(houseid+1) || ((houseid+1) > 0 && pData[id][pMysqlID] != gHouses[houseid][houseOwnerID])) SetPlayerSkin(id,pData[id][pSkin]);
			else if(!gHouses[houseid][houseImprove][3]) SetPlayerSkin(id,pData[id][pSkin]);
			else
			{
				for(new x; x < 3; x ++) {
					if(!gHouses[houseid][houseSkin]) continue;
					pData[id][pSkin] = gHouses[houseid][houseSkin];
					if(GetPlayerSkin(id) == gHouses[houseid][houseSkin][3]) SetPlayerSkin(id,pData[id][pSkin]);
				}
				gHouses[houseid][houseSkin][3] = 0;

				UpdateHouseDress(houseid);
			}
			SetPlayerSkin(id,pData[id][pSkin]);
			format(mes,sizeof(mes),"%s уволил Вас из организации. Причина: %s",pData[playerid][pNickname], tmp);
			SendClientMessage(id,CBADINFO,mes);
			format(mes,sizeof(mes),"%s получил выговор от %s (3/3). Причина: %s",pData[id][pNickname],pData[playerid][pNickname],tmp);
			SendFMes(pData[playerid][pFraction],CBLUE, mes);
			format(mes,sizeof(mes),"%s был уволен из организации. Причина: %s",pData[id][pNickname], tmp);
			SendClientMessage(playerid,CINFO,mes);
		}
		return 1;
	}
