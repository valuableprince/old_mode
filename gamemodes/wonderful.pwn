stock ToDevelopSkills(Slashes,Points)
{
	new strign[149];
	new Slash[2] = "|";
	new Point[2] = ".";
	for(new i = 0; i < Slashes; i++) strcat(strign, Slash);
	for(new i = 0; i < Points; i++) strcat(strign, Point);
	return strign;
}

forward UpdateCheaterID();
public UpdateCheaterID()
{
	new str[16];
	for(new i=9;i!=0;i--)
	{
  		CheaterID[0][i] = CheaterID[0][i-1],CheaterID[1][i] = CheaterID[1][i-1],GunCheaterID[i] = GunCheaterID[i-1];
		if(GunCheaterID[i] > -1) { format(str, sizeof(str), "~g~%d", GunCheaterID[i]),TextDrawSetString(CheatShow[0][i],str); }
		format(str, sizeof(str), "%d", CheaterID[0][i]),TextDrawSetString(CheatShow[0][i],str);
		format(str, sizeof(str), "%d", CheaterID[1][i]),TextDrawSetString(CheatShow[1][i],str);
	}
}
AddCheaterID(playerid, strokaID)
{
	new str[16];
    for(new i; i < 10; i++) if(CheaterID[strokaID][i] == playerid) return 1;
	CheaterID[strokaID][0] = playerid;
	format(str, sizeof(str), "%d", CheaterID[strokaID][0]);
	TextDrawSetString(CheatShow[strokaID][0],str);
	return 1;
}

AddGunCheaterID(playerid)
{
	new str[16];
    for(new i; i < 10; i++) if(GunCheaterID[i] == playerid) return 1;
    for(new i; i < 10; i++)
    {
	GunCheaterID[i] = playerid;
	format(str, sizeof(str), "~g~%d", GunCheaterID[i]);
	TextDrawSetString(CheatShow[0][i],str);
	}
	return 1;
}

stock NoRoof(playerid)
{
    new carid = GetPlayerSurfingVehicleID(playerid);
    if(carid != INVALID_VEHICLE_ID )
    {
        new cm=GetVehicleModel(carid);
        switch(cm)
        {
        case 406,422,455,478,554,430,446,452,453,454,472,473,484,493,595:{return 1;}
        default:{}
        }
        new Float:slx, Float:sly, Float:slz;
        GetPlayerPos(playerid, slx, sly, slz);
        SetPlayerPos(playerid, slx, sly+2.5, slz);
    }
    return 1;
}

