			if(id < 0) return 1;
			new products = strval(inputtext);
			if(products < 1 || products > 200) return SendClientMessage(playerid,-1,"• {AC0000}[Ошибка] {"#cW"}Вы можете купить не менее 1 и не более 200 продуктов за раз");
			SetPVarInt(playerid,"grocerproducts",products);
