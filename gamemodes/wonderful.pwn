	if(PRESSED(KEY_FIRE))
	{
		if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
		{
			if(GetPlayerVehicleID(playerid)) ToggleLamp(GetPlayerVehicleID(playerid));
		}
	}
	return 1;
}

