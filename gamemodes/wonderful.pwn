		}
		format(all,sizeof(all),"Наличные: \t%s$\nБанк:\t\t%s$\n%s",money,bank,str);
		ShowPlayerDialog(playerid,dMes,0,account,all,"Закрыть","");
	}
	if(!strcmp(cmd,"/stats", true))
	{
	    tmp = strtok(cmdtext, idx);
	    new id = strval(tmp);
	    if(!strlen(tmp)) id = playerid;
	    if(id != playerid && !pData[playerid][pAdmin]) return 1;
	    if(!IsPlayerConnected(id) || IsKicked(id)) return SendClientMessage(playerid,CGRAY,"Неверный ID");
	    if(!pTemp[playerid][pLogined]) return SendClientMessage(playerid,CGRAY,"Игрок с введённым ID не залогинен.");
  		new h,m,s; gettime(h,m,s);
		new day,month,year; getdate(year,month,day);
		new sex[12],
			fraction[42],
			job[42],
			classname[20],
			bussiness[32],
			housenumber[12],
			wanted, warn,
			divrc[32],
			nation[68],
			obr[60];
		if(pData[id][pSex] == 2) sex = "Женский"; else sex = "Мужской";
		if(pData[id][pSchool] == 1) obr = "Школьное образование"; else obr = "Без образования";
		if(pData[id][pWanted]) wanted = pData[id][pWanted];
		if(pData[id][pWarnc]) warn = pData[id][pWarnc];
		if(pData[id][pJob] && !pData[id][pFraction]) format(job, 32, "%s", gJobNames[pData[id][pJob]-1]);
		if(!pData[id][pJob] && !pData[id][pFraction]) format(job, 32, "Отсутствует");
	    if(pData[id][pFraction])
		{
			new fractionid = pData[id][pFraction]-1;
			new rank = pData[id][pRank];
			strcat(fraction,gFractionName[fractionid]);
			if(pData[id][pSubfraction] > 0)
			{
				new frid = GetSubfractionID(fractionid);
				new subid = pData[id][pSubfraction]-1;
				strcat(job,gSubfractionName[frid][subid]);
				strcat(job, " / ");
			}
   			if(fractionid+1 == 11 && !pData[playerid][pSubfraction] && rank <= 9)
   				strcat(job, gPrezRankName[rank-1]);
			else strcat(job,gFractionRankName[fractionid][rank-1]);
		}
		else format(fraction, 32, "Отсутствует");
		if(pData[id][pHouse])
		{
			format(housenumber,12, "%d", pData[id][pHouse]);
			switch(gHouses[pData[id][pHouse]-1][houseClass])
			{
				case 0:classname = "[Эконом]";
				case 1:classname = "[Cредний]";
				case 2:classname = "[Элитный]";
				case 3:classname = "[Особняк]";
				default: classname = "[Неизвестно]";
			}
		}
		else format(housenumber,12, "Отсутствует");
	    switch(pData[playerid][pNation])
		{
			case 1: strcat(nation,"Американец");
			case 2: strcat(nation,"Японец");
			case 3: strcat(nation,"Итальянец");
			case 4: strcat(nation,"Мексиканец");
			case 5: strcat(nation,"Латиноамериканец");
			case 6: strcat(nation,"Испанец");
			case 7: strcat(nation,"Русский");
			case 8: strcat(nation,"Португалец");
			case 9: strcat(nation,"Француз");
			case 10: strcat(nation,"Афроамериканец");
		}
		if(pData[id][pBusiness]) {
		    new businessid = pData[id][pBusiness] - 1;
			if(businessid < FILLING_ID_OFFSET) format(bussiness,sizeof(bussiness),"%s",gBusiness[businessid][busiName]);
			else format(bussiness,sizeof(bussiness),"АЗС");
		}
		else format(bussiness,32, "Отсутствует");
        if(!pData[id][pMarried]) format(divrc,32,"Отсутствует");
		else if(pData[id][pMarried] == 1) format(divrc,32,"%s",pData[id][pDivorce]);
		new zText[1300];
        format(zText,sizeof(zText),"{"#cWHITE"}Номер аккаунта: \t\t{0099ff}%d\n{"#cWHITE"}Имя: \t\t\t\t{0099ff}%s\n{"#cWHITE"}Уровень: \t\t\t{0099ff}%d\n{"#cWHITE"}Очки опыта: \t\t\t{0099ff}%d из %d\n{"#cWHITE"}Предупреждений: \t\t{0099ff}%d\n\n{"#cWHITE"}Номер телефона \t\t{0099ff}%d\n\n{"#cWHITE"}Образование: \t\t{0099ff}%s\n\n",pData[id][pMysqlID],pData[id][pNickname],pData[id][pLevel],pData[id][pExp],pData[id][pLevel]*6,warn,pData[id][pPhone], obr);
		format(zText,sizeof(zText),"%s\n\n{"#cWHITE"}Законопослушность: \t\t{0099ff}%d\n{"#cWHITE"}Уровень розыска: \t\t{0099ff}%d\n{"#cWHITE"}Лёгких наркотиков: \t\t{0099ff}%d гр.\n{"#cWHITE"}Тяжёлых наркотиков: \t\t{0099ff}%d гр.\n{"#cWHITE"}Патроны: \t\t\t{0099ff}%d\n{"#cWHITE"}Ед. Оружия: \t\t\t{0099ff}%d\n{"#cWHITE"}Сигареты: \t\t\t{0099ff}%d",zText, pData[id][pZakon],wanted,pData[id][pDrugs],pData[id][pHarddrugs],pData[id][pAmmo],pData[id][pGunAmount],pData[id][pCiggaret]);
		format(zText,sizeof(zText),"%s\n\n{"#cWHITE"}Пол: \t\t\t\t{0099ff}%s\n{"#cWHITE"}Возраст: \t\t\t{0099ff}%d\n{"#cWHITE"}Муж/Жена: \t\t\t{0099ff}%s\n{"#cWHITE"}Национальность: \t\t{0099ff}%s{"#cWHITE"}",zText, sex,pData[id][pAge],divrc,nation);
		format(zText,sizeof(zText),"%s\n\n{"#cWHITE"}Организация: \t\t\t{0099ff}%s\n{"#cWHITE"}Работа/Должность: \t\t{0099ff}%s\n{"#cWHITE"}Ранг: \t\t\t\t{0099ff}%d\n{"#cWHITE"}Выговоров: \t\t\t{0099ff}%d",zText, fraction,job,pData[id][pRank],pData[id][pTWarn]);
		format(zText,sizeof(zText),"%s\n\n{"#cWHITE"}Дом: \t\t\t\t{0099ff}%s %s\n{"#cWHITE"}Бизнес: \t\t\t{0099ff}%s (%d)\n\n{"#cWHITE"}Woks-Token: \t\t\t{0099ff}%d шт",zText, housenumber,classname,bussiness,pData[id][pBusiness],pData[id][pWoks]);
		format(zText,sizeof(zText),"%s\n\n{"#cWHITE"}Время: \t\t\t{0099ff}%02d:%02d:%02d\n{"#cWHITE"}Дата: \t\t\t\t{0099ff}%02d.%02d.%d\n",zText, h,m,s,day,month,year);
		ShowPlayerDialog(playerid,dMes,0,"{"#cOR"}Статистика",zText,"OK","");
        return 1;
	}
	if(!strcmp(cmd,"/clear",true))
	{
		if(!IsACop(playerid) || pData[playerid][pRank] < 4) return SendErr(playerid, "Вы не можете использовать данную команду");
		tmp = strtok(cmdtext, idx);
		new id = strval(tmp);
		if(!IsPlayerConnected(id)) return SendClientMessage(playerid,CGRAY,"Неверный ID");
		if(!pData[id][pWanted]) return SendClientMessage(playerid,CGRAY,"У игрока нет розыска");
		pData[id][pWanted] = 0;
		UpdatePlayerData(id,"wanted",0);
		SetPlayerWantedLevel(id,0);
		new mes[128];
		format(mes,sizeof(mes),"%s %s снял розыск %s",gFractionRankName[pData[playerid][pFraction]-1][pData[playerid][pRank]-1], pData[playerid][pNickname],pData[id][pNickname]);
  		CopMes(CDEPARTMENT,mes);
		format(mes,sizeof(mes), "%s %s снял вам розыск",gFractionRankName[pData[playerid][pFraction]-1][pData[playerid][pRank]-1],pData[playerid][pNickname]);
		SendClientMessage(id,CDEPARTMENT,mes);
		return 1;
	}
	if(!strcmp(cmd,"/createbiz",true))
	{
	   	if(strcmp(pData[playerid][pNickname], FD1, true)!=0) return 1;
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp) || !isNumeric(tmp)) return SendPods(playerid, "/createbiz [type] [bint] [price] [name]");
		new type = strval(tmp);
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp) || !isNumeric(tmp)) return SendPods(playerid, "/createbiz [type] [bint] [price] [name]");
		new bint = strval(tmp);
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp) || !isNumeric(tmp)) return SendPods(playerid, "/createbiz [type] [bint] [price] [name]");
		new price = strval(tmp);
		new name[128];
		name = strrest(cmdtext, idx);
		if(!strlen(tmp)) return SendPods(playerid, "/createbiz [type] [bint] [price] [name]");
		sql_escape_string(snow, name, name, 24);
		new Float:x, Float:y, Float:z, Float:r;
		GetPlayerPos(playerid,x,y,z);
		GetPlayerFacingAngle(playerid,r);
		new query[256];
		format(query,sizeof(query),"INSERT INTO `business` VALUES('','%s','%d','%d','0','%d','0','0','0','1','%f','%f','%f','%f','','')",name,type,bint,price,x,y,z,r);
		sql_query(snow, query);
		CreateDynamicPickup(19132,1,x,y,z);
		SendClientMessage(playerid,CGREEN,"Бизнес создан");
	}
	if(!strcmp(cmd,"/bints",true))
	{
	    if(strcmp(pData[playerid][pNickname], FD1, true)!=0) return 1;
		if(!GetPVarFloat(playerid,"oldx")) ShowBintsDialog(playerid,dBints,"Посмотреть","Отмена");
		else
		{
			new Float:x, Float:y, Float:z;
			x = GetPVarFloat(playerid,"oldx");
			y = GetPVarFloat(playerid,"oldy");
			z = GetPVarFloat(playerid,"oldz");
			SetPlayerInterior(playerid,0);
			SetPlayerVirtualWorld(playerid,0);
			SetPlayerPos(playerid,x,y,z);
			DeletePVar(playerid,"oldx");
			DeletePVar(playerid,"oldy");
			DeletePVar(playerid,"oldz");
		}
	}
	if(!strcmp(cmd,"/quest",true))
	{
		new time[64], string[450], les[64], phone[64], shahta[64], prava[64], school[64];
		if(pData[playerid][pWatch]) time = "{00FF00}Выполнено";
		else time = "{FF0000}Не выполнено";
		if(pData[playerid][pLesoryb]) les = "{00FF00}Выполнено";
		else les = "{FF0000}Не выполнено";
		if(pData[playerid][pPhone]) phone = "{00FF00}Выполнено";
		else phone = "{FF0000}Не выполнено";
		if(pData[playerid][pShahta]) shahta = "{00FF00}Выполнено";
		else shahta = "{FF0000}Не выполнено";
		if(pData[playerid][pLicenses][LIC_DRIVING]) prava = "{00FF00}Выполнено";
		else prava = "{FF0000}Не выполнено";
		if(pData[playerid][pQSchool] == 1) school = "{00FF00}Выполнено";
		else school = "{FF0000}Не выполнено";
		format(string,sizeof(string),"1. Не теряем время \t\t\t\t[%s{FFFFFF}]\n2. Трудоголик \t\t\t\t\t[%s{FFFFFF}]\n3. Заработал и купил\t\t\t\t[%s{FFFFFF}]\n4. Великий помощник\t\t\t\t[%s{FFFFFF}]\n5. Начинающий водитель\t\t\t[%s{FFFFFF}]\n6. Вперед, за знаниями!\t\t\t[%s{FFFFFF}]", time, les, phone, shahta, prava, school);
		ShowPlayerDialog(playerid,dQuest,DIALOG_STYLE_LIST,"Доступные задания",string,"Выбрать","Отмена"); 
		return 1;
	}
	if(!strcmp(cmd,"/apanel",true))
	{
		if(pData[playerid][pAdmin] < 8) return 1;
		new string[350], tpkvam[20],spza[20],tpksebe[20],adonate2[20],aexp2[20];
		if(toggotome[playerid] == 1) tpkvam = "{FF0000}Запрещено";
		else tpkvam = "{00FF00}Разрешено";
		if(spme[playerid] == 1) spza = "{FF0000}Запрещено";
		else spza = "{00FF00}Разрешено";
		if(gethereme[playerid] == 1) tpksebe = "{FF0000}Запрещено";
		else tpksebe = "{00FF00}Разрешено";
		if(Donatex2 == 0) adonate2 = "{FF0000}Выключен";
		else adonate2 = "{00FF00}Включен";
		if(expx2 == 0) aexp2 = "{FF0000}Выключен";
		else aexp2 = "{00FF00}Включен";
		format(string,sizeof(string),"\
		1. Телепортироваться к Вам [%s{FFFFFF}]\n\
		2. Следить за Вами [%s{FFFFFF}]\n\
		3. Телепортировать Вас [%s{FFFFFF}]\n\
		4. Удвоение Доната [%s{FFFFFF}]\n\
		5. Удвоение EXP [%s{FFFFFF}]", tpkvam, spza, tpksebe, adonate2, aexp2);
		ShowPlayerDialog(playerid,dApanel,DIALOG_STYLE_LIST,"Административная панель",string,"Выбрать","Отмена");
		return 1;
	}
	if(!strcmp(cmd,"/adonate",true))
	{
	    new query[135];
		if(strcmp(pData[playerid][pNickname], FD1, true)!=0) return 1;
	  	if(Donatex2 == 0)
		{
			Donatex2 = 1;
			SendClientMessageToAll(0xF0E68CFF, "[{FFD700}Информация{FFFFFF}] {F0E68C}Уважаемые игроки! Сегодня действует акция на платные услуги. Подробности: {00CED1}/donate");
			format(query,sizeof(query),"UPDATE `serverdata` SET `donate2x` = '%d'",Donatex2);
			sql_query(snow, query);
			return 1;
		}
		if(Donatex2 == 1)
		{
			Donatex2 = 0;
			SendClientMessageToAll(0xF0E68CFF, "[{FFD700}Информация{FFFFFF}] {F0E68C}Уважаемые игроки! Акция на платные услуги отключена.");
			format(query,sizeof(query),"UPDATE `serverdata` SET `donate2x` = '%d'",Donatex2);
			sql_query(snow, query);
			return 1;
		}

	}
	if(!strcmp(cmd,"/aexp",true))
	{
	    new query[135];
		if(strcmp(pData[playerid][pNickname], FD1, true)!=0) return 1;
		if(expx2 == 0)
		{
			expx2 = 1;
			SendClientMessageToAll(0xF0E68CFF, "[{FFD700}Информация{FFFFFF}] {F0E68C}Сегодня действует акция удвоенного EXP!");
			format(query,sizeof(query),"UPDATE `serverdata` SET `exp2x` = '1'");
			sql_query(snow, query);
			SendRconCommand("hostname Wonderful Role Play | Присоединяйся к нам [X2 EXP]");
			return 1;
		}
		if(expx2 == 1)
		{
			expx2 = 0;
			SendClientMessageToAll(0x33AA33FF, "Внимание! Aкция на удвоенное EXP отключена!");
			format(query,sizeof(query),"UPDATE `serverdata` SET `exp2x` = '0'");
			sql_query(snow, query);
			SendRconCommand("hostname Wonderful Role Play | Присоединяйся к нам");
			return 1;
		}
	}
	if(!strcmp(cmd,"/payday",true))
	{
		if(strcmp(pData[playerid][pNickname], FD1, true)!=0) return 1;
		PayDayAdm();
	}
	return 1;
}

public OnPlayerEnterVehicle(playerid, vehicleid, ispassenger)
{
    NewWVehicle[playerid] = vehicleid;
    Ten[playerid] = SetTimerEx("Tuning",5000,true,"d",playerid);
	pTemp[playerid][pAbletoGun] = 2;
	if(pTemp[playerid][pCuffee] == playerid)
	{
		SendClientMessage(playerid,CGRAY,"Вы не можете сесть в т/с в наручниках");
		RemovePlayerFromVehicle(playerid);
		ClearAnimations(playerid);
		return 1;
	}
	if(!ispassenger) pTemp[playerid][pEnterVehicle] = vehicleid;
	if(vehicleid >= aBus[0] && vehicleid <= aBus[1])
	{
		new driver = gVehicleDriver[vehicleid-1];
		if(IsPlayerConnected(driver))
		{
			if(pTemp[driver][pBusID] == vehicleid)
			{
				if(ispassenger) SetVehicleParamsForPlayer(vehicleid,playerid,0,0);
				else if(playerid != driver) SetVehicleParamsForPlayer(vehicleid,playerid,0,1);
				else if(playerid == driver) SetVehicleParamsForPlayer(vehicleid,playerid,0,0);
			}
		}
	}
	return 1;
}

public OnPlayerExitVehicle(playerid, vehicleid)
{
	pTemp[playerid][pAbletoGun] = 2;
	new string[90];
	new id = GetPVarInt(playerid, "vehid");
	if(id > 0) {
		GetVehiclePos(id, gVehicles[id - 1][vX], gVehicles[id - 1][vY], gVehicles[id - 1][vZ]);
		GetVehicleZAngle(id, gVehicles[id - 1][vA]);
	}
	incar_player[GetPlayerVehicleID(playerid)] == false;
	if(GetPVarInt(playerid, "BeltStatus") == 1)
	{
		SetPVarInt(playerid, "BeltStatus", 0);
		if(IsABikes(vehicleid) || IsAMoped(vehicleid))
		{
			RemovePlayerAttachedObject(playerid, 3);
			//GameTextForPlayer(playerid, "~r~Helmet Shot", 5000, 3);
			SetPlayerChatBubble(playerid, "снял шлем", CPINK, 13.0, 10000);
			format(string,sizeof(string),"снял шлем",pData[playerid][pNickname]);
			MeAction(playerid,string);
		}
		else
		{

		    //GameTextForPlayer(playerid, "~r~Belt Unfastened", 5000, 3);
			SetPlayerChatBubble(playerid, "расстегнул ремень безопасности", CPINK, 13.0, 10000);
			format(string,sizeof(string),"расстегнул ремень безопасности",pData[playerid][pNickname]);
			MeAction(playerid,string);
		}
	}
	return 1;
}

public OnPlayerStateChange(playerid, newstate, oldstate)
{
	switch(GetVehicleModel(playerid))
	{
	    case 400,409,516,517,526,535,551,575,576,579,599:{ MaxSpeed[playerid] = 88; } // 88
	    case 401,466:{ MaxSpeed[playerid] = 82; }// 82
	    case 402,477:{ MaxSpeed[playerid] = 104; } // 104
	    case 403,433,471,532,601:{ MaxSpeed[playerid] = 61; } // 61
	    case 404:{ MaxSpeed[playerid] = 74; }// 74
	    case 405,445,518,542:{ MaxSpeed[playerid] = 91; } // 91
	    case 410:{ MaxSpeed[playerid] = 72; } // 72
	    case 411:{ MaxSpeed[playerid] = 123; } // 123
	    case 412,439,560,534,602,603:{ MaxSpeed[playerid] = 94; }// 94
	    case 415,451:{ MaxSpeed[playerid] = 108; } // 108
	    case 416,421:{ MaxSpeed[playerid] = 86; }// 86
	    case 419,436,474,527,529,540,546:{ MaxSpeed[playerid] = 83; }// 83
	    case 420,550,568:{ MaxSpeed[playerid] = 81; }// 81
	    case 422,467,489,492,500:{ MaxSpeed[playerid] = 78; }// 78
	    case 424:{ MaxSpeed[playerid] = 75; }// 75
	    case 426,522,596,597,598:{ MaxSpeed[playerid] = 98; }// 98
	    case 427,507,565,587:{ MaxSpeed[playerid] = 92; }// 92
	    case 429,541:{ MaxSpeed[playerid] = 113; } // 113
	    case 434:{ MaxSpeed[playerid] = 93; } // 93
	    case 438,505,515,547:{ MaxSpeed[playerid] = 79; } // 79
	    case 440,582:{ MaxSpeed[playerid] = 76; } // 76
	    case 461,521,524,566:{ MaxSpeed[playerid] = 90; } // 90
	    case 462,463,468,586:{ MaxSpeed[playerid] = 80; }// 80
	    case 558,470,482,490:{ MaxSpeed[playerid] = 87; } // 87
	    case 475,536,567:{ MaxSpeed[playerid] = 96; }// 96
	    case 478:{ MaxSpeed[playerid] = 65; } // 65
	    case 480:{ MaxSpeed[playerid] = 103; } // 103
	    case 491:{ MaxSpeed[playerid] = 83; } // 83
	    case 494,502,503:{ MaxSpeed[playerid] = 120; }// 120
	    case 523,580,581,585,600:{ MaxSpeed[playerid] = 85; } // 85
	    case 506,559,562:{ MaxSpeed[playerid] = 100; } // 100
	    case 571:{ MaxSpeed[playerid] = 52; } // 52
	    case 514:{ MaxSpeed[playerid] = 67; } // 67
	    default: { MaxSpeed[playerid] = 124; }
	}
    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) SetPVarInt(playerid, "Position", gettime() + 2);
	if(newstate == PLAYER_STATE_PASSENGER) SetTimerEx("AntiCarShoter",3500,false,"i",playerid);
	if(newstate == PLAYER_STATE_ONFOOT) checkcs[playerid] = 0;
    if(newstate == PLAYER_STATE_DRIVER) SetPVarInt(playerid,"VehID",GetPlayerVehicleID(playerid)),SetPVarInt(playerid,"exitedtrans",0);
    if(oldstate == PLAYER_STATE_DRIVER)
    {
        if(BanCar[GetPVarInt(playerid,"VehID")]) KillTimer(TimeUpdate[playerid]);
        TimeUpdate[playerid] = SetTimerEx("UpdateVehiclePos", 10000, false, "ii", GetPVarInt(playerid,"VehID"), 1);
        BanCar[GetPVarInt(playerid,"VehID")] = true;
	}
	pTemp[playerid][pAbletoGun] = 2;
	if(newstate == PLAYER_STATE_DRIVER)
	{
	    SetPVarInt(playerid,"exitedtrans",0);
		SetPlayerArmedWeapon(playerid,0);
		new vehicleid = GetPlayerVehicleID(playerid);
		new model = GetPlayerVehicleSeat(playerid);
		if(model != 128)
		{
			if(!model)
			{
				model = GetVehicleModel(GetPlayerVehicleID(playerid));
				if(!(400 <= model <= 611) || MaxPassengers[model - 400 >>> 3] >>> ((model - 400 & 7) << 2) & 0xF == 15) return NewKick(playerid);
			}
			else return NewKick(playerid);
		}
		if(pTemp[playerid][pEnterVehicle] != vehicleid && !IsKicked(playerid))
		{
			AddCheaterID(playerid,1);
			return 1;
		}
