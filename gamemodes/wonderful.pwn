			else SetPlayerSpecialAction(playerid, 25), SetPlayerAttachedObject(playerid,0,gEateryObj[sel],3,0.232999,-0.376998,-0.408999,54.199886,-35.700153,-35.000019,1.000000,1.000000,1.000000);
		}
