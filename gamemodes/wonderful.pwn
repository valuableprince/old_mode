		if(sql_num_rows(zBan)) return SendClientMessage(playerid, COLOR_GREY, "Данный игрок забанен");
		sql_free_result(zBan);
  		new stringer[255];
		format(stringer, sizeof(stringer), "Администратор %s дал оффлайн бан игроку %s на %d дней. Причина: %s",pData[playerid][pNickname],account,time,tmp);
