stock UpdateBusinessText(id)
{
	if(id < 0 || id >= MAX_BUSINESS_COUNT || !gBusiness[id][busiID]) return -1;
	new mes[296];
	if(gBusiness[id][busiStatus])
	{
	    new atext[100];
		switch(gBusiness[id][busiMafia])
		{
		    case F_COL: atext = "Колумбия";
		    case F_MEX: atext = "Мексиканцы";
		    case F_YAK: atext = "Якудза";
		    default: atext = "Нет";
		}
		new ownerid = gBusiness[id][busiOwnerID];
		new nickname[MAX_PLAYER_NAME];
		if(ownerid)	GetPlayerNameByID(ownerid,nickname);
		else strcat(nickname,"Нет");
		new status[24];
		if(gBusiness[id][busiStatus]) strcat(status,"{"#cGREEN"}Открыт");
		else strcat(status,"{"#cRED"}Закрыт");
		if(gBusiness[id][busiEnterPrice] > 0)
		{
			format(mes,sizeof(mes),"{"#cGREEN"}%s\n{"#cBLUE"}Владелец: {"#cW"}%s\n{"#cBLUE"}Стоимость: {"#cW"}$%d\n{"#cBLUE"}Контроль: {"#cW"}%s\n{"#cBLUE"}Цена за вход: {ffffff}%d$",gBusiness[id][busiName],nickname,gBusiness[id][busiSellPrice],atext,gBusiness[id][busiEnterPrice]);
		}
		if(!gBusiness[id][busiEnterPrice])
		{
			format(mes,sizeof(mes),"{"#cGREEN"}%s\n{"#cBLUE"}Владелец: {"#cW"}%s\n{"#cBLUE"}Стоимость: {"#cW"}$%d\n{"#cBLUE"}Контроль: {"#cW"}%s",gBusiness[id][busiName],nickname,gBusiness[id][busiSellPrice],atext);
		}
	}
	else strcat(mes,"\t\t\t{"#cRED"}ЗАКРЫТО\n{"#cGRAY"}(Информация недоступна)");
	UpdateDynamic3DTextLabelText(gBusinessText[id],CWHITE,mes);
	return 1;
}

