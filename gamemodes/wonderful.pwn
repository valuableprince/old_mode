	if(!strcmp(cmd,"/maskirovka",true))
	{
		if(pData[playerid][pFraction] != 12) return SendClientMessage(playerid,-1,"{AC0000}[Ошибка] {ffffff}У Вас нет доступа к служебному инвентарю");
		if(pData[playerid][pRank] < 3) return SendClientMessage(playerid,-1,"• {AC0000}[Ошибка] {ffffff}Функция доступна только с 3 ранга");
		ShowPlayerDialog(playerid,dMaskirovka,2,"Выбор маскировки","Grove Street\nBallas Gang\nRifa Gang\nVagos Gang\nAztecas Gang\nКолумбийская мафия\nМексиканская мафия\nYakuza\nГражданский 1\nГражданский 2\nГражданский 3\nВернуть свою внешность","Выбрать","Отмена");
	    if(GetPVarInt(playerid,"seloldsk") > 0) return 1;
		SetPVarInt(playerid, "OldSkinm", GetPlayerSkin(playerid));
		SetPVarInt(playerid,"seloldsk",1);
	}
	if(!strcmp(cmd,"/filling",true))
	{
		if(pData[playerid][pBusiness] < FILLING_ID_OFFSET) return SendClientMessage(playerid,-1,"• {AC0000}[Ошибка] {ffffff}У Вас нет АЗС");
		new fillingid = -1;
		for(new i;i<FILLING_COUNT;i++)
		{
			if(pData[playerid][pMysqlID] == gFillings[i][fillOwnerID]) fillingid = i;
		}
		if(fillingid == -1) return SendClientMessage(playerid,CRED,"Програмная ошибка (не найдена АЗС)");
		SetPVarInt(playerid,"fillingid",fillingid);
		ShowPlayerDialog(playerid,dFillingInfo,2,"Управление АЗС","1. Информация\n2. Цены\n3. Улучшения\n4. Заказать топливо\n5. Управление кассой\n6. Открыть / закрыть заправку\n7. Продать АЗС","ОК","Отмена");
	}
 	if(!strcmp(cmd,"/fillcar",true))
	{
	    if(pTemp[playerid][pKanistra] == false)return SendClientMessage(playerid,-1,"• {AC0000}[Ошибка] {ffffff}У вас нет канистры!");
	    if(!pData[playerid][pCar]) return SendClientMessage(playerid,-1,"• {AC0000}[Ошибка] {ffffff} Заправлять можно личное транспортное средство");
	    new slot = GetCarSlot(pData[playerid][pCar]);
		new Float:x, Float:y, Float:z;
		new vehicleid = gCars[slot][carVid];
		if(GetEngineStat(vehicleid) == 1) return SendClientMessage(playerid,-1,"• {AC0000}[Ошибка] {ffffff}Заправляться можно только с заглушенными двигателем");
		if(gVehicles[vehicleid-1][vFuel] <= 60) return SendClientMessage(playerid,-1,"• {AC0000}[Ошибка] {ffffff}У Вас бак залит полностью.");
		GetVehiclePos(vehicleid,x,y,z);
		new Float:x2,Float:y2,Float:z2;
		GetPlayerPos(playerid,x2,y2,z2);
		if(PointToPoint3D(x,y,z,x2,y2,z2) > 6.0) return SendClientMessage(playerid,-1,"• {AC0000}[Ошибка] {ffffff}Вы далеко от своего т/с");
		pTemp[playerid][pKanistra] = false;
		gVehicles[vehicleid-1][vFuel] += 15;
		if(IsPlayerAttachedObjectSlotUsed(playerid, 6)) RemovePlayerAttachedObject(playerid,6);
		SendClientMessage(playerid,COLOR_GREEN,"В бак залито 15 литров бензина.");
	}
	if(!strcmp(cmd,"/buyfuel",true))
	{
	    if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT) return SendClientMessage(playerid,-1,"• {AC0000}[Ошибка] {ffffff}Вы не должны быть в т/с.");
	    new fillingid = -1;
	  	for(new i;i<FILLING_COUNT;i++)
