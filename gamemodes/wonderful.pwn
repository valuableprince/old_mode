forward IsVehicleOccupied(vehicleid);
public IsVehicleOccupied(vehicleid)
{
	foreach(new i : Player)
	{
		if(IsPlayerInVehicle(i,vehicleid)) return i;
	}
	return -1;
}
publics:SpcarsAvto(playerid)
{
	new string[256];
	for(new c=0; c<MAX_VEHICLES; c++)
	{
		if(IsVehicleOccupied(c) == -1) SetVehicleToRespawn(c);
	}
	format(string,sizeof(string),"(A) %s обновил весь незанятый транспорт!",pData[playerid][pNickname]);
	AdminChat(COLOR_GREY,string);
}
publics:Rullete(playerid)
{
	new randomS = RandomEx(0,5);
	switch(randomS)
	{
		case 0:
		{
		 	new name = 1000+random(15000);
	 		SendMes(playerid, COLOR_YELLOW, "{FFC800}Поздравляем! {FFFFFF} Ваш выигрыш составляет: %d $", name);
	 		pData[playerid][pMoney] += name;
			new mes[60];
			format(mes,sizeof(mes),"~w~%d$",name);
			GameTextForPlayer(playerid,mes,5000,1);
   		}
		case 1:
		{
			new name = 5+random(50);
			SendMes(playerid, COLOR_YELLOW, "{FFC800}Поздравляем! {FFFFFF} Ваш выигрыш составляет: %d рублей", name);
			pData[playerid][pDonate] += name;
			UpdatePlayerData(playerid,"donate",pData[playerid][pDonate]);
			new mes[60];
			format(mes,sizeof(mes),"~w~%drub",name);
			GameTextForPlayer(playerid,mes,5000,1);
		}
		case 2:
		{
			new name = random(50000);
			SendMes(playerid, COLOR_YELLOW, "{FFC800}Поздравляем! {FFFFFF} Ваш выигрыш составляет: %d $", name);
	 		pData[playerid][pMoney] += name;
	 		new mes[60];
			format(mes,sizeof(mes),"~w~%d$",name);
			GameTextForPlayer(playerid,mes,5000,1);
		}
		case 3:
		{
			new name = RandomEx(1,5);
			SendMes(playerid, COLOR_YELLOW, "{FFC800}Поздравляем! {FFFFFF} Ваш выигрыш составляет: %d EXP", name);
			pData[playerid][pExp] += name;
			if(pData[playerid][pExp] >= pData[playerid][pLevel]*6)
				{
				SendClientMessage(playerid,0xc0c0c0FF,"Ваш игровой уровень и IC возраст повысился");
				pData[playerid][pLevel]++;
				pData[playerid][pAge]++;
				pData[playerid][pExp] = pData[playerid][pExp] - (pData[playerid][pLevel]-1)*6;
				SetPlayerScore(playerid,pData[playerid][pLevel]);
				new query[144];
				format(query,sizeof(query),"UPDATE `aplayerakk` SET exp='%d', level='%d', age='%d' WHERE `id` = '%d'",
				pData[playerid][pExp],pData[playerid][pLevel],pData[playerid][pAge], pData[playerid][pMysqlID]);
				sql_query(snow, query, QUERY_THREADED);
				if(pData[playerid][pLevel] == 4)
				{
		    		if(pData[playerid][pPromo1] == 1)
		    		{
	            		SFCM(playerid,-1,"• {FFC800}[Информация] {FFFFFF}Вы получили {EE82EE}50.000$ {FFFFFF}за введеный ранее промокод");
	            		pData[playerid][pMoney] += 50000;
	            		pData[playerid][pPromo1] = 0;
	            		format(query,sizeof(query),"UPDATE `aplayerakk` SET `pPromo1` = '0', `money` = '%d' WHERE `id` = '%d'", pData[playerid][pMoney],pData[playerid][pMysqlID]);
						sql_query(snow, query, QUERY_THREADED);
   					}
					if(pData[playerid][pPromo1] == 2)
		    		{
		           		SFCM(playerid,-1,"• {FFC800}[Информация] {FFFFFF}Вы получили {EE82EE}200.000$ {FFFFFF}за введеный ранее промокод");
		           		pData[playerid][pMoney] += 200000;
		           		pData[playerid][pPromo1] = 0;
		           		format(query,sizeof(query),"UPDATE `aplayerakk` SET `pPromo1` = '0', `money` = '%d' WHERE `id` = '%d'", pData[playerid][pMoney],pData[playerid][pMysqlID]);
						sql_query(snow, query, QUERY_THREADED);
	   				}
				}
			}
			UpdatePlayerData(playerid,"exp",pData[playerid][pExp]);
		}
		case 4:
		{
			new name = random(30000);
			SendMes(playerid, COLOR_YELLOW, "{FFC800}Поздравляем! {FFFFFF} Ваш выигрыш составляет: %d $", name);
	 		pData[playerid][pMoney] += name;
	 		new mes[60];
			format(mes,sizeof(mes),"~w~%d$",name);
			GameTextForPlayer(playerid,mes,5000,1);
		}
	}
	DeletePVar(playerid,"ruletka");
}
publics: Gmtest(playerid)
{
    new Float:nowhealth[MAX_PLAYERS],query[250];
	new gmid = AdmGMID[playerid];
    if(AdmGM[playerid] == 1)
    {
        GetPlayerHealth(gmid,nowhealth[gmid]);
    }
    if((AdmGMHP[playerid]-nowhealth[AdmGMID[playerid]]) > 0)
    {
  		format(query,sizeof(query),"Игрок %s[%d] God Mode не обнаружен [Было HP: %.0f.00, стало HP: %.0f.00]",pData[gmid][pNickname],gmid,AdmGMHP[playerid],nowhealth[gmid],(AdmGMHP[playerid]-nowhealth[gmid]));
		SendClientMessage(playerid, CORANGE, query);
        SetPlayerHealth(AdmGMID[playerid], AdmGMHP[playerid]);
        AdmGM[playerid] = 0;
        AdmGMHP[playerid] = 0;
        AdmGMID[playerid] = INVALID_PLAYER_ID;
     }
     else if((AdmGMHP[playerid]-nowhealth[AdmGMID[playerid]]) == 0)
     {
  		format(query,sizeof(query),"Игрок %s[%d] подозрение на God Mode [Было HP: %.0f.00, стало HP: %.0f.00]",pData[gmid][pNickname],gmid,AdmGMHP[playerid],nowhealth[gmid],(AdmGMHP[playerid]-nowhealth[gmid]));
		SendClientMessage(playerid, CORANGE, query);
        AdmGM[playerid] = 0;
        AdmGMHP[playerid] = 0;
        AdmGMID[playerid] = INVALID_PLAYER_ID;
    }
	if(AdmGMArm[playerid] > 0)
	{
	SetPlayerArmourEx(gmid,AdmGMArm[playerid]);
	}
    KillTimer(GmtestTimer[playerid]);
}
publics: IsPlayerInZone(playerid, Float:minX, Float:minY, Float:maxX, Float:maxY)
{
	new Float:FXF_ZoneX, Float:FXF_ZoneY, Float:FXF_ZoneZ;
	GetPlayerPos(playerid, FXF_ZoneX, FXF_ZoneY, FXF_ZoneZ);
	if((FXF_ZoneX >= minX && FXF_ZoneX <= maxX) && (FXF_ZoneY >= minY && FXF_ZoneY <= maxY) && FXF_ZoneZ <= 500)
	{
		return 1;
	}
	return 0;
}
publics: IsPlayerInWater(playerid)
{
    new Float:FXF_wpos[3];
    GetPlayerPos(playerid,FXF_wpos[0],FXF_wpos[1],FXF_wpos[2]);
    if((FXF_wpos[2] > 0.00) || IsPlayerInZone(playerid,1808.2019,1424.5392,-2230.5024,-2347.7979)) { return 0; }
    else if((FXF_wpos[2] < 0.00) && (FXF_wpos[2] > -1.00)) { return 1; }
    else if(FXF_wpos[2] < -1.00) { return 2; }
    return 0;
}
publics: SecTimer()
{
    for(new playerid; playerid < MAX_PLAYERS; playerid++)
    {
	    if(Smoke[playerid] == 1)
		{
			if(SmokeTime[playerid] > 0)
			{
				SmokeTime[playerid] --;
				if(!SmokeTime[playerid])
				{
					new Float:Health;
					GetPlayerHealth(playerid, Health);
					SetPlayerSpecialAction(playerid,SPECIAL_ACTION_SMOKE_CIGGY);
					if(Health+5 < 100.0) SetPlayerHealthEx(playerid,Health+5);
					if(Smokes[playerid] >= 4)
					{
						if(pData[playerid][pSex] == 1) MeAction(playerid, "докурил сигарету и выбросил окурок");
						else MeAction(playerid, "докурила сигарету и выбросила окурок");
						SetPlayerSpecialAction(playerid,SPECIAL_ACTION_NONE);
						SmokeTime[playerid] = 0;
						Smokes[playerid] = 0;
						Smoke[playerid] = 0;
					}
					else
					{
						Smokes[playerid] ++;
						SmokeTime[playerid] = 10;
						if(pData[playerid][pSex] == 1) MeAction(playerid, "стряхнул пепел");
						else MeAction(playerid, "стряхнула пепел");
					}
				}
			}
		}
	}
	return 1;
}
stock SpeedVehicle(playerid)
{
    new Float:ST[4];
    if(IsPlayerInAnyVehicle(playerid))
    GetVehicleVelocity(GetPlayerVehicleID(playerid),ST[0],ST[1],ST[2]);
    else GetPlayerVelocity(playerid,ST[0],ST[1],ST[2]);
    ST[3] = floatsqroot(floatpower(floatabs(ST[0]), 2.0) + floatpower(floatabs(ST[1]), 2.0) + floatpower(floatabs(ST[2]), 2.0)) * 100.3;
    return floatround(ST[3]);
}
stock GetPlayer2DZone(playerid, zone[], len)
{
	new Float:x, Float:y, Float:z;
	GetPlayerPos(playerid, x, y, z);
	for(new i = 0; i != sizeof(gSAZones); i++ )
	{
		if(x >= gSAZones[i][SAZONE_AREA][0] && x <= gSAZones[i][SAZONE_AREA][3] && y >= gSAZones[i][SAZONE_AREA][1] && y <= gSAZones[i][SAZONE_AREA][4]) return format(zone, len, gSAZones[i][SAZONE_NAME], 0);
	}
	return 0;
}
forward TransferMoney(playerid,toplayerid,money,reason[]);
public TransferMoney(playerid,toplayerid,money,reason[])
{
	if(GetPlayerMoney(playerid) < 0) ResetPlayerMoney(playerid);
	if(GetPlayerMoney(toplayerid) < 0) ResetPlayerMoney(toplayerid);
	new id1=-1,id2=-1,remain1,remain2;
	if(toplayerid >= 0)
	{
		pData[toplayerid][pMoney] = pData[toplayerid][pMoney] + money;
		GivePlayerMoney(toplayerid,money);
		id2 = pData[toplayerid][pMysqlID];
		remain2 = pData[toplayerid][pMoney];
	}
	if(playerid >= 0)
	{
		GivePlayerMoney(playerid,-money);
		pData[playerid][pMoney] = pData[playerid][pMoney] - money;
		id1 = pData[playerid][pMysqlID];
		remain1 = pData[playerid][pMoney];
	}
	new y,m,d,h,mi,s;
	getdate(y,m,d);
	gettime(h,mi,s);
	new query[256];
	format(query,sizeof(query),"INSERT INTO `log_transfer` VALUES ('','%d','%d','%d-%d-%d %d:%d:%d','%d','%d','%d','%s')",id1,id2,y,m,d,h,mi,s,money,remain1,remain2,reason);
	sql_query(snow, query);
	if(playerid >= 0) UpdatePlayerData(playerid,"money",pData[playerid][pMoney]);
	if(toplayerid >= 0) UpdatePlayerData(toplayerid,"money",pData[toplayerid][pMoney]);
}
stock ServerIpBan(playerid,ip[],time)
{
	new query[128];
	if(playerid < 0) format(query,sizeof(query),"INSERT INTO `banip` VALUES ('','-1','%s','%d')",ip,time);
	else format(query,sizeof(query),"INSERT INTO `banip` VALUES ('','%d','%s','%d')",pData[playerid][pMysqlID],ip,time);
	sql_query(snow, query);
	return 1;
}
stock IsTextInvalid(text[])
{
	if(strfind(text, "'", true) != -1) return 1;
	if(strfind(text, "=", true) != -1) return 1;
	if(strfind(text, "%", true) != -1) return 1;
	if(strfind(text, "&", true) != -1) return 1;
	if(strfind(text, "*", true) != -1) return 1;
	if(strfind(text, "(", true) != -1) return 1;
	if(strfind(text, ")", true) != -1) return 1;
	if(strfind(text, ",", true) != -1) return 1;
	if(strfind(text, "`", true) != -1) return 1;
	if(strfind(text, ";", true) != -1) return 1;
	if(strfind(text, "|", true) != -1) return 1;
	return 0;
}
publics: MoneyFriends(playerid)
{
	new nick[MAX_PLAYER_NAME],bool:online = false,friendmsg[34+24];
	if(pData[playerid][pLevel] == 4 && pData[playerid][pExp] == 1)
	{
        foreach(new i:Player)
        {
		    if(i != INVALID_PLAYER_ID && IsPlayerConnected(i))
			{
			    if(i == playerid) continue;
			    GetPlayerName(i,nick,MAX_PLAYER_NAME);
			    if(strcmp(nick,pData[playerid][pRinvitation],false) == 0)
			    {
			        online = true;
					format(pData[playerid][pRinvitation],24,"-");
			        TransferMoney(-1,i,50000,"friendmoney");
					format(friendmsg,sizeof(friendmsg),"Вы получили 50.000$ за друга %s которого вы пригласили",pData[playerid][pNickname]);
					SendClientMessage(i,COLOR_YELLOW,friendmsg);
					GameTextForPlayer(playerid,"~g~ +50000$",5000,1);
					PlayerPlaySound(i, 43001, 0.0, 0.0, 0.0);
					format(friendmsg,sizeof(friendmsg),"Ваш друг %s, ник которого Вы указали при регистраций получил 50.000$",pData[i][pNickname]);
					SendClientMessage(playerid,COLOR_YELLOW,friendmsg);
			        break;
			    }
			}
		}
		if(online == false)
		{
			new friendquery[75];
			format(friendquery,sizeof friendquery,"SELECT `id` FROM `aplayerakk` WHERE `nickname` = '%s'",pData[playerid][pRinvitation]);
   			new Result:r = sql_query(snow, friendquery);
			new id;
			if(sql_num_rows(r))
			{
				id = strval(friendquery);
				format(friendquery,sizeof friendquery,"UPDATE `aplayerakk` SET `bank` = `bank` + 50000 WHERE `id` = '%d'",id);
				sql_query(snow,friendquery);
				new mes[128];
				format(mes,sizeof(mes),"Ваш друг %s, ник которого Вы указали при регистраций получил 50.000$",pData[playerid][pRinvitation]);
				SendClientMessage(playerid,COLOR_YELLOW,mes);
			}
			sql_free_result(r);
		}
		new friendupd[65+MAX_PLAYER_NAME];
		SendClientMessage(playerid,0x66CC00FF,"CERFFFFFFFF");
		format(friendupd,sizeof friendupd,"UPDATE `aplayerakk` SET `invitation` = '-' WHERE `nickname` = '%s'",pData[playerid][pNickname]);
		sql_query(snow,friendupd);
	}
	return 1;
}
