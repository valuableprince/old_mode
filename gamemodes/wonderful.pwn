		if(!IsPlayerConnected(id) || playerid == id) return SendErr(playerid,"Неверный ID игрока");
		if(GetPlayerDistanceToPlayer(playerid,id) > 3.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(id)) return SendErr(playerid,"Вы далеко друг от друга");
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp) || !isNumeric(tmp)) return SendErr(playerid, "/givepatr (ID - игрока)[Кол-во]");
