		case dBusPrice:
		{
			if(!response) return RemovePlayerFromVehicle(playerid);
			if(!strlen(inputtext) || !isNumeric(inputtext))
			{
				SendClientMessage(playerid,CGRAY,"Цена должна быть указана цифрами");
				return ShowPlayerDialog(playerid,dBusPrice,1,"Цена за проезд","{"#cW"}Введите цену билета:","ОК","Отмена");
			}
			new price = strval(inputtext);
			if(price < 1 || price > 20)
			{
				SendClientMessage(playerid,CGRAY,"Цена должна быть от 1 до 15 $");
