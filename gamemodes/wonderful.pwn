		else if(vehicleid >= aRadio[0] && vehicleid <= aRadio[1])
		{
		   	if(pData[playerid][pFraction] != 10)
			{
				SendClientMessage(playerid,CGRAY,"Этот транспорт доступен только сорудникам SAN News");
				RemovePlayerFromVehicle(playerid);
			}
		}
		else if(vehicleid >= aSFPD[0] && vehicleid <= aSFPD[1])
		{
			if(pData[playerid][pFraction] == 9 && pData[playerid][pRank] == 13) return 1;
		    if(!(pData[playerid][pFraction] == 9 && pData[playerid][pSubfraction] == 2))
			{
				SendClientMessage(playerid,CGRAY,"Этот транспорт доступен только сорудникам SFPD");
				RemovePlayerFromVehicle(playerid);
			}
		}
		else if(vehicleid >= aLVPD[0] && vehicleid <= aLVPD[1])
		{
			if(pData[playerid][pFraction] == 9 && pData[playerid][pRank] == 13) return 1;
		    if(!(pData[playerid][pFraction] == 9 && pData[playerid][pSubfraction] == 3))
			{
				SendClientMessage(playerid,CGRAY,"Этот транспорт доступен только сотрудникам LVPD");
				RemovePlayerFromVehicle(playerid);
			}
		}
		else //Цикл на проверку т.с. бандитов
		{
			for(new i;i<5;i++)
			{
				for(new j;j<5;j++)
				{
					if(vehicleid == aGang[i][j] && pData[playerid][pFraction] != i+3)
					{
						new mes[128];
						format(mes,sizeof(mes),"Этот транспорт доступен только членам %s",gFractionName[i+2]);
						SendClientMessage(playerid,CGRAY,mes);
						RemovePlayerFromVehicle(playerid);
					}
				}
			}
		}
		if(gVehicleGun[vehicleid][vGunLoading] || gVehicleGun[vehicleid][vGunUnloading])
		{
			if(vehicleid >= aArmy1[0] && vehicleid <= aArmy2[1] && pData[playerid][pFraction] != 8) return 1;
			if(vehicleid >= aLSPD[0] && vehicleid <= aLVPD[1] && pData[playerid][pFraction] != 9) return 1;
			ShowPlayerDialog(playerid,dStopLoad,0,"Загрузка/Разгрузка завершена.","{"#cW"}Вы хотите прекратить загрузку боеприпасов в грузовик?","Да","Нет");
		}
		SetPVarInt(playerid, "vehid", GetPlayerVehicleID(playerid));
		if(vehicleid) gVehicleDriver[vehicleid-1] = playerid;
		gVehicles[GetPlayerVehicleID(playerid) - 1][vOccupied] = true;
	}
	if(newstate == PLAYER_STATE_ONFOOT)
	{
		if(pData[playerid][pJob] == 1 && pTemp[playerid][pBusID] != INVALID_VEHICLE_ID)
		{
			DisablePlayerRaceCheckpoint(playerid);
			SendClientMessage(playerid,CRED,"У Вас есть 15 секунд, чтобы вернуться в автобус");
			pTemp[playerid][pBusSpawnTimer] = SetTimerEx("BusSpawn",15000,false,"i",playerid);
			SetPVarInt(playerid,"exitedtrans",1);
		}
		if(pData[playerid][pJob] == 3 && pTemp[playerid][pTaxiID] != INVALID_VEHICLE_ID)
		{
			DisablePlayerRaceCheckpoint(playerid);
			SendClientMessage(playerid,CRED,"У Вас есть 15 секунд, чтобы вернуться в такси");
			pTemp[playerid][pTaxiSpawnTimer] = SetTimerEx("TaxiSpawn",15000,false,"i",playerid);
			SetPVarInt(playerid,"exitedtrans",1);
		}
		if(pData[playerid][pJob] == 2 && pTemp[playerid][pTruckID] != INVALID_VEHICLE_ID)
		{
			DisablePlayerRaceCheckpoint(playerid);
			SendClientMessage(playerid,CRED,"У Вас есть 15 секунд, чтобы вернуться в грузовик");
			pTemp[playerid][pTruckSpawnTimer] = SetTimerEx("TruckerSpawn",15000,false,"i",playerid);
			SetPVarInt(playerid,"exitedtrans",1);
		}
		if(pTemp[playerid][pOnAutoExam] == true)
		{
			SendClientMessage(playerid, COLOR_LIGHTRED, "[Инструктор] Экзамен по вождению прекращён, вы покинули автомобиль");
   			pTemp[playerid][pOnAutoExam] = false;
   			pTemp[playerid][pOnExam] = false;
			DeletePVar(playerid, "LicTestHealth");
			DeletePVar(playerid, "LicTestError");
			SetVehicleToRespawn(GetPlayerVehicleID(playerid));
			DisablePlayerRaceCheckpoint(playerid);
		}
	}
	if(newstate == PLAYER_STATE_PASSENGER)
	{
		new vehicleid = GetPlayerVehicleID(playerid);
		pTemp[playerid][pOldVehicleid] = vehicleid;
		SetPlayerArmedWeapon(playerid,29);
		if(vehicleid >= aBus[0] && vehicleid <= aBus[1] && gVehicleDriver[vehicleid-1] != INVALID_PLAYER_ID) //Пассажир сел в автобус
		{
			new driverid = gVehicleDriver[vehicleid-1];
			new price = pTemp[driverid][pBusPrice];
			if(GetPlayerMoneyEx(playerid) < price)
			{
				SendClientMessage(playerid,CRED,"Недостаточно денег");
				return RemovePlayerFromVehicle(playerid);
			}
			new mes[12];
			format(mes,sizeof(mes),"~g~+$%d",price);
			GameTextForPlayer(driverid,mes,1000,1);
			format(mes,sizeof(mes),"~r~-$%d",price);
			GameTextForPlayer(playerid,mes,1000,1);
			pData[playerid][pMoney] -= price;
			pData[driverid][pMoney] += price;
		}
		if(vehicleid >= aTaxi[0] && vehicleid <= aTaxi[2] && gVehicleDriver[vehicleid-1] != INVALID_PLAYER_ID) //Пассажир сел в такси
		{
			new driverid = gVehicleDriver[vehicleid-1];
			if(pTemp[driverid][pTaxiID] != vehicleid || !pTemp[driverid][pTaxiPrice]) return 1;
			if(pTemp[driverid][pTaxiPass] == INVALID_PLAYER_ID)
			{
				if(GetPlayerMoneyEx(playerid) < pTemp[driverid][pTaxiPrice])
				{
					SendClientMessage(playerid,CRED,"Недостаточно денег");
					return RemovePlayerFromVehicle(playerid);
				}
				pTemp[driverid][pTaxiStart] = gVehicles[vehicleid-1][vDrived];
				pTemp[driverid][pTaxiPass] = playerid;
				pTemp[driverid][pTaxiGoing] = true;
			}
			else
			{
				if(pTemp[driverid][pTaxiTurn][0] == INVALID_PLAYER_ID) pTemp[driverid][pTaxiTurn][0] = playerid;
				else if(pTemp[driverid][pTaxiTurn][1] == INVALID_PLAYER_ID) pTemp[driverid][pTaxiTurn][1] = playerid;
				else
				{
					if(!IsPlayerConnected(pTemp[driverid][pTaxiTurn][0]) || GetPlayerVehicleID(pTemp[driverid][pTaxiTurn][0]) != vehicleid)
					{
						if(pTemp[driverid][pTaxiTurn][1] != INVALID_PLAYER_ID)
						{
							pTemp[driverid][pTaxiTurn][0] = pTemp[driverid][pTaxiTurn][1];
							pTemp[driverid][pTaxiTurn][1] = playerid;
						}
						else pTemp[driverid][pTaxiTurn][0] = playerid;
					}
					else if(!IsPlayerConnected(pTemp[driverid][pTaxiTurn][1]) || GetPlayerVehicleID(pTemp[driverid][pTaxiTurn][1]) != vehicleid)
					{
						pTemp[driverid][pTaxiTurn][1] = playerid;
					}
					else
					{
						SendClientMessage(playerid,CGRAY,"Ошибка. Зайдите в такси еще раз");
						RemovePlayerFromVehicle(playerid);
					}
				}
			}
		}
	}
	if(oldstate == PLAYER_STATE_DRIVER)
	{
		if(pTemp[playerid][pCarInfoTimer] != 0)
		{
			HideCarInfo(playerid);
			KillTimer(pTemp[playerid][pCarInfoTimer]);
			pTemp[playerid][pCarInfoTimer] = 0;
		}
		new id = GetPVarInt(playerid, "vehid");
		if(id)
		{
			gVehicles[id - 1][vOccupied] = false;
			GetVehiclePos(id, gVehicles[id - 1][vX], gVehicles[id - 1][vY], gVehicles[id - 1][vZ]);
			GetVehicleZAngle(id, gVehicles[id - 1][vA]);
			gVehicleDriver[id-1] = INVALID_VEHICLE_ID;
			SetPVarInt(playerid, "lastveh", id);
		}
	}
	return 1;
}

public OnPlayerEnterCheckpoint(playerid)
{
	if(pTemp[playerid][pDebtor] == true)
	{
	    DisablePlayerCheckpoint(playerid);
	    pTemp[playerid][pDebtor] = false;
	}
	if(pTemp[playerid][pNomera] == true)
	{
	    DisablePlayerCheckpoint(playerid);
		new query[512],nomer[15];
		format(query,sizeof(query),"SELECT `carnumber` FROM `cars` WHERE `id` = '%d'",pData[playerid][pCar]);
		new Result:r = sql_query(snow, query, QUERY_CACHED);
		sql_get_field(r, 0, nomer);
		new vehicleid = GetPlayerVehicleID(playerid), Float:x, Float:y, Float:z, Float:ang;
		SetVehicleNumberPlate(vehicleid, nomer);
		GetVehiclePos(vehicleid, x,y,z);
		GetVehicleZAngle(vehicleid,ang);
		SetVehicleToRespawn(vehicleid);
		SetVehiclePos(vehicleid,x,y,z);
		PutPlayerInVehicle(playerid,vehicleid,0);
		SetVehicleZAngle(vehicleid,ang);
		PlayerPlaySound(playerid,1133,0.0,0.0,0.0);
		pTemp[playerid][pNomera] = false;
		SendClientMessage(playerid, 0xFF9966FF,"Вы получили номера. Используйте {3366FF}/pts{FF9966} для показа ПТС авто.");
	}
 	if(GetPVarInt(playerid, "RunMut") == 1)
 	{
 	   	new vehicleid = GetPlayerVehicleID(playerid);
		if(GetVehicleModel(vehicleid) != 440) return SendErr(playerid,"Вы должны быть за рулём автомобиля для перевозки грузов");
		if(gGunWorkWH[3] < 10) return SendErr(playerid,"На складе недостаточно отходов");
		DisablePlayerCheckpoint(playerid);
		SendPods(playerid,"Металл загружен. Разгрузитесь на фабрике");
		SetPVarInt(playerid, "Dostavka", 1);
		gGunWorkWH[3] -= 10;
		SaveServerData();
 	}
 	if(GetPVarInt(playerid, "Rashod") == 1)
 	{
 	   	new vehicleid = GetPlayerVehicleID(playerid);
		if(GetVehicleModel(vehicleid) != 440) return SendErr(playerid,"Вы должны быть за рулём автомобиля для перевозки грузов");
		DisablePlayerCheckpoint(playerid);
		SendPods(playerid,"Расходный материал загружен. Отвезите комплектующие на фабрику");
		SetPVarInt(playerid, "Dostavka", 1);
 	}
	if(pTemp[playerid][pGPS])
	{
		DisablePlayerCheckpoint(playerid);
		pTemp[playerid][pGPS] = false;
		SendClientMessage(playerid,0x97d324ff,"Вы достигли места назначения");
	}
	if(GetPVarInt(playerid, "DrugsPlayerID") > 0)
	{
		new slot = GetPVarInt(playerid, "MafiaDrugsPlace");
		SeedObjectStatus[slot][GetPVarInt(playerid, "DrugsPlayerID")-1] = false;
		DestroyObject(SeedObject[slot][GetPVarInt(playerid, "DrugsPlayerID")-1]);
	    SetPVarInt(playerid, "DrugsPlayerVeh", GetPVarInt(playerid, "DrugsPlayerID")+1);
	    DeletePVar(playerid, "DrugsPlayerID");
   		ClearAnimations(playerid);
		ApplyAnimation(playerid,"CARRY","crry_prtial",4.1,0,1,1,1,1);
		SetPlayerAttachedObject(playerid, 3, 2901, 17, -0.073969, 0.349906, 0.065601, 331.510559, 271.870788, 321.750610, 0.831871, 1.000000, 0.748390 );
		DisablePlayerCheckpoint(playerid);
 		SendClientMessage(playerid, CGREEN, "Следуйте к вашему грузовику");
	}
	return 1;
}

public OnPlayerLeaveCheckpoint(playerid)
{
	return 1;
}

public OnPlayerEnterDynamicCP(playerid,checkpointid)
{
	if(checkpointid == CheckGang[0]	&& pData[playerid][pFraction] == F_YAK
	|| checkpointid == CheckGang[1] && pData[playerid][pFraction] == F_MEX
	|| checkpointid == CheckGang[2] && pData[playerid][pFraction] == F_COL)
	{
		if(IsAMafia(playerid))
		{
			ShowPlayerDialog(playerid, dMafia, 2, "{FFCD00}Склад Мафии", "{9ACD32}Положить патроны\n{9ACD32}Положить ед.оружия\n{9ACD32}Положить деньги\n{9ACD32}Положить наркотики\n{"#cW"}Взять наркотики\nВзять патроны\nВзять ед.оружия\nВзять деньги", "Принять", "Отмена");
		}
		else SendClientMessage(playerid, CGRAY, "Вы не можете пользоваться этим складом");
	}
    if(checkpointid == Sklad)
	{
		if(IsAMafia(playerid))
		{
		    new strv[300];
			new ptsk[MAX_PLAYERS];
			ptsk[playerid] = random(5)+1;
			if(MafiaAngar[0] - ptsk[playerid] < 0 || MafiaAngar[1] - ptsk[playerid] < 0) return SendClientMessage(playerid, COLOR_WHITE, "Нет Патронов или Ед.Оружия");
			if(500 < ptsk[playerid] + pData[playerid][pAmmo]) return SendClientMessage(playerid, COLOR_WHITE, "Недостаточно места в инвентаре.");
			if(500 < ptsk[playerid] + pData[playerid][pGunAmount]) return SendClientMessage(playerid, COLOR_WHITE, "Недостаточно места в инвентаре.");
			pData[playerid][pAmmo] += ptsk[playerid];
			UpdatePlayerData(playerid, "ammo", pData[playerid][pAmmo]);
			pData[playerid][pGunAmount] += ptsk[playerid];
			UpdatePlayerData(playerid, "gunamount", pData[playerid][pGunAmount]);
			Vor[playerid] = 1;
			format(strv, 32, "+ %d",ptsk[playerid]);
			SetPlayerChatBubble(playerid, strv, COLOR_YELLOW, 20.0, 10000);
			MafiaAngar[0] -= ptsk[playerid];
			MafiaAngar[1] -= ptsk[playerid];
			new mes[200];
			format(mes,sizeof(mes),"Кол-во патронов на складе: {"#cWHITE"}%i\n{"#cGREEN"}Кол-во ед. оружия на складе: {"#cWHITE"}%i\n\nНажмите \"H\" чтобы взять боеприпасы.", MafiaAngar[0], MafiaAngar[1]);
			UpdateDynamic3DTextLabelText(Angar,0x33AA33FF,mes);
		}
	}
	if(checkpointid == bandob)
	{
		OnPlayerCommandText(playerid,"/bandobsse");
	}
    if(checkpointid == TyritPT)
	{
		new armyid = GetPlayerVirtualWorld(playerid);
		if(pData[playerid][pFraction] >= 3 && pData[playerid][pFraction] <= 8)
		{
			StealMats(playerid,armyid);
		}
	}
	return 1;
}

public OnPlayerEnterRaceCheckpoint(playerid)
{
	if(pTemp[playerid][pOnAutoExam] == true)
	{
		if(GetPlayerState(playerid) != 2) return SendClientMessage(playerid, COLOR_GREY, "Вы должны находиться за рулем!");
		if(pPressed[playerid] == 32)
		{
			if(GetPVarInt(playerid, "LicTestError") == 3)
			{
				SendClientMessage(playerid, COLOR_LIGHTRED, "Вы провалили экзамен по вождению");
				ShowPlayerDialog(playerid, dMes, 0, "{"#cORANGE"}Школа вождения", "{FF6347}К сожалению вы не сдали экзамен по вождению", "Закрыть", "");
			}
			else
			{
				SendClientMessage(playerid, CGREEN, "Поздравляем! Вы сдали экзамен по вождению");
				ShowPlayerDialog(playerid, dMes, 0, "{"#cORANGE"}Школа вождения", "{"#cW"}Поздравляем, вы сдали экзамен по вождению", "Закрыть", "");
				new query[144];
				format(query,sizeof(query), "UPDATE `aplayerakk` SET `licDrive` = '1' WHERE `id` = '%d'",pData[playerid][pMysqlID]);
				sql_query(snow, query);
				SendClientMessage(playerid,COLOR_WHITE, "[{FFA500}Помощник Аманда{FFFFFF}] Ура! Поздравляю! Ты получил водительское удостоверение! Держи награду!");
				DeletePVar(playerid, "QTime");
				pData[playerid][pExp] += 1;
				pData[playerid][pMoney] += 2000;
				if(pData[playerid][pExp] >= pData[playerid][pLevel]*6)
				{
					SendClientMessage(playerid,0xc0c0c0FF,"Ваш игровой уровень и IC возраст повысился");
					pData[playerid][pLevel]++;
					pData[playerid][pAge]++;
					pData[playerid][pExp] = pData[playerid][pExp] - (pData[playerid][pLevel]-1)*6;
					SetPlayerScore(playerid,pData[playerid][pLevel]);
					format(query,sizeof(query),"UPDATE `aplayerakk` SET exp='%d', level='%d', age='%d' WHERE `id` = '%d'",
					pData[playerid][pExp],pData[playerid][pLevel],pData[playerid][pAge], pData[playerid][pMysqlID]);
					sql_query(snow, query, QUERY_THREADED);
					if(pData[playerid][pLevel] == 4)
					{
			    		if(pData[playerid][pPromo1] == 1)
			    		{
		            		SFCM(playerid,-1,"• {FFC800}[Информация] {FFFFFF}Вы получили {EE82EE}50.000$ {FFFFFF}за введеный ранее промокод");
		            		pData[playerid][pMoney] += 50000;
		            		pData[playerid][pPromo1] = 0;
		            		format(query,sizeof(query),"UPDATE `aplayerakk` SET `pPromo1` = '0', `money` = '%d' WHERE `id` = '%d'", pData[playerid][pMoney],pData[playerid][pMysqlID]);
							sql_query(snow, query, QUERY_THREADED);
	   					}
	   					if(pData[playerid][pPromo1] == 2)
			    		{
		            		SFCM(playerid,-1,"• {FFC800}[Информация] {FFFFFF}Вы получили {EE82EE}200.000$ {FFFFFF}за введеный ранее промокод");
		            		pData[playerid][pMoney] += 200000;
		            		pData[playerid][pPromo1] = 0;
		            		format(query,sizeof(query),"UPDATE `aplayerakk` SET `pPromo1` = '0', `money` = '%d' WHERE `id` = '%d'", pData[playerid][pMoney],pData[playerid][pMysqlID]);
							sql_query(snow, query, QUERY_THREADED);
	   					}
					}
				}
				pData[playerid][pLicenses][LIC_DRIVING] = 1;
			}
			pTemp[playerid][pOnAutoExam] = false;
			DeletePVar(playerid, "LicTestHealth");
			DeletePVar(playerid, "LicTestError");
			SetVehicleToRespawn(GetPlayerVehicleID(playerid));
			DisablePlayerRaceCheckpoint(playerid);
		}
		else
		{
			pPressed[playerid]++;
			new Float:healthd, i = pPressed[playerid];
			GetVehicleHealth(GetPlayerVehicleID(playerid), healthd);
			if(healthd < GetPVarFloat(playerid, "LicTestHealth"))
			{
				SendMes(playerid, COLOR_LIGHTRED, "Вы повредили транспорт. Ошибок: {"#cW"}%i", GetPVarInt(playerid, "LicTestError") + 1);
				SetPVarInt(playerid, "LicTestError", GetPVarInt(playerid, "LicTestError") + 1);
			}
			if(pPressed[playerid] < 32) SetPlayerRaceCheckpoint(playerid, 0, LicTest[i][0],LicTest[i][1],LicTest[i][2],LicTest[i][3],LicTest[i][4],LicTest[i][5], 5.0);
			else SetPlayerRaceCheckpoint(playerid,1, LicTest[i][0],LicTest[i][1],LicTest[i][2],LicTest[i][3],LicTest[i][4],LicTest[i][5], 5.0);
			SetPVarFloat(playerid, "LicTestHealth", healthd);
		}
	}
 	if(pData[playerid][pJob] == 6 && pTemp[playerid][pTruckID] != INVALID_VEHICLE_ID && pTemp[playerid][pTruckWagonID] != INVALID_VEHICLE_ID)
	{
		new weight = pTemp[playerid][pTruckWeight],
	    	fillid = pTemp[playerid][pTruckLoadID]-1,
	    	vehicleid = GetPlayerVehicleID(playerid),
			vagon = pTemp[playerid][pTruckWagonID];
		pTemp[playerid][pTruckWagonID] = INVALID_VEHICLE_ID;
		SetVehicleToRespawn(pTemp[playerid][pTruckWagonID]);
	    pTemp[playerid][pTruckLoadID] = 0;
	    pTemp[playerid][pTruckWeight] = 0;
		if(IsValid3DTextLabel(pTemp[playerid][pTruckWagonText])) DestroyDynamic3DTextLabelEx(pTemp[playerid][pTruckWagonText]);
		if(!IsPlayerInDynamicArea(playerid,gAreas[arFill][fillid]))
		{
            fuelOrders++;
            zFuelUpdate();
			SendClientMessage(playerid, COLOR_LIGHTRED, "Вы не отвезли бензин в нужное место и не получаете прибыли.");
			return 1;
		}
		if(!IsTrailerAttachedToVehicle(vehicleid) || vehicleid != pTemp[playerid][pTruckID] || GetVehicleTrailer(vehicleid) != vagon)
		{
		    fuelOrders++;
		    zFuelUpdate();
			SendClientMessage(playerid,CRED,"Вы потеряли прицеп и не получаете прибыли.");
			return 1;
		}
		SendClientMessage(playerid,CRED,"Вы доставили бензин на заправку.");
		pData[playerid][pZarplata] += weight*0.3;
		new zarpl[150];
		format(zarpl,sizeof(zarpl),"UPDATE `aplayerakk` SET `pZarplata` = '+%d' WHERE id = '%d'",pData[playerid][pZarplata]+(weight*0.3),pData[playerid][pMysqlID]);
		sql_query(snow, zarpl, QUERY_THREADED);
		new query[144];
		format(query,sizeof(query),"%d$ было добавлено к вашей зарплате.",weight*0.3);
		SendClientMessage(playerid,CGREEN,query);
		format(query,sizeof(query),"{FFAF00}SMS: {FFF700}На ваш зарплатный счет поступила заработная плата в размере %i$. {FFAF00}| {FFF700}Отправитель: Bank of America",weight*0.3);
		SendClientMessage(playerid,0xFFF700FF,query);
		SendClientMessage(playerid, COLOR_WHITE, "[{FF8C00}Подсказка{FFFFFF}] Заработную плату можно снять в банке");
		gFillings[fillid][fillFuel] += weight;
		UpdateFillingFuel(fillid);
	}
