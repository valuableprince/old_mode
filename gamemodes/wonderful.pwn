	if(!strcmp(cmd,"/sellcar",true))
	{
  		if(!pData[playerid][pCar] || (!pData[playerid][pHouse])) return SendErr(playerid, "У Вас нет т/с");
		new carID = GetCarSlot(pData[playerid][pCar]);
		if(carID == -1) return SendErr(playerid, "Т/С не найдено");
		if(pTemp[playerid][pTaxiID] != INVALID_VEHICLE_ID || pTemp[playerid][pTaxiPass] != INVALID_PLAYER_ID) return SendErr(playerid, "Нельзя использовать данную Команду сейчас");
		new vehicleid = gCars[carID][carVid];
		new modelid = GetVehicleModel(vehicleid) - 400;
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp))
		{
			new Float:factor;
			if(pData[playerid][pHouse]) factor = 0.5;
			else factor = 0.8;
			new price = floatround(gTransport[modelid][trPrice]*factor);
			SetPVarInt(playerid,"psellcarPrice",price);
			SetPVarInt(playerid,"psellcarID",carID);
			new mes[128];
			format(mes,sizeof(mes),"{"#cW"}Вы хотите продать свое т/с за {"#cGREEN"}$%d?",price);
			ShowPlayerDialog(playerid,dSellCar,0,"Продажа т/с",mes,"Да","Нет");
		}
		else
		{
			new actplayerid = strval(tmp);
			if(actplayerid == playerid || !IsPlayerConnected(actplayerid)) return SendErr(playerid, "Неверный ID игрока");
			if(!pData[actplayerid][pHouse] ) return SendErr(playerid, "У игрока нет дома");
			new houseid = pData[actplayerid][pHouse]-1;
			if(gHouses[houseid][houseOwnerID] != pData[actplayerid][pMysqlID]) return SendErr(playerid, "Машина может быть только у владельца дома");
			if(pData[actplayerid][pCar]) return SendErr(playerid, "У игрока уже есть своя машина. Если Вы хотите обменятся машинами используйте /changecar");
			if(GetPlayerDistanceToPlayer(playerid,actplayerid) > 3.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(actplayerid)) return SendErr(playerid, "Вы далеко друг от друга");
			tmp = strtok(cmdtext, idx);
			new price = strval(tmp);
			if(price < 1 || price > 50000000) return SendErr(playerid, "Цена не может быть меньше $1 или больше 50 млн.");
			new mes[128],classname[12];
			GetCarClassName(gTransport[modelid][trClass],classname);
			format(mes,sizeof(mes),"Вы предложили {"#cW"}%s {"#cINFO"} купить ваше т/с",pData[actplayerid][pNickname]);
			SendClientMessage(playerid,CINFO,mes);
			format(mes,sizeof(mes),"%s {"#cINFO"} предлагает Вам купить его авто за {"#cRED"}$%d{"#cINFO"}. Чтобы подтвердить нажмите {"#cGREEN"}Y{"#cINFO"}, иначе {"#cRED"}N",pData[playerid][pNickname],price);
			SendClientMessage(actplayerid,CWHITE,mes);
			format(mes,sizeof(mes),"Название: %s | Класс: %s | Пробег: %d | Бензобак: %dл. | Расход: %dл/100км",gTransport[modelid][trName],classname,gVehicles[vehicleid-1][vDrived],gTransport[modelid][trTank],gTransport[modelid][trConsumption]);
			SendClientMessage(actplayerid,CGREEN,mes);
			pTemp[playerid][pSellCarOffer] = playerid;
			pTemp[actplayerid][pSellCarOffer] = playerid;
			pTemp[actplayerid][pSellCarOffee] = actplayerid;
			pTemp[actplayerid][pSellCarPrice] = price;
			pTemp[actplayerid][pSellCarID] = carID;
			pData[playerid][pFast1] = 0;
			pData[playerid][pFast2] = 0;
            new query[128];
            format(query,sizeof(query),"UPDATE `aplayerakk` SET `fast1` = '0',`fast2` = '0' WHERE `id` = '%d'", pData[playerid][pMysqlID]);
			sql_query(snow, query);
		}
	}
	if(!strcmp(cmd,"/pay",true))
	{
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp) || !isNumeric(tmp)) return SendPods(playerid, "/pay (ID - игрока) [сумма]");
		new actplayerid = strval(tmp);
		if(!IsPlayerConnected(actplayerid) || playerid == actplayerid) return SendErr(playerid, "Неверный ID игрока");
		if(GetPlayerDistanceToPlayer(playerid,actplayerid) > 3.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(actplayerid)) return SendErr(playerid, "Вы далеко друг от друга");
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp) || !isNumeric(tmp)) return SendPods(playerid, "/pay (ID - игрока) [сумма]");
		new money = strval(tmp);
		if(money < 1 || money > 5000) return SendErr(playerid, "Можно передавать от 1 до 5000$");
		if(GetPlayerMoneyEx(playerid) < money) return SendErr(playerid, "У Вас недостаточно денег");
		if(GetPlayerState(playerid) == PLAYER_STATE_PASSENGER)
		{
			foreach(new i:Player)
			{
				if(!IsPlayerConnected(i)) continue;
				if(pTemp[i][pTaxiPass] == playerid) return SendErr(playerid, "Нельзя использовать операции с деньгами, пока вы не расплатитесь за проезд в такси");
			}
		}
		new mes[128];
		format(mes,sizeof(mes),"%s {"#cINFO"}передал Вам {"#cGREEN"}$%d",pData[playerid][pNickname],money);
		SendClientMessage(actplayerid,CWHITE,mes);
		format(mes,sizeof(mes),"Вы передали {"#cW"}%s {"#cRED"}$%d",pData[actplayerid][pNickname],money);
		SendClientMessage(playerid,CINFO,mes);
		format(mes,sizeof(mes),"достал деньги и передал их %s",pData[actplayerid][pNickname]);
		MeAction(playerid,mes);
		pData[playerid][pMoney] -= money;
		pData[actplayerid][pMoney] += money;
		format(mes,sizeof(mes),"~w~-%d~g~$",money);
		GameTextForPlayer(playerid,mes,5000,1);
		format(mes,sizeof(mes),"~w~+%d~g~$",money);
		GameTextForPlayer(actplayerid,mes,5000,1);
	}
	if(!strcmp(cmd,"/me",true))
	{
		if(pData[playerid][pMut]) return SendPods(playerid, "У вас бан чата. Используйте /mutetime чтобы узнать время бана.");
		tmp = strrest(cmdtext, idx);
		if(!strlen(tmp)) return SendPods(playerid, "/me [действие]");
		ReplaceID(tmp);
		MeActionMUT(playerid,tmp);
	}
	if(!strcmp(cmd,"/eat",true))
	{
		if(poxavat[playerid] == 3)
		{
			if(IsPlayerAttachedObjectSlotUsed(playerid,5)) RemovePlayerAttachedObject(playerid,5);// забрали кирку
			SetPlayerHealthEx(playerid, 100);
			pData[playerid][pHealth] = 100;
			poxavat[playerid] = 0;
			ApplyAnimation(playerid,"FOOD","EAT_Burger",4.1,0,1,1,1,1);
			SetPlayerChatBubble(playerid,"+30 HP",COLOR_YELLOW,20.0,10000);
			return 1;
		}
		else if(poxavat[playerid] == 2)
		{
			if(IsPlayerAttachedObjectSlotUsed(playerid,5)) RemovePlayerAttachedObject(playerid,5);// забрали кирку
			SetPlayerHealthEx(playerid, 100);
			pData[playerid][pHealth] = 100;
			poxavat[playerid] = 0;
			ApplyAnimation(playerid,"FOOD","EAT_Burger",4.1,0,1,1,1,1);
			SetPlayerChatBubble(playerid,"+90 HP",COLOR_YELLOW,20.0,10000);
			return 1;
		}
		else if(poxavat[playerid] == 1)
		{
			if(IsPlayerAttachedObjectSlotUsed(playerid,5)) RemovePlayerAttachedObject(playerid,5);// забрали кирку
			SetPlayerHealthEx(playerid, 100);
			pData[playerid][pHealth] = 100;
			poxavat[playerid] = 0;
			ApplyAnimation(playerid,"FOOD","EAT_Burger",4.1,0,1,1,1,1);
