public OnPlayerGiveDamage(playerid, damagedid, Float:amount, weaponid)
{

    new adminka = pData[playerid][pAdmin] == 0;
	if(weaponid == 4 && adminka || weaponid == 8 && adminka || weaponid == 9 && adminka || weaponid == 16 && adminka || weaponid == 17 && adminka || weaponid == 18 && adminka || weaponid == 35 && adminka || weaponid == 36 && adminka ||
	weaponid == 37 && adminka || weaponid == 38 && adminka || weaponid == 39 && adminka || weaponid == 22 && adminka || weaponid == 26 && adminka || weaponid == 27 && adminka || weaponid == 28 && adminka || weaponid == 32 && adminka)
	{
		AddGunCheaterID(playerid);
	}
	if(GetPlayerWeapon(playerid) == 23 && !IsPlayerInAnyVehicle(playerid))
	{
		new stringer[256];
		format(stringer,sizeof(stringer),"/tazer %d",damagedid);
		OnPlayerCommandText(playerid,stringer);
	}
	if(GetPlayerWeapon(playerid) == 3 && !IsPlayerInAnyVehicle(playerid))
	{
	    new stringer[256];
		format(stringer,sizeof(stringer),"/tazerdubinka %d",damagedid);
		OnPlayerCommandText(playerid,stringer);
	}
	if (damagedid >= MAX_PLAYERS) return 1;
	if(damagedid != INVALID_PLAYER_ID && !pTemp[damagedid][pControllable] && (pTemp[damagedid][pTazer] || pTemp[damagedid][pCuffee] == damagedid))
	{
		new Float:health = pData[damagedid][pHealth];
		health -= amount;
		if(health < 0.0) health = 0.0;
		SetPlayerHealthEx(damagedid,health);
	}
	return 1;
}


