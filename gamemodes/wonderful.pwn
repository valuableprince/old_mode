		strcat(mes,stringes);
		format(stringes,sizeof(stringes),"{FFFFFF}Наименование должности: {32CD32}%s\n",arang);
		strcat(mes,stringes);
		format(stringes,sizeof(stringes),"{FFFFFF}Дата: {32CD32}%02d-%02d-%d\n",day, month, year);
		strcat(mes,stringes);
		format(stringes,sizeof(stringes),"{FFFFFF}Текущее время: {32CD32}%d:%02d\n",h, m);
		strcat(mes,stringes);
		format(stringes,sizeof(stringes),"{FFFFFF}Время администрирования за сегодня: {32CD32}%d {FFFFFF}минут(ы)",pData[playerid][pAdmintime]);
		strcat(mes,stringes);
