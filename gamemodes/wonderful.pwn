			SendClientMessage(playerid,CWHITE,query);
			SendClientMessage(playerid,CWHITE,"• {FFCD00}[Подсказка] {FFFFFF}Не забудьте сделать скриншот, т.к. восстановить код при утере будет невозможно");
			format(query,sizeof(query),"UPDATE `aplayerakk` SET `ipcode` = '%d',`requestipcode` = '1' WHERE id = '%d'",pTemp[playerid][pKodIP],pData[playerid][pMysqlID]);
			sql_query(snow, query, QUERY_THREADED);
		}
