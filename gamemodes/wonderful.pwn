		new id = strval(tmp);
		if(!IsPlayerConnected(id) || id == playerid) return SendClientMessage(playerid,CGRAY,"Неверный ID игрока");
		if(GetPlayerDistanceToPlayer(playerid,id) > 3.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(id)) return SendClientMessage(playerid,CGRAY,"Вы далеко друг от друга");
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp) || !isNumeric(tmp)) return SendPods(playerid, "/sellgun (ID - игрока) [К-во патронов] [Цена]");
		new needammo = strval(tmp);
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp) || !isNumeric(tmp)) return SendPods(playerid, "/sellgun (ID - игрока) [К-во патронов] [Цена]");
		new price = strval(tmp);
		if(price > 300000 || price < 1) return SendClientMessage(playerid,CGRAY,"Цена должна быть от 1 до 300 тыс.");
		if(needammo > 300000 || needammo < 1) return SendClientMessage(playerid,CGRAY,"Неверное к-во патронов");
		new weaponid = GetPlayerWeapon(playerid);
		new ammo = GetPlayerAmmo(playerid);
		if(!weaponid) return SendClientMessage(playerid,CGRAY,"Возьмите в руку то оружие, которое хотите продать");
		if(ammo < needammo) return SendClientMessage(playerid,CGRAY,"У вас недостаточно патронов");
		SetPVarInt(playerid,"gunoffee",id);
		SetPVarInt(id,"gunoffee",id);
		SetPVarInt(id,"gunoffer",playerid);
		SetPVarInt(id,"gunprice",price);
		SetPVarInt(id,"gunammo",needammo);
		SetPVarInt(id,"gunid",weaponid);
		SetPVarInt(id,"pxa",ammo);
		new weapname[24];
		GetWeaponName(weaponid,weapname,24);
		new mes[128];
		format(mes, sizeof(mes), "Вы предложили {"#cW"}%s{"#cINFO"} купить у вас {"#cW"}%s{"#cINFO"} за {"#cW"}$%d. {"#cINFO"}Патронов: {"#cW"}%d",pData[id][pNickname],weapname,price,needammo);
		SendClientMessage(playerid,CINFO,mes);
		format(mes, sizeof(mes), "%s{"#cINFO"} предложил вам купить {"#cW"}%s{"#cINFO"} за {"#cW"}$%d. {"#cINFO"}Патронов: {"#cW"}%d",pData[playerid][pNickname],weapname,price,needammo);
		SendClientMessage(playerid,CINFO,mes);
		SendClientMessage(id,CINFO,"Чтобы согласиться нажмите {"#cGREEN"}Y, {"#cINFO"}иначе - {"#cRED"}N");

	}
	if(!strcmp(cmd,"/givekey",true))
	{
		if(pData[playerid][pFraction] >= 3 && pData[playerid][pFraction] <= 7 && pData[playerid][pRank] == 10)
		{
			tmp = strtok(cmdtext, idx);
			if(!strlen(tmp) || !isNumeric(tmp)) return SendPods(playerid, "/givekey (ID - игрока)");
			new id = strval(tmp);
			if(GetPlayerDistanceToPlayer(playerid,id) > 3.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(id)) return SendClientMessage(playerid,CGRAY,"Вы далеко друг от друга");
			if(!pTemp[id][pGangKey]) pTemp[id][pGangKey] = true,SendClientMessage(id,-1,"Вы получили ключи от дома банды"),SendClientMessage(playerid,-1,"Вы выдали ключи от дома банды");
			else pTemp[id][pGangKey] = false,SendClientMessage(id,-1,"У Вас забрали ключи от дома банды"),SendClientMessage(playerid,-1,"Вы забрали ключи от дома банды");
		}
		else return 1;
	}
	if(!strcmp(cmd,"/grespawn",true))
	{
		if(pData[playerid][pFraction] >= 3 && pData[playerid][pFraction] <= 7 && pData[playerid][pRank] == 10)
		{
			if(gGangRespawnCar) return SendClientMessage(playerid,CGRAY,"Попробуйте через 10 секунд");
			gGangRespawnCar = 5;
			new gangid = pData[playerid][pFraction]-3;
			for(new i=0;i<5;i++)
			{
				DestroyVehicle(aGang[gangid][i]);
				new vid;
				vid = CreateVehicle(gGangCars[gangid][i],gGangCarSlot[gangid][i][0],gGangCarSlot[gangid][i][1],gGangCarSlot[gangid][i][2],gGangCarSlot[gangid][i][3],gGangCarColors[gangid],gGangCarColors[gangid],900);
				aGang[gangid][i] = vid;
				//if(!j) aGang[gangid][i] = vid;
				//last = vid;
				gVehicles[vid - 1][vX] = gGangCarSlot[gangid][i][0];
				gVehicles[vid - 1][vY] = gGangCarSlot[gangid][i][1];
				gVehicles[vid - 1][vZ] = gGangCarSlot[gangid][i][2];
				gVehicles[vid - 1][vFuel] = gTransport[gGangCars[gangid][i]-400][trTank];
				gVehicles[vid - 1][vHealth] = 1000.0;
				gVehicles[vid - 1][vOwnerid] = INVALID_PLAYER_ID;
				gVehicles[vid - 1][vLock] = 0;
				gVehicles[vid - 1][vID] = vid;
			}
			SendClientMessage(playerid,CGREEN,"Авто банды было зареспавнено");
		}
	}
	if(!strcmp(cmd,"/gsellcar",true))
	{
		if(pData[playerid][pFraction] >= 3 && pData[playerid][pFraction] <= 7 && pData[playerid][pRank] == 10)
		{
			new gangid = pData[playerid][pFraction]-3;
			new mes[512];
			for(new i;i<5;i++)
			{
				if(!gGangCars[gangid][i] || gGangCars[gangid][i] == 481)
				{
					format(mes,sizeof(mes),"%s%d. Пусто\n",mes,i+1);
				}
				else
				{
					new modelid = gGangCars[gangid][i] - 400;
					format(mes,sizeof(mes),"%s%d. %s [{"#cGREEN"}$%d{"#cW"}]\n",mes,i+1,gTransport[modelid][trName],floatround(gTransport[modelid][trPrice]*0.2));
				}
			}
			ShowPlayerDialog(playerid,dSellGangCar,2,"Продать авто для банды",mes,"Продать","Отмена");
		}
	}
	if(!strcmp(cmd,"/setfuel",true))
	{
		if(pData[playerid][pAdmin] < 3) return 1;
	  	if(IsPlayerInAnyVehicle(playerid)){
		gVehicles[GetPlayerVehicleID(playerid)-1][vFuel] = gTransport[GetVehicleModel(GetPlayerVehicleID(playerid)) - 400][trTank];
		return 1;}
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp) || !isNumeric(tmp)) return SendPods(playerid, "/setfuel [ID авто]");
		new vid = strval(tmp);
		new model = GetVehicleModel(vid);
		if(!model) return SendClientMessage(playerid,CGRAY,"Неверный ID авто");
		gVehicles[vid-1][vFuel] = gTransport[model - 400][trTank];
		SendClientMessage(playerid, COLOR_WHITE, "Машина заправлена");
		return 1;
	}
	if(!strcmp(cmd,"/fv",true))
	{
		if(pData[playerid][pAdmin] < 2) return 1;
		if(IsPlayerInAnyVehicle(playerid)){
		SetVehicleHealthEx(GetPlayerVehicleID(playerid), 1000.0);
		RepairVehicle(GetPlayerVehicleID(playerid));
		return 1;}
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp) || !isNumeric(tmp)) return SendPods(playerid, "/fv [ID авто]");
		new vid = strval(tmp);
		new model = GetVehicleModel(vid);
		if(!model) return SendClientMessage(playerid,CGRAY,"Неверный ID авто");
		SendClientMessage(playerid, COLOR_WHITE, "[{FFA500}Admin-Helper{FFFFFF}] Транспорт отремонтирован");
		SetVehicleHealthEx(vid, 1000.0);
		RepairVehicle(vid);
		return 1;
	}
	if(!strcmp(cmd,"/economy",true))
	{
	    if(pData[playerid][pFraction] != 11) return 1;
     	if(pData[playerid][pRank] != 10 ) return SendClientMessage(playerid,CGRAY,"Эта возможность доступна только губернатору");
	    if(!IsPlayerInRangeOfPoint(playerid, 5.0, 390.5671,1378.8477,1089.1360)) return SendClientMessage(playerid,CGRAY,"Вы должны находиться в кабинете губернатора");
	   	ShowPlayerDialog(playerid, dEconomy, DIALOG_STYLE_LIST, "{ffff66}Управление экономикой", \
		"Бюджет казны штата {33AA33}Wonderful\n\
		{"#cOR"}1.{"#cW"} Контроль недвижимости\n\
		{"#cOR"}2.{"#cW"} Регулирование гос.работ\n\
		{"#cOR"}3.{"#cW"} Изменение пенсионного возраста\n\
		{"#cOR"}4.{"#cW"} Изменение пенсий", "Далее", "Закрыть");
		return 1;
	}
	if(!strcmp(cmd,"/newleader",true))
	{
	    if(pData[playerid][pAdmin] > 0 && pData[playerid][pAdmin] < 7) return SendClientMessage(playerid,CGRAY,"Недоступно");
   		if(pData[playerid][pComGs] == 1 || pData[playerid][pComGa] == 1 || pData[playerid][pComOsn] == 1)
		{
			if(!pData[playerid][pFraction]) return SendClientMessage(playerid,CGRAY,"Вы не состоите во фракции");
			new fractionid = pData[playerid][pFraction] - 1;
			if(pData[playerid][pRank] < gFractionRankCount[fractionid]) return SendClientMessage(playerid,CGRAY,"Функция доступна только лидеру");
			new frid = GetSubfractionID(fractionid);
			if(pData[playerid][pSubfraction] > 0) return SendClientMessage(playerid,CGRAY,"Функция доступна только лидеру");
			if(pData[playerid][pFraction] == 10) return SendClientMessage(playerid,CGRAY,"В вашей фракции нет подфракций");
			if(pData[playerid][pFraction] == 11) return SendClientMessage(playerid,CGRAY,"В вашей фракции нет подфракций");
			if(frid == -1) return SendClientMessage(playerid,CGRAY,"В вашей фракции нет подфракций");
			tmp = strtok(cmdtext, idx);
			if(!strlen(tmp) || !isNumeric(tmp)) return SendPods(playerid, "/newleader (ID - игрока)");
			new id = strval(tmp);
			if(!IsPlayerConnected(id) || !pData[id][pMysqlID]) return SendClientMessage(playerid,CGRAY,"Неверный ID / игрок не зарегистрирован");
			if(pData[id][pFraction] && pData[id][pFraction] != pData[playerid][pFraction]) return SendClientMessage(playerid,CGRAY,"Игрок уже состоит в организации");
			SetPVarInt(playerid,"actsubleader",id);
			new mes[128];
			strcat(mes,"Выберите подфракцию:");
			for(new i = 0;i < 3;i++)
			{
				if(strlen(gSubfractionName[frid][i]))
				{
					strcat(mes,"\n");
					strcat(mes,gSubfractionName[frid][i]);
				}
			}
			pTemp[id][pOfferFraction] = playerid;
			pTemp[id][pOfferFractionid] = fractionid;
			pTemp[playerid][pInviteLeader1] = id;
			ShowPlayerDialog(playerid,dSubleader,2,"Выберите подфракцию:",mes,"Назначить","Отмена");
		}
	}
	if(!strcmp(cmd,"/gnews",true))
	{
	    if(pData[playerid][pAdmin] > 0 && pData[playerid][pAdmin] < 7) return SendClientMessage(playerid,CGRAY,"Недоступно");
		if(pData[playerid][pMut]) return SendPods(playerid, "У вас бан чата. Используйте /mutetime чтобы узнать время бана.");
		if(!pData[playerid][pFraction]) return SendClientMessage(playerid,CGRAY,"Вы не состоите во фракции");
		new fraction = pData[playerid][pFraction];
		if(fraction != 12 && fraction != 2 && (fraction < 8 || fraction > 9) && fraction != 11 && fraction != 10 && fraction != 1) return SendClientMessage(playerid,CGRAY,"Вам недоступна эта функция");
		if(!IsAbleToGiveRank(playerid)) return SendErr(playerid, "Ваша должность недостаточна для использования данной функции");
		if(pTemp[playerid][pGnews] == 4) return SendClientMessage(playerid,CGRAY,"Вы сможете использовать команду через 10 минут");
		tmp = strrest(cmdtext, idx);
		if(!strlen(tmp)) return SendPods(playerid, "/gnews [сообщение]");
		if(!GetPVarInt(playerid, "playerPiar"))
	 	{
        Reklama(playerid, tmp);
        if(GetPVarInt(playerid, "playerPiar")) return DeletePVar(playerid, "playerPiar");
	    }
		new mes[128];
		format(mes,sizeof(mes),"[Гос.Новости] %s [%d]: %s",pData[playerid][pNickname],playerid, tmp);
		SendClientMessageToAll(0x4466ccff,mes);
		pTemp[playerid][pGnews] += 1;
		if(pTemp[playerid][pGnews] == 4)
		{
		SetTimerEx("Gnewslider",600000,false,"i",playerid);
		}
	}
	if(!strcmp(cmd,"/stopload",true))
	{
		if(pData[playerid][pFraction] != 8 && !IsAMafia(pData[playerid][pFraction]) && pData[playerid][pFraction] != 9) return SendClientMessage(playerid,CGRAY,"Вам недоступна эта функция");
		if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
		{
			new vehicleid = GetPlayerVehicleID(playerid);
			if((pData[playerid][pFraction] == 8 && GetVehicleModel(vehicleid) != 433 && GetVehicleModel(vehicleid) != 470) || ((IsAMafia(pData[playerid][pFraction]) || pData[playerid][pFraction] == 9) && GetVehicleModel(vehicleid) != 482)) return SendClientMessage(playerid,CGRAY,"Вы должны быть за рулем т.с. для перевозки оружия");
			{
				if(!vehicleid) return 1;
				if(gVehicleGun[vehicleid][vGunLoading] == false && gVehicleGun[vehicleid][vGunUnloading] == false) return 1;
				gVehicleGun[vehicleid][vGunLoading] = false;
				gVehicleGun[vehicleid][vGunUnloading] = false;
				if(IsValid3DTextLabel(gVehicleGun[vehicleid][vGunText])) DestroyDynamic3DTextLabelEx(gVehicleGun[vehicleid][vGunText]);
				DestroyDynamicArea(gVehicleGun[vehicleid][vGunArea]);
				DestroyDynamicPickup(gVehicleGun[vehicleid][vGunPickup]);
				gVehicleGun[vehicleid][vGunArea] = 0;
				gVehicleGun[vehicleid][vGunPickup] = 0;
				SendClientMessage(playerid,CGRAY,"Загрузка / разгрузка завершена");
			}
		}
	}
	if(!strcmp(cmd,"/runmut",true))
	{
		if(!IsAGang(playerid)) return SendErr(playerid,"Вам недоступна эта функция");
		if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
		{
  			if(GetPVarInt(playerid, "RunMut") == 1 || GetPVarInt(playerid, "Rashod") == 1)
			{
				SendPods(playerid, "Задание отменено");
				DisablePlayerCheckpoint(playerid);
				DeletePVar(playerid, "RunMut");
				DeletePVar(playerid, "Rashod");
			}
			new vehicleid = GetPlayerVehicleID(playerid);
			if(GetVehicleModel(vehicleid) != 440) return SendErr(playerid,"Вы должны быть за рулём автомобиля для перевозки грузов");
			ShowPlayerDialog(playerid,8514,2,"{ffff66}Выберите пункт","{4271ff}1.{"#cW"} Загрузка металла (отходы завода)\n{4271ff}2.{"#cW"} Загрузка расходного материала","Выбрать","Закрыть");
		}
	}
	if(!strcmp(cmd,"/loadgun",true))
	{
		if(pData[playerid][pFraction] != 8 && !IsAMafia(pData[playerid][pFraction]) && pData[playerid][pFraction] != 9) return SendClientMessage(playerid,CGRAY,"Вам недоступна эта функция");
		if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
		{
			new vehicleid = GetPlayerVehicleID(playerid);
			if((pData[playerid][pFraction] == 8 && GetVehicleModel(vehicleid) != 433 && GetVehicleModel(vehicleid) != 470) || ((IsAMafia(pData[playerid][pFraction]) || pData[playerid][pFraction] == 9) && GetVehicleModel(vehicleid) != 482)) return SendClientMessage(playerid,CGRAY,"Вы должны быть за рулем т.с. для перевозки оружия");
			if(gVehicleGun[vehicleid][vGunLoading] || gVehicleGun[vehicleid][vGunUnloading]) return SendClientMessage(playerid,CGRAY,"Авто уже стоит на загрузке / разгрузке");
			gVehicleGun[vehicleid][vGunVid] = vehicleid;
			gVehicleGun[vehicleid][vGunLoading] = true;
			RemovePlayerFromVehicle(playerid);
			new Float:x, Float:y, Float:z, Float:a;
			GetVehiclePos(vehicleid,x,y,z);
			GetVehicleZAngle(vehicleid,a);
			x = x - (-6.0*floatsin(a,degrees));
			y = y - 6.0*floatcos(a,degrees);
			gVehicleGun[vehicleid][vGunPickup] = CreateDynamicPickup(19133,1,x,y,z-0.5);
			new mes[128];
			format(mes,sizeof(mes),"Ед. оружия: {"#cGREEN"}%d\n{"#cWHITE"}Патронов: {"#cGREEN"}%d",gVehicleGun[vehicleid][vGunGunAmount],gVehicleGun[vehicleid][vGunAmmo]);
			gVehicleGun[vehicleid][vGunText] = CreateDynamic3DTextLabel(mes,CWHITE,x,y,z+0.5,20.0);
			gVehicleGun[vehicleid][vGunArea] = CreateDynamicSphere(x,y,z,1.0);
			SendClientMessage(playerid,CGREEN,"Загрузка началась.Что-бы закончить загрузку введите /stopload");
		}
	}
	if(!strcmp(cmd,"/unloadgun",true))
	{
		if(pData[playerid][pFraction] != 8 && !IsAMafia(pData[playerid][pFraction]) && pData[playerid][pFraction] != 9) return SendClientMessage(playerid,CGRAY,"Вам недоступна эта функция");
		if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
		{
			new vehicleid = GetPlayerVehicleID(playerid);
			if((pData[playerid][pFraction] == 8 && GetVehicleModel(vehicleid) != 433 && GetVehicleModel(vehicleid) != 470) || ((IsAMafia(pData[playerid][pFraction]) || pData[playerid][pFraction] == 9) && GetVehicleModel(vehicleid) != 482)) return SendClientMessage(playerid,CGRAY,"Вы должны быть за рулем т.с. для перевозки оружия");
            if(gVehicleGun[vehicleid][vGunLoading] || gVehicleGun[vehicleid][vGunUnloading]) return SendClientMessage(playerid,CGRAY,"Авто уже стоит на загрузке / разгрузке");
			gVehicleGun[vehicleid][vGunVid] = vehicleid;
			gVehicleGun[vehicleid][vGunUnloading] = true;
			RemovePlayerFromVehicle(playerid);
			new Float:x, Float:y, Float:z, Float:a;
			GetVehiclePos(vehicleid,x,y,z);
			GetVehicleZAngle(vehicleid,a);
			x = x - (-6.0*floatsin(a,degrees));
			y = y - 6.0*floatcos(a,degrees);
			gVehicleGun[vehicleid][vGunPickup] = CreateDynamicPickup(19133,1,x,y,z-0.5);
			new mes[128];
			format(mes,sizeof(mes),"Ед. оружия: {"#cGREEN"}%d\n{"#cWHITE"}Патронов: {"#cGREEN"}%d",gVehicleGun[vehicleid][vGunGunAmount],gVehicleGun[vehicleid][vGunAmmo]);
			gVehicleGun[vehicleid][vGunText] = CreateDynamic3DTextLabel(mes,CWHITE,x,y,z+0.5,20.0);
			gVehicleGun[vehicleid][vGunArea] = CreateDynamicSphere(x,y,z,1.0);
			SendClientMessage(playerid,CGREEN,"Разгрузка началась.Что-бы закончить разгрузку введите /stopload");
		}
	}
	if(!strcmp(cmd,"/tow",true))
	{
		if(pData[playerid][pJob] != 4) return SendClientMessage(playerid,CGRAY,"Вы не работаете механиком");
		if(pTemp[playerid][pMechID] == INVALID_VEHICLE_ID || GetPlayerVehicleID(playerid) != pTemp[playerid][pMechID]) return SendClientMessage(playerid,CGRAY,"Вы должны быть в буксире");
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp) || !isNumeric(tmp)) return SendPods(playerid, "/tow (ID - игрока)");
		new id = strval(tmp);
		if(!IsPlayerConnected(id) || !pData[id][pMysqlID] || id == playerid) return SendClientMessage(playerid,CGRAY,"Неверный ID / игрок не зарегистрирован");
		if(GetPlayerState(id) != PLAYER_STATE_DRIVER) return SendClientMessage(playerid,CGRAY,"Игрок должен быть за рулем т.с.");
		if(GetPlayerDistanceToPlayer(playerid,id) > 10.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(id)) return SendClientMessage(playerid,CGRAY,"Вы далеко друг от друга");
		SetPVarInt(playerid,"towoffer",playerid);
		SetPVarInt(playerid,"towoffee",id);
		SetPVarInt(id,"towoffer",playerid);
		SetPVarInt(id,"towoffee",id);
		new towcode = RandomEx(10000,99999);
		SetPVarInt(id,"towcode",towcode);
		new mes[128];
		format(mes, sizeof(mes), "Вы предложили {"#cW"}%s {"#cINFO"}отбуксировать его т.с.",pData[id][pNickname]);
		SendClientMessage(playerid,CINFO,mes);
		SPFD(id,dTow,1,"Буксир","ОК","Отмена","{"#cW"}%s предлагает отбуксировать ваше т.с.\nЕсли вы согласны введите \"{"#cLIGHTGREEN"}%d{"#cW"}\" (без кавычек) и нажмите ОК",pData[playerid][pNickname],towcode);
	}
	if(!strcmp(cmd,"/untow",true))
	{
		if(GetPVarInt(playerid,"towvid"))
		{
			new vehicleid = GetPVarInt(playerid,"towvid");
			new trailer = GetPVarInt(playerid,"towactvid");
			SetPVarInt(playerid,"towvid",0);
			SetPVarInt(playerid,"towactvid",0);
			if(GetVehicleTrailer(vehicleid) == trailer)
			{
				DetachTrailerFromVehicle(vehicleid);
				SendClientMessage(playerid,CGRAY,"Ваша машины была отцеплена от авто механика");
				return 1;
			}
		}
		if(pData[playerid][pJob] != 4) return SendClientMessage(playerid,CGRAY,"Вы не работаете механиком");
		if(pTemp[playerid][pMechID] == INVALID_VEHICLE_ID || GetPlayerVehicleID(playerid) != pTemp[playerid][pMechID]) return SendClientMessage(playerid,CGRAY,"Вы должны быть в буксире");
		new vehicleid = GetPlayerVehicleID(playerid);
		new trailer = GetVehicleTrailer(vehicleid);
		if(!trailer) return SendClientMessage(playerid,CGRAY,"Вы не буксируете авто");
		DetachTrailerFromVehicle(vehicleid);
		SendClientMessage(playerid,CGRAY,"Вы отсоединили авто");
	}
