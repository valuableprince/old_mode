						TogglePlayerControllable(playerid,0);
						SetTimerEx("Unfreez",3000,false,"i",playerid);
	  				}
				}
			}
		}
	}
	return 1;
}

public OnPlayerStreamIn(playerid, forplayerid)
{
	if(!(pData[forplayerid][pSettings] & setShowNickname)) ShowPlayerNameTagForPlayer(forplayerid,playerid,0);
	return 1;
}

public OnPlayerStreamOut(playerid, forplayerid)
{
	return 1;
}

public OnVehicleStreamIn(vehicleid, forplayerid)
{
    UpdateVehiclePos(vehicleid, 0);
	if(gVehicles[vehicleid-1][vLock]) SetVehicleParamsForPlayer(vehicleid,forplayerid,0,1);
	else SetVehicleParamsForPlayer(vehicleid,forplayerid,0,0);
	GetVehiclePos(vehicleid, gVehicles[vehicleid - 1][vX], gVehicles[vehicleid - 1][vY], gVehicles[vehicleid - 1][vZ]);
	GetVehicleZAngle(vehicleid, gVehicles[vehicleid - 1][vA]);
	return 1;
}

public OnVehicleStreamOut(vehicleid, forplayerid)
{
	return 1;
}

public OnDialogResponse(playerid, dialogid, response, listitem, inputtext[])
{
	printf("OnDialogResponse(%d, %d, %d, %d, %s)",playerid, dialogid, response, listitem, inputtext);
	if(dialogid == 5000)
	{
 		SetPVarInt(playerid, "dialogid", dialogid);
 		SetPVarInt(playerid, "response", response);
 		return 1;
	}
	pTemp[playerid][pDDOS2]++;
	strreplace(inputtext, '%', '#');
	pTemp[playerid][pDialog] = false;
	if(strlen(inputtext) && (strfind(inputtext,"`") != -1 || strfind(inputtext,"'") != -1 ||
	strfind(inputtext,"=") != -1)) return SendClientMessage(playerid,-1,"Ошибка. Вы использовали запрещенные символы.");
	switch(dialogid)
	{
	    case dObshak:
	    {
	        if(!response) return 1;
			if(pData[playerid][pFraction] < 3 || pData[playerid][pFraction] > 7) return SendClientMessage(playerid,CGRAY,"Данная функция доступна только бандам");
			switch(listitem)
			{
				case 0: ShowPlayerDialog(playerid,dObshakEd,2,"Общак","Положить ед. оружия\nВзять ед. оружия","Далее","Назад");
				case 1: ShowPlayerDialog(playerid,dObshakPt,2,"Общак","Положить патроны\nВзять патроны","Далее","Назад");
				case 2: ShowPlayerDialog(playerid,dObshakNrk,2,"Общак","Положить наркотики\nВзять наркотики","Далее","Назад");
				case 3: ShowPlayerDialog(playerid,dObshakMn,2,"Общак","Положить деньги\nВзять деньги","Далее","Назад");
			}
	    }
	    case dObshakEd:
	    {
	        if(!response) return OnPlayerCommandText(playerid,"/bandobsse");
			if(pData[playerid][pFraction] < 3 || pData[playerid][pFraction] > 7) return SendClientMessage(playerid,CGRAY,"Данная функция доступна только бандам");
			switch(listitem)
			{
				case 0: ShowPlayerDialog(playerid,dObshakEdput,1,"Положить ед.оружия","Введите кол-во","Далее","Назад");
				case 1: ShowPlayerDialog(playerid,dObshakEdtake,1,"Взять ед.оружия","Введите кол-во","Далее","Назад");
			}
	    }
	    case dObshakPt:
	    {
	        if(!response) return OnPlayerCommandText(playerid,"/bandobsse");
			if(pData[playerid][pFraction] < 3 || pData[playerid][pFraction] > 7) return SendClientMessage(playerid,CGRAY,"Данная функция доступна только бандам");
			switch(listitem)
			{
				case 0: ShowPlayerDialog(playerid,dObshakPtput,1,"Положить патроны","Введите кол-во","Далее","Назад");
				case 1: ShowPlayerDialog(playerid,dObshakPttake,1,"Взять патроны","Введите кол-во","Далее","Назад");
			}
	    }
	    case dObshakNrk:
	    {
	        if(!response) return OnPlayerCommandText(playerid,"/bandobsse");
			if(pData[playerid][pFraction] < 3 || pData[playerid][pFraction] > 7) return SendClientMessage(playerid,CGRAY,"Данная функция доступна только бандам");
			switch(listitem)
			{
				case 0: ShowPlayerDialog(playerid,dObshakNrkput,1,"Положить наркотики","Введите кол-во","Далее","Назад");
				case 1: ShowPlayerDialog(playerid,dObshakNrktake,1,"Взять наркотики","Введите кол-во","Далее","Назад");
			}
	    }
	    case dObshakMn:
	    {
	        if(!response) return OnPlayerCommandText(playerid,"/bandobsse");
			if(pData[playerid][pFraction] < 3 || pData[playerid][pFraction] > 7) return SendClientMessage(playerid,CGRAY,"Данная функция доступна только бандам");
			if(pData[playerid][pAdmin]) return SendErr(playerid, "Администрации запрещена данная функция!");
			switch(listitem)
			{
				case 0: ShowPlayerDialog(playerid,dObshakMnput,1,"Положить деньги","Введите кол-во","Далее","Назад");
				case 1: ShowPlayerDialog(playerid,dObshakMntake,1,"Взять деньги","Введите кол-во","Далее","Назад");
			}
	    }
	    case dObshakMnput:
		{
	        if(!response) return 1;
			if(pData[playerid][pFraction] < 3 || pData[playerid][pFraction] > 7) return SendClientMessage(playerid,CGRAY,"Данная функция доступна только бандам");
			new gangid = pData[playerid][pFraction] - 3;
			if(!IsPlayerInDynamicArea(playerid,gAreas[arDorm]) && GetPlayerVirtualWorld(playerid) != gangid) return SendClientMessage(playerid,CGRAY,"Вы должны быть в комнате с общаком");
//			tmp = strtok(cmdtext, idx);
			new amount = strval(inputtext);
			if(!strlen(inputtext) || !isNumeric(inputtext)) return SendClientMessage(playerid,CGRAY,"Вы ввели неверное значение");
			if(pData[playerid][pMoney] < amount || amount < 0) return SendClientMessage(playerid,CGRAY,"У Вас недостатчочно денег");
			gGangDorm[gangid][3] += amount;
			for(new i;i<MAX_PLAYERS;i++)
			{
				if(!IsPlayerConnected(i) || pData[i][pFraction] != pData[playerid][pFraction]) continue;
				new mes[128];
				format(mes,sizeof(mes),"%s {"#cGREEN"}положил в общак {"#cW"}%d {"#cGREEN"}$",pData[playerid][pNickname],amount);
				SendClientMessage(i,CWHITE,mes);
			}
			MeAction(playerid,"положил деньги в общак");
			pData[playerid][pMoney] -= amount;
			new query[128];
			format(query,sizeof(query),"UPDATE `gangs` SET `money` = '%d', `ammo` = '%d' WHERE `id` = '%d'",gGangDorm[gangid][3],gGangDorm[gangid][1],gangid+1);
			sql_query(snow, query);
			if(amount < 96000) return 1;
		}
		case 4001:
  		{
    		if(!response) return 1;
			if(!strlen(inputtext)) return ShowPlayerDialog(playerid, 4001, DIALOG_STYLE_INPUT, "Выгнать из семьи", "Введите id:", "Выгнать", "Отмена");
			if(!IsPlayerConnected(strval(inputtext))) return  SendClientMessage(playerid, 0xFFFFFFFF, "Игрок не в игре!");
		 	if(pData[strval(inputtext)][pFlvl] == 6) return SendClientMessage(playerid, 0xFFFFFFFF, "Нельзя выгонять создателя семьи!");
			if(pData[strval(inputtext)][pFname] == pData[playerid][pFname])
			{
				new string[128];
				pData[strval(inputtext)][pFlvl] = 0;
				format(string, 256, "Вы были выгнаны из семьи игроком %s.", pData[playerid][pNickname]);
				SendClientMessage(strval(inputtext), 0xFF0000FF, string);
				new query[256];
				format(query,sizeof(query),"UPDATE `aplayerakk` SET `fname`='', `flvl` = '0' WHERE `nickname` = '%s'", pData[strval(inputtext)][pNickname]);
				sql_query(snow, query);
				new query1[256];
				format(query1,sizeof(query1),"UPDATE `family_system` SET `members`=`members`-1 WHERE `name` = '%s'", pData[playerid][pFname]);
				sql_query(snow, query1);
				format(pData[playerid][pFname], 24, "");
			}else return SendClientMessage(playerid, 0xFFFFFFFF, "Этот игрок не в вашей семье!");
	 	}
	 	case 9001:
  		{
	  		if(!response) return 1;
			if(!strlen(inputtext)) return ShowPlayerDialog(playerid, 21, DIALOG_STYLE_INPUT, "Назначение ранга", "Введите id:", "Далее", "Отмена");
			if(pData[strval(inputtext)][pFlvl]!=6)
			{
				if(pData[strval(inputtext)][pFname] == pData[playerid][pFname])
				{
  					id21[playerid] = strval(inputtext);
					ShowPlayerDialog(playerid, 9002, DIALOG_STYLE_LIST, "Назначение ранга", "Новичок\nИгрок\nПро игрок\nЭлита\nЗам.лидера", "Принять", "Отмена");
				}
				else return SendClientMessage(playerid, 0xFFFF00FF, "Игрок не в вашей семье!");
			}
			else return SendClientMessage(playerid, 0xFFFFFFFF, "Нельзя менять ранг создателю!");
  		}
		case 9002:
  		{
  			if(!response) return 1;
	        switch(listitem)
			{
	            case 0: pData[id21[playerid]][pFlvl]  = 1;
	            case 1: pData[id21[playerid]][pFlvl]  = 2;
	            case 2: pData[id21[playerid]][pFlvl]  = 3;
		        case 3: pData[id21[playerid]][pFlvl]  = 4;
	            case 4: pData[id21[playerid]][pFlvl]  = 5;
			}
			new string[128];
			format(string, sizeof(string), "Вы выдали %s %i ранг", pData[id21[playerid]][pNickname], pData[id21[playerid]][pFlvl]);
			SendClientMessage(playerid, 0xFFFF00FF, string);
			format(string, sizeof(string), "%s выдал Вам %i ранг", pData[playerid][pNickname], pData[id21[playerid]][pFlvl]);
			SendClientMessage(id21[playerid], 0xFFFF00FF, string);
			new query[256];
			format(query,sizeof(query),"UPDATE `aplayerakk` SET `flvl` = '%d' WHERE `nickname` = '%s'", pData[id21[playerid]][pFlvl], pData[id21[playerid]][pNickname]);
			sql_query(snow, query);
			id21[playerid] = -1;
        }
        case 3002:
        {
        	if(!response) return 1;
	    	if(!strlen(inputtext)) return SendClientMessage(playerid, 0xFFFFFFFF, "Ошибка!");
	     	pData[playerid][pFlvl] = 1;
	      	format(pData[playerid][pFname], 24, "%s", inputtext);
	     	new query22[256];	format(query22,sizeof(query22),"SELECT `name` FROM `family_system` WHERE `name` = '%s'",inputtext);
			new Result:r = sql_query(snow, query22, QUERY_CACHED);
			if(!sql_num_rows(r))
			{
   				sql_free_result(r);
				SendErr(playerid,"Такой семьи не существует");
				return sql_free_result(r);
			}
			sql_free_result(r);
  			new query[256];
			format(query,sizeof(query),"UPDATE `aplayerakk` SET `fname`='%s', `flvl` = '1' WHERE `nickname` = '%s'", inputtext, pData[playerid][pNickname]);
			sql_query(snow, query);
			new query1[256];
			format(query1,sizeof(query1),"UPDATE `family_system` SET `members`=`members`+1 WHERE `name` = '%s'", inputtext);
			sql_query(snow, query1);
		    new string[512];
		    format(string, sizeof(string), "Вы вступили в семью {FF0000}%s!", inputtext);
		    SendClientMessage(playerid, 0xFFFFFFFF, string);
        }
        case dDonateFamily:
		{
		    if(!response) return 1;
			if(pData[playerid][pFlvl] > 0) return SendClientMessage(playerid,CGRAY,"Вы состоите в семье!");
		    if(pData[playerid][pDonate] < 100)
			{
				return SendClientMessage(playerid,CGRAY,"Вам нужно иметь 100 рублей на донат счете, чтобы создать семью.");
			}
			new query[256];	format(query,sizeof(query),"SELECT `name` FROM `family_system` WHERE `name` = '%s'",inputtext);
			new Result:r = sql_query(snow, query, QUERY_CACHED);
			if(sql_num_rows(r))
			{
			    sql_free_result(r);
				SendClientMessage(playerid,CGRAY,"Такое название семьи уже используется!");
				return sql_free_result(r);
			}
			sql_free_result(r);
			new string[256];
			format(string, sizeof(string), "Семья упешно создана!\r\nНазвание семьи: %s", inputtext);
			SendClientMessage(playerid, COLOR_LIGHTRED, string);
			new y23,m23,d23;
			getdate(y23,m23,d23);
			format(date23,12,"%d-%d-%d",y23,m23,d23);
			//new query[256];
			format(query,sizeof(query),"INSERT INTO `family_system` (`name`,`owner`,`date`,`color`,`members`) VALUES ('%s','%s','%s','FF0000','1')", inputtext, pData[playerid][pNickname], date23);
			sql_query(snow, query);
			pData[playerid][pDonate] -= 100;
			pData[playerid][pFlvl] = 6;
			format(pData[playerid][pFname],32,"%s",inputtext);
			new zStr[126];
			format(zStr,sizeof(zStr),"UPDATE `aplayerakk` SET `donate` = '%d', fname='%s', flvl='6' WHERE `id` = '%d'",pData[playerid][pDonate], inputtext, pData[playerid][pMysqlID]);
			sql_query(snow, zStr, QUERY_THREADED);
		}
  		case dDonateFamilyX2:
		{
		    if(!response) return 1;
			if(pData[playerid][pFlvl] > 0) return SendClientMessage(playerid,CGRAY,"Вы состоите в семье!");
		    if(pData[playerid][pDonate] < 50)
			{
				return SendClientMessage(playerid,CGRAY,"Вам нужно иметь 50 рублей на донат счете, чтобы создать семью.");
			}
			new query[256];	format(query,sizeof(query),"SELECT `name` FROM `family_system` WHERE `name` = '%s'",inputtext);
			new Result:r = sql_query(snow, query, QUERY_CACHED);
			if(sql_num_rows(r))
			{
			    sql_free_result(r);
				SendClientMessage(playerid,CGRAY,"Такое название семьи уже используется!");
				return sql_free_result(r);
			}
			sql_free_result(r);
			new string[256];
			format(string, sizeof(string), "Семья упешно создана!\r\nНазвание семьи: %s", inputtext);
			SendClientMessage(playerid, COLOR_LIGHTRED, string);
			new y23,m23,d23;
			getdate(y23,m23,d23);
			format(date23,12,"%d-%d-%d",y23,m23,d23);
			//new query[256];
			format(query,sizeof(query),"INSERT INTO `family_system` (`name`,`owner`,`date`,`color`,`members`) VALUES ('%s','%s','%s','FF0000','1')", inputtext, pData[playerid][pNickname], date23);
			sql_query(snow, query);
			pData[playerid][pDonate] -= 50;
			pData[playerid][pFlvl] = 6;
			format(pData[playerid][pFname],32,"%s",inputtext);
			new zStr[126];
			format(zStr,sizeof(zStr),"UPDATE `aplayerakk` SET `donate` = '%d', fname='%s', flvl='6' WHERE `id` = '%d'",pData[playerid][pDonate], inputtext, pData[playerid][pMysqlID]);
			sql_query(snow, zStr, QUERY_THREADED);
		}
		case dObshakMntake:
		{
	        if(!response) return 1;
			if(pData[playerid][pFraction] < 3 || pData[playerid][pFraction] > 7) return SendClientMessage(playerid,CGRAY,"Данная функция доступна только бандам");
			new gangid = pData[playerid][pFraction] - 3;
			if(!IsPlayerInDynamicArea(playerid,gAreas[arDorm]) && GetPlayerVirtualWorld(playerid) != gangid) return SendClientMessage(playerid,CGRAY,"Вы должны быть в комнате с общаком");
//			tmp = strtok(cmdtext, idx);
			new amount = strval(inputtext);
			if(!strlen(inputtext) || !isNumeric(inputtext)) return SendClientMessage(playerid,CGRAY,"Вы ввели неверное значение");
			if(gGangDorm[gangid][3] < amount || amount < 0) return SendClientMessage(playerid,CGRAY,"В общаке нет столько денег");
			gGangDorm[gangid][3] -= amount;
			for(new i;i<MAX_PLAYERS;i++)
			{
				if(!IsPlayerConnected(i) || pData[i][pFraction] != pData[playerid][pFraction]) continue;
				new mes[128];
				format(mes,sizeof(mes),"%s {"#cGREEN"}взял из общака {"#cW"}%d {"#cGREEN"}$",pData[playerid][pNickname],amount);
				SendClientMessage(i,CWHITE,mes);
			}
			MeAction(playerid,"взял деньги из общака");
			pData[playerid][pMoney] += amount;
			new query[128];
			format(query,sizeof(query),"UPDATE `gangs` SET `money` = '%d', `ammo` = '%d' WHERE `id` = '%d'",gGangDorm[gangid][3],gGangDorm[gangid][1],gangid+1);
			sql_query(snow, query);
			if(amount < 96000) return 1;
		}
	    case dObshakPtput:
		{
	        if(!response) return 1;
			if(pData[playerid][pFraction] < 3 || pData[playerid][pFraction] > 7) return SendClientMessage(playerid,CGRAY,"Данная функция доступна только бандам");
			new gangid = pData[playerid][pFraction] - 3;
			if(!IsPlayerInDynamicArea(playerid,gAreas[arDorm]) && GetPlayerVirtualWorld(playerid) != gangid) return SendClientMessage(playerid,CGRAY,"Вы должны быть в комнате с общаком");
//			tmp = strtok(cmdtext, idx);
			if(!strlen(inputtext) || !isNumeric(inputtext)) return SendClientMessage(playerid,CGRAY,"Вы ввели неверное значение");
			new gunamount = strval(inputtext);
			if(gGangDorm[gangid][1] + gunamount > 15000 || gunamount < 0) return SendClientMessage(playerid,CGRAY,"Общак полон");
			if(pData[playerid][pAmmo] < gunamount) return SendClientMessage(playerid,CGRAY,"У Вас недостаточно патрон");
			gGangDorm[gangid][1] += gunamount;
			pData[playerid][pAmmo] -= gunamount;
