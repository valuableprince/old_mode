		if(!IsAGang(playerid) && pData[playerid][pFraction] != 8) return SendClientMessage(playerid,CGRAY,"Вам недоступна данная функция");
		if(!pData[playerid][pAmmo]) return SendClientMessage(playerid,CGRAY,"У вас нет патронов");
