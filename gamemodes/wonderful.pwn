      	{
			new stringer[255];
	      	format(stringer, sizeof(stringer), "Администратор %s выдал оффлайн варн игроку %s. Причина: %s",pData[playerid][pNickname],account,tmp);
	      	SendLog(stringer);
	      	format(mes,sizeof(mes),"%s получил оффлайн предупреждение от Администратора %s. Причина: %s",account,pData[playerid][pNickname],tmp);
	       	SendClientMessageToAll(COLOR_LIGHTRED,mes);
	      	format(query, sizeof(query), "UPDATE `aplayerakk` SET `warnc` = `warnc`+1, `warn` = `warn`+%d, `fraction` = '0',`subfraction` = '0',`rank` = '0',`job` = '0' WHERE nickname = '%s'",WARN_TIME,account);
	      	sql_query(snow, query, QUERY_THREADED);
      	}
      	if(warn == 2)
      	{
	  		new stringer[255];
			format(stringer, sizeof(stringer), "Администратор %s дал оффлайн бан игроку %s (3 варна). Причина: %s",pData[playerid][pNickname],account,tmp);
			SendLog(stringer);
			format(zStr,sizeof(zStr),"%s получил оффлайн бан от Администратора %s (3 предупреждения). Причина: %s",account, pData[playerid][pNickname],tmp);
			SendClientMessageToAll(COLOR_LIGHTRED,zStr);
			new time = 15;
			time += gCurDay;
			if(!time) time += gCurDay + (365 * 99);
			format(query,sizeof(query),"INSERT INTO `ban` VALUES ('','%d','%d','%d','%s')",pData[playerid][pMysqlID],id,time,tmp);
			sql_query(snow, query);
  	      	format(query, sizeof(query), "UPDATE `aplayerakk` SET `warnc` = 0, `warn` = 0 WHERE nickname = '%s'",gCurDay + WARN_TIME,account);
	      	sql_query(snow, query, QUERY_THREADED);
      	}
	}
