		{
			if(response)
			{
			    new stringer[256];
				if(!strlen(inputtext)) return ShowPlayerDialog(playerid,10015,DIALOG_STYLE_INPUT,"{FF9900}Кикнуть игрока","Введите причину","Кикнуть","Отмена");
				format(stringer,sizeof(stringer),"/kick %d %s",pTemp[playerid][pSpectatee],(inputtext));
