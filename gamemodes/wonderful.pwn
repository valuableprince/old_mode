		}
		case dSafeCodeChange2:
		{
			if(!response)
			{
				new houseid = pData[playerid][pHouse] - 1;
				new mes[128];
				format(mes,sizeof(mes),"{"#cW"}Наркотики [{"#cGREEN"}%d/10000{"#cW"}]\nДеньги [{"#cGREEN"}%d$/1000000${"#cW"}]",gHouses[houseid][houseDrugs],gHouses[houseid][houseSafeMoney]);
				return ShowPlayerDialog(playerid,dSafe,0,"Сейф",mes,"Далее","Отмена");
			}
