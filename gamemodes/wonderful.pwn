		if(pData[playerid][pAdmin] >= 4) SendClientMessage(playerid, 0xffffffff, "[{FFA500}Модер (4){FFFFFF}] {BDB76B}/goto, /ban, /warn, /unwarn, /aclear, /respv, /offwarn, /templeader, /okay, /nookay, /unwarnoff");
		if(pData[playerid][pAdmin] >= 5) SendClientMessage(playerid, 0xffffffff, "[{FFA500}Ст.Модер (5){FFFFFF}] {BDB76B}/house, /gethere, /veh, /msg, /skin, /delv, /chat, /chatsms, /sban, /offget");
		if(pData[playerid][pAdmin] >= 5) SendClientMessage(playerid, 0xffffffff, "[{FFA500}Администратор (6){FFFFFF}] {BDB76B}/auninvite, /inter, /offban, /am, /startmp, /stopmp");
		if(pData[playerid][pAdmin] >= 6) SendClientMessage(playerid, 0xffffffff, "[{FFA500}Администратор (6){FFFFFF}] {BDB76B}/unban, /setweather, /deletegun, /spawncars, /rhp, /rgun, /agivegun");
		if(pData[playerid][pAdmin] >= 7) SendClientMessage(playerid, 0xffffffff, "[{FFA500}Ст.админ (7){FFFFFF}] {BDB76B}/setleader, /offleader, /agl, /gzcolor");
		if(pData[playerid][pAdmin] >= 7) SendClientMessage(playerid, 0xffffffff, "[{FFA500}Ст.админ (7){FFFFFF}] {BDB76B}/gun, /agivegun, /settime, /object");
		if(pData[playerid][pAdmin] >= 8) SendClientMessage(playerid, 0xffffffff, "[{FFA500}Зам.гл.админ (8){FFFFFF}] {BDB76B}/setbizprod, /setadmin, /deladmin, /banip, /unbanip, /apanel");
		if(pData[playerid][pAdmin] >= 8) SendClientMessage(playerid, 0xffffffff, "[{FFA500}Зам.гл.админ (8){FFFFFF}] {BDB76B}/testattachobjexx, /setskill, /setdostup, /delete, /givefund");
		if(pData[playerid][pAdmin] >= 9) SendClientMessage(playerid, 0xffffffff, "[{FFA500}Гл.Админ (9){FFFFFF}] {BDB76B}/delete, /setadmin");
		if(pData[playerid][pAdmin] >= 10) SendClientMessage(playerid, 0xffffffff, "[{FFA500}Основатель (10){FFFFFF}] /givecmd, /createbag (по спец.доступу)");
		if(pData[playerid][pAdmin] >= 11) SendClientMessage(playerid, 0xffffffff, "[{FFA500}Разработчик (11){FFFFFF}] /putfund, /aadmins, /createhouse, /createbiz, /hcar, /givedonate, /hints");
		if(pData[playerid][pAdmin] >= 11) SendClientMessage(playerid, 0xffffffff, "[{FFA500}Разработчик (11){FFFFFF}] /createhint, /setcmd, /setstat, /premia, /newzp, /bints, /payday");
