					return 1;
				}
				SetPVarString(playerid,"passvtr",inputtext);
				ShowPlayerDialog(playerid,dRegisterPovtor,3,"{ffffad}Повтор пароля","\n{FFFFFF}Введите пароль еще раз:","ОК","Отмена");
