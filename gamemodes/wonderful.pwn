			ShowPlayerDialog(playerid,dGrocer2,0,"Продуктвоый магазин",mes,"Да","Нет");
		}
		case dGrocer2:
		{
			if(!response) return ShowPlayerDialog(playerid,dGrocer,1,"Магазин продуктов","{"#cW"}Здесь Вы можете купить продукты которые будут храниться в вашем холодильнике\nУкажите количество продуктов которое Вы хотите купить:","ОК","Отмена");
			new products = GetPVarInt(playerid,"grocerproducts");
			new id = pTemp[playerid][pSelectedBusinessID];
