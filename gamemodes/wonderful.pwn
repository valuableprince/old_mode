		format(mes,sizeof(mes),"%s {"#cINFO"}предложил Вам купить номер телефона {4271FF}%d{"#cINFO"} за {FF0000}$%d{"#cINFO"}.",pData[playerid][pNickname],pData[playerid][pPhone],money);
		SendClientMessage(actplayerid,CWHITE,mes);
 		format(mes,sizeof(mes),"{"#cINFO"}Чтобы подтвердить нажмите {"#cGREEN"}Y{"#cINFO"}, иначе {"#cRED"}N");
		SendClientMessage(actplayerid,CINFO,mes);
  		format(mes,sizeof(mes),"• {FFC800}[Подсказка] {FFFFFF}При покупке номера он заменит ваш старый номер.");
		SendClientMessage(actplayerid,CWHITE,mes);
		pTemp[actplayerid][pSellsimpl] = playerid;
		pTemp[actplayerid][pSellsimact] = actplayerid;
		pTemp[actplayerid][pSellsum] =  money;
		pTemp[actplayerid][pSellsim] = 1;
