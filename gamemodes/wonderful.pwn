			}
			else pData[playerid][pWarnc] = 0;
			SendSucc(playerid, "Вы успешно сняли варн");
			new query[128];
			format(query,sizeof(query),"UPDATE `aplayerakk` SET `warn` = '%d', warnc = '%d', donate = '%d' WHERE `id` = '%d'",pData[playerid][pWarn], pData[playerid][pWarnc], pData[playerid][pDonate], pData[playerid][pMysqlID]);
			sql_query(snow, query);
		}
		case dDonateMoney1:
		{
			if(!response) return OnPlayerCommandText(playerid,"/donate");
