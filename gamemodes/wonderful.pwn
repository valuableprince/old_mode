			{
				SendClientMessage(playerid,CGRAY,"Возраст не может быть менее 18 и более 120");
				return OnPlayerCommandText(playerid,"/donate");
			}
			pData[playerid][pAge] = age;
			pData[playerid][pDonate] -= 25;
			new query[128];
			format(query,sizeof(query),"UPDATE `aplayerakk` SET `age` = '%d', donate = '%d' WHERE `id` = '%d'",age,pData[playerid][pDonate],pData[playerid][pMysqlID]);
			sql_query(snow, query);
			SendClientMessage(playerid,CGREEN,"Игровой возраст изменен");
		}
		case dRullete:
		{
