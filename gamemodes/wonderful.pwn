		new Result:r = sql_query(snow, query, QUERY_CACHED);
		new creator11[32],name11[32],data11[32];
		sql_get_field_assoc(r, "name", name11);
		sql_get_field_assoc(r, "owner", creator11);
		sql_get_field_assoc(r, "date", data11);
		new members = sql_get_field_assoc_int(r, "members");
		new rep = sql_get_field_assoc_int(r, "rep");
		format(string2,sizeof(string2),
		"%s\n\n{ff0000}Семья %s\n\
		{ffffff}Дата образования: {DEF78C}%s\n\
		{ff0000}Создатель: {89B1F2}%s\n\
		{89B1F2}Участников: %d\n\
		{89B1F2}Репутация: %d",string2,name11,data11,creator11,members,rep);
		ShowPlayerDialog(playerid, 0000, DIALOG_STYLE_MSGBOX, "{DEF78C}Информация о семье", string2, "Закрыть", "");
