forward SecUpdate();
public SecUpdate()
{
    GzCheck();
    GzCheckD();
    for(new i = 1; i <= TOTALGZ; i++)
	{
		if(GZSafeTime[i] > 0)
		{
			GZSafeTime[i]--;
			new stringText[30];
			Convert(GZSafeTime[i], stringText);
			TextDrawSetString(CaptTime, stringText);
   			if(GZSafeTime[i] == 60 || GZSafeTime[i] == 600)
			{
			    new string[127];
                format(string,127,"До окончания захвата территории осталось %d секунд.",GZSafeTime[i]);
				SendFMes(GZMZ[i][gNapad],CRED,string);
				SendFMes(GZMZ[i][gFrak],CRED,string);
			}
			if(GZSafeTime[i] == 0 && ZoneOnBattle[i] == 1)
			{
			    new string[127];
  				format(string,127,"Захват территории был окончен!");
				SendFMes(GZMZ[i][gNapad],CRED,string);
				SendFMes(GZMZ[i][gFrak],CRED,string);
			}
		}
	}
	for(new i = 1; i <= 5; i++)
	{
 		if(MafiaDrugs[i][1] == true && MafiaDrugs[i][2] == false)
		{
		    new Float:X, Float:Y, Float:Z;
		    for(new p = 0; p < 16; p++)
		    {
		        if(SeedObjectStatus[i][p] == true)
		        {
  					GetObjectPos(SeedObject[i][p], X, Y, Z);
        			MoveObject(SeedObject[i][p], X, Y, Z+0.0269163894653, 2, 0.0, 0.0, 0.0);
				}
			}
			GetObjectPos(SeedObject[i][0], X, Y, Z);
			if(Z >= 129.19999694824)
			{
		 		MafiaDrugs[i][2] = true;
		 		SendFMes(MafiaDrugSlot[i], CGREEN, "[Ферма] Урожай созрел. Можете его обрабатывать");
		 	}
		}
		if(MafiaDrugTime[i] != 0 && MafiaDrugTime[i] <= gettime())
	    {
			SendFMes(MafiaDrugSlot[i], CGREEN, "[Ферма] У вашей организации истекло время ");
	        MafiaDrugSlot[i] = 0;
	        MafiaDrugTime[i] = 0;
	    }
	}
}

stock Convert(seconds, stringTo[], size = sizeof(stringTo))
{
	stringTo[0] = 0x0;
	new result[4];
	result[0] = floatround(seconds / (3600 * 24));
	result[1] = floatround(seconds / 3600);
	result[2] = floatround((seconds / 60) - (result[1] * 60));
	result[3] = floatround(seconds - ((result[1] * 3600) + (result[2] * 60)));
	switch(result[0])
	{
	case 0:
		{
			switch(result[1])
			{
			case 0: format(stringTo,size,"%02d:%02d",result[2],result[3]);
			default: format(stringTo,size,"%d:%02d:%02d",result[1],result[2],result[3]);
			}
		}
	}
	return stringTo;
}
stock SendFMes(fact, color, str[])
{
	if(fact == 12) fact = 9;
	else if(fact == 9) fact = 12;
	foreach(new i:Player)
	{
		if(pData[i][pFraction] == fact) SendClientMessage(i, color, str);
		else if((fact == 12 && pData[i][pFraction] == 9) || (fact == 9 && pData[i][pFraction] == 12)) SendClientMessage(i, color, str);
	}
	return 1;
}
stock SendAPWMes(fact, color, str[])
{
	if(fact == 11) fact = 11;
	foreach(new i:Player)
	{
		if(pData[i][pFraction] == 11) SendClientMessage(i, color, str);
	}
	return 1;
}
stock SendRWMes(fact, color, str[])
{
	if(fact == 12) fact = 9;
	else if(fact == 9) fact = 12;
	foreach(new i:Player)
	{
		if(pData[i][pJob] == fact) SendClientMessage(i, color, str);
		else if((fact == 1 && pData[i][pJob] == 4) || (fact == 9 && pData[i][pJob] == 5)) SendClientMessage(i, color, str);
	}
	return 1;
}

stock GetColor(playerid)
{
    new str[8];
	format(str,8,"%06x",gFunctionColorFract[pData[playerid][pFraction] - 1] >>> 8);
	return str;
