			new mes[128];
			format(mes,sizeof(mes),"{"#cW"}Наркотики [{"#cGREEN"}%d/2000{"#cW"}]\nДеньги [{"#cGREEN"}%d$/1000000${"#cW"}]",gHouses[houseid][houseDrugs],gHouses[houseid][houseSafeMoney]);
			ShowPlayerDialog(playerid,dSafe,0,"Сейф",mes,"Далее","Отмена");
		}
		case dSafe:
		{
