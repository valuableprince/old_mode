		new holden[256];
		format(holden,sizeof(holden),"Смена ника на "Hostname" One.\nВаш новый ник: %s\nС Уважением, администрация проекта.",nickname);
		SendMail(pData[i][pEmail],""Serveremail"", ""Developer"", ""Hostname"", holden); }
	    return 1;
	}
