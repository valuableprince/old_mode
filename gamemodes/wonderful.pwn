					}
					ShowPlayerDialog(playerid,dDonateSex, DIALOG_STYLE_LIST,"Смена пола","{"#cW"}Мужской\nЖенский","Далее","Отмена");
				}
				case 5: // варн
				{
				    if(pData[playerid][pDonate] < 75)
					{
						OnPlayerCommandText(playerid,"/donate");
						return SendErr(playerid,"Вам нужно иметь 75 рублей на донат счете, чтобы снять Ваш варн.");
					}
					ShowPlayerDialog(playerid,dDonateWarn,0,"Снятие варна","{"#cW"}Вы уверены, что хотите снять 1 варн за 75 рублей?","Да","Отмена");
				}
				case 6: // семья
				{
				    if(pData[playerid][pDonate] < 100)
