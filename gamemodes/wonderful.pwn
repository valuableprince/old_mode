			ApplyAnimation(playerid, "GANGS", "hndshkfa",4.0,0,0,0,0,0,1);
			ApplyAnimation(acter, "GANGS", "hndshkfa",4.0,0,0,0,0,0,1);
			pTemp[playerid][pGiveHiact] = -1;
			pTemp[playerid][pGiveHipl] = -1;
			pTemp[acter][pGiveHipl] = -1;
			pTemp[acter][pGiveHiact] = -1;
			pTemp[playerid][pGiveHi] = 0;
			pTemp[acter][pGiveHi] = 0;
	    }
	    if(pTemp[playerid][pShowPassact] == playerid)
	    {
	        new acter = pTemp[playerid][pShowPasspl];
            ShowPass(acter,playerid);
       		new mes[64];
			format(mes,sizeof(mes),"достал паспорт и показал его %s",pData[playerid][pNickname]);
			MeAction(acter,mes);
			pTemp[playerid][pShowPassact] = -1;
