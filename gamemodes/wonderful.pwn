stock ReplaceID(text[])
{
    for(new i = strfind(text, "$", true), a = 0, tmp[4]; i != -1; i = strfind(text, "$", true, i))
	{
		++i, a = 0;
		while(48 <= text[i] <= 57 && a != 4) tmp[a++] = text[i++];
		if(tmp[0] == EOS) continue;
		if(!IsPlayerConnected(strval(tmp)) && !pTemp[strval(tmp)][pLogined]) continue;
		strdel(text, i - a - 1, i);
		strins(text, pData[strval(tmp)][pNickname], i - a - 1, 128);
	}
	return 1;
}
