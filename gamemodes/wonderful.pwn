			format(query,sizeof(query),"UPDATE `aplayerakk` SET `fraction` = '%d', rank = '1', `fractionskin` = '%d', `subfraction` = '%d', `job` = '0' WHERE `id` = '%d'",fractionid+1,skinid,pData[playerid][pSubfraction],pData[actplayerid][pMysqlID]);
			sql_query(snow, query);
