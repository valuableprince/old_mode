				OnPlayerCommandText(playerid,"/donate");
				return SendErr(playerid,"Вам нужно иметь 15 рублей на донат счете, чтобы поменять ник");
			}
			pData[playerid][pSex] = listitem+1;
			pData[playerid][pDonate] -= 15;
