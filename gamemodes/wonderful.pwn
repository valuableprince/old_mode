	if(!strcmp(cmd,"/warn",true))
	{
		if(pData[playerid][pAdmin] < 4) return 1;
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp) || !isNumeric(tmp)) return SendPods(playerid, "/warn (ID - игрока) (причина)");
		new id = strval(tmp);
		if(!IsPlayerConnected(id) || IsKicked(id)) return SendClientMessage(playerid,CGRAY,"Неверный ID");
		if(!pData[id][pMysqlID]) return SendClientMessage(playerid,CGRAY,"Этот игрок не зарегистрирован");
	 	if(pData[id][pAdmin] >= pData[playerid][pAdmin]) return SendPods(playerid, "/warn (ID - игрока) (причина)");
		tmp = strrest(cmdtext, idx);
		if(!strlen(tmp)) return SendPods(playerid, "/warn (ID - игрока) (причина)");
		new mes[128];
		new kol = pData[id][pWarnc]+1;
		if(IsIpFound(tmp))
		{
		format(mes,sizeof(mes),"(A)(Ban) %s[%d] получил блокировку аккаунта. (Реклама посторонних ресурсов)", pData[playerid][pNickname], playerid);
		AdminChat(0xFF0000ff,mes);
		format(mes,sizeof(mes),"[Cпам/Реклама] %s[%d]: %s",pData[playerid][pNickname],playerid,tmp);
		AdminChat(COLOR_YELLOW,mes);
		ServerBan(-1,playerid,60,"Реклама посторонних ресурсов");
		NewKick(playerid);
		new stringer[255];
		format(stringer, sizeof(stringer), "Админ %s получил блокировку за рекламу. IP: %s",pData[playerid][pNickname],pData[playerid][pLastIP]);
		SendLog(stringer);
		return 1;
		}
		if(kol < 3) format(mes,sizeof(mes),"Администратор %s выдал предупреждение игроку %s [%d/3]. Причина: %s",pData[playerid][pNickname],pData[id][pNickname],kol,tmp);
 		if(kol-1 > 0) pData[id][pWarn] += WARN_TIME;
		else pData[id][pWarn] = gCurDay + WARN_TIME;
		pData[id][pWarnc] = kol;
		new query[128];
		format(query,sizeof(query),"UPDATE `aplayerakk` SET `fraction` = '0', `rank` = '0', `fractionskin` = '0', `subfraction` = '0' WHERE `id` = '%d'",pData[id][pMysqlID]);
		sql_query(snow, query, QUERY_THREADED);
		pData[id][pFraction] = 0;
		pData[id][pRank] = 0;
		pData[id][pFractionSkin] = 0;
		pData[id][pSubfraction] = 0;
		SetPlayerColor(id,0xFFFFFF11);
		ResetPlayerWeaponsEx(id);
		new houseid = pData[id][pHouse]-1;
		if(!(houseid+1) || ((houseid+1) > 0 && pData[id][pMysqlID] != gHouses[houseid][houseOwnerID])) SetPlayerSkin(id,pData[id][pSkin]);
		else if(!gHouses[houseid][houseImprove][3]) SetPlayerSkin(id,pData[id][pSkin]);
		else
		{
			for(new x; x < 3; x ++) {
				if(!gHouses[houseid][houseSkin]) continue;
				pData[id][pSkin] = gHouses[houseid][houseSkin];
				if(GetPlayerSkin(id) == gHouses[houseid][houseSkin][3]) SetPlayerSkin(id,pData[id][pSkin]);
			}
			gHouses[houseid][houseSkin][3] = 0;
		}
		UpdatePlayerData(id,"warn",pData[id][pWarn]);
		UpdatePlayerData(id,"warnc",pData[id][pWarnc]);
		new stringer[255];
		format(stringer, sizeof(stringer), "Администратор %s выдал варн игроку %s (%d/3). Причина: %s",pData[playerid][pNickname],pData[id][pNickname],kol,tmp);
		SendLog(stringer);
		if(kol == 3)
		{
			pData[id][pWarn] = 0;
			pData[id][pWarnc] = 0;
			UpdatePlayerData(id,"warn",pData[id][pWarn]);
			UpdatePlayerData(id,"warnc",pData[id][pWarnc]);
			format(query,sizeof(query),"UPDATE `aplayerakk` SET `fraction` = '0', `rank` = '0', `fractionskin` = '0', `subfraction` = '0' WHERE `id` = '%d'",pData[id][pMysqlID]);
			sql_query(snow, query, QUERY_THREADED);
			pData[id][pFraction] = 0;
			pData[id][pRank] = 0;
			pData[id][pFractionSkin] = 0;
			pData[id][pSubfraction] = 0;
			SetPlayerColor(id,0xFFFFFF11);
			ResetPlayerWeaponsEx(id);
			if(!(houseid+1) || ((houseid+1) > 0 && pData[id][pMysqlID] != gHouses[houseid][houseOwnerID])) SetPlayerSkin(id,pData[id][pSkin]);
			else if(!gHouses[houseid][houseImprove][3]) SetPlayerSkin(id,pData[id][pSkin]);
			else
			{
				for(new x; x < 3; x ++) {
					if(!gHouses[houseid][houseSkin]) continue;
					pData[id][pSkin] = gHouses[houseid][houseSkin];
					if(GetPlayerSkin(id) == gHouses[houseid][houseSkin][3]) SetPlayerSkin(id,pData[id][pSkin]);
				}
				gHouses[houseid][houseSkin][3] = 0;
			}
			format(stringer, sizeof(stringer), "Администратор %s выдал бан на 15 дней. (Причина: %s)",pData[playerid][pNickname],pData[id][pNickname],tmp);
			SendLog(stringer);
			format(mes,sizeof(mes),"Администратор %s заблокировал игрока %s (3 предупреждения). Причина: %s",pData[playerid][pNickname],pData[id][pNickname],tmp);
			ServerBan(playerid,id,15,tmp);
		}
		SendClientMessageToAll(COLOR_LIGHTRED,mes);
		NewKick(id);
	}
	if(!strcmp(cmd,"/unwarn",true))
