		if(!i) format(mes,sizeof(mes),"%s",gunname);
		else format(mes,sizeof(mes),"%s\n%s",mes,gunname);
	}
	ShowPlayerDialog(playerid,dMakeGun,2,"Сборка оружия",mes,"Далее","Отмена");
